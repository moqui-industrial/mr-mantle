<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <default-property name="mantle_content_root" value=""/>
    <default-property name="mantle_content_large_root" value=""/>
    <!-- the framework's CalDAV and CardDAV servers serve Mantle's calendars, tasks and contact books (mr-moqui docs/interfaces/Sync.md) -->
    <dav-server calendar-services="mantle.work.CalendarDavServices" contact-services="mantle.party.ContactDavServices"/>
    <!-- an internal organization's own Constitution for agent runs and readers (service/mantle/party/ConstitutionServices.xml) -->
    <llm-facade><constitution-provider service="mantle.party.ConstitutionServices.get#ScopedConstitution"/></llm-facade>
    <!-- Smithy's quota for Git LFS (mr-pass plan/design-smithy.md §11 Quotas): asked before an upload is accepted; it
        returns at once for a repository with no SmithyRepository row -->
    <!-- Smithy over the git host (design-smithy §9.1, §9.3, N-HOOKS): the status contexts agreement/ and ci/ are the
        system's (the agreement check and the engine write them with authorization disabled, a user never); a merge
        request pushed for review, proposed on a page or opened from a fork starts hidden until Smithy's handler of its
        opened event has passed its text through the post gate (SmithyReviewServices.handle#MergeRequestEvent); and the
        answer to a push names the merge request's page under a root Smithy mount (a path: the host is the server's
        public URL) -->
    <git-server lfs-upload-check-service="mantle.smithy.SmithyGitServices.check#LfsUpload"
            reserved-status-contexts="agreement/,ci/" review-start-hidden="true"
            merge-request-url="/{repositoryPath}/-/merge-requests/{mergeRequestNum}"/>
    <webapp-list><webapp name="webroot">
        <servlet name="PassApi" location="component://mr-mantle/script/PassApi.js">
            <url-pattern>/rest/s1/pass/v1/sites/*</url-pattern>
        </servlet>
    </webapp></webapp-list>
    <!-- Commerce P14: a served feed's check by build, generation and the latest publication change in effect (StoreFeeds.js
        servable); bounded, as each generation change leaves the earlier keys behind -->
    <cache-list>
        <cache name="mantle.product.feedServing" type="local" max-elements="2000" expire-time-live="86400"/>
    </cache-list>
</moqui-conf>
