<?xml version="1.0" encoding="UTF-8" ?>
<!-- No copyright or license for configuration file, details here are not considered a creative work. -->
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <!-- Mantle's settings, each also an environment name (moqui_conf__mantle__smithy_github_api): smithy-github-api the
        GitHub API the Smithy import reads (a GitHub Enterprise Server's /api/v3), smithy-agreement-max-commits how many
        commits of a merge request are checked for agreements (250, the most a compare gives, when empty),
        calendar-email-from the sender of calendar reminders (the work effort owner's organization's when empty),
        content-root the location under which a record's files and text content are written (a task's, an order's, a
        Smithy release's notes and files, and the others), content-large-root the same for binary files. The roots are
        settings, never a user's preference: a user who could set one would choose where the server writes.
        mail-provider-authserv-ids the authserv-ids (comma separated) of the mail providers a synced (IMAP or POP) mailbox's
        mail comes from, whose topmost Authentication-Results field proves its sender's domain for a service queue's mail
        (mx.google.com for Gmail, for one); mail the listener takes is proved under the listener's own id
        (smtp-server@authserv-id, else its hostname when it verifies mail itself), never this list (SEC-BAP-84).
        forum-inbound-accounts the mail accounts (emailAccountId, comma separated) that are the forum's own inbound accounts: a
        forum route's mail is read only from one of these (hosted or shared, fed by the mail listener), never from a person's
        or an organization's mailbox that holds the same address (SEC-PFS-85). Empty: the forum reads no route's mail. -->
    <!-- Shop's payment limits: shop-payment-calls a requester's payment result and payment form calls in ten minutes,
        shop-payment-forms the hosted payment forms one payment attempt is given in ten minutes; each asks the provider
        (SEC-PSS-84); a customer's renewal resumptions and card changes count with the payment calls, and
        shop-renewal-resumes is how many times a day the customer has one renewal charged again (SEC-PSS-86).
        Marketing's event registrations: marketing-reservations-per-offer how many reservations an event's offer takes in a
        day from one requester and for one buyer address (each up to its tickets' places), marketing-tickets-per-address how
        many reservations a day name one attendee address, which is mailed each ticket (SEC-PSS-88). -->
    <mantle smithy-github-api="https://api.github.com" smithy-agreement-max-commits="" calendar-email-from=""
            content-root="dbresource://mantle/content" content-large-root="dbresource://mantle/content"
            shop-payment-calls="120" shop-payment-forms="10" shop-renewal-resumes="2"
            marketing-reservations-per-offer="20" marketing-tickets-per-address="10"
            mail-provider-authserv-ids="" forum-inbound-accounts=""/>
    <!-- the framework's CalDAV and CardDAV servers serve Mantle's calendars, tasks and contact books (mr-moqui docs/interfaces/Sync.md) -->
    <dav-server calendar-services="mantle.work.CalendarDavServices" contact-services="mantle.party.ContactDavServices"/>
    <!-- an internal organization's own Constitution for agent runs and readers (service/mantle/party/ConstitutionServices.xml) -->
    <!-- and the user's organizations and active one for a new agent conversation's prompt (service/mantle/party/UserFactServices.xml;
        mr-boss impl-sales P6, F65), the prerequisite of the apps' skills -->
    <llm-facade>
        <constitution-provider service="mantle.party.ConstitutionServices.get#ScopedConstitution"/>
        <user-facts service="mantle.party.UserFactServices.get#OrganizationFacts"/>
    </llm-facade>
    <!-- Smithy's quota for Git LFS (mr-pass plan/design-smithy.md §11 Quotas): asked before an upload is accepted; it
        returns at once for a repository with no SmithyRepository row -->
    <!-- Smithy over the git host (design-smithy §9.1, §9.3, N-HOOKS): the status contexts agreement/, ci/ and deploy/ are
        the system's (the agreement check and the engine, its runs and deployments, write them with authorization disabled, a user never); a merge
        request pushed for review, proposed on a page or opened from a fork starts hidden until Smithy's handler of its
        opened event has passed its text through the post gate (SmithyReviewServices.handle#MergeRequestEvent); and the
        answer to a push names the merge request's page under a root Smithy mount (a path: the host is the server's
        public URL) -->
    <!-- A hidden repository (or one of a site without Smithy) sends no webhook and pushes to no mirror
        (SmithyGitServices.check#Outbound) -->
    <!-- A repository Smithy keeps is written through Smithy's REST, not the framework's, and the hosting offer and the
        agreement check name Smithy's REST to a client such as the Dev AIDE (mr-moqui plans/design-dev-aide.md §21;
        SmithyGitServices check#RestWrite, add#HostingOffer, check#AuthorSigned); the review threads of the framework's REST
        are Mantle's (mantle.work.GitServices.handle#GitReviewThread) -->
    <git-server lfs-upload-check-service="mantle.smithy.SmithyGitServices.check#LfsUpload"
            outbound-check-service="mantle.smithy.SmithyGitServices.check#Outbound"
            rest-write-check-service="mantle.smithy.SmithyGitServices.check#RestWrite"
            offer-service="mantle.smithy.SmithyGitServices.add#HostingOffer"
            agreement-check-service="mantle.smithy.SmithyGitServices.check#AuthorSigned"
            review-thread-service="mantle.work.GitServices.handle#GitReviewThread"
            reserved-status-contexts="agreement/,ci/,deploy/" review-start-hidden="true"
            merge-request-url="/{repositoryPath}/-/merge-requests/{mergeRequestNum}"/>
    <!-- Smithy decides whether a pipeline run may start, waits or is refused, its trust, owner and pool (design-smithy §10,
        DG5), and names the run's page for its statuses -->
    <git-ci run-check-service="mantle.smithy.SmithyPipelineServices.check#Run"
            run-url-service="mantle.smithy.SmithyPipelineServices.get#RunUrl"/>
    <!-- A real SSO sign-in that links a GitHub id claims Smithy's imported placeholders of that id (design-smithy §18.2,
        DG8; SmithyImportServices.handle#SsoLinked checks the flow, its endpoints and the provider's host) -->
    <user-facade>
        <login sso-linked-service="mantle.smithy.SmithyImportServices.handle#SsoLinked"/>
        <!-- an app's every-organization reach (SEC-BOS-84): only a holder grants one, gives a membership of a group that carries
            it (an app's administrator group) or invites into one, so an access administrator of one organization does not widen
            anyone's scope, their own included; ADMIN holds them all. Added to the framework's list as elements, never by the
            sealed-permissions attribute, which would replace it. -->
        <authz>
            <sealed-permission name="ACCOUNTING_ALL_ORGANIZATIONS"/>
            <sealed-permission name="COMMERCE_ALL_ORGANIZATIONS"/>
            <sealed-permission name="FACILITY_ALL_ORGANIZATIONS"/>
            <sealed-permission name="MAINTENANCE_ALL_ORGANIZATIONS"/>
            <sealed-permission name="MARKETING_ALL_ORGANIZATIONS"/>
            <sealed-permission name="PEOPLE_ALL_ORGANIZATIONS"/>
            <sealed-permission name="SALES_ALL_ORGANIZATIONS"/>
        </authz>
    </user-facade>
    <!-- Marketing P22 (mr-boss impl-marketing P22, F72): Mantle's answer to the framework's sms-consent hook, from its consent
        records and SMS suppressions, asked for every sender of a promotional text, a campaign's dispatch running as the system
        included (MessageSms.js consent; mr-moqui docs/tools/Comms.md "Provider hooks") -->
    <screen-facade><shell-providers>
        <sms-consent name="mantle.consent" service="mantle.party.MessageSmsServices.check#SmsConsent"/>
    </shell-providers></screen-facade>
    <webapp-list><webapp name="webroot">
        <!-- an anonymous caller reaches this servlet, so its multipart bodies are held to the PASS media limit (10 MiB,
            PortalMedia.js maxBytes) plus the form's envelope, not the 2 GiB of webapp-list/webapp[webroot]/web-protection/requests@max-upload (SEC-PSA-07) -->
        <servlet name="PassApi" location="component://mr-mantle/script/PassApi.js" max-upload="11m">
            <url-pattern>/rest/s1/pass/v1/sites/*</url-pattern>
        </servlet>
    </webapp></webapp-list>
    <!-- Commerce P14: a served feed's check by build, generation and the latest publication change in effect (StoreFeeds.js
        servable); bounded, as each generation change leaves the earlier keys behind -->
    <cache-list>
        <cache name="mantle.product.feedServing" type="local" max-elements="2000" expire-time-live="86400"/>
        <!-- Smithy DG7 (SmithySite.js): a docs or landing page rendered, by its blob id, and the component.xml of a commit,
            by repository and commit id; bounded, as each change leaves the earlier keys behind -->
        <cache name="smithy.docs.rendered" type="local" max-elements="2000" expire-time-live="86400"/>
        <!-- the docs files of a repository at a commit (repositoryId|commitId|root), a list of at most 500 entries; a
            rendering over 64 KB is not kept, so the renders hold at most about 128 MB -->
        <cache name="smithy.docs.files" type="local" max-elements="1000" expire-time-live="86400"/>
        <cache name="smithy.component" type="local" max-elements="5000" expire-time-live="86400"/>
    </cache-list>
</moqui-conf>
