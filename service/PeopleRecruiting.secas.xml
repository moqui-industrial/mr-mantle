<!-- An issued offer's letter is emailed to the applicant once the issue commits (IronStone People design §15; impl-people P17
    review, the user's call of Nov 12, 2026): RecruitingServices.send#OfferLetter attaches the letter as it was stored and records
    the outcome on the offer; a failed send is recorded and never undoes the issue, and an offer editor sends it again. The rule
    runs as the issuer, on a service worker, at least once; the service sends a letter once.
    An interview's invitations go once its schedule, change or cancel commits (F358, People follow-up 1, Nov 12, 2026): sent in
    the interview's own transaction, a failing send marked it rollback-only and the change was undone while the screen said it was
    made. RecruitingServices.send#InterviewInvitations sends them as the system in a transaction of its own, a failure logged; the
    rules run as the recruiter, on a service worker. send#EventInvitations tells only the attendees whose invitation changed, so a
    second run tells nobody again. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="PeopleOfferLetterEmail" service="mantle.humanres.RecruitingServices.change#OfferState" when="tx-commit">
        <condition><expression>action == 'issue' &amp;&amp; employmentOfferId &amp;&amp; !repeated</expression></condition>
        <actions><service-call name="mantle.humanres.RecruitingServices.send#OfferLetter" in-map="{employmentOfferId:employmentOfferId}"/></actions>
    </seca>
    <seca id="PeopleInterviewScheduledInvitations" service="mantle.humanres.RecruitingServices.schedule#Interview" when="tx-commit">
        <condition><expression>workEffortId</expression></condition>
        <actions><service-call name="mantle.humanres.RecruitingServices.send#InterviewInvitations" in-map="{workEffortId:workEffortId}"/></actions>
    </seca>
    <seca id="PeopleInterviewChangedInvitations" service="mantle.humanres.RecruitingServices.change#Interview" when="tx-commit">
        <condition><expression>workEffortId</expression></condition>
        <actions><service-call name="mantle.humanres.RecruitingServices.send#InterviewInvitations" in-map="{workEffortId:workEffortId}"/></actions>
    </seca>
    <seca id="PeopleInterviewCancelledInvitations" service="mantle.humanres.RecruitingServices.cancel#Interview" when="tx-commit">
        <condition><expression>workEffortId</expression></condition>
        <actions><service-call name="mantle.humanres.RecruitingServices.send#InterviewInvitations" in-map="{workEffortId:workEffortId}"/></actions>
    </seca>
</secas>
