<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- A deleted (expired) payment method's Authorize.Net payment profile is deleted at the gateway too, as the
        AuthorizeDotNet component's delete#PaymentMethod SECA did; a method with active payments is deleted later
        (checkDelete#PaymentPaymentMethods), and this runs then. A gateway failure is a warning, not the delete's. -->
    <seca id="AuthorizeNetDeletePaymentProfile" service="mantle.account.PaymentMethodServices.delete#PaymentMethod" when="post-service" run-on-error="false">
        <actions>
            <entity-find-one entity-name="mantle.account.method.PaymentMethod" value-field="deletedMethod"/>
            <if condition="deletedMethod?.thruDate &amp;&amp; deletedMethod.gatewayCimId &amp;&amp; deletedMethod.paymentGatewayConfigId">
                <entity-find-one entity-name="mantle.account.method.PaymentGatewayConfig" value-field="deletedMethodGateway" cache="true">
                    <field-map field-name="paymentGatewayConfigId" from="deletedMethod.paymentGatewayConfigId"/>
                </entity-find-one>
                <if condition="deletedMethodGateway?.paymentGatewayTypeEnumId == 'PgtAuthorizeNet'">
                    <service-call name="mantle.account.AuthorizeNetServices.delete#CustomerPaymentProfile" in-map="{paymentMethodId:deletedMethod.paymentMethodId}"/>
                </if>
            </if>
        </actions>
    </seca>
</secas>
