<!-- IronStone Sales P8 (the chargeable repair's handoff, design-sales §6; the user's call of Nov 13, 2026): Customer Service's
    warranty decision, once committed, tells the organization's default Sales team when it is a chargeable repair
    (mantle.order.SalesQuoteServices.notify#RepairToQuote, which reads the decision and leaves every other one alone). A replayed
    decision (alreadyApplied) tells nobody again. Customer Service's decide#WarrantyClaim is unchanged. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-service-eca.xsd">
    <seca id="SalesRepairToQuote" service="mantle.request.WarrantyServices.decide#WarrantyClaim" when="tx-commit">
        <condition><expression>warrantyDecisionId &amp;&amp; !alreadyApplied</expression></condition>
        <actions><service-call name="mantle.order.SalesQuoteServices.notify#RepairToQuote"
                in-map="{warrantyDecisionId:warrantyDecisionId}"/></actions>
    </seca>
</secas>
