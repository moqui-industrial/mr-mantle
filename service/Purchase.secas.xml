<!-- The purchase approval gate on Mantle's approval (design-purchasing §6 automation, D8; impl-purchasing P3, §2):
    autoApprove#Order approves only when check#OrderPreApprove has no warning, so a purchase part of an organization whose
    buying policy has the approval gate on is not approved without a current decision (a prepaid or zero-total purchase order
    too). approve#Order refuses on the same warning. With the gate off (no PurchasePolicy row, the default) nothing is
    added. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="OrderPreApprovePurchase" service="mantle.order.OrderInfoServices.check#OrderPreApprove" when="post-service">
        <actions>
            <service-call name="mantle.order.PurchaseServices.check#PurchaseApprovalRequired" out-map="purchaseOut"
                    disable-authz="true" in-map="{orderId:orderId}"/>
            <if condition="purchaseOut.approveWarnings?.length">
                <set field="results.approveWarnings"
                        from="Array.from(results.approveWarnings ?? []).concat(Array.from(purchaseOut.approveWarnings))"/>
            </if>
        </actions>
    </seca>
    <!-- P4: a commercial change of a purchase order after an approval decision (a key field, not a status, file or note)
        supersedes the earlier revision's decisions, and a placed order's approval starts again (design ApprovalPolicies).
        Every order's revision passes here, so the condition leaves out the kinds that are not commercial, and the service
        returns at once for an order with no decision. -->
    <seca id="OrderRevisionPurchaseApproval" service="mantle.order.OrderServices.increment#OrderRevision" when="post-service">
        <condition><expression>orderId &amp;&amp; !['status', 'content', 'note'].includes(revisionKind)</expression></condition>
        <actions>
            <service-call name="mantle.order.PurchaseServices.handle#PurchaseApprovalRevision" disable-authz="true"
                    in-map="{orderId:orderId, revisionKind:revisionKind}"/>
        </actions>
    </seca>
</secas>
