<!-- Store merchandising (impl-commerce P3, COM-MERCH and SHOP-CATALOG's resolver core; design-commerce §4 Merchandising and
    StoreCategories; StoreMerchandising.js): a store's assortment and its dated publication (ProductStoreProduct), the
    publication preview and batch, the resolver of what is public, the adoption proposal, and the store's category roles,
    rollup moves and category membership. Each service checks COMMERCE_VIEW to read, COMMERCE_MERCHANDISE to change the
    assortment and categories and COMMERCE_PUBLISH to publish, and the store's organization (the user's own) and a current
    StoreStaff row's stores (StoreAdmin.js). A missing store and one outside the scope are refused alike (RECORD_UNAVAILABLE).
    Every change of what a store shows advances the generation of its sites (the `shop` mounts naming it). Refusals start with
    their reason code. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="StorePublication" allow-remote="false" authenticate="anonymous-view">
        <description>Whether products are public and purchasable in a store (Shop's catalog, SHOP-CATALOG): a product is public
            only by a current publication row of it, or of its virtual product with no exclusion row of the variant, while it
            is sellable (check#ProductUsable), in the store's view-allow category when the store has one (an empty one shows
            nothing) and, with siteId, while the site has an enabled shop mount naming the store; purchasable adds the
            purchase-allow category. Without products, the store's published rows a page at a time. Each answer says how
            (own, virtual), why not (reasonCode) and the row's template, badge and rank. Now unless asOfDate, which needs
            COMMERCE_VIEW and the store's scope. A caller without COMMERCE_VIEW in the store's scope gets a product that is not
            public as its id with isPublic false and nothing more, and a list of the public products only.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productId"/>
            <parameter name="productIds" type="List"/>
            <parameter name="siteId"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="products" type="List"/>
            <parameter name="productsCount" type="Integer"/>
            <parameter name="productsPageIndex" type="Integer"/>
            <parameter name="productsPageSize" type="Integer"/>
            <parameter name="productsPageMaxIndex" type="Integer"/>
            <parameter name="productsPageRangeLow" type="Integer"/>
            <parameter name="productsPageRangeHigh" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('getStorePublication', context)"/>
            <set field="products" from="found.products"/>
            <set field="productsCount" from="found.productsCount"/>
            <set field="productsPageIndex" from="found.productsPageIndex"/>
            <set field="productsPageSize" from="found.productsPageSize"/>
            <set field="productsPageMaxIndex" from="found.productsPageMaxIndex"/>
            <set field="productsPageRangeLow" from="found.productsPageRangeLow"/>
            <set field="productsPageRangeHigh" from="found.productsPageRangeHigh"/>
        </actions>
    </service>

    <service verb="find" noun="StoreProducts" allow-remote="false">
        <description>The products a store may carry (its organization's and the shared catalog's; a variant under its virtual
            product unless includeVariants), by id or name ignoring case, category, type and publication state (published,
            scheduled, withdrawn, excluded, unpublished), a page at a time, each with its state, its row in effect or next,
            price readiness and stock policy. COMMERCE_VIEW and the store's scope.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="term"/>
            <parameter name="productCategoryId"/>
            <parameter name="productTypeEnumId"/>
            <parameter name="publicationState"/>
            <parameter name="includeVariants" type="Boolean" default="false"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="products" type="List"/>
            <parameter name="productsCount" type="Integer"/>
            <parameter name="productsPageIndex" type="Integer"/>
            <parameter name="productsPageSize" type="Integer"/>
            <parameter name="productsPageMaxIndex" type="Integer"/>
            <parameter name="productsPageRangeLow" type="Integer"/>
            <parameter name="productsPageRangeHigh" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('findStoreProducts', context)"/>
            <set field="products" from="found.products"/>
            <set field="productsCount" from="found.productsCount"/>
            <set field="productsPageIndex" from="found.productsPageIndex"/>
            <set field="productsPageSize" from="found.productsPageSize"/>
            <set field="productsPageMaxIndex" from="found.productsPageMaxIndex"/>
            <set field="productsPageRangeLow" from="found.productsPageRangeLow"/>
            <set field="productsPageRangeHigh" from="found.productsPageRangeHigh"/>
        </actions>
    </service>
    <service verb="store" noun="StoreProduct" allow-remote="false">
        <description>A published product's storefront details in a store (template key, badge text, featured rank, signature
            requirement) as a new row from fromDate (now when empty) ending the row in effect there; a row starting on that
            instant (or a scheduled one) is changed in place. Refused: an unpublished product (NOT_PUBLISHED), a stale row
            (STALE_REVISION), a row starting later (DATED_OVERLAP), a past start (VALUE_INVALID). COMMERCE_MERCHANDISE; advances the store's site
            generations.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productId" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="templateKey"/>
            <parameter name="badgeText"/>
            <parameter name="featuredRank" type="Integer"/>
            <parameter name="signatureRequiredEnumId"/>
            <parameter name="changeReason"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="sites" type="List"/>
        </out-parameters>
        <actions>
            <set field="saved" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('storeStoreProduct', context)"/>
            <set field="fromDate" from="saved.fromDate"/>
            <set field="sites" from="saved.sites"/>
        </actions>
    </service>
    <service verb="preview" noun="Publication" allow-remote="false">
        <description>What publishing, withdrawing, excluding or restoring these products would do, without writing: each
            allowed or refused with its code, the variants a virtual product's row covers, and the readiness findings
            (sellable, price, content, stock policy; warnings that do not block); and the store's sites with the generation
            the change advances to. COMMERCE_VIEW and the store's scope.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productIds" type="List" required="true"/>
            <parameter name="action" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="items" type="List"/>
            <parameter name="sites" type="List"/>
        </out-parameters>
        <actions>
            <set field="preview" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('previewPublication', context)"/>
            <set field="items" from="preview.items"/>
            <set field="sites" from="preview.sites"/>
        </actions>
    </service>
    <service verb="publish" noun="StoreProduct" allow-remote="false">
        <description>One product's publication action in a store from fromDate (now when empty), with its reason, in the
            caller's transaction: publish starts a published row; withdraw ends the published row (one not yet started is
            withdrawn); exclude starts a variant's exclusion row under its published virtual product; restore ends the
            exclusion. Advances the store's site generations. Refused with the preview's code (ALREADY_PUBLISHED,
            NOT_PUBLISHED, NOT_COVERED, NOT_EXCLUDED, DATED_OVERLAP, STALE_REVISION), REASON_REQUIRED, a past effective time
            (VALUE_INVALID: a publication is not back-dated), or without COMMERCE_PUBLISH. publish#StoreProducts calls it per product.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productId" required="true"/>
            <parameter name="action" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="changeReason"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="sites" type="List"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('publishStoreProduct', context)"/>
            <set field="fromDate" from="done.fromDate"/>
            <set field="sites" from="done.sites"/>
        </actions>
    </service>
    <service verb="publish" noun="StoreProducts" allow-remote="false">
        <description>A publication action on each of these products (publish, withdraw, exclude, restore) from fromDate, with
            one reason, each product in its own transaction advancing the store's site generations; a result per product
            (done, or refused with its code), the rest done when one fails. Keyed by operationKey on PostingOperation
            (StorePublication): a retry answers the first result. expectedLastUpdatedStamps maps a product to the revision
            of its row the user saw. COMMERCE_PUBLISH and the store's scope.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productIds" type="List" required="true"/>
            <parameter name="action" required="true"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="changeReason"/>
            <parameter name="expectedLastUpdatedStamps" type="Map"/>
            <parameter name="operationKey" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="results" type="List"/>
            <parameter name="doneCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="sites" type="List"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('publishStoreProducts', context)"/>
            <set field="results" from="done.results"/>
            <set field="doneCount" from="done.doneCount"/>
            <set field="failedCount" from="done.failedCount"/>
            <set field="sites" from="done.sites"/>
            <set field="alreadyApplied" from="!!done.alreadyApplied"/>
        </actions>
    </service>
    <service verb="find" noun="ProductPublications" allow-remote="false">
        <description>A product's publication in each store the user works (the first 50 by name) that publishes it or its
            virtual product: its state, whether it is public now and why not, and its row's dates and badge.
            COMMERCE_VIEW.</description>
        <in-parameters>
            <parameter name="productId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="publications" type="List"/>
            <parameter name="storeCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('findProductPublications', context)"/>
            <set field="publications" from="found.publications"/>
            <set field="storeCount" from="found.storeCount"/>
        </actions>
    </service>
    <service verb="propose" noun="StorePublication" allow-remote="false">
        <description>For a store with no publication rows (a store from before publication, Shop P8's adoption), the sellable
            products its categories hold (its category roles and below; a virtual product for its variants), to be approved
            through publish#StoreProducts; never writes. A store with rows is refused (PUBLICATION_EXISTS). COMMERCE_VIEW and
            the store's scope.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="proposals" type="List"/>
            <parameter name="proposalsCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="proposed" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('proposeStorePublication', context)"/>
            <set field="proposals" from="proposed.proposals"/>
            <set field="proposalsCount" from="proposed.proposalsCount"/>
        </actions>
    </service>

    <service verb="get" noun="StoreCategories" allow-remote="false">
        <description>A store's category roles (current and starting later) and its category tree now (each category under the
            roles with its parent, depth, sequence, member count and whether another store shares it); with productCategoryId
            (in the tree), that category's members. COMMERCE_VIEW and the store's scope.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productCategoryId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="roles" type="List"/>
            <parameter name="tree" type="List"/>
            <parameter name="members" type="List"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('getStoreCategories', context)"/>
            <set field="roles" from="found.roles"/>
            <set field="tree" from="found.tree"/>
            <set field="members" from="found.members"/>
        </actions>
    </service>
    <service verb="get" noun="CategoryStores" allow-remote="false">
        <description>The user's stores whose category tree shows a category (now, or by a role or rollup starting later), and
            the count of other stores that do, for naming them before a taxonomy change. COMMERCE_VIEW.</description>
        <in-parameters>
            <parameter name="productCategoryId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="affectedStores" type="List"/>
            <parameter name="otherStoreCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('getCategoryStores', context)"/>
            <set field="affectedStores" from="found.affectedStores"/>
            <set field="otherStoreCount" from="found.otherStoreCount"/>
        </actions>
    </service>
    <service verb="store" noun="StoreCategory" allow-remote="false">
        <description>A store's dated category role (ProductStoreCategory) from fromDate (now when empty), ending the open row
            of the same role and category there, or with end the row in effect; a one-category role (home page, browse root,
            search, view and purchase allow...) ends another category's open row of the role. Refused: a category of another
            organization (CATEGORY_UNAVAILABLE), an unknown role, a row starting later (DATED_OVERLAP). COMMERCE_MERCHANDISE;
            advances the store's site generations.</description>
        <implements service="mantle.product.StoreAdminServices.define#DatedParameters"/>
        <in-parameters>
            <parameter name="productCategoryId" required="true"/>
            <parameter name="storeCategoryTypeEnumId" required="true"/>
            <parameter name="sequenceNum" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="sites" type="List"/>
        </out-parameters>
        <actions>
            <set field="saved" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('storeStoreCategory', context)"/>
            <set field="fromDate" from="saved.fromDate"/>
            <set field="sites" from="saved.sites"/>
        </actions>
    </service>
    <service verb="move" noun="StoreCategory" allow-remote="false">
        <description>Move a category of the store's tree under another of its categories from fromDate (now when empty), its
            rollup to the old parent ending there; under the same parent, set its sequence in place, or with direction (up, down) or
            beforeCategoryId place it among its siblings and number them 10, 20, 30. Refused: a parent that is
            the category or below it, now or by a rollup starting later (CATEGORY_CYCLE); a category outside the store's tree
            (CATEGORY_UNAVAILABLE); a past date (VALUE_INVALID) or one before the current place, or a move starting later
            (DATED_OVERLAP); a category that a store the user does not work shares (CATEGORY_SHARED_OUTSIDE); one the user's
            other stores share, without confirmShared (CATEGORY_SHARED). previewOnly answers the affected stores without
            writing. COMMERCE_MERCHANDISE; advances the affected stores' site generations.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="productCategoryId" required="true"/>
            <parameter name="toParentCategoryId"><description>Required but for direction, which keeps the parent.</description></parameter>
            <parameter name="fromParentCategoryId"/>
            <parameter name="direction"><description>up or down: one place among its siblings, renumbering them.</description></parameter>
            <parameter name="beforeCategoryId"><description>A sibling under the parent to place it before (a drag's drop),
                renumbering them.</description></parameter>
            <parameter name="sequenceNum" type="Integer"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="previewOnly" type="Boolean" default="false"/>
            <parameter name="confirmShared" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="moved" type="Boolean"/>
            <parameter name="affectedStores" type="List"/>
            <parameter name="otherStoreCount" type="Integer"/>
            <parameter name="sites" type="List"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('moveStoreCategory', context)"/>
            <set field="moved" from="done.moved"/>
            <set field="affectedStores" from="done.affectedStores"/>
            <set field="otherStoreCount" from="done.otherStoreCount"/>
            <set field="sites" from="done.sites"/>
        </actions>
    </service>
    <service verb="store" noun="CategoryMembership" allow-remote="false">
        <description>A store category's dated members (ProductCategoryMember) for one product or several: each from fromDate
            (now when empty), or with end ended, with a result per product (a failure named and the rest saved; refused
            when every one fails). The category must be in the store's tree and each product one the store may carry
            (PRODUCT_UNAVAILABLE); shared categories as move#StoreCategory. previewOnly answers the affected stores.
            COMMERCE_MERCHANDISE; advances the affected stores' site generations.</description>
        <implements service="mantle.product.StoreAdminServices.define#DatedParameters"/>
        <in-parameters>
            <parameter name="productCategoryId" required="true"/>
            <parameter name="productId"/>
            <parameter name="productIds" type="List"/>
            <parameter name="sequenceNum" type="Integer"/>
            <parameter name="previewOnly" type="Boolean" default="false"/>
            <parameter name="confirmShared" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="results" type="List"/>
            <parameter name="affectedStores" type="List"/>
            <parameter name="otherStoreCount" type="Integer"/>
            <parameter name="sites" type="List"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreMerchandising.js').execute('storeCategoryMembership', context)"/>
            <set field="results" from="done.results"/>
            <set field="affectedStores" from="done.affectedStores"/>
            <set field="otherStoreCount" from="done.otherStoreCount"/>
            <set field="sites" from="done.sites"/>
        </actions>
    </service>
    <!-- Commerce P9: reviews (StoreReviews.js; design-commerce §4 Reviews): staff reads with COMMERCE_VIEW, decisions and the
        store's reply with COMMERCE_MERCHANDISE, each in the user's store scope; the review request on the delivery ledger -->
    <service verb="find" noun="Reviews" allow-remote="false">
        <description>The reviews of the user's stores (or one store), by product, status, posted dates (fromDate inclusive,
            thruDate exclusive), text, author label or id ignoring case, and unreplied, newest first, a page at a time: each with
            its product, rating, author's public label, posted date, state, reply, verified purchase (its proof's order) and
            image count. COMMERCE_VIEW and the store's scope (RECORD_UNAVAILABLE outside it).</description>
        <in-parameters>
            <parameter name="productStoreId"/>
            <parameter name="productId"/>
            <parameter name="statusId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="term"/>
            <parameter name="unreplied" type="Boolean"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="reviews" type="List"/>
            <parameter name="reviewsCount" type="Integer"/>
            <parameter name="reviewsPageIndex" type="Integer"/>
            <parameter name="reviewsPageSize" type="Integer"/>
            <parameter name="reviewsPageMaxIndex" type="Integer"/>
            <parameter name="reviewsPageRangeLow" type="Integer"/>
            <parameter name="reviewsPageRangeHigh" type="Integer"/>
            <parameter name="canModerate" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('findReviews', context)"/>
            <set field="reviews" from="found.reviews"/>
            <set field="reviewsCount" from="found.reviewsCount"/>
            <set field="reviewsPageIndex" from="found.reviewsPageIndex"/>
            <set field="reviewsPageSize" from="found.reviewsPageSize"/>
            <set field="reviewsPageMaxIndex" from="found.reviewsPageMaxIndex"/>
            <set field="reviewsPageRangeLow" from="found.reviewsPageRangeLow"/>
            <set field="reviewsPageRangeHigh" from="found.reviewsPageRangeHigh"/>
            <set field="canModerate" from="found.canModerate"/>
        </actions>
    </service>
    <service verb="get" noun="Review" allow-remote="false">
        <description>One review of the user's stores for its decision and reply: the find#Reviews row with its whole text, its
            proof (order and line) and its images (sequence, name and size; the file through get#ReviewImage).
            COMMERCE_VIEW and the store's scope.</description>
        <in-parameters>
            <parameter name="productReviewId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="review" type="Map"/>
            <parameter name="canModerate" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('getReview', context)"/>
            <set field="review" from="found.review"/>
            <set field="canModerate" from="found.canModerate"/>
        </actions>
    </service>
    <service verb="get" noun="ReviewImage" allow-remote="false">
        <description>A review image for staff in any state of its review (ReviewDecision's preview): its location, name and type,
            which the screen sends; COMMERCE_VIEW and the store's scope.</description>
        <in-parameters>
            <parameter name="productReviewId" required="true"/>
            <parameter name="imageSeqId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="location"/>
            <parameter name="filename"/>
            <parameter name="contentType"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('getStaffImage', context)"/>
            <set field="location" from="found.location"/>
            <set field="filename" from="found.filename"/>
            <set field="contentType" from="found.contentType"/>
        </actions>
    </service>
    <service verb="moderate" noun="Review" allow-remote="false">
        <description>Approve or delete reviews (decision approve or delete), each at its expected revision (reviews: a list of
            {productReviewId, expectedLastUpdatedStamp}, or one productReviewId) and in a transaction of its own; the decision
            covers the review's images, its reason (required to delete) goes to the status's audit log, and one refused (stale,
            deleted, outside the scope) is named while the rest go on: results, one per review, with ok, the status or the
            reason code. Up to 100 a call. COMMERCE_MERCHANDISE; advances the store's site generations.</description>
        <in-parameters>
            <parameter name="decision" required="true"/>
            <parameter name="reviews" type="List"/>
            <parameter name="selectionKeys"><description>A list's selected rows, each productReviewId@revision (find#Reviews'
                selectionKey), comma-separated or a list.</description></parameter>
            <parameter name="productReviewId"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="results" type="List"/>
            <parameter name="decidedCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('moderateReviews', context)"/>
            <set field="results" from="done.results"/>
            <set field="decidedCount" from="done.decidedCount"/>
            <set field="failedCount" from="done.failedCount"/>
        </actions>
    </service>
    <service verb="decide" noun="Review" allow-remote="false">
        <description>Internal, for moderate#Review: one review's status at its expected revision, in the caller's new
            transaction. COMMERCE_MERCHANDISE and the store's scope.</description>
        <in-parameters>
            <parameter name="productReviewId" required="true"/>
            <parameter name="statusId" required="true"/>
            <parameter name="changeReason"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="statusId"/>
            <parameter name="changed" type="Boolean"/>
            <parameter name="message"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('decideReview', context)"/>
            <set field="statusId" from="done.statusId"/>
            <set field="changed" from="done.changed"/>
            <set field="message" from="done.message"/>
        </actions>
    </service>
    <service verb="reply" noun="Review" allow-remote="false">
        <description>The store's public reply to an approved review (plain text, up to 2,000 characters) at its expected
            revision, its author and time kept and audit-logged; withdraw=true removes it. Refused: a review not approved
            (NOT_APPROVED), a stale revision (STALE_REVISION). COMMERCE_MERCHANDISE and the store's scope; advances the store's
            site generations.</description>
        <in-parameters>
            <parameter name="productReviewId" required="true"/>
            <parameter name="replyText"/>
            <parameter name="withdraw" type="Boolean" default="false"/>
            <parameter name="changeReason"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="replied" type="Boolean"/>
            <parameter name="lastUpdatedStamp" type="Timestamp"/>
        </out-parameters>
        <actions>
            <set field="done" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('replyReview', context)"/>
            <set field="replied" from="done.replied"/>
            <set field="lastUpdatedStamp" from="done.lastUpdatedStamp"/>
        </actions>
    </service>
    <service verb="queue" noun="ReviewRequests" authenticate="anonymous-all" allow-remote="false">
        <description>Internal, for the ShipmentDeliveredRequestReviews and DownloadFirstRequestReview SECAs: one review request
            (PsetReviewRequest) per delivered line of a Shop order (a shipment's lines, a download grant's line, or a named
            line) on the delivery ledger, once per line; an order Shop did not place or a store with no current review request
            email queues nothing. Not transactional: the ledger sends it only with the recipient's marketing email consent.
            Each line on its own.</description>
        <in-parameters>
            <parameter name="shipmentId"/>
            <parameter name="downloadGrantId"/>
            <parameter name="orderId"/>
            <parameter name="orderItemSeqId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="queued" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="queued" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('queueRequests', context).queued"/>
        </actions>
    </service>
    <service verb="build" noun="ReviewRequest" allow-remote="false">
        <description>The delivery ledger's source build of the review request (MessageDeliverySource MdsrcReviewRequest): the
            store, product and the product's review page, made for each attempt, or suppress once the line is reviewed by its
            buyer, cancelled or returned, or its product is no longer public.</description>
        <in-parameters>
            <parameter name="deliveryId"/>
            <parameter name="eventKey" required="true"/>
            <parameter name="recipientPartyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="toAddress"/>
            <parameter name="bodyParameters" type="Map"/>
            <parameter name="suppress"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/product/StoreReviews.js').execute('buildRequest', context)"/>
            <set field="toAddress" from="out.toAddress"/>
            <set field="bodyParameters" from="out.bodyParameters"/>
            <set field="suppress" from="out.suppress"/>
        </actions>
    </service>
</services>
