<!-- An organization's suppliers: the supplier profile (SupplierProfile, effective-dated) with its finance fields
    (SUPPLIER_TERMS_EDIT) and buying fields (SUPPLIER_PROFILE_EDIT), a new supplier, its buyer and category
    (SupplierProfile.js), and a supplier's finance with the organization. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="store" noun="SupplierProfile" allow-remote="false">
        <description>Change an organization's profile of a supplier: the row in effect ends at fromDate (now by default) and
            the next starts there with the fields given and the others carried over; nothing changes when nothing differs.
            The finance fields, the default payment term of the supplier's bills (settlementTermId) and self-billing
            (selfBillingIndicator, Y or N), need SUPPLIER_TERMS_EDIT in the organization. The buying fields (impl-purchasing
            P2), the default currency and Incoterm, the approval status (SupplierApproval) and a dated purchase block with
            its reason, need SUPPLIER_PROFILE_EDIT; an approval decision (Approved or Rejected) or clearing the status needs PURCHASE_APPROVE too.
            A supplier's first row takes self-billing from the organization's match policy (selfBillingDefault) unless the
            change gives it. Each field is audit-logged with the reason. Refuses an unknown term, currency, Incoterm or
            status (TERM_INVALID, PROFILE_INVALID), a block without its start or reason or ending before it starts
            (BLOCK_INVALID), a supplier another user keeps private, or with buying fields one owned by another organization
            (SUPPLIER_UNAVAILABLE), and a start before the row in effect (DATE_INVALID). SupplierProfile.js.</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="supplierPartyId" required="true"/>
            <parameter name="settlementTermId"/>
            <parameter name="selfBillingIndicator"/>
            <parameter name="currencyUomId"/>
            <parameter name="incotermEnumId"/>
            <parameter name="approvalStatusId"/>
            <parameter name="purchaseBlockFromDate" type="Timestamp"/>
            <parameter name="purchaseBlockThruDate" type="Timestamp"/>
            <parameter name="purchaseBlockReason"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="supplierProfileId"/>
            <parameter name="changed" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/party/SupplierProfile.js"/>
            <set field="stored" from="ec.resource.script(module).execute('store', context)"/>
            <set field="supplierProfileId" from="stored.supplierProfileId"/>
            <set field="changed" from="stored.changed"/>
        </actions>
    </service>
    <service verb="create" noun="Supplier" allow-remote="false">
        <description>A new supplier of an organization (design-purchasing Suppliers; impl-purchasing P2): an organization
            (organizationName) or a person (firstName and lastName) owned by the organization, in the Supplier role, with
            its external ID, primary email and phone and a supplier category (PcltSupplierCategory). Its profile starts
            Pending approval when the organization's PurchasePolicy requires supplier approval. A caller searches for
            duplicates first. Requires SUPPLIER_PROFILE_EDIT in the organization (PERMISSION_DENIED,
            ORGANIZATION_DENIED); refuses a supplier without its name (SUPPLIER_INVALID) and a classification of another
            type (CLASSIFICATION_INVALID).</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="organizationName"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="externalId"/>
            <parameter name="emailAddress"><text-email/></parameter>
            <parameter name="contactNumber"/>
            <parameter name="partyClassificationId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="partyId"/>
            <parameter name="supplierProfileId"/>
            <parameter name="approvalStatusId"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/party/SupplierProfile.js"/>
            <set field="created" from="ec.resource.script(module).execute('create', context)"/>
            <set field="partyId" from="created.partyId"/>
            <set field="supplierProfileId" from="created.supplierProfileId"/>
            <set field="approvalStatusId" from="created.approvalStatusId"/>
        </actions>
    </service>
    <service verb="store" noun="SupplierBuyer" allow-remote="false">
        <description>The supplier's buyer for an organization from a date (now by default), as a dated PartyRelationship
            (PrtSupplier) from the buyer in the Buyer role to the supplier in the Supplier role, not a profile field
            (impl-drawers-commons §4): the relationships of the organization's people to the supplier in effect then end
            there, and the buyer's starts; with no buyer they only end. Another organization's buyers of a shared supplier
            are left alone. Requires SUPPLIER_PROFILE_EDIT in the organization; refuses a buyer who is not a person of the
            organization (BUYER_INVALID), a party not in the Supplier role, another user's private contact or a supplier
            owned by another organization (SUPPLIER_UNAVAILABLE) and a start before the buyer in effect (DATE_INVALID).</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="supplierPartyId" required="true"/>
            <parameter name="buyerPartyId"/>
            <parameter name="fromDate" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="partyRelationshipId"/>
            <parameter name="changed" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/party/SupplierProfile.js"/>
            <set field="stored" from="ec.resource.script(module).execute('storeBuyer', context)"/>
            <set field="partyRelationshipId" from="stored.partyRelationshipId"/>
            <set field="changed" from="stored.changed"/>
        </actions>
    </service>
    <service verb="set" noun="SupplierCategory" allow-remote="false">
        <description>A supplier's category (a PartyClassification of PcltSupplierCategory), replacing the one in effect, or
            with none given the category ends. Requires SUPPLIER_PROFILE_EDIT in the organization; refuses a classification
            of another type (CLASSIFICATION_INVALID) and a party not in the Supplier role or owned by another organization
            (SUPPLIER_UNAVAILABLE); the category already in effect is no change.</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="supplierPartyId" required="true"/>
            <parameter name="partyClassificationId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="changed" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/party/SupplierProfile.js"/>
            <set field="changed" from="ec.resource.script(module).execute('setCategory', context).changed"/>
        </actions>
    </service>
    <service verb="get" noun="SupplierFinance" allow-remote="false">
        <description>A supplier's finance with an organization for a finance reader (ACCOUNTING_VIEW, ACCOUNTING_ADMIN or
            PAYABLE_VIEW): its name, the bills (find#Payables) and payments, by currency the open payable, the amount in
            review, the part on hold and the overdue, agreements, and the supplier profile's rows, newest first, with the one
            in effect. Payment methods (masked) only for treasury (BANK_RECONCILE and PAYMENT_EDIT), identifications for
            PAYABLE_EDIT, tax registrations for TAX_STATEMENT_EDIT. Refuses a supplier with no business relationship with
            the organization (check#CustomerScope).</description>
        <in-parameters>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="supplierPartyId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="supplier" type="Map"/>
            <parameter name="capabilities" type="Map"/>
            <parameter name="bills" type="List"/>
            <parameter name="payments" type="List"/>
            <parameter name="summaryRows" type="List"/>
            <parameter name="agreements" type="List"/>
            <parameter name="profile" type="Map"/>
            <parameter name="profileRows" type="List"/>
            <parameter name="paymentMethods" type="List"/>
            <parameter name="identifications" type="List"/>
            <parameter name="taxRegistrations" type="List"/>
            <parameter name="incomplete" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="workflow" value="component://mr-mantle/service/mantle/account/InvoiceWorkflow.js"/>
            <set field="held" from="ec.resource.script(workflow).execute('permissions', {permissions:['ACCOUNTING_VIEW',
                'ACCOUNTING_ADMIN', 'PAYABLE_VIEW', 'PAYABLE_EDIT', 'BANK_RECONCILE', 'PAYMENT_EDIT', 'TAX_STATEMENT_EDIT',
                'SUPPLIER_TERMS_EDIT']})"/>
            <if condition="!held.ACCOUNTING_VIEW &amp;&amp; !held.ACCOUNTING_ADMIN &amp;&amp; !held.PAYABLE_VIEW">
                <return error="true" message="PERMISSION_DENIED: PAYABLE_VIEW authority is required"/></if>
            <service-call name="mantle.account.CustomerFinanceServices.check#CustomerScope" out-map="scope" disable-authz="true"
                    in-map="{organizationPartyId:organizationPartyId, customerPartyId:supplierPartyId, side:'supplier'}"/>
            <set field="supplier" from="scope.customer"/>
            <set field="capabilities" from="{canEditTerms:held.SUPPLIER_TERMS_EDIT, canEditIdentifications:held.PAYABLE_EDIT,
                canReadPaymentMethods:held.BANK_RECONCILE &amp;&amp; held.PAYMENT_EDIT,
                canEditPaymentMethods:held.BANK_RECONCILE &amp;&amp; held.PAYMENT_EDIT,
                canReadTaxRegistrations:held.TAX_STATEMENT_EDIT, canEditTaxRegistrations:held.TAX_STATEMENT_EDIT}"/>

            <service-call name="mantle.account.InvoiceServices.find#Payables" out-map="payables" disable-authz="true"
                    in-map="{organizationPartyId:organizationPartyId, supplierPartyId:supplierPartyId, pageSize:100}"/>
            <set field="bills" from="payables.records"/>
            <entity-find entity-name="mantle.account.payment.Payment" list="paymentList" limit="101" disable-authz="true">
                <econdition field-name="fromPartyId" from="organizationPartyId"/>
                <econdition field-name="toPartyId" from="supplierPartyId"/>
                <order-by field-name="-effectiveDate"/><order-by field-name="paymentId"/>
            </entity-find>
            <set field="payments" from="Array.from(paymentList).slice(0, 100).map((row) => ({paymentId:row.paymentId,
                statusId:row.statusId, effectiveDate:row.effectiveDate, amount:row.amount, amountUomId:row.amountUomId,
                paymentRefNum:row.paymentRefNum, unappliedTotal:row.unappliedTotal}))"/>
            <set field="payablesModule" value="component://mr-mantle/service/mantle/account/Payables.js"/>
            <set field="summary" from="ec.resource.script(payablesModule).execute('supplierSummary',
                {organizationPartyId:organizationPartyId, supplierPartyId:supplierPartyId})"/>
            <set field="summaryRows" from="summary.summaryRows"/>
            <set field="incomplete" from="payables.recordsCount &gt; 100 || paymentList.length &gt; 100 || summary.incomplete"/>

            <entity-find entity-name="mantle.party.agreement.AgreementParty" list="supplierAgreementList" limit="500"
                    disable-authz="true"><econdition field-name="partyId" from="supplierPartyId"/></entity-find>
            <set field="agreements" from="[]"/>
            <if condition="supplierAgreementList.length">
                <entity-find entity-name="mantle.party.agreement.AgreementParty" list="sharedAgreementList" disable-authz="true">
                    <econdition field-name="partyId" from="organizationPartyId"/>
                    <econdition field-name="agreementId" operator="in"
                            from="Array.from(supplierAgreementList).map((row) => row.agreementId)"/>
                </entity-find>
                <if condition="sharedAgreementList.length">
                    <entity-find entity-name="mantle.party.agreement.Agreement" list="agreements" limit="200"
                            disable-authz="true">
                        <econdition field-name="agreementId" operator="in"
                                from="Array.from(sharedAgreementList).map((row) => row.agreementId)"/>
                        <order-by field-name="-fromDate"/>
                    </entity-find>
                </if>
            </if>

            <entity-find entity-name="mantle.party.supplier.SupplierProfile" list="profileRows" limit="100"
                    disable-authz="true">
                <econdition field-name="organizationPartyId"/><econdition field-name="supplierPartyId"/>
                <order-by field-name="-fromDate"/>
            </entity-find>
            <set field="nowMillis" from="Number(ec.user.nowTimestamp)"/>
            <set field="profile" from="Array.from(profileRows).find((row) => Number(row.fromDate) &lt;= nowMillis &amp;&amp;
                (row.thruDate == null || Number(row.thruDate) &gt; nowMillis))?.getMap() ?? null"/>

            <set field="paymentMethods" from="[]"/>
            <set field="identifications" from="[]"/>
            <set field="taxRegistrations" from="[]"/>
            <if condition="capabilities.canReadPaymentMethods">
                <set field="finance" value="component://mr-mantle/service/mantle/account/CustomerFinance.js"/>
                <set field="paymentMethods" from="ec.resource.script(finance).execute('paymentMethods',
                    {customerPartyId:supplierPartyId}).paymentMethods"/>
            </if>
            <if condition="capabilities.canEditIdentifications">
                <entity-find entity-name="mantle.party.PartyIdentification" list="identifications" limit="100"
                        disable-authz="true">
                    <econdition field-name="partyId" from="supplierPartyId"/></entity-find>
            </if>
            <if condition="capabilities.canReadTaxRegistrations">
                <entity-find entity-name="mantle.other.tax.TaxAuthorityParty" list="taxRegistrations" limit="100"
                        disable-authz="true"><econdition field-name="partyId" from="supplierPartyId"/></entity-find>
            </if>
        </actions>
    </service>
</services>
