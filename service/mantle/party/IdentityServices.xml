<!-- Organization-scoped identity (mr-boss plan/design-admin.md §4.1, §17.2; impl-admin P4): the staff identities of the internal
    organizations the caller administers (their own, every one for ADMIN), through PartyRelationship and PartyRole, calling the
    framework's org.moqui.admin guards (AccessServices' grant proposals, IdentityServices' credentials and administration
    path). Reads need ADMIN_IDENTITY_VIEW, changes ADMIN_IDENTITY_MANAGE, and an account-wide change of an identity shared with an
    organization the caller does not administer ADMIN_IDENTITY_GLOBAL. A refusal of a change is answered (applied false,
    reasonCode, reason); a missing permission or an identity out of scope (RECORD_UNAVAILABLE) is an error. Names no app group:
    grants come as a proposal of registered bundles the app supplies. ALL_USERS may call them (data/PartyAccessData.xml): each
    refuses without its permission. The bodies are Identity.js. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="find" noun="Users" allow-remote="false">
        <description>The staff identities with a current relationship (agent, employee, member) to an internal organization the
            caller administers, or to organizationPartyId among them; narrowed by text (name, username, email, ignoring case),
            userGroupId (a current member) and state (active, ending, locked, disabled, terminated); each with its organizations
            in scope (others counted, never named), state and last sign-in, paged. Public identities (accounts of no internal
            organization) only with includePublic and ADMIN_IDENTITY_GLOBAL, labelled as site relationships. Needs
            ADMIN_IDENTITY_VIEW.</description>
        <in-parameters>
            <parameter name="text"/>
            <parameter name="organizationPartyId"/>
            <parameter name="userGroupId"/>
            <parameter name="state"/>
            <parameter name="includePublic" type="Boolean" default="false"/>
            <parameter name="pageIndex" type="Integer" default="0"/>
            <parameter name="pageSize" type="Integer" default="50"/>
        </in-parameters>
        <out-parameters>
            <parameter name="userList" type="List"/>
            <parameter name="userListCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('findUsers', context))</script></actions>
    </service>
    <service verb="get" noun="Account" allow-remote="false">
        <description>One identity in scope: its account fields (never a password, hash or secret), state, organizations in scope
            and the count of others, its dated organization relationships the caller administers, its group memberships, its
            factors and credentials (metadata only, the framework's get#AccountCredentials) and whether the caller may make an
            account-wide change (and why not). Needs ADMIN_IDENTITY_VIEW.</description>
        <in-parameters><parameter name="userId" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="account" type="Map"/>
            <parameter name="organizations" type="List"/>
            <parameter name="otherOrganizationCount" type="Integer"/>
            <parameter name="sharedBeyondScope" type="Boolean"/>
            <parameter name="relationships" type="List"/>
            <parameter name="memberships" type="List"/>
            <parameter name="factorList" type="List"/>
            <parameter name="singleUseCodeCount" type="Integer"/>
            <parameter name="credentialList" type="List"/>
            <parameter name="canManage" type="Boolean"/>
            <parameter name="canChangeAccount" type="Boolean"/>
            <parameter name="accountChangeReason"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('getAccount', context))</script></actions>
    </service>
    <service verb="get" noun="AccountHistory" allow-remote="false">
        <description>An identity's access events, newest first, at most limit (50): sign-ins (UserLoginHistory, with the session
            each opened) and the audit log's changes of its account, group memberships and the organization relationships the
            caller administers, each with actor, time, reason and the session it was made in; no password, token or session
            secret. Needs ADMIN_IDENTITY_VIEW.</description>
        <in-parameters>
            <parameter name="userId" required="true"/>
            <parameter name="limit" type="Integer" default="50"/>
        </in-parameters>
        <out-parameters><parameter name="eventList" type="List"/></out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('getAccountHistory', context))</script></actions>
    </service>
    <service verb="store" noun="OrganizationMembership" allow-remote="false">
        <description>A dated relationship of a person to an internal organization the caller administers (relationshipTypeEnumId
            PrtEmployee by default, PrtAgent, PrtMember or PrtRepresentative): a new one from fromDate (now when empty), or with
            partyRelationshipId and expectedRevision its end at thruDate (now when empty). Ended rows are kept; the dates are
            audit-logged with the reason. Refused for an overlapping relationship of the same kind or a stale revision. Needs
            ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="partyRelationshipId"/>
            <parameter name="expectedRevision"/>
            <parameter name="partyId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="relationshipTypeEnumId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="partyRelationshipId"/>
            <parameter name="revision"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('storeOrganizationMembership', context))</script></actions>
    </service>
    <service verb="create" noun="StaffAccount" allow-remote="false">
        <description>An exceptional direct staff account (invitations are the default): a person (partyId, or a new one from
            firstName and lastName) with a relationship to an internal organization the caller administers, an account through
            mantle.party.PartyServices.create#PartyUserAccount with no password (the reset password reset#Password mails, unless
            sendReset is false, lets the user set one), and the memberships of the grant proposal (bundleGroupIdList, registered
            bundles the app supplies, checked and applied by the framework's AccessServices), all or nothing. An existing person
            who works for an organization the caller does not administer needs ADMIN_IDENTITY_GLOBAL. Needs
            ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="partyId"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="username"/>
            <parameter name="emailAddress" required="true"><text-email/></parameter>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="relationshipTypeEnumId"/>
            <parameter name="bundleGroupIdList" type="List" required="true"/>
            <parameter name="sendReset" type="Boolean" default="true"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="userId"/>
            <parameter name="partyId"/>
            <parameter name="addedGroupIds" type="List"/>
            <parameter name="bundleList" type="List"/>
            <parameter name="resetSent" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('createStaffAccount', context))</script></actions>
    </service>
    <service verb="store" noun="Account" allow-remote="false">
        <description>An identity's account fields (emailAddress, username, ipAllowed, requirePasswordChange, locale, timeZone) at
            its revision (expectedRevision, get#Account's account.revision), through update#PartyUserAccount. Each is
            account-wide, so an identity shared with an organization the caller does not administer needs ADMIN_IDENTITY_GLOBAL;
            ipAllowed is checked against the administration path. The audit log keeps before and after with the reason.
            Enabling, disabling and the end date are the lifecycle's. Needs ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="userId" required="true"/>
            <parameter name="expectedRevision" required="true"/>
            <parameter name="emailAddress"><text-email/></parameter>
            <parameter name="username"/>
            <parameter name="ipAllowed"/>
            <parameter name="requirePasswordChange"/>
            <parameter name="locale"/>
            <parameter name="timeZone"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="revision"/>
            <parameter name="changed" type="List"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('storeAccount', context))</script></actions>
    </service>
    <service verb="reset" noun="Authentication" allow-remote="false">
        <description>A sign-in reset of an identity in scope. resetKind password (the default) sends the change-only reset password
            org.moqui.impl.UserServices.reset#Password mails (no password is set; the current one stays valid), for any identity
            in scope; factor ends factorId (invalidate#UserAuthcFactorEntry), checked against the administration path; lock
            releases a failed-login lock and the account's artifact velocity locks (never a permanent disable). A factor or lock
            reset is account-wide: an identity shared with an organization the caller does not administer needs
            ADMIN_IDENTITY_GLOBAL. Needs ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="userId" required="true"/>
            <parameter name="resetKind" default-value="password"/>
            <parameter name="factorId"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="resetKind"/>
            <parameter name="releasedCount" type="Integer"/>
            <parameter name="message"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Identity.js').execute('resetAuthentication', context))</script></actions>
    </service>
    <!-- Staff invitations (impl-admin P5; design-admin §4.1 Invitations, §4 Invitations and AcceptInvitation, §16): the bodies are
        Invitations.js. invite#User, find#Invitations, resend#Invitation, revoke#Invitation and reveal#InvitationLink are the
        inviter's (ADMIN_IDENTITY_MANAGE, ADMIN_IDENTITY_VIEW to read, an organization in scope); check#InvitationToken,
        get#InvitationSummary, accept#Invitation and confirm#InvitationFactor the token holder's, signed in or not (the token
        route /i/<token>), each checking the token first. A token is never an out-parameter but of reveal#InvitationLink, once. -->
    <service verb="invite" noun="User" allow-remote="false">
        <description>One staff invitation: emailAddress (an existing person's, partyId, or a new person's with firstName and
            lastName), an internal organization the caller administers, the relationship (relationshipTypeEnumId, PrtEmployee by
            default) and the grant proposal (bundleGroupIdList: registered bundles the app supplies, checked as the caller by
            the framework's check#GrantProposal; a privileged group or a group granting a sealed permission is refused), with an
            optional message and expiry (expireDays, 7, at most 30). The token is mailed when the instance can send mail
            (mailSent); otherwise linkPending says the caller shows the link once through reveal#InvitationLink. A pending
            invitation of the address to the organization is refused (resend it); a retry with the same operationKey answers
            the invitation it made (retried). An existing person who also works for an organization the caller does not
            administer needs ADMIN_IDENTITY_GLOBAL. Needs ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="emailAddress" required="true"><text-email/></parameter>
            <parameter name="partyId"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="organizationPartyId" required="true"/>
            <parameter name="relationshipTypeEnumId"/>
            <parameter name="bundleGroupIdList" type="List" required="true"/>
            <parameter name="message"/>
            <parameter name="expireDays" type="Integer"/>
            <parameter name="operationKey"/>
            <parameter name="baseUrl"><description>The site root of the link, such as https://boss.example.com; else the
                template's web host or its mail server's web base URL</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="invitationId"/>
            <parameter name="state"/>
            <parameter name="mailSent" type="Boolean"/>
            <parameter name="linkPending" type="Boolean"/>
            <parameter name="expiresDate" type="Long"/>
            <parameter name="retried" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('inviteUser', context))</script></actions>
    </service>
    <service verb="find" noun="Invitations" allow-remote="false">
        <description>The invitations of the organizations the caller administers (organizationPartyId among them), narrowed by
            text (address or name) and state (pending, accepted, revoked, expired), newest first, paged: address, person,
            organization, the access by name, state, expiry, sends, inviter, revision and what the caller may do. Never a token
            or its hash. Needs ADMIN_IDENTITY_VIEW.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="text"/>
            <parameter name="state"/>
            <parameter name="pageIndex" type="Integer" default="0"/>
            <parameter name="pageSize" type="Integer" default="50"/>
        </in-parameters>
        <out-parameters>
            <parameter name="invitationList" type="List"/>
            <parameter name="invitationListCount" type="Integer"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('findInvitations', context))</script></actions>
    </service>
    <service verb="resend" noun="Invitation" allow-remote="false">
        <description>A new token for a pending or expired invitation at its revision (expectedRevision), with a new expiry: the
            earlier token no longer matches. Mailed, or linkPending as invite#User. The proposal is checked again as the caller.
            Needs ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="invitationId" required="true"/>
            <parameter name="expectedRevision" required="true"/>
            <parameter name="expireDays" type="Integer"/>
            <parameter name="baseUrl"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="invitationId"/>
            <parameter name="revision"/>
            <parameter name="mailSent" type="Boolean"/>
            <parameter name="linkPending" type="Boolean"/>
            <parameter name="expiresDate" type="Long"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('resendInvitation', context))</script></actions>
    </service>
    <service verb="revoke" noun="Invitation" allow-remote="false">
        <description>Revoke a pending or expired invitation at its revision, with the reason audit-logged; its token then reads
            as no longer valid. Needs ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="invitationId" required="true"/>
            <parameter name="expectedRevision" required="true"/>
            <parameter name="reason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="revision"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('revokeInvitation', context))</script></actions>
    </service>
    <service verb="reveal" noun="InvitationLink" allow-remote="false">
        <description>The acceptance link of an invitation the instance could not mail (no mail server), once, to whoever sent or
            resent it, within fifteen minutes: a new token is made now and only its hash kept; linkShownDate, audited, records
            the showing (never the token). Refused (LINK_SHOWN) after that: a resend makes a new link. Needs
            ADMIN_IDENTITY_MANAGE.</description>
        <in-parameters>
            <parameter name="invitationId" required="true"/>
            <parameter name="baseUrl"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="acceptUrl"/>
            <parameter name="emailAddress"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('revealInvitationLink', context))</script></actions>
    </service>
    <service verb="check" noun="InvitationToken" authenticate="anonymous-view" allow-remote="false">
        <description>The token check of the token route i (/i/&lt;token&gt;; the framework calls it with token and routeName before
            anything of the page runs): every well-formed token is valid, so the page says "This invitation is no longer valid"
            for a spent token and an unknown one alike; routeContext is {open}. Read only.</description>
        <in-parameters>
            <parameter name="token" required="true"/>
            <parameter name="routeName"/>
        </in-parameters>
        <out-parameters>
            <parameter name="valid" type="Boolean"/>
            <parameter name="routeContext" type="Map"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('checkInvitationToken', context))</script></actions>
    </service>
    <service verb="get" noun="InvitationSummary" authenticate="anonymous-view" allow-remote="false">
        <description>For the holder of a token: step (invitation, factor, done or spent) and, while open, the organization, the
            inviter, the invited address, the access proposed by name (no group ids), the expiry, how to accept (accountMode:
            signedIn, wrongAccount, signIn, create), whether a factor will be asked, and on the factor step the authenticator's
            setup. A spent or unknown token answers step spent and message alone. Read only.</description>
        <in-parameters><parameter name="token" required="true"/></in-parameters>
        <out-parameters>
            <parameter name="open" type="Boolean"/>
            <parameter name="step"/>
            <parameter name="message"/>
            <parameter name="organizationName"/>
            <parameter name="inviterName"/>
            <parameter name="emailAddress"/>
            <parameter name="personName"/>
            <parameter name="bundleList" type="List"/>
            <parameter name="expiresDate" type="Long"/>
            <parameter name="accountMode"/>
            <parameter name="signedInName"/>
            <parameter name="signedInAsInvited" type="Boolean"/>
            <parameter name="factorRequired" type="Boolean"/>
            <parameter name="factor" type="Map"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('getInvitationSummary', context))</script></actions>
    </service>
    <service verb="accept" noun="Invitation" authenticate="anonymous-all" allow-remote="false">
        <description>Accept an open invitation as its token's holder: the signed-in account with the invited address, or with no
            one signed in a new account (username, userFullName, newPassword, newPasswordVerify; the invited address, through
            create#PartyUserAccount) when no account has the address (else ACCOUNT_EXISTS: sign in first). The inviter's
            authority and each bundle are checked again; then the organization relationship, the memberships of the proposal
            (authorization on, so the framework's sealed and privileged EECAs decide each) and, when a bundle's group requires a
            factor the account lacks, an authenticator factor to confirm (step factor); all or nothing. Nothing of the request
            names the organization or the access. A spent token: INVITATION_SPENT, "This invitation is no longer valid".</description>
        <in-parameters>
            <parameter name="token" required="true"/>
            <parameter name="username"/>
            <parameter name="userFullName"/>
            <parameter name="newPassword"/>
            <parameter name="newPasswordVerify"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="userId"/>
            <parameter name="accountCreated" type="Boolean"/>
            <parameter name="addedGroupIds" type="List"/>
            <parameter name="step"/>
            <parameter name="retried" type="Boolean"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('acceptInvitation', context))</script></actions>
    </service>
    <service verb="confirm" noun="InvitationFactor" authenticate="anonymous-all" allow-remote="false">
        <description>The first code (code) of the authenticator factor an acceptance made, from the token's holder, within a day of
            the acceptance; a wrong code counts as a failed sign-in of the account (CODE_INVALID).</description>
        <in-parameters>
            <parameter name="token" required="true"/>
            <parameter name="code" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="applied" type="Boolean"/>
            <parameter name="reasonCode"/>
            <parameter name="reason"/>
            <parameter name="step"/>
        </out-parameters>
        <actions><script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/party/Invitations.js').execute('confirmInvitationFactor', context))</script></actions>
    </service>
</services>
