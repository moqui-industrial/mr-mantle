<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="Facility">
        <in-parameters><parameter name="facilityId" required="true"/></in-parameters>
        <out-parameters>
            <auto-parameters entity-name="mantle.facility.Facility" include="nonpk"/>

            <auto-parameters entity-name="mantle.party.contact.PostalAddress" include="nonpk"/>
            <parameter name="longitude" type="BigDecimal"/>
            <parameter name="latitude" type="BigDecimal"/>
            <auto-parameters entity-name="mantle.party.contact.TelecomNumber" include="nonpk"/>
            <parameter name="emailAddress"/>

            <parameter name="contactInfo" type="Map"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.facility.Facility" value-field="facility"/>
            <service-call name="mantle.facility.ContactServices.get#FacilityContactInfo" out-map="contactInfo"
                    in-map="{facilityId:facilityId, postalContactMechPurposeId:'PostalPrimary',
                        telecomContactMechPurposeId:'PhonePrimary', emailContactMechPurposeId:'EmailPrimary',
                        otherContactMechPurposeId:'WebUrlPrimary'}"/>
            <service-call name="mantle.facility.ContactServices.get#FacilityContactInfo" out-map="contactFaxOut"
                    in-map="{facilityId:facilityId, telecomContactMechPurposeId:'PhoneFax'}"/>
            <script>
                ec.context.putAll(Object.assign({}, facility))
                // flatten the nested contact info maps into one map: a nested value is added only if its name is not already set
                const flattenNestedMap = (theMap) => {
                    const flat = {}
                    const nested = []
                    for (const [key, value] of Object.entries(theMap ?? {})) {
                        if (value != null &amp;&amp; typeof value === 'object' &amp;&amp; !Array.isArray(value) &amp;&amp; value.constructor === Object) nested.push(value)
                        else flat[key] = value
                    }
                    for (const child of nested) {
                        for (const [key, value] of Object.entries(flattenNestedMap(child))) if (!(key in flat)) flat[key] = value
                    }
                    return flat
                }
                const contactInfoMap = flattenNestedMap(contactInfo)
                delete contactInfoMap.description
                ec.context.putAll(contactInfoMap)
            </script>
            <set field="emailAddress" from="contactInfo.emailAddress"/>
        </actions>
    </service>
    <service verb="get" noun="FacilitiesByOwner">
        <in-parameters>
            <parameter name="ownerPartyId"/>
            <parameter name="productStoreId"/>
            <parameter name="facilityTypeEnumId"/>
        </in-parameters>
        <out-parameters><parameter name="resultList" type="List"/></out-parameters>
        <actions>
            <set field="resultList" from="[]"/>
            <if condition="productStoreId">
                <entity-find-one entity-name="mantle.product.store.ProductStore" value-field="productStore"/>
                <if condition="productStore?.inventoryFacilityId">
                    <entity-find-one entity-name="mantle.facility.Facility" value-field="fac" cache="true">
                        <field-map field-name="facilityId" from="productStore?.inventoryFacilityId"/></entity-find-one>
                    <if condition="fac != null">
                        <script>resultList.push({facilityId:fac.facilityId, label:ec.resource.expand('FacilityNameTemplate', '', fac)})</script>
                    </if>
                </if>
            </if>
            <if condition="ownerPartyId">
                <set field="ownerPartyIdSet" from="[ownerPartyId]"/>
                <!-- look for parent org(s) if any, include facilities from parent org too -->
                <entity-find entity-name="mantle.party.PartyRelationship" list="parentRelList" cache="true">
                    <date-filter/>
                    <econdition field-name="relationshipTypeEnumId" value="PrtOrgRollup"/>
                    <econdition field-name="fromPartyId" from="ownerPartyId"/>
                    <econdition field-name="toPartyId" operator="is-not-null"/>
                </entity-find>
                <script>for (const rel of parentRelList) { if (!ownerPartyIdSet.includes(rel.toPartyId)) ownerPartyIdSet.push(rel.toPartyId) }</script>

                <entity-find entity-name="mantle.facility.Facility" list="facList" cache="true">
                    <econdition field-name="ownerPartyId" operator="in" from="ownerPartyIdSet"/>
                    <econdition field-name="facilityTypeEnumId" ignore-if-empty="true"/>
                    <order-by field-name="facilityName"/>
                </entity-find>
            </if>
            <script>
                if (typeof facList !== 'undefined' &amp;&amp; facList) for (const fac of facList) resultList.push({facilityId:fac.facilityId, label:ec.resource.expand('FacilityNameTemplate', '', fac)})
            </script>
        </actions>
    </service>

    <service verb="create" noun="Facility">
        <in-parameters>
            <parameter name="facilityId"/>
            <auto-parameters entity-name="mantle.facility.Facility" include="nonpk"/>
            <parameter name="facilityName" required="true"/>

            <auto-parameters entity-name="mantle.party.contact.PostalAddress" include="nonpk"/>
            <parameter name="longitude" type="BigDecimal"/>
            <parameter name="latitude" type="BigDecimal"/>

            <auto-parameters entity-name="mantle.party.contact.TelecomNumber" include="nonpk"/>
            <parameter name="areaCode"><text-digits/></parameter>
            <parameter name="contactNumber"><matches regexp="^\d\d[-\. \d]*\d\d$" message="Please enter a valid phone number"/></parameter>
            <parameter name="emailAddress"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId" required="true"/>
        </out-parameters>
        <actions>
            <service-call name="create#mantle.facility.Facility" out-map="context" in-map="context"/>

            <if condition="address1 || city || postalCode">
                <service-call name="mantle.party.ContactServices.create#PostalAddress" out-map="paOut"
                        in-map="Object.assign({}, context, {contactMechPurposeId:'PostalPrimary'})"/></if>
            <if condition="contactNumber">
                <service-call name="mantle.party.ContactServices.create#TelecomNumber" out-map="phoneOut"
                        in-map="Object.assign({}, context, {contactMechPurposeId:'PhonePrimary'})"/></if>
            <if condition="emailAddress">
                <service-call name="mantle.party.ContactServices.create#EmailAddress" out-map="emOut"
                        in-map="{facilityId:facilityId, emailAddress:emailAddress, contactMechPurposeId:'EmailPrimary'}"/></if>
        </actions>
    </service>
    <service verb="update" noun="Facility">
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <auto-parameters entity-name="mantle.facility.Facility" include="nonpk"/>

            <auto-parameters entity-name="mantle.party.contact.PostalAddress" include="nonpk"/>
            <parameter name="longitude" type="BigDecimal"/>
            <parameter name="latitude" type="BigDecimal"/>

            <auto-parameters entity-name="mantle.party.contact.TelecomNumber" include="nonpk"/>
            <parameter name="areaCode"><text-digits/></parameter>
            <parameter name="contactNumber"><matches regexp="^\d\d[-\. \d]*\d\d$" message="Please enter a valid phone number"/></parameter>
            <parameter name="emailAddress"/>
        </in-parameters>
        <actions>
            <service-call name="update#mantle.facility.Facility" in-map="context" out-map="context"/>

            <if condition="contactNumber">
                <entity-find entity-name="mantle.facility.FacilityContactMech" list="phoneFcmList"><date-filter/>
                    <econdition field-name="facilityId"/><econdition field-name="contactMechPurposeId" value="PhonePrimary"/>
                </entity-find>
                <if condition="(phoneFcmList?.length > 0)"><then>
                    <service-call name="mantle.facility.ContactServices.update#FacilityTelecomNumber" out-map="phoneOut"
                            in-map="Object.assign({}, context, {contactMechId:phoneFcmList[0].contactMechId, contactMechPurposeId:'PhonePrimary'})"/>
                </then><else>
                    <service-call name="mantle.party.ContactServices.create#TelecomNumber" out-map="phoneOut"
                            in-map="Object.assign({}, context, {contactMechPurposeId:'PhonePrimary'})"/>
                </else></if>
                <set field="telecomContactMechId" from="phoneOut.contactMechId"/>
            </if>
            <if condition="emailAddress">
                <entity-find entity-name="mantle.facility.FacilityContactMech" list="emailFcmList"><date-filter/>
                    <econdition field-name="facilityId"/><econdition field-name="contactMechPurposeId" value="EmailPrimary"/>
                </entity-find>
                <if condition="(emailFcmList?.length > 0)"><then>
                    <service-call name="mantle.facility.ContactServices.update#FacilityContactOther" out-map="emOut"
                            in-map="{facilityId:facilityId, contactMechId:emailFcmList[0].contactMechId, infoString:emailAddress, contactMechPurposeId:'EmailPrimary'}"/>
                </then><else>
                    <service-call name="mantle.party.ContactServices.create#EmailAddress" out-map="emOut"
                            in-map="{facilityId:facilityId, emailAddress:emailAddress, contactMechPurposeId:'EmailPrimary'}"/>
                </else></if>
                <set field="emailContactMechId" from="emOut.contactMechId"/>
            </if>

            <!-- update PostalAddress and GeoPoint last to get telecomContactMechId and emailContactMechId -->
            <if condition="address1 || city || postalCode">
                <entity-find entity-name="mantle.facility.FacilityContactMech" list="addressFcmList"><date-filter/>
                    <econdition field-name="facilityId"/><econdition field-name="contactMechPurposeId" value="PostalPrimary"/>
                </entity-find>
                <if condition="(addressFcmList?.length > 0)"><then>
                    <service-call name="mantle.facility.ContactServices.update#FacilityPostalAddress" out-map="paOut"
                            in-map="Object.assign({}, context, {contactMechId:addressFcmList[0].contactMechId, contactMechPurposeId:'PostalPrimary'})"/>
                </then><else>
                    <service-call name="mantle.party.ContactServices.create#PostalAddress" out-map="paOut"
                            in-map="Object.assign({}, context, {contactMechPurposeId:'PostalPrimary'})"/>
                </else></if>
            </if>
        </actions>
    </service>

    <service verb="update" noun="FacilityCertification">
        <in-parameters>
            <parameter name="facilityCertificationId" required="true"/>
            <auto-parameters entity-name="mantle.facility.FacilityCertification" include="nonpk"/>
            <parameter name="documentFile" type="org.apache.commons.fileupload2.core.FileItem"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="mantle.facility.FacilityCertification" value-field="facilityCertification"/>
            <set field="facilityId" from="facilityCertification.facilityId"/>
            <if condition="documentFile != null &amp;&amp; documentFile.size &gt; 0">
                <if condition="!documentLocation">
                    <set field="filename" from="documentFile.getName()"/>
                    <if condition="ResourceReference.isTextFilename(filename)"><then>
                        <set field="contentRoot" from="ec.user.getPreference('mantle.content.root') || 'dbresource://mantle/content'"/>
                    </then><else>
                        <set field="contentRoot" from="ec.user.getPreference('mantle.content.large.root') || 'dbresource://mantle/content'"/>
                    </else></if>
                    <set field="documentLocation" value="${contentRoot}/facility/${facilityId||'_NA_'}/certification/${facilityCertificationId}/${filename}"/>
                </if>
                <set field="docRr" from="ec.resource.getLocationReference(documentLocation)"/>
                <script>
                    const fileStream = documentFile.getInputStream()
                    try { docRr.putStream(fileStream) } finally { fileStream.close() }
                </script>
            </if>

            <service-call name="update#mantle.facility.FacilityCertification" in-map="context"/>
        </actions>
    </service>

    <service verb="create" noun="FacilityLocation">
        <in-parameters>
            <auto-parameters entity-name="mantle.facility.FacilityLocation"/>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationSeqId" default-value="${areaId||''}${aisleId||''}${sectionId||''}${levelId||''}${positionId||''}"/>
        </in-parameters>
        <out-parameters><parameter name="locationSeqId"/></out-parameters>
        <actions>
            <if condition="!locationSeqId"><return error="true" message="No location ID specified, and no area, aisle, section, level, or position to generate it"/></if>
            <entity-find-one entity-name="mantle.facility.FacilityLocation" value-field="existingLoc"/>
            <if condition="existingLoc != null"><return error="true" message="Location with ID ${locationSeqId} already exists in facility ${facilityId}"/></if>
            <service-call name="create#mantle.facility.FacilityLocation" in-map="context" out-map="context"/>
        </actions>
    </service>

    <service verb="create" noun="FacilityNote">
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="userId" default="ec.user.userId"/>
            <parameter name="noteDate" default="ec.user.nowTimestamp"/>
            <parameter name="noteText" required="true"/>
        </in-parameters>
        <actions><service-call name="create#mantle.facility.FacilityNote" in-map="context"/></actions>
    </service>

    <service verb="get" noun="ScannedIdGeneral">
        <description>For a given scanId (barcode scanner, etc input) see if it can be resolved to assetId, containerId, locationSeqId, or productId</description>
        <in-parameters>
            <parameter name="facilityId"/>
            <parameter name="scanId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="assetId"/>
            <parameter name="containerId"/>
            <parameter name="locationSeqId"/>
            <parameter name="productId"/><parameter name="packProductId"/><parameter name="containedQuantity" type="BigDecimal"/><parameter name="quantityUomId"/><parameter name="appliedConversionFactor" type="BigDecimal"/><parameter name="ambiguityList" type="List"/><parameter name="gs1" type="Map"/><parameter name="packPath" type="List"/><parameter name="found" type="Boolean"/><parameter name="ambiguous" type="Boolean"/><parameter name="findings" type="List"/>
        </out-parameters>
        <actions>
            <set field="facilityId" from="facilityId || ec.user.getPreference('FacilityActive') || ec.user.getPreference('FacilityGeneralDefault')"/>
            <if condition="scanId">
                <!-- see if scanId is a assetId -->
                <entity-find-one entity-name="mantle.product.asset.Asset" value-field="asset">
                    <field-map field-name="assetId" from="scanId"/></entity-find-one>
                <if condition="asset != null"><set field="assetId" from="asset.assetId"/></if>
                <!-- see if scanId is a containerId -->
                <entity-find-one entity-name="mantle.product.asset.Container" value-field="container">
                    <field-map field-name="containerId" from="scanId"/></entity-find-one>
                <if condition="container != null"><then>
                    <set field="containerId" from="container.containerId"/>
                </then><else>
                    <!-- see if scanId is a Container.serialNumber -->
                    <entity-find-one entity-name="mantle.product.asset.Container" value-field="container">
                        <field-map field-name="serialNumber" from="scanId"/></entity-find-one>
                    <if condition="container != null"><set field="containerId" from="container.containerId"/></if>
                </else></if>
                <if condition="facilityId">
                    <!-- if we have a facilityId see if scanId is a locationSeqId -->
                    <entity-find-one entity-name="mantle.facility.FacilityLocation" value-field="facilityLocation">
                        <field-map field-name="facilityId"/><field-map field-name="locationSeqId" from="scanId"/></entity-find-one>
                    <if condition="facilityLocation != null"><set field="locationSeqId" from="facilityLocation.locationSeqId"/></if>
                </if>
                <!-- see if scanId matches Product.pseudoId, ProductIdentification.idValue, or Product.productId -->
                <!-- TODO: who would the Product.ownerPartyId be for an incoming shipment, Shipment.toPartyId or let user specify somehow? -->
                <service-call name="mantle.product.ProductServices.resolve#ScannedProduct" out-map="productByIdOut"
                        in-map="{scanId:scanId}"/>
                <script>ec.context.putAll(productByIdOut)</script>
            </if>
            <if condition="!assetId &amp;&amp; !containerId &amp;&amp; !locationSeqId &amp;&amp; !productId">
                <message>No Asset, Container, Location, or Product found with ID ${scanId}</message></if>
        </actions>
    </service>
    <service verb="get" noun="ProductFacilityPolicy" allow-remote="false">
        <description>Warehouse-owned product/facility policy; minimumStock targets the location when locationSeqId is supplied. Facility and location levels are edited separately and audit-logged.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="productId" required="true"/>
            <parameter name="facilityId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="productId"/>
            <parameter name="facilityId"/>
            <parameter name="locationSeqId"/>
            <parameter name="facilityPolicy" type="Map"/>
            <parameter name="locationPolicies" type="List"/>
            <parameter name="canPlan" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/facility/WarehousePolicy.js').execute('facilityRead',context))</script>
        </actions>
    </service>
    <service verb="store" noun="ProductFacilityPolicy" allow-remote="false">
        <description>Warehouse-owned product/facility policy; minimumStock targets the location when locationSeqId is supplied. Facility and location levels are edited separately and audit-logged.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="productId" required="true"/>
            <parameter name="facilityId" required="true"/>
            <auto-parameters entity-name="mantle.facility.ProductFacility" include="nonpk"/>
            <parameter name="locationSeqId"/>
            <parameter name="moveQuantity" type="BigDecimal"/>
            <parameter name="removeLocation" type="Boolean" default="false"><description>With locationSeqId, removes the
                product's policy at that location (ProductFacilityLocation).</description></parameter>
            <parameter name="changeReason" required="true"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="productId"/>
            <parameter name="facilityId"/>
            <parameter name="locationSeqId"/>
            <parameter name="facilityPolicy" type="Map"/>
            <parameter name="locationPolicies" type="List"/>
            <parameter name="canPlan" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/facility/WarehousePolicy.js').execute('facilityStore',context))</script>
        </actions>
    </service>

    <!-- Facility and location setup (FacilitySetup.js): the saves a facility administrator makes, each checking
        FACILITY_EDIT and the organization by party relationship, and the location close with its open check. -->
    <service verb="store" noun="Facility" allow-remote="false">
        <description>Create a facility, or change one of the user's (FACILITY_EDIT; a facility is the user's when its owner
            is one of their internal organizations, every one for a system administrator). Refuses another organization's
            facility (FACILITY_UNAVAILABLE), an owner that is not one of the user's internal organizations
            (OWNER_UNAVAILABLE), no name, a parent that is not one of the user's facilities, a parent that is the facility
            itself or one under it (PARENT_CYCLE), and a close before the open. A changed owner needs changeReason
            (REASON_REQUIRED), which the audit log keeps. A blank parentFacilityId keeps the stored parent unless
            clearParent; a parent equal to the stored one is kept without being checked again. The scope is
            FacilityScope.js's: the user's organizations (the active one when it is theirs), every one with
            FACILITY_ALL_ORGANIZATIONS. Contact details go through create#Facility and update#Facility.</description>
        <in-parameters>
            <parameter name="facilityId"/>
            <parameter name="facilityName"/>
            <parameter name="facilityTypeEnumId"/>
            <parameter name="parentFacilityId"/>
            <parameter name="clearParent" type="Boolean" default="false"><description>With a blank parentFacilityId,
                removes the parent.</description></parameter>
            <parameter name="ownerPartyId"/>
            <parameter name="description"/>
            <parameter name="openedDate" type="Timestamp"/>
            <parameter name="closedDate" type="Timestamp"/>
            <parameter name="defaultDaysToShip" type="Integer"/>
            <parameter name="address1"/>
            <parameter name="address2"/>
            <parameter name="city"/>
            <parameter name="stateProvinceGeoId"/>
            <parameter name="countryGeoId"/>
            <parameter name="postalCode"/>
            <parameter name="countryCode"/>
            <parameter name="areaCode"><text-digits/></parameter>
            <parameter name="contactNumber">
                <matches regexp="^\d\d[-\. \d]*\d\d$" message="Please enter a valid phone number"/></parameter>
            <parameter name="emailAddress"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="created" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="saved" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('storeFacility', context)"/>
            <set field="facilityId" from="saved.facilityId"/>
            <set field="created" from="saved.created"/>
        </actions>
    </service>
    <service verb="store" noun="FacilityLocation" allow-remote="false">
        <description>Create a location in one of the user's facilities, or change an open one (FACILITY_EDIT): its type,
            description, area, aisle, section, level and position, capacity with its unit, and pick sequence (sequenceNum).
            Its id is given or made from the area through the position. With isNew, refuses an id in use
            (LOCATION_EXISTS); refuses a closed location (LOCATION_CLOSED), another organization's facility
            (FACILITY_UNAVAILABLE), an unknown type or unit, a negative capacity and a pick sequence that is not a whole
            number.</description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationSeqId"/>
            <parameter name="isNew" type="Boolean" default="false"/>
            <parameter name="locationTypeEnumId"/>
            <parameter name="description"/>
            <parameter name="areaId"/>
            <parameter name="aisleId"/>
            <parameter name="sectionId"/>
            <parameter name="levelId"/>
            <parameter name="positionId"/>
            <parameter name="capacity"/>
            <parameter name="capacityUomId"/>
            <parameter name="sequenceNum"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="locationSeqId"/>
            <parameter name="created" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="saved" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('storeLocation', context)"/>
            <set field="facilityId" from="saved.facilityId"/>
            <set field="locationSeqId" from="saved.locationSeqId"/>
            <set field="created" from="saved.created"/>
        </actions>
    </service>
    <service verb="store" noun="FacilityLocationType" allow-remote="false">
        <description>The asset status that receive#Asset and move#Asset give stock put in a location of this type in one of
            the user's facilities (FACILITY_EDIT); empty for none. Audit-logged with changeReason, which is required.
            Refuses a status that is not an asset status and another organization's facility.</description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationTypeEnumId" required="true"/>
            <parameter name="autoStatusId"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="locationTypeEnumId"/>
            <parameter name="autoStatusId"/>
        </out-parameters>
        <actions>
            <set field="saved" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('storeLocationType', context)"/>
            <set field="facilityId" from="saved.facilityId"/>
            <set field="locationTypeEnumId" from="saved.locationTypeEnumId"/>
            <set field="autoStatusId" from="saved.autoStatusId"/>
        </actions>
    </service>
    <service verb="get" noun="FacilityLocationBlockers" allow-remote="false">
        <description>What keeps a location of one of the user's facilities from closing now (FACILITY_EDIT), each kind with
            the records it names: stock with on-hand or available-to-promise not zero (a depleted asset does not block),
            equipment that has not left (not delivered or deactivated, no actualEndOfLife), containers, reservations not
            issued on an asset there (open picks), counts not complete with a line there, and product location policies
            (ProductFacilityLocation) naming it.</description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationSeqId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="blockers" type="List"><description>Each blocker's kind, label, recordIds (at most ten),
                count and text.</description></parameter>
            <parameter name="locationClosed" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="found" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('blockers', context)"/>
            <set field="blockers" from="found.blockers"/>
            <set field="locationClosed" from="found.locationClosed"/>
        </actions>
    </service>
    <service verb="close" noun="FacilityLocation" allow-remote="false">
        <description>Close a location of one of the user's facilities now (FACILITY_EDIT): its audit-logged thruDate, with
            changeReason, which is required. Refuses, naming each, while anything of get#FacilityLocationBlockers is there
            (LOCATION_IN_USE); relocating the stock is how it is emptied. Refuses a closed location.</description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationSeqId" required="true"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="locationSeqId"/>
            <parameter name="thruDate" type="Timestamp"/>
        </out-parameters>
        <actions>
            <set field="closed" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('closeLocation', context)"/>
            <set field="facilityId" from="closed.facilityId"/>
            <set field="locationSeqId" from="closed.locationSeqId"/>
            <set field="thruDate" from="closed.thruDate"/>
        </actions>
    </service>
    <service verb="reopen" noun="FacilityLocation" allow-remote="false">
        <description>Open a closed location of one of the user's facilities again (FACILITY_EDIT), clearing its thruDate
            with changeReason, which is required, in the audit log.</description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationSeqId" required="true"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="facilityId"/>
            <parameter name="locationSeqId"/>
        </out-parameters>
        <actions>
            <set field="opened" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('reopenLocation', context)"/>
            <set field="facilityId" from="opened.facilityId"/>
            <set field="locationSeqId" from="opened.locationSeqId"/>
        </actions>
    </service>
    <service verb="check" noun="FacilityLocationOpen" allow-remote="false">
        <description>For a destination guard (receive, move, putaway): refuses a location that does not exist
            (LOCATION_UNAVAILABLE) or is closed (LOCATION_CLOSED), or one of a facility whose closedDate has passed
            (FACILITY_CLOSED), since receive#Asset and move#Asset do not read FacilityLocation.thruDate. It locks the
            location row, so the guard calls it inside its own transaction, where the lock serializes it with
            close#FacilityLocation. Checks no permission: the guard has checked the user and the facility.</description>
        <in-parameters>
            <parameter name="facilityId" required="true"/>
            <parameter name="locationSeqId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="locationTypeEnumId"/>
        </out-parameters>
        <actions>
            <set field="open" from="ec.resource.script('component://mr-mantle/service/mantle/facility/FacilitySetup.js')
                    .execute('checkOpen', context)"/>
            <set field="locationTypeEnumId" from="open.locationTypeEnumId"/>
        </actions>
    </service>
</services>
