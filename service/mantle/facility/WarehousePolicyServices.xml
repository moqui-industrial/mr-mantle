<!-- The Warehouse policy (WH-POLICY; WarehousePolicy.js): dated WarehousePolicy rows by organization, facility and
    product, in three families. Tracking (lot and serial requirements, patterns, shelf life, the expiry gate's flag) has
    product exceptions, which a stock planner may change; operation (receipt and delivery steps, default locations,
    tolerances, the backorder choice, blind counts, auto-print) and reservation (the facility reservation default where
    a store leaves it unset) are organization and facility policies that take STOCK_POLICY_MANAGE. A change ends the row
    in effect and starts the next, applies from its date (at posting) and never rewrites history. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="PolicyResult" type="interface">
        <description>The in-parameters a policy read or change shares: the scope and the date.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="productId"/>
            <parameter name="asOfDate" type="Timestamp"/>
        </in-parameters>
    </service>

    <service verb="resolve" noun="WarehousePolicy" allow-remote="false">
        <description>The effective Warehouse policy at a date for an organization, facility, store and product, with its
            trace: each value's source (organization, facility, store, product, facility product, the facility's location of
            the type, or the built-in default). Tracking resolves through the organization, the facility, the product and
            the product at the facility, and a narrower scope cannot lift an inherited expiry block; operation through the
            organization and the facility; reservation through the organization, the facility and then the store's own
            settings, which win for that store's orders only. configuredPolicy and history are the rows of policyType
            (default tracking) at the exact scope. Warnings name a location the effective steps need and the facility lacks.
            Refuses a user outside the organization, and a facility, store or product of another.</description>
        <implements service="mantle.facility.WarehousePolicyServices.define#PolicyResult"/>
        <in-parameters>
            <parameter name="productStoreId"><description>The store whose reservation settings override; its inventory
                facility when no facility is given</description></parameter>
            <parameter name="policyType"><description>tracking (default), operation or reservation: the family of
                configuredPolicy and history</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="productId"/>
            <parameter name="productStoreId"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="trackingPolicy" type="Map"/>
            <parameter name="operationPolicy" type="Map"/>
            <parameter name="reservationPolicy" type="Map"/>
            <parameter name="configuredPolicy" type="Map"/>
            <parameter name="sources" type="Map"/>
            <parameter name="sourceRows" type="List"/>
            <parameter name="trace" type="List"/>
            <parameter name="warnings" type="List"/>
            <parameter name="history" type="List"/>
            <parameter name="canPlan" type="Boolean"/>
            <parameter name="canManage" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/WarehousePolicy.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('resolve', context))</script>
        </actions>
    </service>

    <service verb="store" noun="TrackingPolicy" allow-remote="false">
        <description>A dated tracking change at the organization, facility, product or product-at-facility scope. Product
            exceptions take STOCK_POLICY_PLAN or STOCK_POLICY_MANAGE; organization and facility defaults take
            STOCK_POLICY_MANAGE. Refuses a stale expectedFromDate, a start in the past, a second row starting at the same
            time, and invalid flags, days and patterns.</description>
        <in-parameters>
            <auto-parameters entity-name="mantle.facility.WarehousePolicy" include="all"/>
            <parameter name="expectedFromDate" type="Timestamp"/>
            <parameter name="changeReason" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="productId"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="trackingPolicy" type="Map"/>
            <parameter name="configuredPolicy" type="Map"/>
            <parameter name="sources" type="Map"/>
            <parameter name="sourceRows" type="List"/>
            <parameter name="history" type="List"/>
            <parameter name="canPlan" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/WarehousePolicy.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('storeTracking', context))</script>
        </actions>
    </service>

    <service verb="store" noun="OperationPolicy" allow-remote="false">
        <description>A dated operation policy change for an organization (facilityId empty) or a facility: receipt and
            delivery steps (1 to 3), the receiving, quarantine and staging locations (a facility's, of those location
            types), over-receipt and over-shipment tolerances in percent (0 to 100; zero with no row), the backorder choice
            (WarehouseBackorder), blind counts and auto-print. An empty field inherits. Takes STOCK_POLICY_MANAGE in the
            organization. Refuses a stale expectedFromDate, a start in the past and a second row at the same time.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="fromDate" type="Timestamp"><description>Empty starts now</description></parameter>
            <parameter name="expectedFromDate" type="Timestamp"><description>The fromDate of the row in effect at this
                scope when the form was read, empty when none</description></parameter>
            <parameter name="receiptSteps" type="Integer"/>
            <parameter name="deliverySteps" type="Integer"/>
            <parameter name="receivingLocationSeqId"/>
            <parameter name="quarantineLocationSeqId"/>
            <parameter name="stagingLocationSeqId"/>
            <parameter name="overReceiptPercent" type="BigDecimal"/>
            <parameter name="overShipmentPercent" type="BigDecimal"/>
            <parameter name="backorderEnumId"/>
            <parameter name="blindCount"/>
            <parameter name="autoPrint"/>
            <parameter name="inventoryRequestCheck"><description>Y: a stock request (RqtInventory) must name a facility
                of the user's organizations (create#Request, update#Request; impl-warehouse P15)</description></parameter>
            <parameter name="changeReason" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="operationPolicy" type="Map"/>
            <parameter name="configuredPolicy" type="Map"/>
            <parameter name="trace" type="List"/>
            <parameter name="warnings" type="List"/>
            <parameter name="history" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/WarehousePolicy.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('storeOperation', context))</script>
        </actions>
    </service>

    <service verb="store" noun="ReservationPolicy" allow-remote="false">
        <description>A dated facility reservation default for an organization (facilityId empty) or a facility: the
            reservation order (AssetReservationOrder) and automatic timing (AssetReservationAuto) that Mantle's reservation
            uses for an order whose store, or the order part, leaves them unset (orders without a store). An empty field
            inherits. Takes STOCK_POLICY_MANAGE in the organization. The change does not move existing reservations.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="expectedFromDate" type="Timestamp"/>
            <parameter name="reservationOrderEnumId"/>
            <parameter name="reservationAutoEnumId"/>
            <parameter name="changeReason" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="reservationPolicy" type="Map"/>
            <parameter name="configuredPolicy" type="Map"/>
            <parameter name="trace" type="List"/>
            <parameter name="history" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/WarehousePolicy.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('storeReservation', context))</script>
        </actions>
    </service>

    <service verb="get" noun="ReservationDefault" allow-remote="false">
        <description>The facility reservation default Mantle's reservation reads where a store leaves the setting unset:
            the reservation order and automatic timing of the reservation rows in effect now for the organization at the
            facility, else for the organization. Empty with no row, so reservation is unchanged without a policy. Internal:
            it reads policy only and checks no permission.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="reservationOrderEnumId"/>
            <parameter name="reservationAutoEnumId"/>
        </out-parameters>
        <actions>
            <if condition="!organizationPartyId"><return/></if>
            <!-- cached: a cached find filters by date after the cache (XmlActions), so the key holds no time -->
            <entity-find entity-name="mantle.facility.WarehousePolicy" list="defaultList" cache="true"
                    disable-authz="true">
                <date-filter/>
                <econdition field-name="organizationPartyId"/>
                <econdition field-name="policyType" value="reservation"/>
                <econdition field-name="productId" value="_NA_"/>
                <order-by field-name="-fromDate"/>
            </entity-find>
            <set field="facilityRow"
                    from="facilityId ? Array.from(defaultList).find(row =&gt; row.facilityId === facilityId) : null"/>
            <set field="organizationRow" from="Array.from(defaultList).find(row =&gt; row.facilityId === '_NA_')"/>
            <set field="reservationOrderEnumId"
                    from="facilityRow?.reservationOrderEnumId || organizationRow?.reservationOrderEnumId || null"/>
            <set field="reservationAutoEnumId"
                    from="facilityRow?.reservationAutoEnumId || organizationRow?.reservationAutoEnumId || null"/>
        </actions>
    </service>

    <!-- the expiry gate (WH-EXPIRY, impl-warehouse §4, F12): the tracking policy's expiryBlock, off by default -->
    <service verb="get" noun="ExpiryGate" allow-remote="false">
        <description>The tracking policy's expiry settings in effect now for an organization's product at a facility, which
            Mantle's reservation and issue read: expiryBlock (true when a tracking row in effect at the organization,
            facility, product or facility-product scope blocks expired stock; a narrower row cannot lift a wider one's
            block) and nearExpiryDays (the narrowest row that sets it). Off with no row, so reservation and issue are
            unchanged without a policy. Internal: it reads policy only and checks no permission.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="productId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="expiryBlock" type="Boolean"/>
            <parameter name="nearExpiryDays" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="expiryBlock" from="false"/>
            <set field="nearExpiryDays" from="0"/>
            <if condition="!organizationPartyId"><return/></if>
            <!-- cached: a cached find filters by date after the cache (XmlActions), so the key holds no time -->
            <entity-find entity-name="mantle.facility.WarehousePolicy" list="trackingList" cache="true" disable-authz="true">
                <date-filter/>
                <econdition field-name="organizationPartyId"/>
                <econdition field-name="policyType" value="tracking"/>
                <order-by field-name="-fromDate"/>
            </entity-find>
            <script><![CDATA[
                // the newest row of each scope that applies, most general first (WarehousePolicy.js's layering)
                const scopes = [['_NA_', '_NA_'], [facilityId, '_NA_'], ['_NA_', productId], [facilityId, productId]]
                const seen = new Set()
                for (const [scopeFacilityId, scopeProductId] of scopes) {
                    if (!scopeFacilityId || !scopeProductId || seen.has(scopeFacilityId + '|' + scopeProductId)) continue
                    seen.add(scopeFacilityId + '|' + scopeProductId)
                    const row = Array.from(trackingList)
                        .find(policy => policy.facilityId === scopeFacilityId && policy.productId === scopeProductId)
                    if (!row) continue
                    if (row.expiryBlock === 'Y') expiryBlock = true
                    if (row.nearExpiryDays != null) nearExpiryDays = Number(String(row.nearExpiryDays))
                }
            ]]></script>
        </actions>
    </service>
    <service verb="get" noun="AssetExpiry" allow-remote="false">
        <description>An asset's expiry: the earlier of its own expected end of life and its lot's expiration date, as a
            calendar day; expired when that day has passed in the user's zone, near expiry within the tracking policy's
            nearExpiryDays; and the policy's expiryBlock for the asset's facility owner (else its owner) and product
            (get#ExpiryGate). An asset with no date is neither. Internal: it checks no permission.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="expiryDate"/>
            <parameter name="expired" type="Boolean"/>
            <parameter name="nearExpiry" type="Boolean"/>
            <parameter name="expiryBlock" type="Boolean"/>
            <parameter name="nearExpiryDays" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="expired" from="false"/>
            <set field="nearExpiry" from="false"/>
            <entity-find-one entity-name="mantle.product.asset.Asset" value-field="asset" disable-authz="true"/>
            <if condition="asset == null"><return/></if>
            <entity-find-one entity-name="mantle.facility.Facility" value-field="facility" cache="true" disable-authz="true">
                <field-map field-name="facilityId" from="asset.facilityId"/>
            </entity-find-one>
            <service-call name="mantle.facility.WarehousePolicyServices.get#ExpiryGate" out-map="gate" disable-authz="true"
                    in-map="{organizationPartyId:facility?.ownerPartyId || asset.ownerPartyId, facilityId:asset.facilityId,
                        productId:asset.productId}"/>
            <set field="expiryBlock" from="gate.expiryBlock"/>
            <set field="nearExpiryDays" from="gate.nearExpiryDays"/>
            <if condition="asset.lotId">
                <entity-find-one entity-name="mantle.product.asset.Lot" value-field="lot" disable-authz="true">
                    <field-map field-name="lotId" from="asset.lotId"/>
                </entity-find-one>
            </if>
            <script><![CDATA[
                const lib = ec.resource.script('component://mr-mantle/service/mantle/ledger/EntityLib.js')
                const days = [asset.expectedEndOfLife, lot?.expirationDate].filter(day => day != null && day !== '')
                    .map(day => lib.calendarDateText(day)).sort()
                expiryDate = days[0] || null
                if (expiryDate) {
                    const today = ec.l10n.format(ec.user.nowTimestamp, 'yyyy-MM-dd')
                    // the calendar day nearExpiryDays after today
                    const horizon = lib.calendarDateText(Date.parse(today + 'T00:00:00Z') + (nearExpiryDays || 0) * 86400000)
                    expired = expiryDate < today
                    nearExpiry = !expired && (nearExpiryDays || 0) > 0 && expiryDate <= horizon
                }
            ]]></script>
        </actions>
    </service>

    <service verb="check" noun="AssetExpiryGate" allow-remote="false">
        <description>For the issue services (sales and production): refuses an expired asset, naming its date
            (ASSET_EXPIRED), when its tracking policy blocks expired stock. With the asset the caller holds it reads only the
            cached facility and policy (get#ExpiryGate) and returns at once when the policy does not block, so an issuance
            with no such policy reads nothing more; only then get#AssetExpiry reads the asset's and lot's dates. Internal:
            it checks no permission.</description>
        <in-parameters>
            <parameter name="assetId" required="true"/>
            <parameter name="asset" type="Map"><description>The asset the caller already read, if any.</description></parameter>
        </in-parameters>
        <actions>
            <if condition="asset == null">
                <entity-find-one entity-name="mantle.product.asset.Asset" value-field="asset" disable-authz="true"/>
            </if>
            <if condition="asset == null"><return/></if>
            <entity-find-one entity-name="mantle.facility.Facility" value-field="facility" cache="true" disable-authz="true">
                <field-map field-name="facilityId" from="asset.facilityId"/>
            </entity-find-one>
            <service-call name="mantle.facility.WarehousePolicyServices.get#ExpiryGate" out-map="gate" disable-authz="true"
                    in-map="{organizationPartyId:facility?.ownerPartyId || asset.ownerPartyId, facilityId:asset.facilityId,
                        productId:asset.productId}"/>
            <if condition="!gate.expiryBlock"><return/></if>
            <service-call name="mantle.facility.WarehousePolicyServices.get#AssetExpiry" in-map="{assetId:assetId}"
                    out-map="expiry" disable-authz="true"/>
            <if condition="expiry.expired">
                <return error="true" message="ASSET_EXPIRED: Asset ${assetId} expired on ${expiry.expiryDate}"/>
            </if>
        </actions>
    </service>

    <service verb="update" noun="StoreReservation" allow-remote="false">
        <description>A store's own reservation settings, the override over the facility default for that store's orders:
            its inventory facility (the organization's), reservation order, automatic timing and require-inventory flag.
            A field-scoped change of ProductStore, audit-logged with the reason; the store's other settings stay Commerce's.
            Takes STOCK_POLICY_MANAGE in the store's organization. Refuses a stale expectedLastUpdatedStamp.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
            <parameter name="inventoryFacilityId"/>
            <parameter name="reservationOrderEnumId"/>
            <parameter name="reservationAutoEnumId"/>
            <parameter name="requireInventory"/>
            <parameter name="changeReason" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="productStoreId"/>
            <parameter name="facilityId"/>
            <parameter name="reservationPolicy" type="Map"/>
            <parameter name="trace" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/WarehousePolicy.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('storeStoreReservation', context))</script>
        </actions>
    </service>

    <service verb="preview" noun="FacilityReservations" allow-remote="false">
        <description>The reservations at a facility that check#FacilityReservations would repair, read without changing
            anything: on an asset no longer available (ASSET_NOT_AVAILABLE), for an order part of another facility
            (OTHER_FACILITY), on a pool the order does not qualify for (POOL_NOT_QUALIFIED), or not available while the
            product has available stock there (AVAILABLE_ELSEWHERE). At most 200 reservations are checked (truncated says
            more exist). Refuses a user outside the facility's organization.</description>
        <implements service="mantle.facility.WarehousePolicyServices.define#PolicyResult"/>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="productId"/>
            <parameter name="checkedCount" type="Integer"/>
            <parameter name="truncated" type="Boolean"/>
            <parameter name="findings" type="List"/>
            <parameter name="previewFingerprint"><description>The findings' fingerprint, which a repair
                (WarehouseTaskServices.repair#FacilityReservations) gives back.</description></parameter>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/WarehousePolicy.js"/>
            <script>ec.context.putAll(ec.resource.script(module).execute('reservationCheck', context))</script>
        </actions>
    </service>
    <!-- ===== the count schedule (impl-warehouse P10, CountSchedule.js) ===== -->
    <service verb="store" noun="CountSchedule" allow-remote="false">
        <description>A count schedule row of an organization (facilityId empty) or a facility: its scope (a location type,
            area or location of the facility; or a product category or ABC class), its kind (CskPeriodic every frequencyDays,
            CskAnnual on annualMonth and annualDay, CskZero when a location's stock reaches zero), the count mode, the blind
            default (empty: the operation policy's) and the assignee. With countScheduleId the row in effect ends where the
            changed one starts (fromDate, now or later), or ends now with endNow; key fields are audit-logged under the
            required reason. Takes STOCK_POLICY_MANAGE in the organization (POLICY_MANAGE_REQUIRED); refuses locations and
            products in one row, zero confirmation of products and an invalid value (POLICY_INVALID).</description>
        <in-parameters>
            <parameter name="countScheduleId"/>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="locationTypeEnumId"/>
            <parameter name="areaId"/>
            <parameter name="locationSeqId"/>
            <parameter name="productCategoryId"/>
            <parameter name="abcClassEnumId"/>
            <parameter name="scheduleKindEnumId"/>
            <parameter name="frequencyDays"/>
            <parameter name="annualMonth"/>
            <parameter name="annualDay"/>
            <parameter name="countModeEnumId"/>
            <parameter name="blindIndicator"/>
            <parameter name="assigneePartyId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="endNow" type="Boolean" default="false"/>
            <parameter name="expectedLastUpdatedStamp" type="Timestamp"/>
            <parameter name="changeReason" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="countScheduleId"/>
            <parameter name="schedule" type="Map"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/CountSchedule.js"/>
            <set field="answer" from="ec.resource.script(module).execute('store', context)"/>
            <set field="countScheduleId" from="answer.countScheduleId"/>
            <set field="schedule" from="answer.schedule"/>
        </actions>
    </service>
    <service verb="find" noun="CountSchedules" allow-remote="false">
        <description>The count schedule rows of an organization (a facility's and the organization's own), in effect now and
            to come, or all of them with includeHistory, each with how it comes due and its scope in words. Any user in the
            organization's warehouse scope reads; canManage says whether they may change them.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="includeHistory" type="Boolean" default="false"/>
        </in-parameters>
        <out-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="canManage" type="Boolean"/>
            <parameter name="schedules" type="List"/>
        </out-parameters>
        <actions>
            <set field="module" value="component://mr-mantle/service/mantle/facility/CountSchedule.js"/>
            <set field="answer" from="ec.resource.script(module).execute('list', context)"/>
            <set field="organizationPartyId" from="answer.organizationPartyId"/>
            <set field="facilityId" from="answer.facilityId"/>
            <set field="canManage" from="answer.canManage"/>
            <set field="schedules" from="answer.schedules"/>
        </actions>
    </service>
</services>
