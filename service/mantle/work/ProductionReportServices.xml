<!-- Manufacturing's reports (design-manufacturing §9 and Home's Kpis, §12 M10; impl-manufacturing P16): the eight read-only
    report contracts and the dashboard provider over the production records, in ProductionReports.js. Each checks
    PRODUCTION_VIEW and the user's organizations and facilities itself, answers its scope, as-of time, units, currencies and
    the partitions it could not read, and returns money only with ACCOUNTING_VIEW (left out, never zero). A list a screen
    pages comes with its page fields; pageNoLimit (an export) answers every row up to 2000. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="ReportParameters" type="interface">
        <description>The scope every production report takes: an organization of the user's (else all of them), a facility (a
            plant takes the facilities under it), the period (fromDate inclusive; thruDate exclusive, a day at midnight through
            its end; 30 days to now by default) and the page of its list.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="facilityId"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
            <parameter name="pageNoLimit"/>
        </in-parameters>
    </service>
    <service verb="get" noun="ProductionStatusReport" allow-remote="false">
        <description>The production runs of the scope by status (open by default; 'all' or a comma list), due date,
            completion date (completedFrom, completedThru), output product and assignee (WorkOrderStatusReport): each
            run's target, good and remaining quantity in its stock unit, due and completion dates, days late and what
            blocks it (on hold, a short component), with the totals per unit and the count per status. The period
            parameters are not used. Requires PRODUCTION_VIEW (PERMISSION_DENIED); refuses an organization or facility
            outside the user's scope (RECORD_UNAVAILABLE) and a period of more than a year or ending before it starts
            (PERIOD_TOO_LONG, PERIOD_INVALID). Answers its scope, as-of time, units, currencies and the partitions it
            could not read (complete false), and leaves money out without ACCOUNTING_VIEW (withheldText).</description>
        <implements service="mantle.work.ProductionReportServices.define#ReportParameters"/>
        <in-parameters>
            <parameter name="productId"/>
            <parameter name="statusId"/>
            <parameter name="assigneePartyId"/>
            <parameter name="dueFrom" type="Timestamp"/>
            <parameter name="dueThru" type="Timestamp"/>
            <parameter name="completedFrom" type="Timestamp"/>
            <parameter name="completedThru" type="Timestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="scope" type="Map"><description>organizationPartyIds (null: every one), organizationText, facilityId,
                facilityText, fromDate, thruDate and periodText</description></parameter>
            <parameter name="asOf" type="Timestamp"/>
            <parameter name="asOfText"/>
            <parameter name="unitList" type="List"/>
            <parameter name="unitsText"/>
            <parameter name="currencyUomIds" type="List"><description>Only with ACCOUNTING_VIEW</description></parameter>
            <parameter name="currencyText"/>
            <parameter name="partitions" type="List"><description>Each partition not read: name and message</description>
            </parameter>
            <parameter name="partitionsText"/>
            <parameter name="complete" type="Boolean"/>
            <parameter name="financialRead" type="Boolean"/>
            <parameter name="withheldText"/>
            <parameter name="totalRows" type="List"/>
            <parameter name="statusCounts" type="List"/>
            <parameter name="statusRows" type="List"/>
            <parameter name="statusRowsCount" type="Integer"/>
            <parameter name="statusRowsPageIndex" type="Integer"/>
            <parameter name="statusRowsPageSize" type="Integer"/>
            <parameter name="statusRowsPageMaxIndex" type="Integer"/>
            <parameter name="statusRowsPageRangeLow" type="Integer"/>
            <parameter name="statusRowsPageRangeHigh" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="report" from="ec.resource.script('component://mr-mantle/service/mantle/work/ProductionReports.js')
                    .execute('status', context)"/>
            <set field="scope" from="report.scope"/>
            <set field="asOf" from="report.asOf"/>
            <set field="asOfText" from="report.asOfText"/>
            <set field="unitList" from="report.unitList"/>
            <set field="unitsText" from="report.unitsText"/>
            <set field="currencyUomIds" from="report.currencyUomIds"/>
            <set field="currencyText" from="report.currencyText"/>
            <set field="partitions" from="report.partitions"/>
            <set field="partitionsText" from="report.partitionsText"/>
            <set field="complete" from="report.complete"/>
            <set field="financialRead" from="report.financialRead"/>
            <set field="withheldText" from="report.withheldText"/>
            <set field="totalRows" from="report.totalRows"/>
            <set field="statusCounts" from="report.statusCounts"/>
            <set field="statusRows" from="report.statusRows"/>
            <set field="statusRowsCount" from="report.statusRowsCount"/>
            <set field="statusRowsPageIndex" from="report.statusRowsPageIndex"/>
            <set field="statusRowsPageSize" from="report.statusRowsPageSize"/>
            <set field="statusRowsPageMaxIndex" from="report.statusRowsPageMaxIndex"/>
            <set field="statusRowsPageRangeLow" from="report.statusRowsPageRangeLow"/>
            <set field="statusRowsPageRangeHigh" from="report.statusRowsPageRangeHigh"/>
        </actions>
    </service>
