            <parameter name="text"><description>Manufacturing's list search, by id and name ignoring case</description></parameter>
        </in-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/work/Routings.js').execute('list',context))</script>
