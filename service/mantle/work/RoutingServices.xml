            <parameter name="operationWorkEffortId" type="String"/>
            <parameter name="organizationPartyId" type="String"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="thruDate" type="Timestamp"/>
            <parameter name="expectedRevision" type="String"/>
            <parameter name="changeReason" type="String"/>
            <parameter name="workEffortName" type="String"/>
            <parameter name="description" type="String"/>
            <parameter name="sequenceNum" type="Integer"/>
            <parameter name="estimatedSetupTime" type="BigDecimal"/>
            <parameter name="estimatedWorkTime" type="BigDecimal"/>
            <parameter name="timeUomId" type="String"/>
            <parameter name="methodMachineSetupTime" type="BigDecimal"/>
            <parameter name="methodMachineRunTime" type="BigDecimal"/>
            <parameter name="methodBatchQuantity" type="BigDecimal"/>
            <parameter name="methodQuantityUomId" type="String"/>
