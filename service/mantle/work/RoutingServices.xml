            <parameter name="rateAmount" type="BigDecimal"/>
            <parameter name="priceUomId" type="String"/>
            <parameter name="approve" type="Boolean"/>
            <parameter name="quantity" type="BigDecimal"/>
            <parameter name="quantityUomId" type="String"/>
            <parameter name="need" type="String"/>
            <parameter name="componentTypeEnumIds" type="List"/>
            <parameter name="allowCurrencyConversion" type="Boolean"/>
