<!-- mantle.marketing.TrackingServices (K, IronStone Marketing design §14.2; impl-marketing P11, §4): the order-placed handler of the
    Mantle SECA OrderPlacedRecordAttribution (MarketingTracking.secas.xml). P11 files the automation admission event; P20 adds the
    attribution (record#OrderAttribution); P15 adds the tracking links and capture. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="handle" noun="OrderPlaced" authenticate="anonymous-all" allow-remote="false">
        <description>Internal, the SECA OrderPlacedRecordAttribution's one handler (design §15.1), after an order's placement commits, in a transaction of its own: the order's admission event (order:orderId, the customer, the time placed) filed once for each active automation of its seller with the order-placed trigger, of the order's store or of every store; a failure of one automation is logged and the next goes on, and the placement never waits on it. Runs as the system. P20 adds the attribution.</description>
        <in-parameters><parameter name="orderId" required="true"/></in-parameters>
        <out-parameters><parameter name="filedCount" type="Integer"/></out-parameters>
        <actions>
            <set field="filedCount" from="ec.resource.script('component://mr-mantle/service/mantle/marketing/MarketingAutomations.js').execute('orderPlaced', context).filedCount"/>
        </actions>
    </service>
</services>
