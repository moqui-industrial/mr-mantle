<!-- Shop themes and releases (mr-pass impl-shop P2, SHOP-THEME; design-shop §12.2-§12.5; Themes.js and ThemeView.js).
    The core, which Commerce P5's editors call: a draft from a starter package or a release, its validation and digest,
    publish (an immutable release pinning the files' versions and digests, the site's binding and generation switched in
    one transaction against the expected active revision), restore of an earlier release and its export manifest. Each
    checks COMMERCE_VIEW and its own permission (COMMERCE_THEME_EDIT for drafts, COMMERCE_THEME_PUBLISH to publish or
    restore) and the store's scope: the theme's store and the store the site's Shop mount targets (StoreAdmin.js). The
    live part is PASS operations through pass.Facade.call#Operation (input map, result map, the site from the facade):
    the page view of a published site's Shop mount, and the active release's manifest and files for a frontend to verify
    and render. Commerce P4 appends the page and navigation part, P5 the authoring part. Refusals start with their code. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <!-- ===== core ===== -->
    <service verb="create" noun="ThemeDraft" allow-remote="false">
        <description>A new theme of a store with its draft copied from a starter package (starter "component/name": the
            component's theme/{name} directory) or from one of the store's releases (releaseId). Refuses a missing starter
            (STARTER_REQUIRED, STARTER_UNAVAILABLE), a package over its bounds (PACKAGE_TOO_LARGE) and another store's
            release. COMMERCE_THEME_EDIT and the store's scope.</description>
        <in-parameters>
            <parameter name="productStoreId" required="true"/>
            <parameter name="starter"/>
            <parameter name="releaseId"/>
            <parameter name="name"/>
        </in-parameters>
        <out-parameters>
            <parameter name="themeId"/>
            <parameter name="name"/>
            <parameter name="draftRevision" type="Integer"/>
            <parameter name="fileCount" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/Themes.js').execute('createThemeDraft', context)"/>
            <set field="themeId" from="out.themeId"/>
            <set field="name" from="out.name"/>
            <set field="draftRevision" from="out.draftRevision"/>
            <set field="fileCount" from="out.fileCount"/>
        </actions>
    </service>
    <service verb="get" noun="ThemeDraft" allow-remote="false">
        <description>A theme's record, its draft's files (path, dbresource version, digest, size; the text with includeText),
            whether its last validation is of the current draft, and its releases. COMMERCE_VIEW and the store's scope.</description>
        <in-parameters>
            <parameter name="themeId" required="true"/>
            <parameter name="includeText" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="theme" type="Map"/>
            <parameter name="files" type="List"/>
            <parameter name="validation" type="Map"/>
            <parameter name="releases" type="List"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/Themes.js').execute('getThemeDraft', context)"/>
            <set field="theme" from="out.theme"/>
            <set field="files" from="out.files"/>
            <set field="validation" from="out.validation"/>
            <set field="releases" from="out.releases"/>
        </actions>
    </service>
    <service verb="validate" noun="Theme" allow-remote="false">
        <description>Validates a theme's draft: the adapter's checks of files, schemas, settings and templates, a template
            for every Shop page kind, the required purchase, cart and checkout components declared and placed, and a bounded
            render of each page kind with a sample view. Answers ok, the diagnostics (file and line) and the validation
            digest publish#Theme takes, and keeps them on the theme. COMMERCE_THEME_EDIT or COMMERCE_THEME_PUBLISH and the
            store's scope.</description>
        <in-parameters>
            <parameter name="themeId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="ok" type="Boolean"/>
            <parameter name="engine"/>
            <parameter name="validationDigest"/>
            <parameter name="draftRevision" type="Integer"/>
            <parameter name="diagnostics" type="List"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/Themes.js').execute('validateTheme', context)"/>
            <set field="ok" from="out.ok"/>
            <set field="engine" from="out.engine"/>
            <set field="validationDigest" from="out.validationDigest"/>
            <set field="draftRevision" from="out.draftRevision"/>
            <set field="diagnostics" from="out.diagnostics"/>
        </actions>
    </service>
    <service verb="publish" noun="Theme" allow-remote="false">
        <description>Publishes a theme's current draft to a site's Shop mount: validates it again, refuses a draft changed
            since the given validation digest (VALIDATION_STALE) or one that does not validate (THEME_INVALID), refuses a
            stale expectedActiveRevision (REVISION_STALE; 0 when the site has no theme), then writes the immutable release
            (each file's version and digest, the manifest and its digest) and switches the site's binding and advances its
            generation in one transaction. A theme of another store than the one the site sells is refused
            (THEME_STORE_MISMATCH). A retry with the same operationKey answers the first result (alreadyApplied).
            COMMERCE_THEME_PUBLISH and the store's scope.</description>
        <in-parameters>
            <parameter name="themeId" required="true"/>
            <parameter name="siteId" required="true"/>
            <parameter name="validationDigest" required="true"/>
            <parameter name="expectedActiveRevision" type="Integer" required="true"/>
            <parameter name="operationKey" required="true"><description>The operation's identity (PostingOperation): a retry
                with the same key answers the first result.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="releaseId"/>
            <parameter name="manifestDigest"/>
            <parameter name="themeId"/>
            <parameter name="siteId"/>
            <parameter name="appMountId"/>
            <parameter name="revision" type="Integer"/>
            <parameter name="generation" type="Integer"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/Themes.js').execute('publishTheme', context)"/>
            <set field="releaseId" from="out.releaseId"/>
            <set field="manifestDigest" from="out.manifestDigest"/>
            <set field="themeId" from="out.themeId"/>
            <set field="siteId" from="out.siteId"/>
            <set field="appMountId" from="out.appMountId"/>
            <set field="revision" from="out.revision"/>
            <set field="generation" from="out.generation"/>
            <set field="alreadyApplied" from="out.alreadyApplied == true"/>
        </actions>
    </service>
    <service verb="restore" noun="ThemeRelease" allow-remote="false">
        <description>Makes an earlier release of the store's the active theme of a site's Shop mount, through the same gate
            as publish: its files must still match their digests (RELEASE_DAMAGED) and validate on this renderer
            (RELEASE_INVALID: also an engine or view API this authority no longer supports), and expectedActiveRevision must
            be current (REVISION_STALE); a retry with the same operationKey answers the first result. The binding's audit log records
            it; live pages still show only what is published now. COMMERCE_THEME_PUBLISH and the store's scope.</description>
        <in-parameters>
            <parameter name="siteId" required="true"/>
            <parameter name="releaseId" required="true"/>
            <parameter name="expectedActiveRevision" type="Integer" required="true"/>
            <parameter name="operationKey" required="true"><description>The operation's identity (PostingOperation): a retry
                with the same key answers the first result.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="releaseId"/>
            <parameter name="manifestDigest"/>
            <parameter name="themeId"/>
            <parameter name="siteId"/>
            <parameter name="appMountId"/>
            <parameter name="revision" type="Integer"/>
            <parameter name="generation" type="Integer"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/Themes.js').execute('restoreThemeRelease', context)"/>
            <set field="releaseId" from="out.releaseId"/>
            <set field="manifestDigest" from="out.manifestDigest"/>
            <set field="themeId" from="out.themeId"/>
            <set field="siteId" from="out.siteId"/>
            <set field="appMountId" from="out.appMountId"/>
            <set field="revision" from="out.revision"/>
            <set field="generation" from="out.generation"/>
            <set field="alreadyApplied" from="out.alreadyApplied == true"/>
        </actions>
    </service>
    <service verb="export" noun="ThemeRelease" allow-remote="false">
        <description>A release's export manifest: its files with versions, digests and sizes, schemas, settings,
            composition, engine, renderer and view API versions and validation digest, with the files' text when
            includeFiles. COMMERCE_THEME_EDIT or COMMERCE_THEME_PUBLISH and the store's scope.</description>
        <in-parameters>
            <parameter name="releaseId" required="true"/>
            <parameter name="includeFiles" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="manifest" type="Map"/>
            <parameter name="manifestDigest"/>
            <parameter name="files" type="Map"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/Themes.js').execute('exportThemeRelease', context)"/>
            <set field="manifest" from="out.manifest"/>
            <set field="manifestDigest" from="out.manifestDigest"/>
            <set field="files" from="out.files"/>
        </actions>
    </service>

    <!-- ===== live (PASS operations) ===== -->
    <service verb="get" noun="ShopPage" authenticate="anonymous-all" allow-remote="false">
        <description>getShopPage (impl-shop P2): a page of a published site's Shop mount (NotFound otherwise, and for a page
            kind the live path does not render yet): its status, the active release (null when none), the site's
            generation and the view contract v1 with its references, media and sources (ThemeView.js).</description>
        <in-parameters>
            <parameter name="input" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="result" type="Map"/>
        </out-parameters>
        <actions>
            <script>result = ec.resource.script("component://mr-mantle/service/mantle/public/ThemeView.js").execute("getShopPage", input)</script>
        </actions>
    </service>
    <service verb="get" noun="ShopThemeRelease" authenticate="anonymous-all" allow-remote="false">
        <description>getShopThemeRelease (impl-shop P2): the manifest text and digest of a published site's active Shop
            release, which must be the releaseId asked for (RELEASE_NOT_ACTIVE, NotFound). Over the authority, only for a
            registered frontend (PassAuthority's CLIENT_READS).</description>
        <in-parameters>
            <parameter name="input" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="result" type="Map"/>
        </out-parameters>
        <actions>
            <script>result = ec.resource.script("component://mr-mantle/service/mantle/public/Themes.js").execute("getShopThemeRelease", input)</script>
        </actions>
    </service>
    <service verb="get" noun="ShopThemeFiles" authenticate="anonymous-all" allow-remote="false">
        <description>getShopThemeFiles (impl-shop P2): up to 50 files of a published site's active Shop release (paths, a
            list or comma-separated), each read at its pinned version with its digest; a file whose text no longer matches is
            RELEASE_DAMAGED. Over the authority, only for a registered frontend.</description>
        <in-parameters>
            <parameter name="input" type="Map"/>
        </in-parameters>
        <out-parameters>
            <parameter name="result" type="Map"/>
        </out-parameters>
        <actions>
            <script>result = ec.resource.script("component://mr-mantle/service/mantle/public/Themes.js").execute("getShopThemeFiles", input)</script>
        </actions>
    </service>

    <!-- ===== pages and navigation (impl-commerce P4, X14; SitePages.js) =====
        A site is worked through its Shop mount's store (the user's organizations, a StoreStaff row's stores). Commerce's
        pages are PublicSitePage rows on the Shop mount; the Forum's guidelines and about pages stay Forum.js's. -->
    <service verb="find" noun="SitePages" allow-remote="false">
        <description>Commerce's pages of the sites of the user's stores (or one site): title, mount, route, locale, policy role,
            template, SEO, the published and scheduled versions, window, state and a failed scheduled publication; by title
            or route ignoring case, locale, role and state (draft, published, withdrawn, scheduled, failed), a page at a
            time. With sitePageId that page alone, with the menus that link to it. COMMERCE_VIEW and the site's store.</description>
        <in-parameters>
            <parameter name="sitePageId"/>
            <parameter name="siteId"/>
            <parameter name="term"/>
            <parameter name="locale"/>
            <parameter name="pageRole"/>
            <parameter name="state"/>
            <parameter name="pageIndex" type="Integer"/>
            <parameter name="pageSize" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="pages" type="List"/>
            <parameter name="pagesCount" type="Integer"/>
            <parameter name="pagesPageIndex" type="Integer"/>
            <parameter name="pagesPageSize" type="Integer"/>
            <parameter name="pagesPageMaxIndex" type="Integer"/>
            <parameter name="pagesPageRangeLow" type="Integer"/>
            <parameter name="pagesPageRangeHigh" type="Integer"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('findSitePages', context)"/>
            <set field="pages" from="out.pages"/>
            <set field="pagesCount" from="out.pagesCount"/>
            <set field="pagesPageIndex" from="out.pagesPageIndex"/>
            <set field="pagesPageSize" from="out.pagesPageSize"/>
            <set field="pagesPageMaxIndex" from="out.pagesPageMaxIndex"/>
            <set field="pagesPageRangeLow" from="out.pagesPageRangeLow"/>
            <set field="pagesPageRangeHigh" from="out.pagesPageRangeHigh"/>
        </actions>
    </service>
    <service verb="store" noun="SitePage" allow-remote="false">
        <description>A new page of a site's Shop (siteId, title, route, locale, template, policy role, SEO; its text a new page of
            the store's page space, which is made with restrictUpdate when the store has none), a page's binding fields
            (on a published or scheduled page a publication: COMMERCE_PUBLISH and expectedRevision, the page's publicationRevision
            advanced, live at once on a published page with the site's generation advanced), or a new version of its text (pageText,
            versionNote; with baseVersionName a page saved since by someone else answers conflict). Saving never publishes.
            Refuses a taken route (ROUTE_TAKEN) or role (ROLE_TAKEN), a Forum role (ROLE_RESERVED), a stale stamp or publication revision
            (REVISION_STALE), a store page space without restrictUpdate (SPACE_NOT_RESTRICTED) and values out of shape
            (VALUE_INVALID, SCHEME_REFUSED). COMMERCE_THEME_EDIT and the site's store.</description>
        <in-parameters>
            <parameter name="sitePageId"/>
            <parameter name="siteId"/>
            <parameter name="appMountId"/>
            <parameter name="title"/>
            <parameter name="routePath"/>
            <parameter name="locale"/>
            <parameter name="templateKey"/>
            <parameter name="pageRole"/>
            <parameter name="seoTitle"/>
            <parameter name="seoDescription"/>
            <parameter name="socialImageUrl"/>
            <parameter name="pageText" allow-html="any"/>
            <parameter name="versionNote"/>
            <parameter name="baseVersionName"/>
            <parameter name="force" type="Boolean"/>
            <parameter name="expectedLastUpdatedStamp"/>
            <parameter name="expectedRevision" type="Integer"/>
            <parameter name="changeReason"/>
        </in-parameters>
        <out-parameters>
            <parameter name="sitePageId"/>
            <parameter name="changed" type="List"/>
            <parameter name="generation" type="Integer"/>
            <parameter name="page" type="Map"/>
            <parameter name="versionName"/>
            <parameter name="currentVersionName"/>
            <parameter name="conflict" type="Boolean"/>
            <parameter name="conflictText"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('storeSitePage', context)"/>
            <set field="sitePageId" from="out.sitePageId"/>
            <set field="changed" from="out.changed"/>
            <set field="generation" from="out.generation"/>
            <set field="page" from="out.page"/>
            <set field="versionName" from="out.versionName"/>
            <set field="currentVersionName" from="out.currentVersionName"/>
            <set field="conflict" from="out.conflict"/>
            <set field="conflictText" from="out.conflictText"/>
        </actions>
    </service>
    <service verb="get" noun="SitePageHistory" allow-remote="false">
        <description>A page's saved versions (newest first; the published and the scheduled one marked) and its binding's activity
            from the audit log: who changed its route, locale, role, template, version or window, when and why.
            COMMERCE_VIEW and the site's store.</description>
        <in-parameters>
            <parameter name="sitePageId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="versions" type="List"/>
            <parameter name="activity" type="List"/>
            <parameter name="currentVersionName"/>
            <parameter name="publishedVersionName"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('getSitePageHistory', context)"/>
            <set field="versions" from="out.versions"/>
            <set field="activity" from="out.activity"/>
            <set field="currentVersionName" from="out.currentVersionName"/>
            <set field="publishedVersionName" from="out.publishedVersionName"/>
        </actions>
    </service>
    <service verb="find" noun="SiteNavigation" allow-remote="false">
        <description>A site's menus (each with its draft items, every destination checked now, and its active, scheduled and failed
            versions) and its redirects; the first site of the user's stores when none is named. COMMERCE_VIEW and the
            site's store.</description>
        <in-parameters>
            <parameter name="siteId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="siteId"/>
            <parameter name="siteName"/>
            <parameter name="appMountId"/>
            <parameter name="mountPath"/>
            <parameter name="menus" type="List"/>
            <parameter name="redirects" type="List"/>
            <parameter name="canEdit" type="Boolean"/>
            <parameter name="canPublish" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('findSiteNavigation', context)"/>
            <set field="siteId" from="out.siteId"/>
            <set field="siteName" from="out.siteName"/>
            <set field="appMountId" from="out.appMountId"/>
            <set field="mountPath" from="out.mountPath"/>
            <set field="menus" from="out.menus"/>
            <set field="redirects" from="out.redirects"/>
            <set field="canEdit" from="out.canEdit"/>
            <set field="canPublish" from="out.canPublish"/>
        </actions>
    </service>
    <service verb="store" noun="SiteNavigation" allow-remote="false">
        <description>A menu's draft on the site's Shop mount: a new menu (menuKey, locale, name), its name, an item added or changed
            (item: itemId, parentItemId, label, destinationTypeEnumId, destinationValue, visible), removed (removeItemId,
            with its children) or moved (moveItemId, direction up, down, in or out; at most 3 levels and 200 items); or a
            redirect's draft (redirect: redirectId, oldPath, destinationTypeEnumId, destinationValue, permanent, fromDate,
            thruDate, expectedRevision, changeReason) or its removal (removeRedirectId, a draft or failed one). Every
            destination is checked: a product public in the store, a store category, a published page, an enabled app of the
            site, a plain path of the site, an https address; refused are another scheme (SCHEME_REFUSED), a private BOSS
            address (PRIVATE_LINK), a reserved path (PATH_RESERVED), a draft product or page (DESTINATION_NOT_PUBLIC), a
            redirect off the site (REDIRECT_OFF_SITE), into a loop (REDIRECT_LOOP) or of a path redirected already
            (REDIRECT_TAKEN). expectedRevision is the menu's draftRevision. Nothing is live until publish#SiteNavigation.
            COMMERCE_MERCHANDISE and the site's store.</description>
        <in-parameters>
            <parameter name="siteId"/>
            <parameter name="navigationId"/>
            <parameter name="menuKey"/>
            <parameter name="locale"/>
            <parameter name="name"/>
            <parameter name="expectedRevision" type="Integer"/>
            <parameter name="item" type="Map"/>
            <parameter name="removeItemId"/>
            <parameter name="moveItemId"/>
            <parameter name="direction"/>
            <parameter name="redirect" type="Map"/>
            <parameter name="removeRedirectId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="navigationId"/>
            <parameter name="draftRevision" type="Integer"/>
            <parameter name="menu" type="Map"/>
            <parameter name="redirectId"/>
            <parameter name="revision" type="Integer"/>
            <parameter name="url"/>
            <parameter name="redirect" type="Map"/>
            <parameter name="removed" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('storeSiteNavigation', context)"/>
            <set field="navigationId" from="out.navigationId"/>
            <set field="draftRevision" from="out.draftRevision"/>
            <set field="menu" from="out.menu"/>
            <set field="redirectId" from="out.redirectId"/>
            <set field="revision" from="out.revision"/>
            <set field="url" from="out.url"/>
            <set field="redirect" from="out.redirect"/>
            <set field="removed" from="out.removed"/>
        </actions>
    </service>
    <service verb="publish" noun="SiteNavigation" allow-remote="false">
        <description>A menu's draft published as a version (navigationId; every destination checked again; from now it ends the
            active version, from a later date it waits for the publication job) or its active version withdrawn; or a
            redirect's draft published (redirectId; now or from its date) or withdrawn. expectedRevision is the menu's
            draftRevision or the redirect's revision (REVISION_STALE); operationKey (PostingOperation SiteNavigationPublish)
            answers a retry with the first result; a publish or withdrawal from now advances the site's generation.
            previewOnly answers the checks and the generation and writes nothing. COMMERCE_PUBLISH and the site's store.</description>
        <in-parameters>
            <parameter name="siteId"/>
            <parameter name="navigationId"/>
            <parameter name="redirectId"/>
            <parameter name="publishAction"/>
            <parameter name="fromDate"/>
            <parameter name="thruDate"/>
            <parameter name="expectedRevision" type="Integer"/>
            <parameter name="changeReason"/>
            <parameter name="operationKey"/>
            <parameter name="previewOnly" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="kind"/>
            <parameter name="navigationId"/>
            <parameter name="redirectId"/>
            <parameter name="state"/>
            <parameter name="url"/>
            <parameter name="generation" type="Integer"/>
            <parameter name="nextGeneration" type="Integer"/>
            <parameter name="revision" type="Integer"/>
            <parameter name="items" type="List"/>
            <parameter name="problem"/>
            <parameter name="scheduled" type="Boolean"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('publishSiteNavigation', context)"/>
            <set field="kind" from="out.kind"/>
            <set field="navigationId" from="out.navigationId"/>
            <set field="redirectId" from="out.redirectId"/>
            <set field="state" from="out.state"/>
            <set field="url" from="out.url"/>
            <set field="generation" from="out.generation"/>
            <set field="nextGeneration" from="out.nextGeneration"/>
            <set field="revision" from="out.revision"/>
            <set field="items" from="out.items"/>
            <set field="problem" from="out.problem"/>
            <set field="scheduled" from="out.scheduled"/>
            <set field="alreadyApplied" from="out.alreadyApplied"/>
        </actions>
    </service>
    <service verb="run" noun="ScheduledSitePublications" authenticate="false" allow-remote="false" transaction-timeout="1800">
        <description>The run_ScheduledSitePublications job: each page, menu version and redirect whose scheduled from date has
            come, revalidated and activated in its own transaction (run#ScheduledSitePublication); a failure is recorded on
            the item and the rest go on.</description>
        <in-parameters>
            <parameter name="limit" type="Integer"/>
        </in-parameters>
        <out-parameters>
            <parameter name="dueCount" type="Integer"/>
            <parameter name="activatedCount" type="Integer"/>
            <parameter name="failedCount" type="Integer"/>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('runScheduledSitePublications', context)"/>
            <set field="dueCount" from="out.dueCount"/>
            <set field="activatedCount" from="out.activatedCount"/>
            <set field="failedCount" from="out.failedCount"/>
            <set field="results" from="out.results"/>
        </actions>
    </service>
    <service verb="run" noun="ScheduledSitePublication" authenticate="false" allow-remote="false">
        <description>One scheduled page (kind page, id its sitePageId), menu version (menu, the navigationId and fromDate) or
            redirect (redirect, its redirectId), revalidated as the user who scheduled it (COMMERCE_PUBLISH and the store still
            theirs, the version or destinations still valid) and activated with the site's generation; a refusal is recorded on
            it, which the store's readiness lists, and what is live stays as it was. The job's step.</description>
        <in-parameters>
            <parameter name="kind" required="true"/>
            <parameter name="id" required="true"/>
            <parameter name="fromDate" type="Long"/>
        </in-parameters>
        <out-parameters>
            <parameter name="result" type="Map"/>
        </out-parameters>
        <actions>
            <set field="out" from="ec.resource.script('component://mr-mantle/service/mantle/public/SitePages.js').execute('runScheduledSitePublication', context)"/>
            <set field="result" from="out.result"/>
        </actions>
    </service>
</services>
