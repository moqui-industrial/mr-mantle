  <service verb="get" noun="SitePage" authenticate="anonymous-all" allow-remote="false">
    <description>A site's public page. The Forum's guidelines and about pages by their role, as before (Forum.js); Commerce's
      pages (impl-commerce P4, SitePages.js) by sitePageId, by a policy role (delivery, returns, privacy, terms) or by
      appMountId, routePath and locale: only in their window, only the binding's exact version when it is the page's
      published wiki version, the body as clean HTML. NotFound otherwise.</description>
    <in-parameters>
      <parameter name="input" type="Map"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const i = input || {}
        const commerce = !!(i.sitePageId || i.routePath || ['delivery', 'returns', 'privacy', 'terms'].includes(i.pageRole))
        result = ec.resource.script(commerce ? "component://mr-mantle/service/mantle/public/SitePages.js"
            : "component://mr-mantle/service/mantle/forum/Forum.js").execute("getSitePage", i)
      ]]></script>
    </actions>
  </service>
