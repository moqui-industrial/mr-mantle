  <service verb="process" noun="Inbound" authenticate="anonymous-all" allow-remote="false">
    <implements service="org.moqui.EmailServices.process#EmailEca"/>
    <description>The forum's email ECA: a stored inbound email addressed to a forum route becomes a reply or new topic by
      its verified, gateway-authenticated sender, or a recorded refusal. Other mail is left alone.</description>
    <in-parameters>
      <parameter name="emailAccountId"/>
      <parameter name="emailMessageId"/>
      <parameter name="spamVerdict" type="Map"><description>The mail gateway's verdict of the message, {spam, reason}, when the
        caller has it (process#JunkInbound gives it for mail the listener put in Junk); without it the verdict fields on the
        message (X-Spam-Flag, X-Spam-Status, X-Spam) say. Spam from an account is held for review (the gate's mail-verdict),
        never posted, and its sender is not answered.</description></parameter>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').processInbound({emailAccountId,emailMessageId,headers,fields,bodyPartList,message,spamVerdict})}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="handle" noun="StoredEmail" authenticate="false" allow-remote="false">
    <description>For the EmailMessage rule (entity/ForumInbound.eecas.xml): a received message stored in a Junk folder (the
      mail listener puts the gateway's spam there, and no email rule runs for it) is given to process#JunkInbound after the
      commit of the store, in a transaction of its own. Any other message is left alone. Never fails the store: a failure
      is logged.</description>
    <in-parameters>
      <parameter name="emailMessageId"/>
      <parameter name="emailFolderId"/>
    </in-parameters>
    <out-parameters><parameter name="junk" type="Boolean"/></out-parameters>
    <actions>
      <script><![CDATA[
        junk = false
        if (!emailMessageId || !emailFolderId) return
        ec.message.pushErrors()
        try {
          const folder = ec.entity.find('moqui.basic.email.EmailFolder').condition('emailFolderId', emailFolderId).disableAuthz().one()
          if (folder?.folderKindEnumId !== 'EfkJunk') return
          junk = true
          const name = 'mantle.forum.DeliveryServices.process#JunkInbound'
          let later = false
          try {
            ec.service.special().name(name).parameters({emailMessageId}).registerOnCommit()
            later = true
          } catch (err) {
            // no transaction in place: the store is committed already
          }
          if (!later) ec.service.sync().name(name).parameter('emailMessageId', emailMessageId).requireNewTransaction(true).disableAuthz().call()
        } catch (err) {
          ec.logger.error('Email message ' + emailMessageId + ' in Junk was not given to the forum: ' + (err && err.message ? err.message : err))
        } finally {
          ec.message.clearErrors()
          ec.message.popErrors()
        }
      ]]></script>
    </actions>
  </service>
  <service verb="process" noun="JunkInbound" authenticate="false" allow-remote="false">
    <description>A message the mail listener stored in a Junk folder, when it is to a forum address: processed as
      process#Inbound does with the spam verdict, from the stored message (its header fields and text; its files are not
      read). So a reply, a message to a list and a report by mail that the gateway marked as spam is held for review, not
      posted and not lost. Not forum mail, and a message in another folder, is left alone.</description>
    <in-parameters><parameter name="emailMessageId" required="true"/></in-parameters>
    <out-parameters><parameter name="result" type="Map"/></out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').processJunk(emailMessageId)}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
