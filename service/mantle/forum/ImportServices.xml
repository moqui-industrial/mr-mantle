  <service verb="handle" noun="VerifiedAddress" authenticate="false" allow-remote="false">
    <description>For the VerifiedAddress rule (entity/ForumInbound.eecas.xml): after the commit of the row, in a transaction
      of its own, claim#VerifiedAddress. Never fails the write: a failure is logged.</description>
    <in-parameters><parameter name="userId"/></in-parameters>
    <actions>
      <script><![CDATA[
        if (!userId) return
        ec.message.pushErrors()
        try {
          const name = 'mantle.forum.ImportServices.claim#VerifiedAddress'
          let later = false
          try {
            ec.service.special().name(name).parameters({userId}).registerOnCommit()
            later = true
          } catch (err) {
            // no transaction in place: the write is committed already
          }
          if (!later) ec.service.sync().name(name).parameter('userId', userId).requireNewTransaction(true).disableAuthz().call()
        } catch (err) {
          ec.logger.error('The verified address of ' + userId + ' was not given to the forum: ' + (err && err.message ? err.message : err))
        } finally {
          ec.message.clearErrors()
          ec.message.popErrors()
        }
      ]]></script>
    </actions>
  </service>
  <service verb="claim" noun="VerifiedAddress" authenticate="false" allow-remote="false">
    <description>An account verified its address: the posts of list archives whose author had that address become the
      account's (in every site; the profile with no account ends), and the list messages held for that address are
      posted as the account, each through the forum's gate. A held report is filed by its sender (Smithy's
      claimHeldReport), not here.</description>
    <in-parameters><parameter name="userId" required="true"/></in-parameters>
    <out-parameters><parameter name="claimed" type="Integer"/><parameter name="posted" type="Integer"/></out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').lists.claimVerified(userId))}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
