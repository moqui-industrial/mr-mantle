<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="get" noun="PayRateAccess">
        <description>Whose pay rate the user may read and set. An employee is a party with a PartyRelationship PrtEmployee from
            it (read without the user's entity filters, so a filter that hides an employment cannot show a pay rate). An
            employee's pay rate (the vendor rates and vendorRateAmountId of the person's time entries, the person's own worker
            pay rates RaprVendor, a staffing candidate's cost rate) is read with PAYROLL_VIEW and set with PAYROLL_EDIT (ADMIN
            holds both): canViewPay and canEditPay. The rates of the others (contractors) are TIME_ENTRY_RATE's, as the callers
            check. For the people given (partyIdList), employment is now: employeePartyIds, and hiddenPartyIds and
            lockedPartyIds the employees whose pay rate the user may not read or set (empty with the permission). For time
            entries (entryList of {key, partyId, date}: the entry's id, its person and its date, fromDate else thruDate) the
            worker counts as an employee when employed on the entry's date or now, so an employee's past pay stays hidden after
            the employment ends: employeeKeys, hiddenKeys and lockedKeys. With organizationPartyId only the employments at that
            employer count (the worker invoice's refusal of an employee's time, InvoiceServices create#TimeEntryInvoiceItems and
            ApprovedTimeBilling: worker invoices are for contractors, the user's call of Nov 12, 2026). One query for all the
            people. Answers only: it adds no error, so a caller asks it in its own transaction.</description>
        <in-parameters>
            <parameter name="partyIdList" type="List"/>
            <parameter name="organizationPartyId"><description>Only employments at this employer</description></parameter>
            <parameter name="entryList" type="List"><parameter name="entry" type="Map"><description>key, partyId, date</description></parameter></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="employeePartyIds" type="List"/>
            <parameter name="hiddenPartyIds" type="List"/>
            <parameter name="lockedPartyIds" type="List"/>
            <parameter name="employeeKeys" type="List"/>
            <parameter name="hiddenKeys" type="List"/>
            <parameter name="lockedKeys" type="List"/>
            <parameter name="canViewPay" type="Boolean"/>
            <parameter name="canEditPay" type="Boolean"/>
        </out-parameters>
        <actions><script><![CDATA[
            canViewPay = !!ec.user.userId && ec.user.hasPermission('PAYROLL_VIEW')
            canEditPay = !!ec.user.userId && ec.user.hasPermission('PAYROLL_EDIT')
            const millis = (value) => {
                if (value == null || value === '') return null
                if (typeof value === 'number') return value
                if (value instanceof Date) return value.getTime()
                const text = String(value)
                return /^-?\d+$/.test(text) ? Number(text) : Date.parse(text)
            }
            const entries = Array.from(entryList || []).filter((entry) => entry && entry.partyId)
            const people = Array.from(new Set(Array.from(partyIdList || []).filter((id) => id).map(String)
                    .concat(entries.map((entry) => String(entry.partyId)))))
            // every employment of the people, ended ones too, in one query
            const spans = new Map()
            let employmentFind = ec.entity.find('mantle.party.PartyRelationship').condition('relationshipTypeEnumId', 'PrtEmployee')
                    .condition('fromPartyId', 'in', people).selectField('fromPartyId,fromDate,thruDate').disableAuthz()
            if (organizationPartyId) employmentFind = employmentFind.condition('toPartyId', organizationPartyId)
            if (people.length) for (const row of Array.from(employmentFind.list())) {
                if (!spans.has(row.fromPartyId)) spans.set(row.fromPartyId, [])
                spans.get(row.fromPartyId).push([millis(row.fromDate), millis(row.thruDate)])
            }
            const nowMs = millis(ec.user.nowTimestamp)
            const employedOn = (partyId, at) => at != null && (spans.get(partyId) || []).some(([from, thru]) => (from == null || from <= at) && (thru == null || thru > at))
            employeePartyIds = Array.from(new Set(Array.from(partyIdList || []).filter((id) => id).map(String))).filter((id) => employedOn(id, nowMs))
            hiddenPartyIds = canViewPay ? [] : employeePartyIds
            lockedPartyIds = canEditPay ? [] : employeePartyIds
            employeeKeys = entries.filter((entry) => employedOn(String(entry.partyId), nowMs) || employedOn(String(entry.partyId), millis(entry.date)))
                    .map((entry) => entry.key)
            hiddenKeys = canViewPay ? [] : employeeKeys
            lockedKeys = canEditPay ? [] : employeeKeys
        ]]></script></actions>
    </service>

    <service verb="create" noun="Employment">
        <description>An employment: the PrtEmployee relationship from the employee to the employer and its Employment row. Refuses
            an overlapping employment of the two (a PrtEmployee relationship: another relationship between them, a contractor's or a
            contact's, does not count, impl-people F3) and a position not of the employer. IronStone People hires through
            mantle.humanres.PeopleServices.hire#Employee, which checks the caller and calls this.</description>
        <in-parameters>
            <auto-parameters entity-name="mantle.party.PartyRelationship" include="nonpk"/>
            <auto-parameters entity-name="mantle.humanres.employment.Employment" include="nonpk"/>
            <parameter name="fromPartyId" required="true"/>
            <parameter name="toPartyId" required="true"/>
            <parameter name="fromRoleTypeId" default-value="Employee"/>
            <parameter name="relationshipTypeEnumId" default-value="PrtEmployee"/>
            <parameter name="toRoleTypeId" default-value="OrgEmployer"/>
            <parameter name="fromDate" default="ec.user.nowTimestamp"/>
        </in-parameters>
        <out-parameters><parameter name="partyRelationshipId"/></out-parameters>
        <actions>
            <!-- one employment at a time per person and employer: an overlapping PrtEmployee relationship is refused; a contractor's
                (PrtAgent), a contact's or another relationship between the two is not an employment and does not block a hire
                (IronStone People PE-02, impl-people F3) -->
            <entity-find entity-name="mantle.party.PartyRelationship" list="partyRelList">
                <econdition field-name="relationshipTypeEnumId" value="PrtEmployee"/>
                <econdition field-name="fromPartyId" from="fromPartyId"/>
                <econdition field-name="toPartyId" from="toPartyId"/>
                <econditions combine="or">
                    <econdition field-name="fromDate" operator="greater-equals" from="fromDate"/>
                    <econdition field-name="thruDate" operator="greater" from="fromDate"/>
                    <econditions>
                        <econdition field-name="fromDate" operator="less" from="fromDate"/>
                        <econdition field-name="thruDate" operator="is-null"/>
                    </econditions>
                </econditions>
            </entity-find>

            <if condition="(partyRelList?.length > 0)">
                <return error="true" message="Cannot have overlapping employments."/>
            </if>

            <if condition="emplPositionId">
                <!-- If a position is specified, make sure it is valid for the toPartyId -->
                <entity-find-one entity-name="mantle.humanres.position.EmplPosition" value-field="emplPosition">
                    <field-map field-name="emplPositionId"/>
                </entity-find-one>
                <if condition="!emplPosition || (emplPosition.organizationPartyId &amp;&amp; toPartyId != emplPosition.organizationPartyId)">
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    <set field="orgName" from="ec.resource.expand('PartyNameTemplate','',toParty)"/>
                    <return error="true" message="Position ${emplPosition.description} is not valid for ${orgName}"/>
                </if>
            </if>
            <service-call name="create#mantle.party.PartyRelationship" in-map="context" out-map="context"/>
            <service-call name="create#mantle.humanres.employment.Employment" in-map="context"/>
        </actions>
    </service>
    <service verb="update" noun="Employment">
        <in-parameters>
            <parameter name="partyRelationshipId" required="true"/>
            <auto-parameters entity-name="mantle.party.PartyRelationship" include="nonpk"/>
            <auto-parameters entity-name="mantle.humanres.employment.Employment" include="nonpk"/>
            <!-- use PartyContent instead
            <parameter name="identityDocumentFile" type="FileItem"/>
            <parameter name="emplAuthzDocumentFile" type="FileItem"/>
            -->
        </in-parameters>
        <actions>
            <!-- use PartyContent instead
            <if condition="identityDocumentFile != null &amp;&amp; identityDocumentFile.size &gt; 0">
                <if condition="!identityLocation">
                    <set field="filename" from="identityDocumentFile.getName()"/>
                    <set field="contentRoot" from="ec.user.getPreference('mantle.content.root') || 'dbresource://mantle/content'"/>
                    <set field="identityLocation" value="${contentRoot}/employment/${partyRelationshipId}/identity/${filename}"/>
                </if>
                <set field="docRr" from="ec.resource.getLocationReference(identityLocation)"/>
                <script>
                    fileStream = identityDocumentFile.getInputStream()
                    try { docRr.putStream(fileStream) } finally { fileStream.close() }
                </script>
            </if>
            <if condition="emplAuthzDocumentFile != null &amp;&amp; emplAuthzDocumentFile.size &gt; 0">
                <if condition="!emplAuthzLocation">
                    <set field="filename" from="emplAuthzDocumentFile.getName()"/>
                    <set field="contentRoot" from="ec.user.getPreference('mantle.content.root') || 'dbresource://mantle/content'"/>
                    <set field="emplAuthzLocation" value="${contentRoot}/employment/${partyRelationshipId}/emplAuthz/${filename}"/>
                </if>
                <set field="docRr" from="ec.resource.getLocationReference(emplAuthzLocation)"/>
                <script>
                    fileStream = emplAuthzDocumentFile.getInputStream()
                    try { docRr.putStream(fileStream) } finally { fileStream.close() }
                </script>
            </if>
            -->

            <entity-find entity-name="mantle.party.PartyRelationship" list="partyRelList">
                <econdition field-name="partyRelationshipId" operator="not-equals" from="partyRelationshipId"/>
                <!-- of PrtEmployee alone, as create#Employment (F3) -->
                <econdition field-name="relationshipTypeEnumId" value="PrtEmployee"/>
                <econdition field-name="fromPartyId" from="fromPartyId"/>
                <econdition field-name="toPartyId" from="toPartyId"/>
                <econditions combine="or">
                    <econdition field-name="fromDate" operator="greater-equals" from="fromDate"/>
                    <econdition field-name="thruDate" operator="greater" from="fromDate"/>
                    <econditions>
                        <econdition field-name="fromDate" operator="less" from="fromDate"/>
                        <econdition field-name="thruDate" operator="is-null"/>
                    </econditions>
                </econditions>
            </entity-find>

            <if condition="(partyRelList?.length > 0)">
                <return error="true" message="Cannot have overlapping employments."/>
            </if>

            <if condition="emplPositionId">
                <!-- If a position is specified, make sure it is valid for the toPartyId -->
                <entity-find-one entity-name="mantle.humanres.position.EmplPosition" value-field="emplPosition">
                    <field-map field-name="emplPositionId"/>
                </entity-find-one>
                <if condition="!emplPosition || (emplPosition.organizationPartyId &amp;&amp; toPartyId != emplPosition.organizationPartyId)">
                    <entity-find-one entity-name="mantle.party.PartyDetail" value-field="toParty">
                        <field-map field-name="partyId" from="toPartyId"/>
                    </entity-find-one>
                    <set field="orgName" from="ec.resource.expand('PartyNameTemplate','',toParty)"/>
                    <return error="true" message="Position ${emplPosition.description} is not valid for ${orgName}"/>
                </if>
            </if>
            <service-call name="update#mantle.party.PartyRelationship" in-map="context"/>
            <service-call name="store#mantle.humanres.employment.Employment" in-map="context"/>
        </actions>
    </service>
    <service verb="delete" noun="Employment">
        <in-parameters>
            <parameter name="partyRelationshipId" required="true"/>
            <parameter name="fromRoleTypeId" default-value="Employee"/>
            <parameter name="relationshipTypeEnumId" default-value="PrtEmployee"/>
            <parameter name="toRoleTypeId" default-value="OrgEmployer"/>
        </in-parameters>
        <actions>
            <entity-find-one entity-name="mantle.party.PartyRelationship" value-field="ptyRel"/>
            <entity-find-one entity-name="mantle.humanres.employment.Employment" value-field="employment"/>
            <if condition="ptyRel &amp;&amp; employment &amp;&amp; (ptyRel.fromRoleTypeId == fromRoleTypeId) &amp;&amp;
                    (ptyRel.relationshipTypeEnumId == relationshipTypeEnumId) &amp;&amp;
                    (ptyRel.toRoleTypeId == toRoleTypeId)"><then>
                <set field="relatedEmpls" from="employment.findRelatedFk(['mantle.party.PartyRelationship'])"/>
                <!-- TODO: Ignore 'mantle.party.PartyRelationship' below and do a deleteWithCascade since party settings probalby shouldn't stop deletion -->
                <set field="relatedPtyRels" from="ptyRel.findRelatedFk(['mantle.humanres.employment.Employment'])"/>
                <iterate list="Array.from(relatedEmpls).concat(Array.from(relatedPtyRels))" entry="relatedValue">
                    <message error="true">Found ${relatedValue.getEntityNamePretty()}. Cannot delete employment.</message>
                </iterate>
                <check-errors/>
                <service-call name="delete#mantle.humanres.employment.Employment" in-map="context"/>
                <service-call name="delete#mantle.party.PartyRelationship" in-map="context"/>
            </then><else>
                <return error="true" message="Cannot find employment relationship"/>
            </else></if>
        </actions>
    </service>
    <service verb="create" noun="EmploymentSalary">
        <description>Create an EmploymentSalary record, getting defaults and checking against min/max amounts on
            PayGrade record from EmplPosition for Employment (a warning outside the band). Extended in IronStone People P23 (F4)
            and its review (the user's call of Nov 12, 2026): needs PAYROLL_EDIT (PERMISSION_DENIED) and a payroll reader of the
            employment's employer (PAYROLL_VIEW in their People scope; else RECORD_UNAVAILABLE); sets an employment's first salary
            only: an employment with a salary changes it through the People pay change (PeopleServices.apply#EmploymentChange,
            changeKind pay), which is approved before it applies (PAY_CHANGE_REQUIRED). A holder of PAYROLL_REPAIR (ADMIN's)
            sets one at any employer for data repair, with comments as its reason (REASON_REQUIRED), kept in the audit log. The
            salary in effect on fromDate ends there (dated rows, never two in effect); a salary from the same moment
            (SALARY_EXISTS) or one from a later date set already (SALARY_SCHEDULED) is refused (PayrollAssignments.js
            writeSalary, which the approved pay change applies through). P24 review (the user's call of Nov 12, 2026): a first salary
            asked by a payroll editor waits for approval like any pay change: it is asked as one (PeopleServices.apply#EmploymentChange,
            changeKind pay, comments its reason, else "First salary"; the pay change's checks of the currency and the pay frequency)
            and written when the employer's payroll approvers approve it (employmentChangeId, applied false); only a holder of
            PAYROLL_REPAIR writes at once (applied true).</description>
        <in-parameters>
            <parameter name="partyRelationshipId" required="true"/>
            <auto-parameters entity-name="mantle.humanres.employment.EmploymentSalary" include="nonpk"/>
            <parameter name="fromDate" default="ec.user.nowTimestamp"/>
        </in-parameters>
        <out-parameters>
            <parameter name="fromDate"/>
            <parameter name="applied" type="Boolean"><description>The salary was written (a repair); else it waits as the pay
                change employmentChangeId</description></parameter>
            <parameter name="employmentChangeId"/>
            <parameter name="waitingText"/>
        </out-parameters>
        <actions>
            <!-- P23: the caller first, so a refused caller reads nothing of the grade's band in a warning -->
            <script>ec.resource.script('component://mr-mantle/service/mantle/humanres/PayrollAssignments.js').execute('salaryAccess', context)</script>
            <entity-find-one entity-name="mantle.humanres.employment.Employment" value-field="employment"/>
            <if condition="!timePeriodTypeId"><set field="timePeriodTypeId" from="employment.timePeriodTypeId"/></if>
            <if condition="!payGradeId">
                <entity-find-related-one value-field="employment" relationship-name="mantle.humanres.position.EmplPosition"
                        to-value-field="emplPosition"/>
                <set field="payGradeId" from="emplPosition?.payGradeId"/>
            </if>
            <if condition="payGradeId">
                <entity-find entity-name="mantle.humanres.rate.PayGradeSalary" list="payGradeSalaryList">
                    <date-filter/><econdition field-name="payGradeId"/>
                    <econdition field-name="timePeriodTypeId" ignore-if-empty="true"/>
                    <order-by field-name="-fromDate"/>
                </entity-find>
                <if condition="(payGradeSalaryList?.length > 0)">
                    <set field="payGradeSalary" from="payGradeSalaryList[0]"/>
                    <if condition="!timePeriodTypeId"><set field="timePeriodTypeId" from="payGradeSalary.timePeriodTypeId"/></if>
                    <if condition="!currencyUomId"><set field="currencyUomId" from="payGradeSalary.currencyUomId"/></if>
                    <if condition="!amount"><set field="amount" from="payGradeSalary.amount"/></if>
                    <if condition="payGradeSalary.minAmount != null &amp;&amp; !toDecimal(payGradeSalary.minAmount).isZero() &amp;&amp; amount != null &amp;&amp; toDecimal(amount).compare(payGradeSalary.minAmount) &lt; 0">
                        <message>Warning: salary amount ${amount} is less than pay grade minimum amount (${payGradeSalary.minAmount})</message></if>
                    <if condition="payGradeSalary.maxAmount != null &amp;&amp; !toDecimal(payGradeSalary.maxAmount).isZero() &amp;&amp; amount != null &amp;&amp; toDecimal(amount).compare(payGradeSalary.maxAmount) &gt; 0">
                        <message>Warning: salary amount ${amount} is greater than pay grade maximum amount (${payGradeSalary.maxAmount})</message></if>
                </if>
            </if>

            <set field="written" from="ec.resource.script('component://mr-mantle/service/mantle/humanres/PayrollAssignments.js').execute('createSalary', context)"/>
            <set field="fromDate" from="written.fromDate"/>
            <set field="applied" from="!!written.applied"/>
            <set field="employmentChangeId" from="written.employmentChangeId"/>
            <set field="waitingText" from="written.waitingText"/>
        </actions>
    </service>


    <!-- Payroll TimePeriod services -->
    <!-- TODO: change to handle PayrollWeek, PayrollBiWeek, etc based on some configuration of what the org will actually use; or this may not be needed at all and TimePeriod records can be created as needed for payroll processing -->
    <service verb="check" noun="NextPayrollTimePeriods">
        <description>
            Ensure that at least current and next TimePeriods exist for PayrollMonth, PayrollQuarter (3 months), PayrollYear.
            If no time periods exist creates fiscal time periods based on calendar (ie fiscal year matches calendar year).
            If time periods do exist but not next time periods, adds next time period starting next day after current.
            This should be run once per month to ensure the next time period exists.
        </description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="basisDate" type="Date" default="new Date(Number(ec.user.nowTimestamp)).toISOString().slice(0, 10)"/>
        </in-parameters>
        <actions>
            <!-- A date reaches a script as epoch millis text (UTC midnight for a Date field); calendar steps are done in UTC on
                yyyy-MM-dd text (see create#TimePeriod in TimeServices), and plusMonths clamps the day as Calendar.add does -->
            <script><![CDATA[
                function dateOf(value) {
                    const text = String(value)
                    if (/^-?\d+$/.test(text)) { const at = new Date(Number(text)); return new Date(Date.UTC(at.getUTCFullYear(), at.getUTCMonth(), at.getUTCDate())) }
                    const [y, m, d] = text.slice(0, 10).split('-').map(Number)
                    return new Date(Date.UTC(y, m - 1, d))
                }
                function textOf(dt) { return dt.toISOString().slice(0, 10) }
                function plusDays(dt, n) { return new Date(Date.UTC(dt.getUTCFullYear(), dt.getUTCMonth(), dt.getUTCDate() + n)) }
                function plusMonths(dt, n) {
                    const first = new Date(Date.UTC(dt.getUTCFullYear(), dt.getUTCMonth() + n, 1))
                    const last = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 0)).getUTCDate()
                    return new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), Math.min(dt.getUTCDate(), last)))
                }
                // the last day of the period that starts on the first of the month after adding months and 5 days to a thru date
                function nextThru(thruText, months) {
                    const moved = plusDays(plusMonths(dateOf(thruText), months), 5)
                    return textOf(plusDays(new Date(Date.UTC(moved.getUTCFullYear(), moved.getUTCMonth(), 1)), -1))
                }
                function nextFrom(fromText, months) {
                    const moved = plusDays(plusMonths(dateOf(fromText), months), 5)
                    return textOf(new Date(Date.UTC(moved.getUTCFullYear(), moved.getUTCMonth(), 1)))
                }
                function yearOf(text) { return dateOf(text).getUTCFullYear() }
                function millisOf(text) { return String(dateOf(text).getTime()) }
                basisText = textOf(dateOf(basisDate))
                basisYear = yearOf(basisText)
                basisMonth = dateOf(basisText).getUTCMonth()
            ]]></script>
            <entity-find-one entity-name="mantle.party.Organization" value-field="organization">
                <field-map field-name="partyId" from="organizationPartyId"/></entity-find-one>

            <!-- start with PayrollYear and go down so we have parentPeriodId -->
            <entity-find entity-name="mantle.party.time.TimePeriod" list="currentYearList"><date-filter valid-date="millisOf(basisText)"/>
                <econdition field-name="partyId" from="organizationPartyId"/><econdition field-name="timePeriodTypeId" value="PayrollYear"/></entity-find>
            <if condition="!currentYearList?.length">
                <!-- no current year... assume fiscal year is calendar year and create one automatically -->
                <script>yearFrom = basisYear + '-01-01'; yearThru = basisYear + '-12-31'</script>
                <service-call name="create#mantle.party.time.TimePeriod" out-map="createTpOut"
                        in-map="{timePeriodTypeId:'PayrollYear', partyId:organizationPartyId,
                            periodNum:yearOf(yearFrom), beginningBalance:0, endingBalance:0,
                            periodName:(organization.organizationName + ' ' + yearOf(yearFrom)),
                            fromDate:yearFrom, thruDate:yearThru, isClosed:'N'}"/>
                <set field="yearPeriodId" from="createTpOut.timePeriodId"/>

                <else>
                    <script>yearFrom = textOf(dateOf(currentYearList[0].fromDate)); yearThru = textOf(dateOf(currentYearList[0].thruDate))</script>
                    <set field="yearPeriodId" from="currentYearList[0].timePeriodId"/>
                </else>
            </if>

            <!-- current quarter -->
            <entity-find entity-name="mantle.party.time.TimePeriod" list="currentQuarterList"><date-filter valid-date="millisOf(basisText)"/>
                <econdition field-name="partyId" from="organizationPartyId"/><econdition field-name="timePeriodTypeId" value="PayrollQuarter"/></entity-find>
            <if condition="!currentQuarterList?.length">
                <!-- no current quarter... assume fiscal year is calendar year with 4 3-month quarters and create one automatically -->
                <script>
                    quarterNumber = Math.trunc(basisMonth / 3)
                    quarterFrom = textOf(new Date(Date.UTC(basisYear, quarterNumber * 3, 1)))
                    quarterThru = textOf(plusDays(new Date(Date.UTC(basisYear, (quarterNumber + 1) * 3, 1)), -1))
                </script>
                <service-call name="create#mantle.party.time.TimePeriod" out-map="createTpOut"
                        in-map="{parentPeriodId:yearPeriodId, timePeriodTypeId:'PayrollQuarter', partyId:organizationPartyId,
                            periodNum:(quarterNumber + 1), beginningBalance:0, endingBalance:0,
                            periodName:(organization.organizationName + ' ' + yearOf(quarterFrom) + 'Q' + (quarterNumber + 1)),
                            fromDate:quarterFrom, thruDate:quarterThru, isClosed:'N'}"/>
                <set field="quarterPeriodId" from="createTpOut.timePeriodId"/>

                <else>
                    <script>quarterFrom = textOf(dateOf(currentQuarterList[0].fromDate)); quarterThru = textOf(dateOf(currentQuarterList[0].thruDate))</script>
                    <set field="quarterPeriodId" from="currentQuarterList[0].timePeriodId"/>
                </else>
            </if>

            <!-- current month -->
            <entity-find entity-name="mantle.party.time.TimePeriod" list="currentMonthList"><date-filter valid-date="millisOf(basisText)"/>
                <econdition field-name="partyId" from="organizationPartyId"/><econdition field-name="timePeriodTypeId" value="PayrollMonth"/></entity-find>
            <if condition="!currentMonthList?.length">
                <!-- no current month... create one automatically -->
                <script>
                    monthNumber = basisMonth
                    monthFrom = textOf(new Date(Date.UTC(basisYear, basisMonth, 1)))
                    monthThru = textOf(new Date(Date.UTC(basisYear, basisMonth + 1, 0)))
                </script>
                <service-call name="create#mantle.party.time.TimePeriod" out-map="createTpOut"
                        in-map="{parentPeriodId:quarterPeriodId, timePeriodTypeId:'PayrollMonth', partyId:organizationPartyId,
                            periodNum:monthNumber+1, beginningBalance:0, endingBalance:0,
                            periodName:(organization.organizationName + ' ' + yearOf(monthFrom) + '-' + (monthNumber + 1)),
                            fromDate:monthFrom, thruDate:monthThru, isClosed:'N'}"/>
                <set field="monthPeriodId" from="createTpOut.timePeriodId"/>

                <else>
                    <script>monthFrom = textOf(dateOf(currentMonthList[0].fromDate)); monthThru = textOf(dateOf(currentMonthList[0].thruDate))</script>
                    <set field="monthPeriodId" from="currentMonthList[0].timePeriodId"/>
                </else>
            </if>

            <!-- next year -->
            <!-- based on current year see if next exists and if not add one starting the day after and one year long -->
            <script>nextYearFrom = textOf(plusMonths(dateOf(yearFrom), 12))</script>
            <entity-find entity-name="mantle.party.time.TimePeriod" list="nextYearList"><date-filter valid-date="millisOf(nextYearFrom)"/>
                <econdition field-name="partyId" from="organizationPartyId"/><econdition field-name="timePeriodTypeId" value="PayrollYear"/></entity-find>
            <if condition="!nextYearList?.length">
                <script>nextYearThru = nextThru(yearThru, 12)</script>
                <set field="nextYearPeriodName" from="`${organization.organizationName} ${yearOf(nextYearFrom)}`"/>
                <service-call name="create#mantle.party.time.TimePeriod" out-map="createTpOut"
                        in-map="{previousPeriodId:yearPeriodId, timePeriodTypeId:'PayrollYear', partyId:organizationPartyId,
                            beginningBalance:0, endingBalance:0, periodNum:yearOf(nextYearFrom),
                            periodName:nextYearPeriodName, fromDate:nextYearFrom,
                            thruDate:nextYearThru, isClosed:'N'}"/>
                <set field="nextYearPeriodId" from="createTpOut.timePeriodId"/>

                <else>
                    <script>nextYearFrom = textOf(dateOf(nextYearList[0].fromDate)); nextYearThru = textOf(dateOf(nextYearList[0].thruDate))</script>
                    <set field="nextYearPeriodId" from="nextYearList[0].timePeriodId"/>
                </else>
            </if>

            <!-- next quarter, may be in current or next year -->
            <script>nextQuarterFrom = nextFrom(quarterFrom, 3)</script>
            <entity-find entity-name="mantle.party.time.TimePeriod" list="nextQuarterList"><date-filter valid-date="millisOf(nextQuarterFrom)"/>
                <econdition field-name="partyId" from="organizationPartyId"/><econdition field-name="timePeriodTypeId" value="PayrollQuarter"/></entity-find>
            <if condition="!nextQuarterList?.length">
                <set field="parentPeriodId" from="(nextQuarterFrom &lt; yearThru) ? yearPeriodId : nextYearPeriodId"/>
                <script>
                    nextQuarterThru = nextThru(quarterThru, 3)
                    nextQuarterNumber = Math.trunc(dateOf(nextQuarterFrom).getUTCMonth() / 3)
                </script>
                <set field="nextQuarterPeriodName" from="`${organization.organizationName} ${yearOf(nextQuarterFrom)}Q${nextQuarterNumber + 1}`"/>
                <service-call name="create#mantle.party.time.TimePeriod" out-map="createTpOut"
                        in-map="{parentPeriodId:parentPeriodId, previousPeriodId:quarterPeriodId,
                            timePeriodTypeId:'PayrollQuarter', partyId:organizationPartyId, beginningBalance:0,
                            endingBalance:0, periodNum:nextQuarterNumber+1, periodName:nextQuarterPeriodName,
                            fromDate:nextQuarterFrom, thruDate:nextQuarterThru, isClosed:'N'}"/>
                <set field="nextQuarterPeriodId" from="createTpOut.timePeriodId"/>

                <else>
                    <script>nextQuarterFrom = textOf(dateOf(nextQuarterList[0].fromDate)); nextQuarterThru = textOf(dateOf(nextQuarterList[0].thruDate))</script>
                    <set field="nextQuarterPeriodId" from="nextQuarterList[0].timePeriodId"/>
                </else>
            </if>

            <!-- next month, may be in current or next quarter -->
            <script>nextMonthFrom = nextFrom(monthFrom, 1)</script>
            <entity-find entity-name="mantle.party.time.TimePeriod" list="nextMonthList"><date-filter valid-date="millisOf(nextMonthFrom)"/>
                <econdition field-name="partyId" from="organizationPartyId"/><econdition field-name="timePeriodTypeId" value="PayrollMonth"/></entity-find>
            <if condition="!nextMonthList?.length">
                <set field="parentPeriodId" from="(nextMonthFrom &lt; quarterThru) ? quarterPeriodId : nextQuarterPeriodId"/>
                <script>
                    nextMonthNumber = dateOf(nextMonthFrom).getUTCMonth()
                    nextMonthThru = nextThru(monthThru, 1)
                </script>
                <set field="nextMonthPeriodName" from="`${organization.organizationName} ${yearOf(nextMonthFrom)}-${nextMonthNumber + 1}`"/>
                <service-call name="create#mantle.party.time.TimePeriod" out-map="createTpOut"
                        in-map="{parentPeriodId:parentPeriodId, previousPeriodId:monthPeriodId,
                            timePeriodTypeId:'PayrollMonth', partyId:organizationPartyId, beginningBalance:0,
                            endingBalance:0, periodNum:nextMonthNumber+1, periodName:nextMonthPeriodName,
                            fromDate:nextMonthFrom, thruDate:nextMonthThru, isClosed:'N'}"/>
            </if>
        </actions>
    </service>
</services>
