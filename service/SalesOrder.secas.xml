<!-- Sales' storeless confirmation (IronStone Sales design §16, §13.1; impl-sales P11, X1, F15, F16): once a storeless sales order of
    Sales' (a direct order, an accepted quote) is placed or approved and that commits, Customer Service's stored confirmation as placed
    is sent through the delivery ledger once for the order's revision and recipient (send#OrderConfirmation, in a transaction of its
    own, never failing the placement). A store order keeps its store mail (OrderReturn.secas.xml OrderPlacedSendEmail); any other
    order sends nothing. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-service-eca.xsd">
    <seca id="OrderPlacedSalesConfirmation" service="update#mantle.order.OrderHeader" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; (statusId == 'OrderPlaced' || statusId == 'OrderApproved')</expression></condition>
        <actions><service-call name="mantle.order.SalesOrderServices.send#OrderConfirmation" in-map="{orderId:orderId}"
                transaction="force-new" ignore-error="true"/></actions>
    </seca>
</secas>
