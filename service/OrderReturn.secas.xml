<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- Order Notifications -->
    <seca id="OrderPlacedSendEmail" service="update#mantle.order.OrderHeader" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderPlaced'</expression></condition>
        <actions><service-call name="mantle.order.OrderInfoServices.send#OrderStoreEmail"
                in-map="{orderId:orderId, emailTypeEnumId:'PsetOrderPlaced'}"/></actions>
    </seca>
    <!-- the confirmation as placed stored at placement, for an organization whose orderConfirmationOnPlace is Y (off by
        default; impl-customer-service P3, F55): after the placement commits, in a transaction of its own, so a render failure
        never fails the place (store#PlacedOrderConfirmation logs it). Not async: an async call runs as the placing user and
        updates their UserAccount when it ends, which deadlocks against a caller still holding that row (a data load placing
        many orders), until the statement timeout. -->
    <seca id="OrderPlacedStoreConfirmation" service="update#mantle.order.OrderHeader" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderPlaced'</expression></condition>
        <actions><service-call name="mantle.order.OrderConfirmationServices.store#PlacedOrderConfirmation"
                in-map="{orderId:orderId}" transaction="force-new" ignore-error="true"/></actions>
    </seca>
    <seca id="OrderApprovedSendEmail" service="update#mantle.order.OrderHeader" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderApproved'</expression></condition>
        <actions>
            <!-- not for a Shop order whose lines are all digital (mr-pass impl-shop P6; design-shop §8.3): its receipt and
                download notice follow; every other order as before -->
            <service-call name="mantle.product.ShopFulfillmentServices.check#ApprovedEmail" in-map="{orderId:orderId}"
                    out-map="approvedEmail" disable-authz="true"/>
            <if condition="!approvedEmail.skip"><service-call name="mantle.order.OrderInfoServices.send#OrderStoreEmail"
                    in-map="{orderId:orderId, emailTypeEnumId:'PsetOrderApproved'}"/></if>
        </actions>
    </seca>
    <seca id="OrderApprovedNotify" service="update#mantle.order.OrderPart" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderApproved'</expression></condition>
        <actions><service-call name="mantle.order.OrderInfoServices.notify#OrderHighPriority"
                in-map="{orderId:orderId, orderPartSeqId:orderPartSeqId}"/></actions>
    </seca>

    <!-- Order Auto-Approve (has various constraints checked by service) -->
    <seca id="OrderPlacedAutoApprove" service="update#mantle.order.OrderHeader" when="post-service" run-on-error="false">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderPlaced'</expression></condition>
        <actions>
            <!-- only auto-approve on the fly here if ProductStore.autoApproveDelay is null or 0 -->
            <entity-find-one entity-name="mantle.order.OrderHeader" value-field="orderHeader"/>
            <set field="productStore" from="orderHeader.productStore"/>
            <set field="autoApproveDelay" from="orderHeader?.productStore?.autoApproveDelay"/>
            <if condition="!autoApproveDelay">
                <service-call name="mantle.order.OrderServices.autoApprove#Order" in-map="{orderId:orderId}"/></if>
        </actions>
    </seca>

    <!-- Check Order Part Completed after WorkEffort statusId update -->
    <seca id="OrderItemWorkEffortCheckComplete" service="update#mantle.work.effort.WorkEffort" when="post-service">
        <condition><expression>statusChanged &amp;&amp; ['WeComplete', 'WeClosed', 'WeCancelled'].includes(statusId)</expression></condition>
        <actions>
            <!-- will rarely be more than one record, but allow it -->
            <entity-find entity-name="mantle.order.OrderItemWorkEffort" list="itemWorkEffortList">
                <econdition field-name="workEffortId"/>
                <econdition field-name="requiredWork" value="Y"/>
            </entity-find>
            <iterate list="itemWorkEffortList" entry="itemWorkEffort">
                <entity-find-one entity-name="mantle.order.OrderItem" value-field="orderItem">
                    <field-map field-name="orderId" from="itemWorkEffort.orderId"/>
                    <field-map field-name="orderItemSeqId" from="itemWorkEffort.orderItemSeqId"/>
                </entity-find-one>
                <if condition="orderItem != null">
                    <service-call name="mantle.order.OrderServices.checkComplete#OrderPart"
                            in-map="{orderId:orderItem.orderId, orderPartSeqId:orderItem.orderPartSeqId}"/>
                </if>
            </iterate>
        </actions>
    </seca>

    <!-- Return processing on approval. With the organization's PartyAcctgPreference.returnSettlementRequired (D11) it
        only creates the return shipment: responses come from settle#Return. -->
    <seca id="ReturnApprovedProcess" service="update#mantle.order.return.ReturnHeader" when="post-service">
        <condition><expression>statusChanged &amp;&amp; statusId == 'ReturnApproved'</expression></condition>
        <actions>
            <!-- Create Return Shipment on Approved -->
            <service-call name="mantle.order.ReturnServices.create#ReturnShipment" in-map="context"/>
            <!-- On ReturnHeader Approved process#ReturnItemResponses, for those with responseImmediate=Y -->
            <service-call name="mantle.order.ReturnServices.get#ReturnSettlementMode" out-map="settlementMode"
                    in-map="{returnId:returnId}"/>
            <if condition="!settlementMode.settlementRequired">
                <service-call name="mantle.order.ReturnServices.process#ReturnItemResponses" in-map="context"/></if>
        </actions>
    </seca>

    <!-- Receive ReturnItems when Return Shipment Delivered (statusId=ShipDelivered, shipmentTypeEnumId=ShpTpSalesReturn);
        for an organization with returnSettlementRequired, its received quantities only (sync#ReturnShipmentReceipts) -->
    <seca id="ShipmentDeliveredReturnReceive" service="update#mantle.shipment.Shipment" when="post-service">
        <condition><expression>statusChanged &amp;&amp; statusId == 'ShipDelivered'</expression></condition>
        <actions>
            <service-call name="mantle.order.ReturnServices.get#ReturnSettlementMode" out-map="settlementMode"
                    in-map="{shipmentId:shipmentId}"/>
            <if condition="!settlementMode.settlementRequired"><then>
                <service-call name="mantle.order.ReturnServices.receive#ReturnShipmentItems" in-map="context"/>
            </then><else-if condition="settlementMode.returnId">
                <service-call name="mantle.order.ReturnServices.sync#ReturnShipmentReceipts" in-map="{shipmentId:shipmentId}"/>
            </else-if></if>
        </actions>
    </seca>

    <!-- On ReturnHeader Received process#ReturnItemResponses, all responses not yet processed;
        consolidates responses as possible (especially for check refunds, replacement orders); not with
        returnSettlementRequired, where settle#Return responds -->
    <seca id="ReturnReceivedProcess" service="update#mantle.order.return.ReturnHeader" when="post-service">
        <condition><expression>statusChanged &amp;&amp; statusId == 'ReturnReceived'</expression></condition>
        <actions>
            <service-call name="mantle.order.ReturnServices.get#ReturnSettlementMode" out-map="settlementMode"
                    in-map="{returnId:returnId}"/>
            <if condition="!settlementMode.settlementRequired">
                <service-call name="mantle.order.ReturnServices.process#ReturnItemResponses" in-map="context"/></if>
        </actions>
    </seca>
    <!-- On ReturnItem Received process#ReturnItemResponses, all responses not yet processed;
        more immediate response, but no consolidation (which is nice for check refunds, replacement orders)
    <seca service="update#mantle.order.return.ReturnItem" when="post-service">
        <condition><expression>statusChanged &amp;&amp; statusId == 'ReturnReceived'</expression></condition>
        <actions><service-call name="mantle.order.ReturnServices.process#ReturnItemResponses" in-map="context"/></actions>
    </seca>
     -->
</secas>
