<!-- Shop's digital delivery (mr-pass impl-shop P6; design-shop §8.3, §10; design-crosscut §1.3). Each acts only on what Shop
    made (an order with a completed StoreCheckout, its fulfillment rows); every other order, refund and return is
    unchanged. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- an approved Shop order's plain digital lines: invoice, capture, finalize, complete, grant (each step its own
        transaction, after the approval commits) -->
    <seca id="ShopOrderApprovedFulfillDigital" service="update#mantle.order.OrderHeader" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderApproved'</expression></condition>
        <actions>
            <entity-find-count entity-name="mantle.order.StoreCheckout" count-field="shopCheckoutCount" disable-authz="true">
                <econdition field-name="orderId"/><econdition field-name="statusId" value="ScoCompleted"/></entity-find-count>
            <if condition="shopCheckoutCount &gt; 0">
                <service-call name="mantle.product.ShopFulfillmentServices.fulfill#ShopOrder" disable-authz="true"
                        in-map="{orderId:orderId}" ignore-error="true"/>
            </if>
        </actions>
    </seca>
    <!-- a refund or a return's settlement ends the download grants it leaves unpaid (S2 serves no unpaid download; P7 adds
        paid access) -->
    <seca id="PaymentRefundedReconcileAccess" service="mantle.account.PaymentServices.refund#OrderPayment" when="post-service" run-on-error="false">
        <condition><expression>refundPaymentId &amp;&amp; statusId != 'PmntDeclined'</expression></condition>
        <actions>
            <entity-find-count entity-name="mantle.product.store.StoreItemFulfillment" count-field="fulfilledCount" disable-authz="true">
                <econdition field-name="paymentId"/></entity-find-count>
            <if condition="fulfilledCount &gt; 0">
                <service-call name="mantle.product.ShopFulfillmentServices.reconcile#RefundedItem" disable-authz="true"
                        in-map="{paymentId:paymentId, reasonEnumId:'SdrRefunded'}"/>
            </if>
        </actions>
    </seca>
    <seca id="ReturnSettledReconcileAccess" service="mantle.order.ReturnServices.settle#Return" when="post-service" run-on-error="false">
        <condition><expression>returnId &amp;&amp; ['SETTLED', 'REFUND_PENDING'].includes(resultCode)</expression></condition>
        <actions>
            <service-call name="mantle.product.ShopFulfillmentServices.reconcile#RefundedItem" disable-authz="true"
                    in-map="{returnId:returnId, reasonEnumId:'SdrReturned'}"/>
        </actions>
    </seca>
</secas>
