<!-- Drop-ship (impl-purchasing P7, F40): an approved drop-ship purchase order goes to its supplier once the approval commits,
    whether the sales order's approval made it approved (gate off) or decide#PurchaseApproval approved it (gate on), so a
    send that fails never undoes either approval. Every order's approval passes here; the service returns at once for an
    order with no parent order. (Its creation is in ProductAsset.secas.xml OrderApprovedReserveAssets, after the
    reservation.) -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="OrderApprovedSendDropShip" service="update#mantle.order.OrderHeader" when="tx-commit">
        <condition><expression>statusChanged &amp;&amp; statusId == 'OrderApproved'</expression></condition>
        <actions>
            <service-call name="mantle.order.DropShipServices.send#DropShipPurchaseOrder" in-map="{orderId:orderId}"
                    disable-authz="true"/>
        </actions>
    </seca>
</secas>
