<!-- Marketing P17 (IronStone Marketing design §9 "Where the seller's approval setting is on", §15.1; impl-marketing P17, §4): a ticket
    order's registrations follow the order, not the payment. When a sales order's status becomes Approved (autoApprove#Order on the
    payment's authorization, or a holder of SALES_ORDER_APPROVE in Sales' Awaiting approval list), Cancelled or Rejected, its places
    are confirmed or cancelled once, in the same transaction as the order's change, by EventRegistrationServices; an order with no
    registration is left alone at the cost of one indexed count. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="EventRegistrationOrderStatus" service="update#mantle.order.OrderHeader" when="post-service" run-on-error="false">
        <condition><expression>statusChanged &amp;&amp; ['OrderApproved', 'OrderCancelled', 'OrderRejected'].includes(statusId)</expression></condition>
        <actions><service-call name="mantle.work.EventRegistrationServices.handle#RegistrationOrderStatus" disable-authz="true"
                in-map="{orderId:orderId, statusId:statusId}"/></actions>
    </seca>
</secas>
