    <!-- A room's dated feature (IronStone Maintenance design §6 Facilities; impl-maintenance P2, F16): a projector, a video
        conference system, step-free access. Ended by its thruDate, never deleted, so a room's features on a past day stay
        readable. Written by FacilityServices.store#FacilityFeature under FACILITY_EDIT. -->
    <entity entity-name="FacilityFeature" package="mantle.facility" cache="never">
        <field name="facilityId" type="id" is-pk="true"/>
        <field name="featureEnumId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="comments" type="text-medium"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="Feature" related="moqui.basic.Enumeration">
            <key-map field-name="featureEnumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Room Feature" enumTypeId="RoomFeature"/>
            <moqui.basic.Enumeration description="Projector" enumId="RfProjector" enumTypeId="RoomFeature" sequenceNum="1"/>
            <moqui.basic.Enumeration description="Display screen" enumId="RfDisplay" enumTypeId="RoomFeature" sequenceNum="2"/>
            <moqui.basic.Enumeration description="Video conference" enumId="RfVideoConference" enumTypeId="RoomFeature" sequenceNum="3"/>
            <moqui.basic.Enumeration description="Whiteboard" enumId="RfWhiteboard" enumTypeId="RoomFeature" sequenceNum="4"/>
            <moqui.basic.Enumeration description="Step-free access" enumId="RfStepFree" enumTypeId="RoomFeature" sequenceNum="5"/>
        </seed-data>
    </entity>

