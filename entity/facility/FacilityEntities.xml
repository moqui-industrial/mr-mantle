    <entity entity-name="CountSchedule" package="mantle.facility" cache="never">
        <description>When locations or products come due for counting (design-warehouse StockPolicies CountSchedule): one
            dated row of the warehouse policy per rule. Its scope is an organization and, optionally, a facility and either
            locations (a location type, an area or one location) or products (a product category or an ABC class). Its kind
            is periodic (every frequencyDays), annual (annualMonth and annualDay) or zero confirmation (a location whose
            stock reached zero since its last count). A change ends the row in effect and starts the next
            (previousCountScheduleId), with the key fields audit-logged; history is never rewritten.</description>
        <field name="countScheduleId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="locationTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="areaId" type="id" enable-audit-log="true"/>
        <field name="locationSeqId" type="id" enable-audit-log="true"/>
        <field name="productCategoryId" type="id" enable-audit-log="true"/>
        <field name="abcClassEnumId" type="id" enable-audit-log="true"/>
        <field name="scheduleKindEnumId" type="id" enable-audit-log="true"/>
        <field name="frequencyDays" type="number-integer" enable-audit-log="true"/>
        <field name="annualMonth" type="number-integer" enable-audit-log="true"/>
        <field name="annualDay" type="number-integer" enable-audit-log="true"/>
        <field name="countModeEnumId" type="id" enable-audit-log="true"/>
        <field name="blindIndicator" type="text-indicator" enable-audit-log="true"/>
        <field name="assigneePartyId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="previousCountScheduleId" type="id"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one-nofk" related="mantle.facility.Facility"/>
        <relationship type="one" title="FacilityLocationType" related="moqui.basic.Enumeration" short-alias="locationType">
            <key-map field-name="locationTypeEnumId"/></relationship>
        <relationship type="one-nofk" related="mantle.product.category.ProductCategory"/>
        <relationship type="one" title="AbcClass" related="moqui.basic.Enumeration" short-alias="abcClassEnum">
            <key-map field-name="abcClassEnumId"/></relationship>
        <relationship type="one" title="CountScheduleKind" related="moqui.basic.Enumeration" short-alias="scheduleKindEnum">
            <key-map field-name="scheduleKindEnumId"/></relationship>
        <relationship type="one" title="CountMode" related="moqui.basic.Enumeration" short-alias="countModeEnum">
            <key-map field-name="countModeEnumId"/></relationship>
        <relationship type="one" title="Assignee" related="mantle.party.Party" short-alias="assignee">
            <key-map field-name="assigneePartyId" related="partyId"/></relationship>
        <index name="COUNT_SCHED_ORG"><index-field name="organizationPartyId"/><index-field name="facilityId"/></index>
    </entity>

<!-- Putaway (design-warehouse §17 WH-PUTAWAY; impl-warehouse P9): the putaway rules mantle.facility.PutawayServices
    resolves destinations by, and the storage type of a product and of a location (StorageType, data/10-seed/InventoryAndQuality.xml). A
    product's ProductFacilityLocation stays its default location; a rule adds destinations for the stock it applies to. -->
    <entity entity-name="PutawayRule" package="mantle.facility" cache="never">
        <description>Where stock of a facility is put away (design-warehouse PutawayRules RuleList): one dated row per rule.
            It applies to stock at a source location or of a source location type (receiving, staging; a receipt counts as
            receiving), of a product, a product category or a storage type (each optional, all given must match), and names
            a destination: one location, or the open locations of a location type (optionally in one area), in pick
            sequence. Lower priority is tried first. capacity with capacityUomId (empty: the stock unit) is the most the rule
            fills a destination to, beside the location's own capacity. A change ends the row in effect and starts the next
            (previousPutawayRuleId), with the key fields audit-logged; history is never rewritten.</description>
        <field name="putawayRuleId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"><description>The facility's owner.</description>
        </field>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="fromLocationTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="fromLocationSeqId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="productCategoryId" type="id" enable-audit-log="true"/>
        <field name="storageTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="toLocationTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="toAreaId" type="id" enable-audit-log="true"/>
        <field name="toLocationSeqId" type="id" enable-audit-log="true"/>
        <field name="priority" type="number-integer" enable-audit-log="true"/>
        <field name="capacity" type="number-decimal" enable-audit-log="true"/>
        <field name="capacityUomId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="previousPutawayRuleId" type="id"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="FromLocationType" related="moqui.basic.Enumeration" short-alias="fromLocationType">
            <key-map field-name="fromLocationTypeEnumId"/></relationship>
        <relationship type="one-nofk" related="mantle.product.Product"/>
        <relationship type="one-nofk" related="mantle.product.category.ProductCategory"/>
        <relationship type="one" title="StorageType" related="moqui.basic.Enumeration" short-alias="storageType">
            <key-map field-name="storageTypeEnumId"/></relationship>
        <relationship type="one" title="ToLocationType" related="moqui.basic.Enumeration" short-alias="toLocationType">
            <key-map field-name="toLocationTypeEnumId"/></relationship>
        <relationship type="one" title="Capacity" related="moqui.basic.Uom" short-alias="capacityUom">
            <key-map field-name="capacityUomId"/></relationship>
        <index name="PUTAWAY_RULE_FAC"><index-field name="facilityId"/><index-field name="thruDate"/></index>
    </entity>

    <entity entity-name="WarehousePolicy" package="mantle.facility">
        <description>Dated Warehouse policy by organization and optional facility/product scope. _NA_ is the all-scope key.
            The policy families (policyType): tracking (organization, facility and product scope), operation (receipt and
            delivery steps, default locations, tolerances, the backorder choice, blind counts and auto-print; organization
            and facility scope) and reservation (the facility reservation default where a store leaves it unset). Each change
            ends the row in effect and starts the next, with its fields audit-logged.</description>
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="policyType" type="text-short" is-pk="true" default="'tracking'"/>
        <field name="facilityId" type="id" is-pk="true" default="'_NA_'"/>
        <field name="productId" type="id" is-pk="true" default="'_NA_'"/>
        <field name="fromDate" type="date-time" is-pk="true" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="lotRequired" type="text-indicator" enable-audit-log="true"/>
        <field name="serialRequired" type="text-indicator" enable-audit-log="true"/>
        <field name="expiryBlock" type="text-indicator" enable-audit-log="true"/>
        <field name="serialPattern" type="text-medium" enable-audit-log="true"/>
        <field name="lotPattern" type="text-medium" enable-audit-log="true"/>
        <field name="shelfLifeDays" type="number-integer" enable-audit-log="true"/>
        <field name="nearExpiryDays" type="number-integer" enable-audit-log="true"/>
        <field name="minimumRemainingShelfLifeDays" type="number-integer" enable-audit-log="true"/>
        <!-- operation policy (store#OperationPolicy) -->
        <field name="receiptSteps" type="number-integer" enable-audit-log="true">
            <description>1 receive to the putaway destination, 2 to a receiving location then putaway, 3 to quarantine then
                inspection and putaway</description></field>
        <field name="deliverySteps" type="number-integer" enable-audit-log="true">
            <description>1 ship from stock, 2 pick to a staging location then ship, 3 pick, pack and ship</description></field>
        <field name="receivingLocationSeqId" type="id" enable-audit-log="true"/>
        <field name="quarantineLocationSeqId" type="id" enable-audit-log="true"/>
        <field name="stagingLocationSeqId" type="id" enable-audit-log="true"/>
        <field name="overReceiptPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="overShipmentPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="backorderEnumId" type="id" enable-audit-log="true"/>
        <field name="blindCount" type="text-indicator" enable-audit-log="true"/>
        <field name="autoPrint" type="text-indicator" enable-audit-log="true"/>
        <!-- reservation policy (store#ReservationPolicy) -->
        <field name="reservationOrderEnumId" type="id" enable-audit-log="true"/>
        <field name="reservationAutoEnumId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one-nofk" related="mantle.facility.Facility"/>
        <relationship type="one-nofk" related="mantle.product.Product"/>
        <relationship type="one" title="WarehouseBackorder" related="moqui.basic.Enumeration" short-alias="backorderEnum">
            <key-map field-name="backorderEnumId"/></relationship>
        <relationship type="one" title="AssetReservationOrder" related="moqui.basic.Enumeration"
                short-alias="reservationOrderEnum">
            <key-map field-name="reservationOrderEnumId"/></relationship>
        <relationship type="one" title="AssetReservationAuto" related="moqui.basic.Enumeration"
                short-alias="reservationAutoEnum">
            <key-map field-name="reservationAutoEnumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Warehouse Backorder Choice" enumTypeId="WarehouseBackorder"/>
            <moqui.basic.Enumeration enumId="WhBoBackorder" description="Keep the remainder on backorder" sequenceNum="1"
                    enumTypeId="WarehouseBackorder"/>
            <moqui.basic.Enumeration enumId="WhBoCancel" description="Cancel the remainder" sequenceNum="2"
                    enumTypeId="WarehouseBackorder"/>
            <moqui.basic.Enumeration enumId="WhBoAsk" description="Ask each time" sequenceNum="3"
                    enumTypeId="WarehouseBackorder"/>
        </seed-data>
    </entity>
</entities>
