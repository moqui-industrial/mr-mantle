<!-- Support channels (design-customer-service §3 ChannelSessions, §9 ChannelRouting; impl-customer-service P6, CS-CHANNELS,
    F10, F11, F12): how mail, a queue's public form, the forum and chat reach a service queue. The mail itself is still the
    Comms rule's (ErActCreateRequest, whose value names the queue), the queue's public form token an ExternalAccessCapability
    on its RequestCategory (ExternalAccess.js, the RequestCategory kind), and the forum's escalation PASS's
    createCaseFromTopic; a ServiceRoute row holds what each of them does on arrival: the type and priority, what an unknown
    sender and an automatic message make, the acknowledgement and its template, the reply identity, the form's hourly limit
    and the token's life. Effective-dated with its key fields audit-logged (§2): a save starts a row from its date and ends
    the one it replaces. Saved by mantle.request.SupportCaseServices.save#ServiceRoute (Channels.js); nothing reads it where
    no route is set up, so every intake path keeps Mantle's default. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="ServiceRoute" package="mantle.request.support" cache="never">
        <description>How one channel files into a service queue of an organization, effective-dated: the channel (mail,
            the queue's public form, a forum category of a PASS site, chat), for mail the account (empty: any account whose
            Comms rule names the queue), for the forum the site and its category, the type, priority and template of what
            it files, what an unknown sender (else the ServicePolicy's) and an automatic message make, whether a new case is
            acknowledged and with which text block and identity, the public form's hourly limit and its token's life in
            days, and the last error an intake met on it.</description>
        <field name="serviceRouteId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="channelEnumId" type="id" enable-audit-log="true"/>
        <field name="requestCategoryId" type="id" enable-audit-log="true"><description>The queue</description></field>
        <field name="emailAccountId" type="id" enable-audit-log="true"/>
        <field name="siteId" type="id" enable-audit-log="true"><description>The PASS site (mantle.public.PublicSite)</description></field>
        <field name="forumContactListId" type="id" enable-audit-log="true"><description>The forum category (its ContactList)</description></field>
        <field name="requestTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="templateFormId" type="id"/>
        <field name="defaultPriority" type="number-integer" enable-audit-log="true"/>
        <field name="unknownSenderEnumId" type="id" enable-audit-log="true"/>
        <field name="autoGeneratedEnumId" type="id" enable-audit-log="true"/>
        <field name="acknowledge" type="text-indicator" enable-audit-log="true"/>
        <field name="ackTextBlockId" type="id" enable-audit-log="true"><description>The acknowledgement's text
            (moqui.basic.email.EmailTextBlock), with ${requestId}, ${requestName} and ${queueName}</description></field>
        <field name="replyEmailIdentityId" type="id" enable-audit-log="true"/>
        <field name="rateLimitPerHour" type="number-integer" enable-audit-log="true"/>
        <field name="tokenValidDays" type="number-integer"/>
        <field name="lastErrorText" type="text-medium"/>
        <field name="lastErrorDate" type="date-time"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium"/>
        <relationship type="one" title="Organization" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="ServiceRouteChannel" related="moqui.basic.Enumeration" short-alias="channel">
            <key-map field-name="channelEnumId" related="enumId"/></relationship>
        <relationship type="one" related="mantle.request.RequestCategory" short-alias="queue"/>
        <relationship type="one-nofk" title="RequestType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="requestTypeEnumId" related="enumId"/></relationship>
        <relationship type="one-nofk" title="ServiceUnknownSender" related="moqui.basic.Enumeration" short-alias="unknownSender">
            <key-map field-name="unknownSenderEnumId" related="enumId"/></relationship>
        <relationship type="one-nofk" title="ServiceAutoGenerated" related="moqui.basic.Enumeration" short-alias="autoGenerated">
            <key-map field-name="autoGeneratedEnumId" related="enumId"/></relationship>
        <index name="SERVICE_ROUTE_ORG"><index-field name="organizationPartyId"/></index>
        <index name="SERVICE_ROUTE_QUEUE"><index-field name="requestCategoryId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Service Route Channel" enumTypeId="ServiceRouteChannel"/>
            <moqui.basic.Enumeration enumId="SrcEmail" description="Mail" sequenceNum="1" enumTypeId="ServiceRouteChannel"/>
            <moqui.basic.Enumeration enumId="SrcWebForm" description="Public form" sequenceNum="2" enumTypeId="ServiceRouteChannel"/>
            <moqui.basic.Enumeration enumId="SrcForum" description="Forum" sequenceNum="3" enumTypeId="ServiceRouteChannel"/>
            <moqui.basic.Enumeration enumId="SrcChat" description="Chat" sequenceNum="4" enumTypeId="ServiceRouteChannel"/>
            <!-- what an automatic message (Auto-Submitted other than no, Precedence bulk, junk or auto_reply, X-Autoreply)
                makes: nothing, or a message on the case its thread names; never a case, never acknowledged -->
            <moqui.basic.EnumerationType description="Service Auto-Generated Mail" enumTypeId="ServiceAutoGenerated"/>
            <moqui.basic.Enumeration enumId="SagAttach" description="Attach to its case only" sequenceNum="1" enumTypeId="ServiceAutoGenerated"/>
            <moqui.basic.Enumeration enumId="SagIgnore" description="Ignore" sequenceNum="2" enumTypeId="ServiceAutoGenerated"/>
            <!-- the channels a case comes by (Request.salesChannelEnumId; ScEmail, ScPhone and ScWeb are Mantle's) -->
            <moqui.basic.Enumeration enumId="ScChat" description="Chat" enumTypeId="SalesChannel"/>
            <moqui.basic.Enumeration enumId="ScForum" description="Forum" enumTypeId="SalesChannel"/>
            <!-- a logged call that is internal (not customer-visible): never a response to the customer -->
            <moqui.basic.Enumeration enumId="CpServiceInternal" description="Internal (not customer-visible)" enumTypeId="CommunicationPurpose"/>
            <!-- how a logged call ended (CommunicationEvent.reasonEnumId; log#CaseCall) -->
            <moqui.basic.EnumerationType description="Case Call Outcome" enumTypeId="CaseCallOutcome"/>
            <moqui.basic.Enumeration enumId="CcoReached" description="Spoke with the customer" sequenceNum="1" enumTypeId="CaseCallOutcome"/>
            <moqui.basic.Enumeration enumId="CcoFollowUp" description="Follow-up needed" sequenceNum="2" enumTypeId="CaseCallOutcome"/>
            <moqui.basic.Enumeration enumId="CcoNoAnswer" description="No answer" sequenceNum="3" enumTypeId="CaseCallOutcome"/>
            <moqui.basic.Enumeration enumId="CcoVoicemail" description="Voicemail" sequenceNum="4" enumTypeId="CaseCallOutcome"/>
        </seed-data>
    </entity>
</entities>
