<!-- The record type registrations (mantle.party.communication.RecordLinkType, SEC-BOS-87). -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <!-- A registration loaded with no rule (no visibleService, parent or organization field) that does not say why it needs none
        (codeRule, publicRead) is seen by a system administrator alone (get#RecordLinkInfo); the error names it so its component
        gives it a rule. The row is kept: one registration failing does not stop the rest of the data. -->
    <eeca id="RecordLinkTypeRuleless" entity="mantle.party.communication.RecordLinkType" on-create="true" on-update="true"
            run-on-error="false" get-entire-entity="true">
        <condition><expression>disabled != 'Y' &amp;&amp; !visibleService &amp;&amp; !(parentEntityName &amp;&amp; parentField)
            &amp;&amp; !organizationField &amp;&amp; codeRule != 'Y' &amp;&amp; publicRead != 'Y'</expression></condition>
        <actions><log level="error" message="Record type ${recordEntityName} (${ownerText ?? ''}) is registered with no visibility rule: only a system administrator sees its records until it names visibleService, parentEntityName and parentField, or organizationField, or says codeRule or publicRead"/></actions>
    </eeca>
</eecas>
