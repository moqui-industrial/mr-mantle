<!-- The record type registrations (mantle.party.communication.RecordLinkType, SEC-BOS-87). -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-eca.xsd">
    <!-- A registration loaded with no rule (no visibleService, parent or organization field) that does not say why it needs none
        (codeRule, only on a type get#RecordLinkInfo rules itself: RecordLinkTypes.js codeRuled; publicRead), or that claims
        codeRule for another type, is seen by a system administrator alone (get#RecordLinkInfo); the error names it so its
        component gives it a rule. The row is kept: one registration failing does not stop the rest of the data. -->
    <eeca id="RecordLinkTypeRuleless" entity="mantle.party.communication.RecordLinkType" on-create="true" on-update="true"
            run-on-error="false" get-entire-entity="true">
        <actions><script>
            const problem = ec.resource.script('component://mr-mantle/service/mantle/party/RecordLinkTypes.js').problemOf(ec.context)
            if (problem) ec.logger.error('Record type ' + recordEntityName + ' (' + (ownerText ?? '') + ') ' + problem)
        </script></actions>
    </eeca>
</eecas>
