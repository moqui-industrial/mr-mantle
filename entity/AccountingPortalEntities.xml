<!-- Accounting's customer and supplier pages (mantle.account.PortalServices): a supplier's bill submissions, the
    organization's gateway for invoice payment, and a hosted gateway page's address. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="SupplierBillSubmission" package="mantle.account.invoice" cache="never">
        <description>A supplier's bill submitted from a public page (submit#SupplierBill): its order, reference and the
            incoming draft bill it made or found. A repeat of the operation, or of the supplier's reference, answers this
            row. The file is scanned before the bill is made, and its name and size are kept here.</description>
        <field name="submissionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="supplierPartyId" type="id"/>
        <field name="orderId" type="id"/>
        <field name="capabilityId" type="id"/>
        <field name="operationId" type="text-short"/>
        <field name="referenceNumber" type="text-medium"/>
        <field name="invoiceId" type="id"/>
        <field name="attached" type="text-indicator"/>
        <field name="filename" type="text-medium"/>
        <field name="byteSize" type="number-integer"/>
        <field name="receivedDate" type="date-time"/>
        <field name="submittedByUserId" type="id"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <relationship type="one" related="mantle.order.OrderHeader"/>
        <relationship type="one" related="mantle.party.ExternalAccessCapability"/>
        <index name="SUPP_BILL_SUB_REF"><index-field name="organizationPartyId"/><index-field name="supplierPartyId"/>
            <index-field name="referenceNumber"/></index>
        <index name="SUPP_BILL_SUB_OP"><index-field name="operationId"/></index>
    </entity>
    <entity entity-name="PortalPaymentAttempt" package="mantle.account.payment" cache="never">
        <description>A payment started from a Billing page (start#InvoicePayment): its invoice, the site and the link or
            contact it came from, and the digest of the reference the gateway's return carries. The pages show, refresh
            and capture only these payments, never one made in Accounting for the same invoice. Since Shop P5 it is Accounting's
            typed payment attempt (purposeEnumId): Shop's checkout attempts carry their order, checkout, store and site,
            the snapshot hash, phase, safe outcome and lookup backoff, and have no invoice.</description>
        <field name="paymentId" type="id" is-pk="true"/>
        <field name="invoiceId" type="id"/>
        <field name="siteId" type="id"/>
        <field name="capabilityId" type="id"/>
        <field name="contactPartyId" type="id"/>
        <field name="returnKeyDigest" type="text-medium"/>
        <field name="createdDate" type="date-time"/>
        <field name="settledDate" type="date-time"><description>When the payment stopped being pending; the return
            reference reads the attempt for a day after it.</description></field>
        <!-- Accounting's typed payment-attempt coordinator (AC-02, review X9; mr-pass impl-shop P5, F13): each attempt has
            its purpose, and each worker selects its own (Billing's invoice attempts are PapInvoice, or empty for those made
            before; Shop's checkout attempts PapShopCheckout), so one worker never refreshes or captures another's. -->
        <field name="purposeEnumId" type="id"><description>PaymentAttemptPurpose: PapInvoice (Billing, also when empty),
            PapShopCheckout, PapShopRenewal, PapEventRegistration.</description></field>
        <field name="orderId" type="id"/>
        <field name="checkoutId" type="id"/>
        <field name="occurrenceId" type="id"/>
        <field name="productStoreId" type="id"/>
        <field name="snapshotHash" type="text-medium"><description>The hash of what the attempt charges (the caller's
            frozen snapshot).</description></field>
        <field name="phase" type="text-short"><description>Where the attempt is: authorizing, pending (at the provider),
            authorized, placed, failed.</description></field>
        <field name="outcome" type="text-short"><description>The safe outcome a customer may see: approved, declined,
            unknown, cancelled, mismatch.</description></field>
        <field name="checkCount" type="number-integer"/>
        <field name="lastCheckDate" type="date-time"/>
        <field name="nextCheckDate" type="date-time"><description>When its worker looks it up next (bounded backoff).</description></field>
        <relationship type="one" related="mantle.account.payment.Payment"/>
        <relationship type="one" related="mantle.account.invoice.Invoice"/>
        <!-- a checkout attempt's store, whose organization scopes Commerce's payment attempts dataset (BOSS impl-insights F30) -->
        <relationship type="one-nofk" related="mantle.product.store.ProductStore" short-alias="productStore"/>
        <relationship type="one" title="PaymentAttemptPurpose" related="moqui.basic.Enumeration">
            <key-map field-name="purposeEnumId" related="enumId"/></relationship>
        <index name="PORTAL_PAY_INVOICE"><index-field name="invoiceId"/></index>
        <index name="PORTAL_PAY_OPEN"><index-field name="settledDate"/><index-field name="createdDate"/></index>
        <index name="PORTAL_PAY_PURPOSE"><index-field name="purposeEnumId"/><index-field name="settledDate"/>
            <index-field name="nextCheckDate"/></index>
        <index name="PORTAL_PAY_CHECKOUT"><index-field name="checkoutId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Payment Attempt Purpose" enumTypeId="PaymentAttemptPurpose"/>
            <moqui.basic.Enumeration description="Invoice payment (Billing)" enumId="PapInvoice" enumTypeId="PaymentAttemptPurpose" sequenceNum="1"/>
            <moqui.basic.Enumeration description="Shop checkout" enumId="PapShopCheckout" enumTypeId="PaymentAttemptPurpose" sequenceNum="2"/>
            <moqui.basic.Enumeration description="Shop renewal" enumId="PapShopRenewal" enumTypeId="PaymentAttemptPurpose" sequenceNum="3"/>
            <moqui.basic.Enumeration description="Event registration" enumId="PapEventRegistration" enumTypeId="PaymentAttemptPurpose" sequenceNum="4"/>
        </seed-data>
    </entity>
    <extend-entity entity-name="PartyAcctgPreference" package="mantle.ledger.config">
        <field name="invoicePayGatewayConfigId" type="id" enable-audit-log="update">
            <description>The gateway a customer pays an invoice through on the organization's Billing pages; one of its
                PaymentGatewayOrganization bindings. Empty, the pages offer no payment.</description></field>
    </extend-entity>
    <extend-entity entity-name="PaymentGatewayResponse" package="mantle.account.method">
        <field name="redirectUrl" type="text-medium">
            <description>Where a hosted gateway takes the payer to pay (its own page), when the authorization is
                pending there.</description></field>
        <!-- mr-pass impl-shop P5 (F38, F41): Authorize.Net Accept Hosted -->
        <field name="hostedFormDate" type="date-time">
            <description>For a pending hosted authorization whose page takes a posted form token (Accept Hosted): when
                the last token was issued, after which (its lifetime and a grace) no payment can be made with
                one.</description></field>
        <field name="networkTransId" type="text-medium">
            <description>The card network's transaction id the provider reported for an approved transaction (stored
                credential evidence for later merchant-initiated charges).</description></field>
    </extend-entity>
</entities>
