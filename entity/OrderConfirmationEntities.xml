<!-- A sales order's confirmation as placed (design-customer-service §4 OrderDetail, impl-customer-service §4, P3, F29, F55;
    mantle.order.OrderConfirmationServices): its PDF, rendered as of the order's placed time, is an OrderContent of type
    OctOrderConfirmation (seeded in data/MantleSetupData.xml) stored once; each resend is an OrderEmailMessage naming the
    content it sent (orderContentId, the version) with its recipient party, the message holding the address and its
    result. Nothing here runs at placement, so
    Mantle's placement path is unchanged. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="OrderEmailMessage" package="mantle.order">
        <field name="orderContentId" type="id">
            <description>The stored document the message sent (a confirmation resend: the OctOrderConfirmation content); empty
                for a message that carried none.</description></field>
        <relationship type="one" related="mantle.order.OrderContent" short-alias="orderContent"/>
    </extend-entity>
</entities>
