<!-- IronStone Projects (impl-projects.md P5): a request new to its triagers (made Submitted, a draft submitted, or a submitted
    one given a project) tells them on the topic RequestTriage, after the commit (queue#RequestTriage), so a request made and
    then given its project in one transaction tells them once. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="RequestTriageNotice" entity="mantle.request.Request" on-create="true" on-update="true" get-entire-entity="true" get-original-value="true">
        <condition><expression>statusId == 'ReqSubmitted' &amp;&amp; (eecaOperation == 'create' || originalValue == null ||
            originalValue.statusId != 'ReqSubmitted' || (rootWorkEffortId &amp;&amp; originalValue.rootWorkEffortId != rootWorkEffortId))
            &amp;&amp; requestTypeEnumId != 'RqtPurchaseRfq'</expression></condition>
        <actions><service-call name="mantle.request.RequestServices.queue#RequestTriage" in-map="{requestId:requestId}"/></actions>
    </eeca>
    <!-- IronStone Customer Service (impl-customer-service P2, D23, F62): a request that may have become a support case (made,
        or its status, type or category changed, while open and not a draft; or given a Customer party) runs the case rule
        after the commit (mantle.request.SupportCaseServices.queue#CaseProfile, ensure#CaseProfile), so every entry point
        makes its case; an organization with no ServicePolicy has no cases, and the rule does nothing. -->
    <eeca id="SupportCaseRule" entity="mantle.request.Request" on-create="true" on-update="true" get-entire-entity="true" get-original-value="true">
        <condition><expression>statusId &amp;&amp; statusId != 'ReqDraft' &amp;&amp; statusId != 'ReqCompleted' &amp;&amp; statusId != 'ReqCancelled'
            &amp;&amp; (eecaOperation == 'create' || originalValue == null || originalValue.statusId != statusId
                || originalValue.requestTypeEnumId != requestTypeEnumId || originalValue.requestCategoryId != requestCategoryId)</expression></condition>
        <actions><service-call name="mantle.request.SupportCaseServices.queue#CaseProfile" in-map="{requestId:requestId}"/></actions>
    </eeca>
    <eeca id="SupportCaseCustomerRule" entity="mantle.request.RequestParty" on-create="true">
        <condition><expression>roleTypeId == 'Customer'</expression></condition>
        <actions><service-call name="mantle.request.SupportCaseServices.queue#CaseProfile" in-map="{requestId:requestId}"/></actions>
    </eeca>
    <!-- a message filed on a case from its customer tells its assignee (SupportCaseCustomerReply) -->
    <eeca id="SupportCaseCustomerReply" entity="mantle.request.RequestCommEvent" on-create="true">
        <actions><service-call name="mantle.request.SupportCaseServices.notify#CaseCustomerReply"
                in-map="{requestId:requestId, communicationEventId:communicationEventId}"/></actions>
    </eeca>
    <!-- IronStone Customer Service (impl-customer-service P4, D23, F64, F83): one rule records every path on a case's clocks: a
        change of a request's status, due date or resolution, from any screen or service (record#CaseEvent; a request that is
        not a case does nothing there) -->
    <eeca id="SupportCaseSlaRule" entity="mantle.request.Request" on-update="true" get-entire-entity="true" get-original-value="true">
        <condition><expression>originalValue != null &amp;&amp; (originalValue.statusId != statusId
            || String(originalValue.responseRequiredDate ?? '') != String(responseRequiredDate ?? '')
            || (originalValue.requestResolutionEnumId ?? null) != (requestResolutionEnumId ?? null))</expression></condition>
        <actions><service-call name="mantle.request.SlaServices.record#CaseEvent" in-map="{requestId:requestId, kind:'status',
                statusId:statusId, fromStatusId:originalValue.statusId, responseRequiredDate:responseRequiredDate,
                dueChanged:(String(originalValue.responseRequiredDate ?? '') != String(responseRequiredDate ?? '')),
                requestResolutionEnumId:requestResolutionEnumId,
                resolutionChanged:((originalValue.requestResolutionEnumId ?? null) != (requestResolutionEnumId ?? null))}"/></actions>
    </eeca>
    <!-- a message filed on a case: an outward response its channel accepted (a sent reply, filed once sent) meets first response;
        a note, an acknowledgement or a send that failed does not; the customer's is a reply -->
    <eeca id="SupportCaseSlaMessage" entity="mantle.request.RequestCommEvent" on-create="true">
        <actions><service-call name="mantle.request.SlaServices.record#CaseEvent"
                in-map="{requestId:requestId, kind:'message', communicationEventId:communicationEventId}"/></actions>
    </eeca>
    <!-- work made or linked on a case -->
    <eeca id="SupportCaseSlaWork" entity="mantle.request.RequestWorkEffort" on-create="true">
        <actions><service-call name="mantle.request.SlaServices.record#CaseEvent"
                in-map="{requestId:requestId, kind:'work', workEffortId:workEffortId}"/></actions>
    </eeca>
</eecas>
