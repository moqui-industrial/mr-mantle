        <field name="rateProposalId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="uomId" type="id"/>
        <field name="toUomId" type="id"/>
        <field name="conversionFactor" type="text-short"><description>The proposed decimal rate, as text</description></field>
        <field name="rateDate" type="date-time"><description>The day the provider's rate is for, from its
            start</description></field>
        <field name="rateSource" type="text-medium"/>
        <field name="providerServiceName" type="text-medium"/>
        <field name="statusId" type="id"><description>RateProposed, RateAccepted or RateRejected</description></field>
        <field name="fetchedDate" type="date-time"/>
        <field name="fetchedByUserId" type="id"/>
        <field name="decidedDate" type="date-time"/>
        <field name="decidedByUserId" type="id"/>
        <field name="uomConversionId" type="id"/>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="moqui.basic.StatusItem"/>
        <index name="RATE_PROPOSAL_ORG"><index-field name="organizationPartyId"/><index-field name="statusId"/></index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="CurrencyRateProposal" description="Exchange rate proposal"/>
            <moqui.basic.StatusItem statusId="RateProposed" statusTypeId="CurrencyRateProposal" description="Proposed"
                    sequenceNum="1"/>
            <moqui.basic.StatusItem statusId="RateAccepted" statusTypeId="CurrencyRateProposal" description="Accepted"
                    sequenceNum="2"/>
            <moqui.basic.StatusItem statusId="RateRejected" statusTypeId="CurrencyRateProposal" description="Rejected"
                    sequenceNum="3"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RateProposed" toStatusId="RateAccepted"
                    transitionName="Accept"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="RateProposed" toStatusId="RateRejected"
                    transitionName="Reject"/>
            <moqui.basic.EnumerationType enumTypeId="ExchangeRateProvider" description="Exchange rate provider"/>
            <moqui.basic.Enumeration enumId="ErpEcb" enumTypeId="ExchangeRateProvider"
                    description="European Central Bank daily reference rates"
                    enumCode="mantle.ledger.CurrencyServices.get#EcbRates"/>
        </seed-data>
    </entity>

