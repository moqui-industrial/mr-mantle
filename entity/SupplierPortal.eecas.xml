<!-- Purchasing's supplier links (impl-purchasing P16, SupplierPortal.js): an order cancelled or rejected ends its supplier
    links, and a quote leaving the quote statuses (an award places it, a decline rejects it, close#QuoteRequest's Not
    awarded cancels it) ends its QuoteResponse links. ExternalAccess.js already refuses such a record; this revokes the
    capabilities so they show as ended. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="SupplierPortalRevoke" entity="mantle.order.OrderHeader" on-update="true" run-on-error="false"
            get-entire-entity="true" get-original-value="true">
        <condition><expression>originalValue != null &amp;&amp; statusId != originalValue.statusId &amp;&amp;
            (statusId == 'OrderCancelled' || statusId == 'OrderRejected' || originalValue.statusId == 'OrderRequested'
            || originalValue.statusId == 'OrderProposed')</expression></condition>
        <actions><service-call name="mantle.order.SupplierPortalServices.revoke#OrderCapabilities" disable-authz="true"
                in-map="{orderId:orderId, statusId:statusId, oldStatusId:originalValue.statusId}"/></actions>
    </eeca>
</eecas>
