<!-- Organization-scoped staff identity (mantle.party.IdentityServices; mr-boss plan/design-admin.md §4.1, §17.2; impl-admin P5):
    the staff invitation. Separate from PASS's PublicSiteInvitation, which is a site's public identity flow and never grants
    staff access. P6 adds the lifecycle operation and its steps. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="UserInvitation" package="mantle.party" cache="never">
        <description>A staff invitation: an address, the organization the invited person will work for (a relationship of
            relationshipTypeEnumId), the grant proposal (registered bundles, checked when it is sent and again when it is accepted)
            and a single-use token, kept only as its hash, that lasts until expiresDate. statusId is UinvPending until it is
            accepted (UinvAccepted, with the account it went to) or revoked (UinvRevoked); a pending one past expiresDate reads
            as expired (UinvExpired). A resend gives it a new token, so the earlier one no longer matches. operationKey makes a
            retry of the same request answer this invitation. The token itself is mailed, or shown once to the inviter when
            the instance cannot send mail (linkShownDate); it is never stored, listed or logged. Read and changed only through
            mantle.party.IdentityServices.</description>
        <field name="invitationId" type="id" is-pk="true"/>
        <field name="emailAddress" type="text-medium"><description>The invited address; the account the invitation
            goes to has it.</description></field>
        <field name="firstName" type="text-medium"><description>The person's name when the invitation makes a new
            person.</description></field>
        <field name="lastName" type="text-medium"/>
        <field name="partyId" type="id"><description>An existing person the inviter chose, or the person the acceptance
            made or matched.</description></field>
        <field name="userId" type="id"><description>The account the invitation was accepted with.</description></field>
        <field name="organizationPartyId" type="id"><description>The internal organization the person will work
            for; the organization entity filters apply to it.</description></field>
        <field name="relationshipTypeEnumId" type="id"><description>PrtEmployee, PrtAgent or PrtMember.</description></field>
        <field name="bundleGroupIds" type="text-medium"><description>The grant proposal: registered bundles (UserGroup
            ids, comma separated) the app supplied, validated structured data, never executable.</description></field>
        <field name="message" type="text-long"><description>The inviter's note in the email.</description></field>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="tokenHash" type="text-medium"><description>The hash of the current token (singleUseCodeHash);
            never the token.</description></field>
        <field name="expiresDate" type="date-time" enable-audit-log="true"/>
        <field name="sentDate" type="date-time" enable-audit-log="true"><description>When the current token was
            issued (sent, or made for the link shown).</description></field>
        <field name="sendCount" type="number-integer"/>
        <field name="mailSent" type="text-indicator"><description>Y when the current token went out by mail.</description></field>
        <field name="linkShownDate" type="date-time" enable-audit-log="true"><description>When the acceptance link of the
            current token was shown to the inviter, the instance having no mail server; audited, without the token.</description></field>
        <field name="acceptedDate" type="date-time" enable-audit-log="true"/>
        <field name="revokedDate" type="date-time" enable-audit-log="true"/>
        <field name="factorId" type="id"><description>The authenticator factor the acceptance made when a bundle's group
            requires one, until its first code confirms it.</description></field>
        <field name="acceptVisitId" type="id"><description>The session (Visit) the acceptance ran in: only it, or the account
            signed in, sees the factor step and its key.</description></field>
        <field name="inviterUserId" type="id"/>
        <field name="revokedByUserId" type="id"/>
        <field name="operationKey" type="text-medium"><description>The caller's key of the request: a retry with the same
            key answers this invitation.</description></field>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" related="moqui.basic.StatusItem"/>
        <relationship type="one" title="Inviter" related="moqui.security.UserAccount">
            <key-map field-name="inviterUserId" related="userId"/></relationship>
        <index name="USER_INVITE_TOKEN" unique="true"><index-field name="tokenHash"/></index>
        <index name="USER_INVITE_OPKEY" unique="true"><index-field name="operationKey"/></index>
        <index name="USER_INVITE_EMAIL"><index-field name="emailAddress"/></index>
    </entity>
    <!-- An account's lifecycle (impl-admin P6; design-admin §4.1 Offboarding, §4 LifecycleOperations and LifecycleDetail, §17.2) -->
    <entity entity-name="UserLifecycleOperation" package="mantle.party" cache="never">
        <description>One lifecycle request of an account: a global disable (now, or at a future date written to the account's
            terminateDate), the removal from one internal organization (its relationships, and the account's memberships when no
            organization is left), or a restoration (enabled again, no credential or schedule brought back). Its independent
            steps (UserLifecycleOperationStep) each keep their own outcome: a failed step leaves the others, and the revocation,
            in place and stays to be retried. organizationPartyId is the organization it was requested for (the one removed, or
            for a global operation the target's organization in the requester's scope), which the organization entity filters
            apply to. operationKey makes a retry of the same request answer this operation. Read and changed only through
            mantle.party.IdentityServices.</description>
        <field name="operationId" type="id" is-pk="true"/>
        <field name="userId" type="id"><description>The account the operation is about.</description></field>
        <field name="partyId" type="id"/>
        <field name="kindEnumId" type="id"><description>UlkDisable, UlkOrgRemoval or UlkRestore.</description></field>
        <field name="isGlobal" type="text-indicator"><description>Y for an account-wide operation (disable, restore), N for one
            organization's removal.</description></field>
        <field name="organizationPartyId" type="id"/>
        <field name="effectiveDate" type="date-time"><description>When it takes effect; a future date of a disable is the
            account's terminateDate, of a removal the relationships' end.</description></field>
        <field name="reason" type="text-long"/>
        <field name="sourceReference" type="text-medium"><description>The requesting record, as its owner names it (People's
            operation key, later); empty for Admin's own requests.</description></field>
        <field name="statusId" type="id" enable-audit-log="true"><description>UlopCompleted, UlopScheduled (taking effect at its
            date) or UlopAttention (a step failed or waits for an owner).</description></field>
        <field name="accountRevision" type="text-short"><description>The account revision the request named.</description></field>
        <field name="requestedByUserId" type="id"/>
        <field name="requestedDate" type="date-time"/>
        <field name="operationKey" type="text-medium"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
        <relationship type="one" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="UserLifecycleKind" related="moqui.basic.Enumeration">
            <key-map field-name="kindEnumId"/></relationship>
        <relationship type="one" related="moqui.basic.StatusItem"/>
        <relationship type="one" title="RequestedBy" related="moqui.security.UserAccount">
            <key-map field-name="requestedByUserId" related="userId"/></relationship>
        <relationship type="many" related="mantle.party.UserLifecycleOperationStep" short-alias="steps">
            <key-map field-name="operationId"/></relationship>
        <index name="USER_LIFE_OPKEY" unique="true"><index-field name="operationKey"/></index>
        <index name="USER_LIFE_USER"><index-field name="userId"/></index>
    </entity>
    <entity entity-name="UserLifecycleOperationStep" package="mantle.party" cache="never">
        <description>One independent step of a lifecycle operation: the account's own (disable, end date, access revoked,
            relationships and memberships ended, enabled again) or a participant's (an owner's pause, or a resource waiting for
            a new owner through the owner's transfer service, design-admin §14). It keeps the target identity, the provider and
            its action, the state, the attempts and the reason; never a copy of the owner's records or a secret. A participant
            step names only a service carrying the owned-resource contract (org.moqui.admin.IdentityServices
            define#OwnedResourceTransfer or define#OwnedResourcePause).</description>
        <field name="operationId" type="id" is-pk="true"/>
        <field name="stepSeqId" type="id" is-pk="true"/>
        <field name="stepKind" type="text-short"><description>disableAccount, endDate, revokeAccess, endRelationships,
            endMemberships, enableAccount, pause or transfer.</description></field>
        <field name="providerKey" type="text-medium"><description>identity for the account's own steps, else the participant's
            key (the app's registration).</description></field>
        <field name="ownerApp" type="text-short"/>
        <field name="title" type="text-medium"/>
        <field name="resourceKind" type="text-short"/>
        <field name="resourceId" type="text-medium"/>
        <field name="resourceName" type="text-medium"/>
        <field name="actionService" type="text-medium"><description>A participant step's service (the owner's pause or
            transfer).</description></field>
        <field name="resourceParameter" type="text-short"><description>The owner's name for the resource's id among the
            transfer service's parameters.</description></field>
        <field name="toUserId" type="id"><description>The new owner a transfer went to.</description></field>
        <field name="statusId" type="id" enable-audit-log="true"><description>UlstDone, UlstFailed, UlstWaiting (for a new
            owner) or UlstSkipped.</description></field>
        <field name="attemptCount" type="number-integer"/>
        <field name="reasonCode" type="text-short"/>
        <field name="reason" type="text-long"/>
        <field name="lastAttemptDate" type="date-time"/>
        <field name="lastAttemptByUserId" type="id"/>
        <field name="completedDate" type="date-time"/>
        <relationship type="one" related="mantle.party.UserLifecycleOperation"/>
        <relationship type="one" related="moqui.basic.StatusItem"/>
        <relationship type="one" title="NewOwner" related="moqui.security.UserAccount">
            <key-map field-name="toUserId" related="userId"/></relationship>
    </entity>

    <!-- The audit log's rows of records that belong to an internal organization, each joined back to that organization and
        aliased organizationPartyId, so the organization entity filters (MANTLE_USER_ORG, MANTLE_ACTIVE_ORG: EntityFilter rows
        in data/PartyAuditData.xml) apply to a find under an app's authorization, as they do to UserAccountOrganization
        (PartyViewEntities; mr-boss impl-admin §4 and P17). They carry the audit row's id, what it is of, who and when:
        never its values. mantle.party.IdentityServices.find#IdentityChanges reads them, for the framework's
        org.moqui.admin.AuditServices. -->
    <view-entity entity-name="AuditLogAccountOrganization" package="mantle.party">
        <description>An audit row whose first key value is a user account, with each internal organization that account's party
            works for now (as UserAccountOrganization): a change of the account itself.</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="USRACT" entity-name="moqui.security.UserAccount" join-from-alias="AUDLOG">
            <key-map field-name="pkPrimaryValue" related="userId"/></member-entity>
        <member-entity entity-alias="PREL" entity-name="mantle.party.PartyRelationship" join-from-alias="USRACT">
            <key-map field-name="partyId" related="fromPartyId"/></member-entity>
        <member-entity entity-alias="ORGRL" entity-name="mantle.party.PartyRole" join-from-alias="PREL">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="PREL" field="toPartyId"/>
        <entity-condition>
            <econdition entity-alias="ORGRL" field-name="roleTypeId" value="OrgInternal"/>
            <econdition entity-alias="PREL" field-name="relationshipTypeEnumId" operator="in" value="PrtAgent,PrtEmployee,PrtMember"/>
            <date-filter entity-alias="PREL"/>
        </entity-condition>
    </view-entity>
    <view-entity entity-name="AuditLogMemberOrganization" package="mantle.party">
        <description>An audit row whose second key value is a user account, with each internal organization that account's party
            works for now: a change of a group membership or of a user's subscription.</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="USRACT" entity-name="moqui.security.UserAccount" join-from-alias="AUDLOG">
            <key-map field-name="pkSecondaryValue" related="userId"/></member-entity>
        <member-entity entity-alias="PREL" entity-name="mantle.party.PartyRelationship" join-from-alias="USRACT">
            <key-map field-name="partyId" related="fromPartyId"/></member-entity>
        <member-entity entity-alias="ORGRL" entity-name="mantle.party.PartyRole" join-from-alias="PREL">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="PREL" field="toPartyId"/>
        <entity-condition>
            <econdition entity-alias="ORGRL" field-name="roleTypeId" value="OrgInternal"/>
            <econdition entity-alias="PREL" field-name="relationshipTypeEnumId" operator="in" value="PrtAgent,PrtEmployee,PrtMember"/>
            <date-filter entity-alias="PREL"/>
        </entity-condition>
    </view-entity>
    <view-entity entity-name="AuditLogActorOrganization" package="mantle.party">
        <description>An audit row with each internal organization the account that made the change works for now: a change of a
            record that is its maker's own doing and carries no organization (an export or an import a person made).</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="USRACT" entity-name="moqui.security.UserAccount" join-from-alias="AUDLOG">
            <key-map field-name="changedByUserId" related="userId"/></member-entity>
        <member-entity entity-alias="PREL" entity-name="mantle.party.PartyRelationship" join-from-alias="USRACT">
            <key-map field-name="partyId" related="fromPartyId"/></member-entity>
        <member-entity entity-alias="ORGRL" entity-name="mantle.party.PartyRole" join-from-alias="PREL">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="PREL" field="toPartyId"/>
        <entity-condition>
            <econdition entity-alias="ORGRL" field-name="roleTypeId" value="OrgInternal"/>
            <econdition entity-alias="PREL" field-name="relationshipTypeEnumId" operator="in" value="PrtAgent,PrtEmployee,PrtMember"/>
            <date-filter entity-alias="PREL"/>
        </entity-condition>
    </view-entity>
    <view-entity entity-name="AuditLogOrganization" package="mantle.party">
        <description>An audit row whose first key value is an internal organization: a change of the organization's own record or
            of what is made available to it.</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="ORGRL" entity-name="mantle.party.PartyRole" join-from-alias="AUDLOG">
            <key-map field-name="pkPrimaryValue" related="partyId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="ORGRL" field="partyId"/>
        <entity-condition><econdition entity-alias="ORGRL" field-name="roleTypeId" value="OrgInternal"/></entity-condition>
    </view-entity>
    <view-entity entity-name="AuditLogRelationshipOrganization" package="mantle.party">
        <description>An audit row whose first key value is a party relationship that makes its party staff of an internal
            organization (an agent, employee or member relationship, current or ended): a change of an organization
            membership.</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="PREL" entity-name="mantle.party.PartyRelationship" join-from-alias="AUDLOG">
            <key-map field-name="pkPrimaryValue" related="partyRelationshipId"/></member-entity>
        <member-entity entity-alias="ORGRL" entity-name="mantle.party.PartyRole" join-from-alias="PREL">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="PREL" field="toPartyId"/>
        <entity-condition>
            <econdition entity-alias="ORGRL" field-name="roleTypeId" value="OrgInternal"/>
            <econdition entity-alias="PREL" field-name="relationshipTypeEnumId" operator="in" value="PrtAgent,PrtEmployee,PrtMember"/>
        </entity-condition>
    </view-entity>
    <view-entity entity-name="AuditLogInvitationOrganization" package="mantle.party">
        <description>An audit row whose first key value is a staff invitation, with the internal organization the invitation is
            for.</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="UINV" entity-name="mantle.party.UserInvitation" join-from-alias="AUDLOG">
            <key-map field-name="pkPrimaryValue" related="invitationId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="UINV" field="organizationPartyId"/>
    </view-entity>
    <view-entity entity-name="AuditLogLifecycleOrganization" package="mantle.party">
        <description>An audit row whose first key value is an account lifecycle operation (the operation's own or one of its
            steps'), with the internal organization the operation was requested for.</description>
        <member-entity entity-alias="AUDLOG" entity-name="moqui.entity.EntityAuditLog"/>
        <member-entity entity-alias="ULOP" entity-name="mantle.party.UserLifecycleOperation" join-from-alias="AUDLOG">
            <key-map field-name="pkPrimaryValue" related="operationId"/></member-entity>
        <alias name="auditHistorySeqId" entity-alias="AUDLOG"/>
        <alias name="changedEntityName" entity-alias="AUDLOG"/>
        <alias name="changedFieldName" entity-alias="AUDLOG"/>
        <alias name="pkPrimaryValue" entity-alias="AUDLOG"/>
        <alias name="pkSecondaryValue" entity-alias="AUDLOG"/>
        <alias name="changedDate" entity-alias="AUDLOG"/>
        <alias name="changedByUserId" entity-alias="AUDLOG"/>
        <alias name="changedInVisitId" entity-alias="AUDLOG"/>
        <alias name="organizationPartyId" entity-alias="ULOP" field="organizationPartyId"/>
    </view-entity>
</entities>
