<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-definition.xsd">
    <!-- Load these seeds after their prerequisites in OrderEntities.xml. -->
    <extend-entity entity-name="OrderHeader" package="mantle.order">
        <seed-data>
            <!-- a requested quote never answered is cancelled when its RFQ closes (close#QuoteRequest): it was not awarded, and
                OrderRejected ("Reject Request") is the supplier's decline -->
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="OrderRequested" toStatusId="OrderCancelled"
                    transitionName="Cancel Quote Request"/>
        </seed-data>
    </extend-entity>

    <extend-entity entity-name="OrderPart" package="mantle.order">
        <seed-data>
            <!-- a supplier quote's evidence: the supplier's file, or how it came (a call, an email) -->
            <moqui.basic.Enumeration enumId="OctSupplierQuote" description="Supplier quote" enumTypeId="OrderContentType"/>
        </seed-data>
    </extend-entity>
</entities>
