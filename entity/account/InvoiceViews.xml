        <alias name="paymentId" entity-alias="PAPP"/>
        <alias name="appliedDate" entity-alias="PAPP"/>
        <alias name="amountApplied" entity-alias="PAPP"/>
        <alias name="toAppliedDate" entity-alias="TPAPP" field="appliedDate"/>
        <alias name="toAmountApplied" entity-alias="TPAPP" field="amountApplied"/>
        <alias name="totalAmountApplied" type="number-decimal"><complex-alias operator="+">
            <complex-alias-field entity-alias="PAPP" field="amountApplied" default-value="0"/>
            <complex-alias-field entity-alias="TPAPP" field="amountApplied" default-value="0"/>
        </complex-alias></alias>

        <alias name="fromPseudoId" entity-alias="FPTY" field="pseudoId"/>
        <alias name="fromPrivateOwnerUserId" entity-alias="FPTY" field="privateOwnerUserId"/>
        <alias name="fromName" function="concat_ws" type="text-medium"><complex-alias operator=",">
            <complex-alias expression="' '"/>
            <complex-alias-field entity-alias="FORG" field="organizationName"/>
            <complex-alias-field entity-alias="FPER" field="firstName"/>
            <complex-alias-field entity-alias="FPER" field="lastName"/>
        </complex-alias></alias>
        <alias name="fromOrganizationName" entity-alias="FORG" field="organizationName"/>
        <alias name="fromFirstName" entity-alias="FPER" field="firstName"/>
        <alias name="fromLastName" entity-alias="FPER" field="lastName"/>
        <alias name="fromRoleTypeId" entity-alias="FPRL" field="roleTypeId"/>
        <alias name="toPseudoId" entity-alias="TPTY" field="pseudoId"/>
        <alias name="toPrivateOwnerUserId" entity-alias="TPTY" field="privateOwnerUserId"/>
        <alias name="toName" function="concat_ws" type="text-medium"><complex-alias operator=",">
            <complex-alias expression="' '"/>
            <complex-alias-field entity-alias="TORG" field="organizationName"/>
            <complex-alias-field entity-alias="TPER" field="firstName"/>
            <complex-alias-field entity-alias="TPER" field="lastName"/>
        </complex-alias></alias>
        <alias name="toOrganizationName" entity-alias="TORG" field="organizationName"/>
        <alias name="toFirstName" entity-alias="TPER" field="firstName"/>
        <alias name="toLastName" entity-alias="TPER" field="lastName"/>
        <alias name="toRoleTypeId" entity-alias="TPRL" field="roleTypeId"/>
    </view-entity>

    <view-entity entity-name="InvoiceItemOnlySummary" package="mantle.account.invoice">
        <member-entity entity-alias="IITM" entity-name="mantle.account.invoice.InvoiceItem"/>
        <member-relationship entity-alias="IVC" join-from-alias="IITM" relationship="invoice"/>
        <alias-all entity-alias="IITM"><exclude field="quantity"/><exclude field="amount"/></alias-all>
        <alias name="itemInvoiceDate" entity-alias="IVC" field="invoiceDate"/>
        <alias name="quantityTotal" entity-alias="IITM" field="quantity" function="sum"/>
        <alias name="amountAverage" entity-alias="IITM" field="amount" function="avg"/>
        <alias name="itemsTotal" is-aggregate="true" type="number-decimal">
            <complex-alias function="SUM">
                <complex-alias function="ROUND">
                    <complex-alias operator="*">
                        <complex-alias-field entity-alias="IITM" field="quantity"/>
                        <complex-alias-field entity-alias="IITM" field="amount"/>
                    </complex-alias>
                    <complex-alias expression="2"/>
                </complex-alias>
            </complex-alias>
        </alias>
    </view-entity>

    <view-entity entity-name="InvoiceGlImpactSummary" package="mantle.account.invoice">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="IITM" entity-name="mantle.account.invoice.InvoiceItemOnlySummary" join-from-alias="INV" sub-select="true">
            <key-map field-name="invoiceId"/></member-entity>
        <member-entity entity-alias="PAPP" entity-name="mantle.account.payment.PaymentApplicationOnlySummary" join-from-alias="INV"
                sub-select="true" join-optional="true">
            <key-map field-name="invoiceId"/></member-entity>
        <member-entity entity-alias="TPAPP" entity-name="mantle.account.payment.PaymentApplicationOnlySummary" join-from-alias="INV"
                sub-select="true" join-optional="true">
            <key-map field-name="invoiceId" related="toInvoiceId"/>
        </member-entity>
        <member-entity entity-alias="ATD" entity-name="mantle.ledger.transaction.AcctgTransAndEntryGlaSummary" join-from-alias="INV"
                sub-select="true" join-optional="true">
            <key-map field-name="invoiceId"/></member-entity>
        <member-entity entity-alias="ATC" entity-name="mantle.ledger.transaction.AcctgTransAndEntryGlaSummary" join-from-alias="INV"
                sub-select="true" join-optional="true">
            <key-map field-name="invoiceId"/></member-entity>

        <alias-all entity-alias="INV"/>
        <alias name="itemDate" entity-alias="IITM"/>
        <alias name="itemInvoiceDate" entity-alias="IITM"/>
        <alias name="isAdjustment" entity-alias="IITM"/>
        <alias name="itemsTotal" entity-alias="IITM"/>

        <alias name="paymentId" entity-alias="PAPP"/>
        <alias name="appliedDate" entity-alias="PAPP"/>
        <alias name="amountApplied" entity-alias="PAPP"/>
        <alias name="unpaidAmount" type="number-decimal"><complex-alias operator="-">
            <complex-alias-field entity-alias="IITM" field="itemsTotal" default-value="0"/>
            <complex-alias-field entity-alias="PAPP" field="amountApplied" default-value="0"/>
        </complex-alias></alias>
        <alias name="toAppliedDate" entity-alias="TPAPP" field="appliedDate"/>
        <alias name="toAmountApplied" entity-alias="TPAPP" field="amountApplied"/>
        <alias name="totalAmountApplied" type="number-decimal"><complex-alias operator="+">
            <complex-alias-field entity-alias="PAPP" field="amountApplied" default-value="0"/>
            <complex-alias-field entity-alias="TPAPP" field="amountApplied" default-value="0"/>
        </complex-alias></alias>

        <alias name="debitGlAccountClassEnumId" entity-alias="ATD" field="glAccountClassEnumId"/>
        <alias name="debitTransactionDate" entity-alias="ATD" field="transactionDate"/>
        <alias name="debitDcFlag" entity-alias="ATD" field="debitCreditFlag"/>
        <alias name="debitTotal" entity-alias="ATD" field="amount"/>
        <alias name="creditGlAccountClassEnumId" entity-alias="ATC" field="glAccountClassEnumId"/>
        <alias name="creditTransactionDate" entity-alias="ATC" field="transactionDate"/>
        <alias name="creditDcFlag" entity-alias="ATC" field="debitCreditFlag"/>
        <alias name="creditTotal" entity-alias="ATC" field="amount"/>
        <alias name="debitMinusCredit" type="number-decimal"><complex-alias operator="-">
            <complex-alias-field entity-alias="ATD" field="amount" default-value="0"/>
            <complex-alias-field entity-alias="ATC" field="amount" default-value="0"/>
        </complex-alias></alias>
        <alias name="creditMinusDebit" type="number-decimal"><complex-alias operator="-">
            <complex-alias-field entity-alias="ATC" field="amount" default-value="0"/>
            <complex-alias-field entity-alias="ATD" field="amount" default-value="0"/>
        </complex-alias></alias>

        <entity-condition>
            <econdition field-name="debitDcFlag" value="D"/>
            <econdition field-name="creditDcFlag" value="C"/>
        </entity-condition>
    </view-entity>

    <view-entity entity-name="InvoiceEmailMessageDetail" package="mantle.account.invoice">
        <member-entity entity-alias="IEM" entity-name="mantle.account.invoice.InvoiceEmailMessage"/>
        <member-entity entity-alias="EMSG" entity-name="moqui.basic.email.EmailMessage" join-from-alias="IEM">
            <key-map field-name="emailMessageId"/></member-entity>
        <alias-all entity-alias="IEM"/><alias-all entity-alias="EMSG"/>
    </view-entity>

    <view-entity entity-name="SettlementTermAndEnumMember" package="mantle.account.invoice">
        <member-entity entity-alias="STT" entity-name="mantle.account.invoice.SettlementTerm"/>
        <member-entity entity-alias="EGM" entity-name="moqui.basic.EnumGroupMember" join-from-alias="STT">
            <key-map field-name="termTypeEnumId" related="enumId"/></member-entity>
        <alias-all entity-alias="STT"/>
        <alias-all entity-alias="EGM"/>
    </view-entity>

    <!-- Sums for the invoice reconciliation report (LedgerReportServices.run#InvoiceReconciliation): the aging's open total
        without loading each invoice -->
    <view-entity entity-name="InvoiceTotalSum" package="mantle.account.invoice">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="invoiceDate"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="invoiceTotalSum" field="invoiceTotal" function="sum"/>
    </view-entity>

    <!-- The overdue receivables of an organization by customer and currency, summed in the query (Collections) -->
    <view-entity entity-name="CollectionOverdueSummary" package="mantle.account.invoice">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="dueDate"/>
        <alias entity-alias="INV" name="unpaidTotal"/>
        <!-- People P27 review (AC-23): the invoice's payroll-origin mark, a condition only (mantle/account/PayrollOrigin.js) -->
        <alias entity-alias="INV" name="payrollOrigin"/>
        <alias entity-alias="INV" name="overdueTotal" field="unpaidTotal" function="sum"/>
        <alias entity-alias="INV" name="oldestDueDate" field="dueDate" function="min"/>
        <alias entity-alias="INV" name="invoiceCount" field="invoiceId" function="count" type="number-integer"/>
    </view-entity>

    <view-entity entity-name="InvoiceOpenHoldSummary" package="mantle.account.invoice" cache="never">
        <description>The number of open holds of each invoice, a sub-select of InvoiceFinance (find#Payables' held
            queue).</description>
        <member-entity entity-alias="HLD" entity-name="mantle.account.invoice.InvoiceHold"/>
        <alias entity-alias="HLD" name="invoiceId"/>
        <alias entity-alias="HLD" name="openHoldCount" field="invoiceHoldId" function="count"/>
        <entity-condition>
            <econdition entity-alias="HLD" field-name="releasedDate" operator="is-null"/>
        </entity-condition>
    </view-entity>

    <view-entity entity-name="InvoiceHoldDetail" package="mantle.account.invoice" cache="never">
        <description>An invoice hold with its bill's parties, status and totals, for the lists of held bills.</description>
        <member-entity entity-alias="HLD" entity-name="mantle.account.invoice.InvoiceHold"/>
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice" join-from-alias="HLD">
            <key-map field-name="invoiceId"/>
        </member-entity>
        <member-entity entity-alias="FROMP" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="fromPartyId" related="partyId"/>
        </member-entity>
        <alias-all entity-alias="HLD"/>
        <alias entity-alias="FROMP" name="fromPrivateOwnerUserId" field="privateOwnerUserId"/>
        <alias entity-alias="INV" name="fromPartyId"/>
        <alias entity-alias="INV" name="toPartyId"/>
        <alias entity-alias="INV" name="statusId"/>
        <alias entity-alias="INV" name="invoiceTypeEnumId"/>
        <!-- People P27 review (AC-23): the bill's payroll-origin mark (mantle/account/PayrollOrigin.js) -->
        <alias entity-alias="INV" name="invoicePayrollOrigin" field="payrollOrigin"/>
        <alias entity-alias="INV" name="referenceNumber"/>
        <alias entity-alias="INV" name="currencyUomId"/>
        <alias entity-alias="INV" name="invoiceTotal"/>
        <alias entity-alias="INV" name="unpaidTotal"/>
        <alias entity-alias="INV" name="dueDate"/>
    </view-entity>

    <view-entity entity-name="InvoiceFinance" package="mantle.account.invoice" cache="never">
        <member-entity entity-alias="INV" entity-name="mantle.account.invoice.Invoice"/>
        <member-entity entity-alias="SRC" entity-name="mantle.account.invoice.Invoice" join-from-alias="INV" join-optional="true">
            <key-map field-name="creditForInvoiceId" related="invoiceId"/>
        </member-entity>
        <member-entity entity-alias="FROMP" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="fromPartyId" related="partyId"/>
        </member-entity>
        <member-entity entity-alias="TOP" entity-name="mantle.party.Party" join-from-alias="INV">
            <key-map field-name="toPartyId" related="partyId"/>
        </member-entity>
        <member-entity entity-alias="OHLD" entity-name="mantle.account.invoice.InvoiceOpenHoldSummary" join-from-alias="INV"
                join-optional="true" sub-select="true">
            <key-map field-name="invoiceId"/>
        </member-entity>
        <!-- People P15 (design-accounting §5 ExpensePosting, impl-people P15): an employee's expense claim on the invoice, whose
            business state and reserved route the expenses queue reads -->
        <member-entity entity-alias="ECLM" entity-name="mantle.humanres.expense.ExpenseClaim" join-from-alias="INV" join-optional="true">
            <key-map field-name="invoiceId"/>
        </member-entity>
        <alias-all entity-alias="INV"/>
        <alias entity-alias="OHLD" name="openHoldCount"/>
        <alias entity-alias="ECLM" name="claimStatusEnumId" field="statusEnumId"/>
        <alias entity-alias="ECLM" name="claimReservedRouteEnumId" field="reservedRouteEnumId"/>
        <alias entity-alias="ECLM" name="claimRouteEnumId" field="routeEnumId"/>
        <alias entity-alias="OHLD" name="heldInvoiceId" field="invoiceId"/>
        <alias entity-alias="SRC" name="sourceFromPartyId" field="fromPartyId"/>
        <alias entity-alias="SRC" name="sourceToPartyId" field="toPartyId"/>
        <alias entity-alias="FROMP" name="fromPrivateOwnerUserId" field="privateOwnerUserId"/>
        <alias entity-alias="FROMP" name="fromPartyTypeEnumId" field="partyTypeEnumId"/>
        <alias entity-alias="TOP" name="toPrivateOwnerUserId" field="privateOwnerUserId"/>
    </view-entity>
</entities>
