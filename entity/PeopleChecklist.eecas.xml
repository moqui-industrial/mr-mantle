<!-- The end of a holding completes its equipment return (IronStone People design §4, review Y6; impl-people P7, F45, F52, F60): an
    AssetPartyAssignment is ended by setting its thruDate (mantle.product.AssetServices.replace#AssetPartyAssignment ends a row so
    and never deletes), whoever ends it (People's return#Equipment, Warehouse's custody change, Maintenance's later), so the rule is
    on the record: the open return tasks of that asset, holder and role are completed (PeopleServices.complete#ReturnTasks, which
    never refuses: a failure is logged and the custody change stands). Narrow: only an update that sets an empty thruDate. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="AssetPartyAssignmentReturnTask" entity="mantle.product.asset.AssetPartyAssignment" on-update="true"
            get-entire-entity="true" get-original-value="true">
        <condition><expression>thruDate &amp;&amp; (originalValue == null || originalValue.thruDate == null)</expression></condition>
        <actions><script>ec.service.sync().name('mantle.humanres.PeopleServices.complete#ReturnTasks')
            .parameters({assetId: assetId, partyId: partyId, roleTypeId: roleTypeId}).disableAuthz().call()</script></actions>
    </eeca>
</eecas>
