<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-definition.xsd">
    <view-entity entity-name="ProductContentAndOwner" package="mantle.product">
        <description>Catalog content with its master owner for scoped content queries.</description>
        <member-entity entity-alias="CNT" entity-name="mantle.product.ProductContent"/>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="CNT">
            <key-map field-name="productId"/>
        </member-entity>
        <alias-all entity-alias="CNT"/>
        <alias entity-alias="PRD" name="ownerPartyId"/>
    </view-entity>

    <!-- ========================================================= -->
    <!-- mantle.product -->
    <!-- ========================================================= -->
    <view-entity entity-name="ProductFindView" package="mantle.product">
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product"/>
        <member-relationship entity-alias="PRID" join-from-alias="PROD" relationship="identifications" join-optional="true"/>
        <member-relationship entity-alias="PTAS" join-from-alias="PROD" relationship="toAssocs" join-optional="true"/>
        <member-relationship entity-alias="PCM" join-from-alias="PROD" relationship="categories" join-optional="true"/>
        <member-relationship entity-alias="PFA" join-from-alias="PROD" relationship="features" join-optional="true"/>
        <alias-all entity-alias="PROD"/>
        <alias-all entity-alias="PRID"/>
        <alias name="assocFromProductId" entity-alias="PTAS" field="productId"/>
        <alias name="productCategoryId" entity-alias="PCM"/>
        <alias name="categoryFromDate" entity-alias="PCM" field="fromDate"/>
        <alias name="categoryThruDate" entity-alias="PCM" field="thruDate"/>
        <alias name="categorySequenceNum" entity-alias="PCM" field="sequenceNum"/>
        <alias name="productFeatureId" entity-alias="PFA"/>
        <alias name="applTypeEnumId" entity-alias="PFA"/>
        <alias name="featureFromDate" entity-alias="PFA" field="fromDate"/>
        <alias name="featureThruDate" entity-alias="PFA" field="thruDate"/>
        <alias name="featureSequenceNum" entity-alias="PFA" field="sequenceNum"/>
    </view-entity>

    <view-entity entity-name="ProductIdentificationAndProduct" package="mantle.product">
        <member-entity entity-alias="PID" entity-name="mantle.product.ProductIdentification"/>
        <member-relationship entity-alias="PROD" join-from-alias="PID" relationship="mantle.product.Product"/>
        <alias-all entity-alias="PID"/>
        <alias-all entity-alias="PROD"/>
    </view-entity>

    <view-entity entity-name="ProductOtherIdentificationAndProduct" package="mantle.product">
        <member-entity entity-alias="PID" entity-name="mantle.product.ProductOtherIdentification"/>
        <member-relationship entity-alias="PROD" join-from-alias="PID" relationship="mantle.product.Product"/>
        <alias-all entity-alias="PID"/>
        <alias-all entity-alias="PROD"/>
    </view-entity>

    <view-entity entity-name="ProductPriceAndFacilityParty" package="mantle.product">
        <member-entity entity-alias="PDPR" entity-name="mantle.product.ProductPrice"/>
        <member-entity entity-alias="FCPTY" entity-name="mantle.facility.FacilityParty" join-from-alias="PDPR">
            <key-map field-name="vendorPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="SPORG" entity-name="mantle.party.Organization" join-from-alias="PDPR">
            <key-map field-name="vendorPartyId" related="partyId"/></member-entity>
        <alias-all entity-alias="PDPR"/>
        <alias-all entity-alias="FCPTY"><exclude field="fromDate"/><exclude field="thruDate"/></alias-all>
        <alias name="fpFromDate" entity-alias="FCPTY" field="fromDate"/>
        <alias name="fpThruDate" entity-alias="FCPTY" field="thruDate"/>
        <alias entity-alias="SPORG" name="organizationName"/>
    </view-entity>

    <view-entity entity-name="ProductAssocAndTo" package="mantle.product">
        <member-entity entity-alias="PASS" entity-name="mantle.product.ProductAssoc"/>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="PASS">
            <key-map field-name="toProductId" related="productId"/></member-entity>
        <alias-all entity-alias="PASS"/>
        <alias-all entity-alias="PROD"><exclude field="productId"/></alias-all>
    </view-entity>

    <view-entity entity-name="ProductAssocAndToFeatureAppl" package="mantle.product">
        <member-entity entity-alias="PASS" entity-name="mantle.product.ProductAssoc"/>
        <member-entity entity-alias="PFA" entity-name="mantle.product.feature.ProductFeatureAppl" join-from-alias="PASS">
            <key-map field-name="toProductId" related="productId"/></member-entity>
        <alias-all entity-alias="PASS"/>
        <alias entity-alias="PFA" name="productFeatureId"/>
        <alias entity-alias="PFA" name="applTypeEnumId"/>
    </view-entity>

    <view-entity entity-name="ProductAssocAndFrom" package="mantle.product">
        <member-entity entity-alias="PASS" entity-name="mantle.product.ProductAssoc"/>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="PASS">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="PASS"/>
        <alias-all entity-alias="PROD"/>
    </view-entity>

    <view-entity entity-name="ProductAssocSummary" package="mantle.product">
        <member-entity entity-alias="PASS" entity-name="mantle.product.ProductAssoc"/>
        <alias-all entity-alias="PASS"><exclude field="quantity"/></alias-all>
        <alias name="bomQuantityTotal" entity-alias="PASS" field="quantity" function="sum"/>
        <entity-condition><date-filter entity-alias="PASS"/></entity-condition>
    </view-entity>

    <view-entity entity-name="ProductAndGlAppl" package="mantle.product">
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product"/>
        <member-entity entity-alias="PGLA" entity-name="mantle.product.ProductGlAppl" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="PROD"/>
        <alias-all entity-alias="PGLA"/>
    </view-entity>

    <view-entity entity-name="ProductAndCategoryAndClass" package="mantle.product">
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product"/>
        <member-entity entity-alias="PCM" entity-name="mantle.product.category.ProductCategoryMember" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="CLEN" entity-name="moqui.basic.Enumeration" join-from-alias="PROD">
            <key-map field-name="productClassEnumId"/></member-entity>
        <alias-all entity-alias="PCM"><exclude field="comments"/></alias-all>
        <alias-all entity-alias="PROD"><exclude field="productId"/></alias-all>
        <alias entity-alias="CLEN" name="classDescription" field="description"/>
    </view-entity>

    <view-entity entity-name="ProductDimensionAndType" package="mantle.product">
        <member-entity entity-alias="PDIM" entity-name="mantle.product.ProductDimension"/>
        <member-entity entity-alias="PDT" entity-name="mantle.product.ProductDimensionType" join-from-alias="PDIM">
            <key-map field-name="dimensionTypeId"/></member-entity>
        <member-entity entity-alias="UOM" entity-name="moqui.basic.Uom" join-from-alias="PDIM">
            <key-map field-name="valueUomId"/></member-entity>
        <alias-all entity-alias="PDIM"/>
        <alias-all entity-alias="PDT"/>
        <alias-all entity-alias="UOM" prefix="uom"/>
    </view-entity>

    <view-entity entity-name="ProductUomDimensionAndType" package="mantle.product">
        <member-entity entity-alias="PDIM" entity-name="mantle.product.ProductUomDimension"/>
        <member-entity entity-alias="PDT" entity-name="moqui.basic.UomDimensionType" join-from-alias="PDIM">
            <key-map field-name="uomDimensionTypeId"/></member-entity>
        <member-entity entity-alias="UOM" entity-name="moqui.basic.Uom" join-from-alias="PDIM">
            <key-map field-name="uomTypeEnumId"/></member-entity>
        <alias-all entity-alias="PDIM"/>
        <alias-all entity-alias="PDT"/>
        <alias-all entity-alias="UOM" prefix="uom"/>
    </view-entity>

    <!-- ========================================================= -->
    <!-- mantle.product.feature -->
    <!-- ========================================================= -->
    <view-entity entity-name="ProductFeatureAndType" package="mantle.product.feature">
        <member-entity entity-alias="PFET" entity-name="mantle.product.feature.ProductFeature"/>
        <member-entity entity-alias="PCTE" entity-name="moqui.basic.Enumeration" join-from-alias="PFET">
            <key-map field-name="productFeatureTypeEnumId" related="enumId"/></member-entity>
        <alias-all entity-alias="PFET"/>
        <alias name="typeDescription" entity-alias="PCTE" field="description"/>
    </view-entity>

    <view-entity entity-name="ProductFeatureAndAppl" package="mantle.product.feature">
        <member-entity entity-alias="PFA" entity-name="mantle.product.feature.ProductFeatureAppl"/>
        <member-entity entity-alias="PFT" entity-name="mantle.product.feature.ProductFeature" join-from-alias="PFA">
            <key-map field-name="productFeatureId"/></member-entity>
        <member-entity entity-alias="PFTE" entity-name="moqui.basic.Enumeration" join-from-alias="PFT">
            <key-map field-name="productFeatureTypeEnumId" related="enumId"/></member-entity>
        <alias-all entity-alias="PFA"/>
        <alias-all entity-alias="PFT"/>
        <alias name="typeDescription" entity-alias="PFTE" field="description"/>
    </view-entity>

    <view-entity entity-name="ProductAndFeatureAppl" package="mantle.product.feature">
        <member-entity entity-alias="PFA" entity-name="mantle.product.feature.ProductFeatureAppl"/>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="PFA">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="PFA"/>
        <alias-all entity-alias="PROD"/>
    </view-entity>

    <view-entity entity-name="ProductAndFeatureAndFeatureAppl" package="mantle.product.feature">
        <member-entity entity-alias="PFA" entity-name="mantle.product.feature.ProductFeatureAppl"/>
        <member-entity entity-alias="PFET" entity-name="mantle.product.feature.ProductFeature" join-from-alias="PFA">
            <key-map field-name="productFeatureId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="PFA">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="PFA"/>
        <alias-all entity-alias="PFET"><exclude field="description"/><exclude field="ownerPartyId"/></alias-all>
        <alias-all entity-alias="PROD"/>
        <alias name="productFeatureDescription" entity-alias="PFET" field="description"/>
    </view-entity>

    <view-entity entity-name="ProductAndFeatureApplMulti" package="mantle.product.feature">
        <description>Product plus one ProductCategoryMember and 5 ProductFeatureAppl, use/select only desired fields to auto-trim the joins.</description>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product"/>
        <member-entity entity-alias="PCM" entity-name="mantle.product.category.ProductCategoryMember" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="PFA1" entity-name="mantle.product.feature.ProductFeatureAppl" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="PFA2" entity-name="mantle.product.feature.ProductFeatureAppl" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="PFA3" entity-name="mantle.product.feature.ProductFeatureAppl" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="PFA4" entity-name="mantle.product.feature.ProductFeatureAppl" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="PFA5" entity-name="mantle.product.feature.ProductFeatureAppl" join-from-alias="PROD">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="PROD"/>
        <alias-all entity-alias="PCM"><exclude field="comments"/></alias-all>
        <alias-all entity-alias="PFA1" prefix="one"/>
        <alias-all entity-alias="PFA2" prefix="two"/>
        <alias-all entity-alias="PFA3" prefix="three"/>
        <alias-all entity-alias="PFA4" prefix="four"/>
        <alias-all entity-alias="PFA5" prefix="five"/>
    </view-entity>

    <view-entity entity-name="ProductFeatureApplAndGroupAppl" package="mantle.product.feature">
        <member-entity entity-alias="PFA" entity-name="mantle.product.feature.ProductFeatureAppl"/>
        <member-entity entity-alias="PFGA" entity-name="mantle.product.feature.ProductFeatureGroupAppl" join-from-alias="PFA">
            <key-map field-name="productFeatureId"/></member-entity>
        <alias-all entity-alias="PFA"/>
        <alias-all entity-alias="PFGA"><exclude field="fromDate"/><exclude field="thruDate"/><exclude field="sequenceNum"/></alias-all>
        <alias entity-alias="PFGA" name="groupFromDate" field="fromDate"/>
        <alias entity-alias="PFGA" name="groupThruDate" field="thruDate"/>
        <alias entity-alias="PFGA" name="groupSequenceNum" field="sequenceNum"/>
    </view-entity>

    <view-entity entity-name="ProductFeatureAndGroupAppl" package="mantle.product.feature">
        <member-entity entity-alias="PFGA" entity-name="mantle.product.feature.ProductFeatureGroupAppl"/>
        <member-entity entity-alias="PFT" entity-name="mantle.product.feature.ProductFeature" join-from-alias="PFGA">
            <key-map field-name="productFeatureId"/></member-entity>
        <alias-all entity-alias="PFGA"/>
        <alias-all entity-alias="PFT"/>
    </view-entity>

    <view-entity entity-name="ProductFeatureGroupAndAppl" package="mantle.product.feature">
        <member-entity entity-alias="PFGA" entity-name="mantle.product.feature.ProductFeatureGroupAppl"/>
        <member-entity entity-alias="PFGP" entity-name="mantle.product.feature.ProductFeatureGroup" join-from-alias="PFGA">
            <key-map field-name="productFeatureGroupId"/></member-entity>
        <alias-all entity-alias="PFGA"/>
        <alias-all entity-alias="PFGP"/>
    </view-entity>

    <view-entity entity-name="ProductCategoryAndFeatureGroupAppl" package="mantle.product.feature">
        <member-entity entity-alias="PCFGA" entity-name="mantle.product.feature.ProductCategoryFeatGrpAppl"/>
        <member-entity entity-alias="PCAT" entity-name="mantle.product.category.ProductCategory" join-from-alias="PCFGA">
            <key-map field-name="productCategoryId"/></member-entity>
        <alias-all entity-alias="PCFGA"/>
        <alias-all entity-alias="PCAT"/>
    </view-entity>

    <view-entity entity-name="ProductFeatureGroupAndCategoryAppl" package="mantle.product.feature">
        <member-entity entity-alias="PCFGA" entity-name="mantle.product.feature.ProductCategoryFeatGrpAppl"/>
        <member-entity entity-alias="PFG" entity-name="mantle.product.feature.ProductFeatureGroup" join-from-alias="PCFGA">
            <key-map field-name="productFeatureGroupId"/></member-entity>
        <alias-all entity-alias="PCFGA"/>
        <alias-all entity-alias="PFG"/>
    </view-entity>

    <view-entity entity-name="AssetIssuanceAndOwner" package="mantle.product.issuance">
        <member-entity entity-alias="AISS" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="AISS">
            <key-map field-name="assetId"/></member-entity>
        <alias-all entity-alias="AISS"/>
        <alias entity-alias="AST" name="ownerPartyId"/>
    </view-entity>

    <!-- ========================================================= -->
    <!-- mantle.product.issuance -->
    <!-- ========================================================= -->
    <view-entity entity-name="AssetIssuanceSummary" package="mantle.product.issuance">
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <alias-all entity-alias="ASI"><exclude field="quantity"/><exclude field="quantityCancelled"/>
            <exclude field="issuedDate"/><exclude field="facilityId"/></alias-all>
        <alias name="quantity" entity-alias="ASI" function="sum"/>
        <alias name="quantityCancelled" entity-alias="ASI" function="sum"/>
        <alias name="issuedDate" entity-alias="ASI" function="max"/>
    </view-entity>

    <view-entity entity-name="AssetAndIssuance" package="mantle.product.issuance">
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset"/>
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance" join-from-alias="AST">
            <key-map field-name="assetId"/></member-entity>
        <alias-all entity-alias="AST"/>
        <alias-all entity-alias="ASI"><exclude field="productId"/><exclude field="facilityId"/></alias-all>
    </view-entity>

    <view-entity entity-name="AssetAndIssuanceCost" package="mantle.product.issuance">
        <description>This is used as a sub-select as a member of the OrderItemSalesSummary and InvoiceItemSalesSummary view entities, may be useful for other finds as well</description>
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASI">
            <key-map field-name="assetId"/></member-entity>
        <alias-all entity-alias="ASI"><exclude field="quantity"/><exclude field="productId"/><exclude field="facilityId"/></alias-all>
        <alias-all entity-alias="AST"/>
        <alias name="quantity" entity-alias="ASI" function="sum"/>
        <alias name="averageCost" entity-alias="AST" field="acquireCost" function="avg"/>
        <alias name="issuanceCost" function="sum" type="number-decimal"><complex-alias operator="*">
            <complex-alias-field entity-alias="ASI" field="quantity"/>
            <complex-alias-field entity-alias="AST" field="acquireCost"/>
        </complex-alias></alias>
    </view-entity>

    <view-entity entity-name="AssetIssuanceDetail" package="mantle.product.issuance">
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASI">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="AST">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="ASI"><exclude field="productId"/><exclude field="facilityId"/></alias-all>
        <alias-all entity-alias="AST"/>
        <alias-all entity-alias="PROD"><exclude field="statusId"/><exclude field="comments"/>
            <exclude field="assetTypeEnumId"/><exclude field="ownerPartyId"/></alias-all>
    </view-entity>

    <view-entity entity-name="AssetIssuanceOriginFacilityAndOwnerDetail" package="mantle.product.issuance">
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASI">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="AST">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="OFAC" entity-name="mantle.facility.Facility" join-from-alias="AST" join-optional="true">
            <key-map field-name="originFacilityId"/></member-entity>
        <member-entity entity-alias="PTY" entity-name="mantle.party.Party" join-from-alias="OFAC" join-optional="true">
            <key-map field-name="ownerPartyId"/></member-entity>
        <member-entity entity-alias="ORG" entity-name="mantle.party.Organization" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="PER" entity-name="mantle.party.Person" join-from-alias="PTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <alias-all entity-alias="ASI"><exclude field="productId"/><exclude field="facilityId"/></alias-all>
        <alias-all entity-alias="AST"/>
        <alias-all entity-alias="PROD"><exclude field="statusId"/><exclude field="comments"/>
            <exclude field="assetTypeEnumId"/><exclude field="ownerPartyId"/></alias-all>
        <alias-all entity-alias="OFAC" prefix="originFacility"/>
        <alias-all entity-alias="PTY" prefix="originFacilityOwner"/>
        <alias-all entity-alias="PER" prefix="originFacilityOwner"/>
        <alias-all entity-alias="ORG" prefix="originFacilityOwner"/>
    </view-entity>

    <view-entity entity-name="AssetAndIssuanceSummary" package="mantle.product.issuance">
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASI">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="AST">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="OITM" entity-name="mantle.order.OrderItem" join-from-alias="ASI" join-optional="true">
            <key-map field-name="orderId"/><key-map field-name="orderItemSeqId"/></member-entity>

        <alias-all entity-alias="ASI"><exclude field="productId"/><exclude field="quantity"/><exclude field="facilityId"/></alias-all>
        <alias-all entity-alias="AST"><exclude field="quantityOnHandTotal"/><exclude field="availableToPromiseTotal"/>
            <exclude field="receivedDate"/><exclude field="manufacturedDate"/><exclude field="expectedEndOfLife"/></alias-all>
        <alias name="quantity" entity-alias="ASI" function="sum"/>
        <alias name="quantityOnHandTotal" entity-alias="AST" function="sum"/>
        <alias name="availableToPromiseTotal" entity-alias="AST" function="sum"/>
        <alias name="receivedDate" entity-alias="AST" function="min"/>
        <alias name="manufacturedDate" entity-alias="AST" function="min"/>
        <alias name="expectedEndOfLife" entity-alias="AST" function="min"/>
        <alias entity-alias="PROD" name="pseudoId"/>
        <alias entity-alias="PROD" name="productName"/>
        <alias entity-alias="PROD" name="amountUomId"/>
        <alias entity-alias="PROD" name="amountFixed"/>
        <alias entity-alias="PROD" name="productTypeEnumId"/>
        <alias name="orderPartSeqId" entity-alias="OITM"/>
    </view-entity>

    <view-entity entity-name="AssetIssuanceOriginSummary" package="mantle.product.issuance">
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASI">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="AST">
            <key-map field-name="productId"/></member-entity>
        <member-entity entity-alias="OFAC" entity-name="mantle.facility.Facility" join-from-alias="AST" join-optional="true">
            <key-map field-name="originFacilityId"/></member-entity>
        <alias-all entity-alias="ASI"><exclude field="quantity"/><exclude field="quantityCancelled"/><exclude field="facilityId"/></alias-all>
        <alias-all entity-alias="AST"><exclude field="availableToPromiseTotal"/><exclude field="quantityOnHandTotal"/>
            <exclude field="originalQuantity"/></alias-all>
        <alias-all entity-alias="PROD"><exclude field="statusId"/><exclude field="comments"/>
            <exclude field="originGeoId"/><exclude field="assetTypeEnumId"/><exclude field="ownerPartyId"/></alias-all>
        <alias-all entity-alias="OFAC" prefix="origin"><exclude field="facilityId"/></alias-all>
        <alias entity-alias="ASI" name="quantity" function="sum"/>
        <alias entity-alias="ASI" name="quantityCancelled" function="sum"/>
        <alias entity-alias="AST" name="availableToPromiseTotal" function="sum"/>
        <alias entity-alias="AST" name="quantityOnHandTotal" function="sum"/>
        <alias entity-alias="AST" name="originalQuantity" function="sum"/>
    </view-entity>

    <view-entity entity-name="AssetAndReservation" package="mantle.product.issuance">
        <member-entity entity-alias="ASR" entity-name="mantle.product.issuance.AssetReservation"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASR">
            <key-map field-name="assetId"/></member-entity>
        <alias-all entity-alias="ASR"/>
        <alias-all entity-alias="AST"><exclude field="productId"/></alias-all>
    </view-entity>

    <view-entity entity-name="AssetAndReservationSummary" package="mantle.product.issuance">
        <member-entity entity-alias="ASR" entity-name="mantle.product.issuance.AssetReservation"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASR">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="FLOC" entity-name="mantle.facility.FacilityLocation" join-from-alias="AST" join-optional="true">
            <key-map field-name="facilityId"/><key-map field-name="locationSeqId"/></member-entity>
        <member-entity entity-alias="OITM" entity-name="mantle.order.OrderItem" join-from-alias="ASR" join-optional="true">
            <key-map field-name="orderId"/><key-map field-name="orderItemSeqId"/></member-entity>
        <member-entity entity-alias="SIS" entity-name="mantle.shipment.ShipmentItemSource" join-from-alias="ASR" join-optional="true">
            <key-map field-name="orderId"/><key-map field-name="orderItemSeqId"/></member-entity>
        <alias-all entity-alias="ASR"><exclude field="productId"/><exclude field="quantity"/>
            <exclude field="quantityNotAvailable"/><exclude field="quantityNotIssued"/></alias-all>
        <alias-all entity-alias="AST"><exclude field="availableToPromiseTotal"/><exclude field="quantityOnHandTotal"/></alias-all>
        <alias-all entity-alias="FLOC"><exclude field="geoPointId"/><exclude field="capacity"/><exclude field="capacityUomId"/>
            <exclude field="sequenceNum"/></alias-all>
        <alias name="orderPartSeqId" entity-alias="OITM"/>
        <alias name="shipmentId" entity-alias="SIS"/>
        <alias name="quantity" entity-alias="ASR" function="sum"/>
        <alias name="quantityNotAvailable" entity-alias="ASR" function="sum"/>
        <alias name="quantityNotIssued" entity-alias="ASR" function="sum"/>
        <alias name="availableToPromiseTotal" entity-alias="AST" function="sum"/>
        <alias name="quantityOnHandTotal" entity-alias="AST" function="sum"/>
        <alias name="reservationCount" entity-alias="ASR" field="assetReservationId" function="count" type="number-integer"/>
    </view-entity>

    <view-entity entity-name="AssetReservationSummary" package="mantle.product.issuance">
        <member-entity entity-alias="ASR" entity-name="mantle.product.issuance.AssetReservation"/>
        <alias-all entity-alias="ASR"><exclude field="quantity"/><exclude field="quantityNotAvailable"/>
            <exclude field="quantityNotIssued"/></alias-all>
        <alias name="quantity" entity-alias="ASR" function="sum"/>
        <alias name="quantityNotAvailable" entity-alias="ASR" function="sum"/>
        <alias name="quantityNotIssued" entity-alias="ASR" function="sum"/>
    </view-entity>

    <view-entity entity-name="AssetIssuanceLotSummary" package="mantle.product.issuance">
        <description>Find AssetIssuance with Lot and Shipment fields available for constraints/etc, such as finding lot dates on
            most recent shipment for a customer.</description>
        <member-entity entity-alias="ASI" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="SHP" entity-name="mantle.shipment.Shipment" join-from-alias="ASI">
            <key-map field-name="shipmentId"/></member-entity>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASI">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="ALOT" entity-name="mantle.product.asset.Lot" join-from-alias="AST" join-optional="true">
            <key-map field-name="lotId"/></member-entity>
        <alias-all entity-alias="ALOT"/>
        <alias name="productId" entity-alias="ASI"/>
        <alias name="issuedDate" entity-alias="ASI"/>
        <alias name="expectedEndOfLife" entity-alias="AST"/>
        <alias name="fromPartyId" entity-alias="SHP"/>
        <alias name="toPartyId" entity-alias="SHP"/>
    </view-entity>

    <view-entity entity-name="AssetIssuanceValuation" package="mantle.product.issuance">
        <member-entity entity-alias="AISS" entity-name="mantle.product.issuance.AssetIssuance"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="AISS">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="AISS" join-optional="true">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="AISS"><exclude field="facilityId"/></alias-all>
        <alias entity-alias="AST" name="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="facilityId"/>
        <alias entity-alias="AST" name="lotId"/>
        <alias entity-alias="AST" name="acquireCost"/>
        <alias entity-alias="AST" name="acquireCostUomId"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>

    <!-- Stock movements with their asset's owner, for the close checklist's stock row by organization -->
    <view-entity entity-name="AssetReceiptAndOwner" package="mantle.product.receipt">
        <member-entity entity-alias="ARCT" entity-name="mantle.product.receipt.AssetReceipt"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ARCT">
            <key-map field-name="assetId"/></member-entity>
        <alias-all entity-alias="ARCT"/>
        <alias entity-alias="AST" name="ownerPartyId"/>
    </view-entity>

    <!-- ========================================================= -->
    <!-- mantle.product.receipt -->
    <!-- ========================================================= -->
    <view-entity entity-name="AssetReceiptSummary" package="mantle.product.receipt">
        <member-entity entity-alias="ASR" entity-name="mantle.product.receipt.AssetReceipt"/>
        <alias-all entity-alias="ASR"><exclude field="quantityAccepted"/><exclude field="quantityRejected"/>
            <exclude field="receivedDate"/></alias-all>
        <alias name="quantityAccepted" entity-alias="ASR" function="sum"/>
        <alias name="quantityRejected" entity-alias="ASR" function="sum"/>
        <alias name="receivedDate" entity-alias="ASR" function="max"/>
    </view-entity>

    <view-entity entity-name="AssetReceiptDetail" package="mantle.product.receipt">
        <member-entity entity-alias="ASR" entity-name="mantle.product.receipt.AssetReceipt"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASR">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="ASR">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="ASR"><exclude field="productId"/></alias-all>
        <alias-all entity-alias="AST"><exclude field="receivedDate"/></alias-all>
        <alias-all entity-alias="PROD"><exclude field="statusId"/><exclude field="comments"/>
            <exclude field="assetTypeEnumId"/><exclude field="ownerPartyId"/></alias-all>
    </view-entity>

    <view-entity entity-name="AssetAndReceiptSummary" package="mantle.product.receipt">
        <member-entity entity-alias="ASR" entity-name="mantle.product.receipt.AssetReceipt"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ASR">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PROD" entity-name="mantle.product.Product" join-from-alias="ASR">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="ASR"><exclude field="productId"/><exclude field="quantityAccepted"/>
            <exclude field="quantityRejected"/><exclude field="receivedDate"/></alias-all>
        <alias-all entity-alias="AST"><exclude field="quantityOnHandTotal"/><exclude field="availableToPromiseTotal"/>
            <exclude field="originalQuantity"/>
            <exclude field="receivedDate"/><exclude field="manufacturedDate"/><exclude field="expectedEndOfLife"/></alias-all>
        <alias name="quantityAccepted" entity-alias="ASR" function="sum"/>
        <alias name="quantityRejected" entity-alias="ASR" function="sum"/>
        <alias name="quantityOnHandTotal" entity-alias="AST" function="sum"/>
        <alias name="availableToPromiseTotal" entity-alias="AST" function="sum"/>
        <alias name="originalQuantity" entity-alias="AST" function="sum"/>
        <alias name="receivedDate" entity-alias="AST" function="min"/>
        <alias name="manufacturedDate" entity-alias="AST" function="min"/>
        <alias name="expectedEndOfLife" entity-alias="AST" function="min"/>
        <alias entity-alias="PROD" name="pseudoId"/>
        <alias entity-alias="PROD" name="productName"/>
        <alias entity-alias="PROD" name="amountUomId"/>
        <alias entity-alias="PROD" name="amountFixed"/>
        <alias entity-alias="PROD" name="productTypeEnumId"/>
    </view-entity>

    <!-- Stock movements with their asset's owner, type, facility and cost, and the product's name: the valuation
        exceptions, the stock transactions report and the receipts a landed cost goes to -->
    <view-entity entity-name="AssetReceiptValuation" package="mantle.product.receipt">
        <member-entity entity-alias="ARCT" entity-name="mantle.product.receipt.AssetReceipt"/>
        <member-entity entity-alias="AST" entity-name="mantle.product.asset.Asset" join-from-alias="ARCT">
            <key-map field-name="assetId"/></member-entity>
        <member-entity entity-alias="PRD" entity-name="mantle.product.Product" join-from-alias="ARCT" join-optional="true">
            <key-map field-name="productId"/></member-entity>
        <alias-all entity-alias="ARCT"/>
        <alias entity-alias="AST" name="ownerPartyId"/>
        <alias entity-alias="AST" name="assetTypeEnumId"/>
        <alias entity-alias="AST" name="facilityId"/>
        <alias entity-alias="AST" name="lotId"/>
        <alias entity-alias="AST" name="acquireCost"/>
        <alias entity-alias="AST" name="acquireCostUomId"/>
        <alias entity-alias="PRD" name="productName"/>
    </view-entity>
</entities>
