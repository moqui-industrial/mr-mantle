<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <!-- Sales' accounts and contacts (IronStone Sales design §4; impl-sales P3; service/mantle/sales/SalesAccounts.js) -->
    <view-entity entity-name="SalesAccountContact" package="mantle.sales">
        <description>A person's relationship to an account (Sales' Contacts list: PrtContact from the person to the account), one row
            for each Sales account role the account has (Account, Customer, Prospect), with the account's owner, state and name and
            the person's, so the list is found, scoped and paged in the query. Read with authorization disabled by
            mantle.sales.SalesWorkspaceServices.find#AccountContacts, which applies the caller's sales scope itself.</description>
        <member-entity entity-alias="PREL" entity-name="mantle.party.PartyRelationship"/>
        <member-entity entity-alias="ACCT" entity-name="mantle.party.Party" join-from-alias="PREL">
            <key-map field-name="toPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="ACRL" entity-name="mantle.party.PartyRole" join-from-alias="ACCT">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ACORG" entity-name="mantle.party.Organization" join-from-alias="ACCT" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="ACPER" entity-name="mantle.party.Person" join-from-alias="ACCT" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <member-entity entity-alias="CPTY" entity-name="mantle.party.Party" join-from-alias="PREL">
            <key-map field-name="fromPartyId" related="partyId"/></member-entity>
        <member-entity entity-alias="CPER" entity-name="mantle.party.Person" join-from-alias="CPTY" join-optional="true">
            <key-map field-name="partyId"/></member-entity>
        <alias name="partyRelationshipId" entity-alias="PREL"/>
        <alias name="relationshipTypeEnumId" entity-alias="PREL"/>
        <alias name="relationshipName" entity-alias="PREL"/>
        <alias name="fromDate" entity-alias="PREL"/>
        <alias name="thruDate" entity-alias="PREL"/>
        <alias name="accountPartyId" entity-alias="PREL" field="toPartyId"/>
        <alias name="accountRoleTypeId" entity-alias="ACRL" field="roleTypeId"/>
        <alias name="accountOwnerPartyId" entity-alias="ACCT" field="ownerPartyId"/>
        <alias name="accountDisabled" entity-alias="ACCT" field="disabled"/>
        <alias name="accountPrivateOwnerUserId" entity-alias="ACCT" field="privateOwnerUserId"/>
        <alias name="accountOrganizationName" entity-alias="ACORG" field="organizationName"/>
        <alias name="accountFirstName" entity-alias="ACPER" field="firstName"/>
        <alias name="accountLastName" entity-alias="ACPER" field="lastName"/>
        <alias name="contactPartyId" entity-alias="PREL" field="fromPartyId"/>
        <alias name="contactPseudoId" entity-alias="CPTY" field="pseudoId"/>
        <alias name="contactOwnerPartyId" entity-alias="CPTY" field="ownerPartyId"/>
        <alias name="contactDisabled" entity-alias="CPTY" field="disabled"/>
        <alias name="contactPrivateOwnerUserId" entity-alias="CPTY" field="privateOwnerUserId"/>
        <alias name="firstName" entity-alias="CPER"/>
        <alias name="lastName" entity-alias="CPER"/>
    </view-entity>
</entities>
