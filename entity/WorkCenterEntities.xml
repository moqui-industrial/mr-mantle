<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <!-- Manufacturing's production resources (design-manufacturing §12 M5, crosscut CX-WORKCENTER): the WorkCenter extension
        of a Facility and its dated rates (Products P8), capacities and alternates (Manufacturing P3). Facility.capacity stays
        the facility's people capacity; production throughput is WorkCenterCapacity. Written through
        mantle.work.RoutingServices.store#WorkCenter, store#WorkCenterRate and mantle.work.WorkCenterServices. -->
    <entity entity-name="WorkCenter" package="mantle.work.production">
        <description>Production extension of a Facility: the plant it belongs to, its calendar (work hours and holidays),
            efficiency, OEE target and scheduling policy. Its capacity is WorkCenterCapacity rows, never Facility.capacity.</description>
        <field name="facilityId" type="id" is-pk="true"/>
        <field name="plantFacilityId" type="id" enable-audit-log="true"><description>The plant the center belongs to; empty
            for its parent facility</description></field>
        <field name="calendarId" type="id" enable-audit-log="true"/>
        <field name="efficiencyPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="oeeTargetPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="schedulingPolicyEnumId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="Plant" related="mantle.facility.Facility" short-alias="plant">
            <key-map field-name="plantFacilityId" related="facilityId"/></relationship>
        <relationship type="one" related="mantle.work.calendar.Calendar" short-alias="calendar"/>
        <relationship type="one" title="WorkCenterSchedulingPolicy" related="moqui.basic.Enumeration" short-alias="schedulingPolicy">
            <key-map field-name="schedulingPolicyEnumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Work Center Scheduling Policy" enumTypeId="WorkCenterSchedulingPolicy"/>
            <moqui.basic.Enumeration enumId="WcspForward" description="Forward from the start" sequenceNum="1"
                    enumTypeId="WorkCenterSchedulingPolicy"/>
            <moqui.basic.Enumeration enumId="WcspBackward" description="Backward from the due date" sequenceNum="2"
                    enumTypeId="WorkCenterSchedulingPolicy"/>
            <moqui.basic.Enumeration enumId="WcspManual" description="Manual sequence" sequenceNum="3"
                    enumTypeId="WorkCenterSchedulingPolicy"/>
        </seed-data>
    </entity>
    <entity entity-name="WorkCenterRate" package="mantle.work.production">
        <description>An approved hourly cost policy is a dated row; money is independently guarded and audit-logged.</description>
        <field name="workCenterRateId" type="id" is-pk="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="componentTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="rateAmount" type="currency-precise" enable-audit-log="true"/>
        <field name="priceUomId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="state" type="text-short" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.work.production.WorkCenter"/>
        <relationship type="one" title="Currency" related="moqui.basic.Uom"><key-map field-name="priceUomId" related="uomId"/></relationship>
    </entity>
    <entity entity-name="WorkCenterCapacity" package="mantle.work.production" cache="never">
        <description>A dated capacity of a work center, for one product, a product type or every product (both empty): a
            quantity per duration (WccbRate: quantity in quantityUomId per perDuration of durationUomId) or a number of
            parallel slots (WccbSlots: operations that run at once). A row is not changed once written except to end it
            (thruDate); a new row for the same basis and product starting later ends the one in effect.</description>
        <field name="workCenterCapacityId" type="id" is-pk="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="capacityBasisEnumId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="productTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="quantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="perDuration" type="number-decimal" enable-audit-log="true"/>
        <field name="durationUomId" type="id" enable-audit-log="true"/>
        <field name="parallelSlots" type="number-integer" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.work.production.WorkCenter"/>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" title="ProductType" related="moqui.basic.Enumeration" short-alias="productType">
            <key-map field-name="productTypeEnumId"/></relationship>
        <relationship type="one" title="WorkCenterCapacityBasis" related="moqui.basic.Enumeration" short-alias="basis">
            <key-map field-name="capacityBasisEnumId"/></relationship>
        <relationship type="one" title="Quantity" related="moqui.basic.Uom" short-alias="quantityUom">
            <key-map field-name="quantityUomId" related="uomId"/></relationship>
        <relationship type="one" title="Duration" related="moqui.basic.Uom" short-alias="durationUom">
            <key-map field-name="durationUomId" related="uomId"/></relationship>
        <index name="WC_CAPACITY_CENTER"><index-field name="facilityId"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Work Center Capacity Basis" enumTypeId="WorkCenterCapacityBasis"/>
            <moqui.basic.Enumeration enumId="WccbRate" description="Quantity per time" sequenceNum="1"
                    enumTypeId="WorkCenterCapacityBasis"/>
            <moqui.basic.Enumeration enumId="WccbSlots" description="Parallel slots" sequenceNum="2"
                    enumTypeId="WorkCenterCapacityBasis"/>
        </seed-data>
    </entity>
    <entity entity-name="WorkCenterAlternate" package="mantle.work.production" cache="never">
        <description>A dated alternate of a work center: another work center of the same organization that may take its
            operations, for one product or every product, in sequence order, with the capability or qualification it
            carries. Ended, never changed, once written.</description>
        <field name="workCenterAlternateId" type="id" is-pk="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="alternateFacilityId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="qualification" type="text-medium" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.work.production.WorkCenter"/>
        <relationship type="one" title="Alternate" related="mantle.work.production.WorkCenter" short-alias="alternate">
            <key-map field-name="alternateFacilityId" related="facilityId"/></relationship>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <index name="WC_ALTERNATE_CENTER"><index-field name="facilityId"/></index>
    </entity>
</entities>
