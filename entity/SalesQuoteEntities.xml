<!-- Sales' quote drafts (IronStone Sales design §5 Quotes and OrderDetail's quote context, §17 SAL-QUOTE; impl-sales P7, F7):
    a quote is the native OrderHeader, OrderPart and OrderItem, marked by its order purpose. Sales seeds the purpose values beside
    Shop's RecurringTemplate (ShopSubscriptionEntities.xml): SalesQuote for an order that starts as an offer, SalesOrder for one
    entered directly; status, not purpose, says whether it was placed. A quote line keeps the price the one resolver selected
    (productPriceId, priceListId, priceRuleId, unitListPrice and calculatedUnitAmount with its priceSource) and, when the rep
    enters another price or a free line, the entered value (unitAmount), the reason and the actor (mantle.order.SalesQuoteServices
    over service/mantle/order/SalesQuotes.js). -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="OrderHeader" package="mantle.order">
        <seed-data>
            <!-- the type is Shop's (ShopSubscriptionEntities.xml), named here too as this file loads first -->
            <moqui.basic.EnumerationType description="Order purpose" enumTypeId="OrderPurpose"/>
            <moqui.basic.Enumeration enumId="OrpSalesQuote" description="Sales quote" sequenceNum="1" enumTypeId="OrderPurpose"/>
            <moqui.basic.Enumeration enumId="OrpSalesOrder" description="Sales order" sequenceNum="2" enumTypeId="OrderPurpose"/>
        </seed-data>
    </extend-entity>

    <!-- a quote line's price provenance and override basis (design §5: a manual price or discount keeps the calculated basis, the
        entered value, reason and actor), the basis audit-logged with the native unitAmount and price ids -->
    <extend-entity entity-name="OrderItem" package="mantle.order">
        <field name="calculatedUnitAmount" type="currency-precise" enable-audit-log="true"><description>The unit price the one
            price resolver selected for the line when it was priced (the basis a manual price or free line overrides); empty when
            no price was available.</description></field>
        <field name="priceSource" type="text-short"><description>Where the line's unit price came from: product-price,
            price-list or list-price-fallback (the resolver's), manual (the rep's entered price) or free (an authorized free
            line).</description></field>
        <field name="priceOverrideReason" type="text-medium" enable-audit-log="update"><description>Why the entered price or
            free line replaces the calculated one.</description></field>
        <field name="priceOverrideUserId" type="id" enable-audit-log="update"><description>Who entered the price or free line.</description></field>
        <field name="priceOverrideDate" type="date-time"><description>When the price or free line was entered.</description></field>
    </extend-entity>
</entities>
