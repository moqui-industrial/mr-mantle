<!-- Comms' text messages (mr-boss impl-marketing P22; design-marketing §12 SendingProfiles; service/mantle/party/MessageSms.js): a
    sending profile's messaging number and its cost a segment. The channel, consent source, suppression reason and source of a text
    and the Send SMS step are seed data/MessageSmsSeedData.xml (their types are defined by entity files that load after this one). -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
  <extend-entity entity-name="MessageSendingProfile" package="mantle.party">
    <field name="fromPhoneNumber" type="text-short" enable-audit-log="true"><description>An SMS profile's number (E.164): one of the
      organization's messaging numbers (a current telecom number of the organization that is one of our numbers with a messaging
      bridge, moqui.call.PhoneNumber)</description></field>
    <field name="segmentCost" type="currency-precise"><description>An SMS profile's configured cost of one segment, for the estimate
      shown before approval</description></field>
    <field name="segmentCostUomId" type="id"/>
  </extend-entity>
</entities>
