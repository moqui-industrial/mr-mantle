<!-- The fields of the Warehouse posting guard's movements (design-warehouse §17 WH-POST, crosscut CX-POSTING;
    impl-warehouse F7): what a person entered, in the unit they entered it, and the conversion the guard applied to reach
    the stock quantity, on each receipt, issuance and shipment source line a guarded entry point writes. The stock
    quantity stays in the existing quantity fields; these are written by the receive, issue and pick entry points (P7,
    P11, P16) and are empty on rows Mantle's own services write. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="AssetReceipt" package="mantle.product.receipt">
        <field name="enteredQuantity" type="number-decimal"/>
        <field name="enteredQuantityUomId" type="id"/>
        <field name="appliedConversionFactor" type="number-decimal"/>
        <relationship type="one" title="EnteredQuantity" related="moqui.basic.Uom" short-alias="enteredQuantityUom">
            <key-map field-name="enteredQuantityUomId"/></relationship>
    </extend-entity>
    <extend-entity entity-name="AssetIssuance" package="mantle.product.issuance">
        <field name="enteredQuantity" type="number-decimal"/>
        <field name="enteredQuantityUomId" type="id"/>
        <field name="appliedConversionFactor" type="number-decimal"/>
        <relationship type="one" title="EnteredQuantity" related="moqui.basic.Uom" short-alias="enteredQuantityUom">
            <key-map field-name="enteredQuantityUomId"/></relationship>
    </extend-entity>
    <extend-entity entity-name="ShipmentItemSource" package="mantle.shipment">
        <field name="enteredQuantity" type="number-decimal"/>
        <field name="enteredQuantityUomId" type="id"/>
        <field name="appliedConversionFactor" type="number-decimal"/>
        <relationship type="one" title="EnteredQuantity" related="moqui.basic.Uom" short-alias="enteredQuantityUom">
            <key-map field-name="enteredQuantityUomId"/></relationship>
    </extend-entity>
</entities>
