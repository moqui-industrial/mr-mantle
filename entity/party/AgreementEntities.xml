<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-definition.xsd">
    <!-- ========================================================= -->
    <!-- mantle.party.agreement -->
    <!-- ========================================================= -->
    <entity entity-name="Agreement" package="mantle.party.agreement" short-alias="agreements">
        <field name="agreementId" type="id" is-pk="true"/>
        <field name="agreementTypeEnumId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="organizationRoleTypeId" type="id"/>
        <field name="otherPartyId" type="id" enable-audit-log="update"/>
        <field name="otherRoleTypeId" type="id"/>
        <field name="agreementDate" type="date-time"/>
        <field name="fromDate" type="date-time" enable-audit-log="update"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="description" type="text-medium"/>
        <field name="currencyUomId" type="id"/>
        <field name="isTemplate" type="text-indicator"/>
        <field name="templateAgreementId" type="id"><description>The template agreement this agreement was cloned from</description></field>
        <field name="textData" type="text-very-long"/>
        <!-- A norm (legislation, a standard, guidance, an internal policy) is an agreement too: the issuing body is the
             organization party, agreementDate the date of adoption or signature, fromDate the entry into force, thruDate
             the end of validity (repealed, withdrawn), and its partitions are AgreementItems in a tree. Each language
             edition is an agreement of its own, associated to the others with AatTranslation. -->
        <field name="documentTypeEnumId" type="id"><description>The kind of document within its agreement type
            (AgreementDocumentType): a regulation, a directive, an international standard, a technical report, a
            procedure, a corrigendum</description></field>
        <field name="versionName" type="text-short"><description>The edition or version as printed: 2010, Ed. 2.0,
            Rev. 3, consolidated 2024-07-20</description></field>
        <field name="locale" type="text-short"><description>Language of the agreement text (en, it, fr_CA)</description></field>
        <field name="jurisdictionGeoId" type="id"><description>Where the agreement applies or binds: a country, a
            region, the European Union; empty for an international document</description></field>
        <field name="publicationDate" type="date-time"><description>Date of official publication (the Official
            Journal, the standards body's publication)</description></field>
        <field name="applicableDate" type="date-time"><description>Date from which the agreement applies, when later
            than its entry into force (fromDate); items applying on other dates have their own fromDate</description></field>
        <field name="prescriptive" type="text-indicator"><description>N when the document contains no prescriptive text,
            nothing that is or may become binding: a technical report, a guide, a non-normative resolution (Akoma Ntoso
            FRBRprescriptive). Its items are read, never applied as requirements</description></field>
        <field name="authoritative" type="text-indicator"><description>N when the text is not the official product of
            the body entrusted with it: an unofficial consolidation, a working translation (Akoma Ntoso
            FRBRauthoritative)</description></field>
        <relationship type="one" title="AgreementType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="agreementTypeEnumId"/></relationship>
        <relationship type="one-nofk" title="AgreementDocumentType" related="moqui.basic.Enumeration" short-alias="documentType">
            <key-map field-name="documentTypeEnumId"/></relationship>
        <relationship type="one-nofk" title="Jurisdiction" related="moqui.basic.Geo" short-alias="jurisdictionGeo">
            <key-map field-name="jurisdictionGeoId"/></relationship>
        <relationship type="one" title="Agreement" related="moqui.basic.StatusItem" short-alias="status"/>
        <relationship type="one" title="Organization" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId"/></relationship>
        <relationship type="one" title="Organization" related="mantle.party.RoleType" short-alias="organizationRole">
            <key-map field-name="organizationRoleTypeId"/></relationship>
        <relationship type="one" title="Other" related="mantle.party.Party" short-alias="other">
            <key-map field-name="otherPartyId"/></relationship>
        <relationship type="one" title="Other" related="mantle.party.RoleType" short-alias="otherRole">
            <key-map field-name="otherRoleTypeId"/></relationship>
        <relationship type="one" title="Currency" related="moqui.basic.Uom" short-alias="currencyUom">
            <key-map field-name="currencyUomId"/></relationship>
        <relationship type="one" title="Template" related="mantle.party.agreement.Agreement" short-alias="templateAgreement">
            <key-map field-name="templateAgreementId"/></relationship>

        <relationship type="many" related="mantle.party.agreement.AgreementTerm" short-alias="terms">
            <key-map field-name="agreementId"/></relationship>
        <relationship type="many" related="mantle.party.agreement.AgreementItem" short-alias="items">
            <key-map field-name="agreementId"/></relationship>
        <relationship type="many" related="mantle.party.agreement.AgreementParty" short-alias="parties">
            <key-map field-name="agreementId"/></relationship>
        <relationship type="many" related="mantle.party.agreement.AgreementIdentification" short-alias="identifications">
            <key-map field-name="agreementId"/></relationship>

        <seed-data>
            <!-- Agreement Type -->
            <moqui.basic.EnumerationType description="Agreement Type" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrProduct" description="Product" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrSales" description="Sales" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrEmployment" description="Employment" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrOther" description="Other" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrCommission" description="Commission" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrEula" description="End User License Agreement" enumTypeId="AgreementType"/>
            <!-- norms: what binds or guides by its text rather than between parties -->
            <moqui.basic.Enumeration enumId="AgrLegislation" description="Legislation" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrStandard" description="Standard" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrGuidance" description="Guidance" enumTypeId="AgreementType"/>
            <moqui.basic.Enumeration enumId="AgrPolicy" description="Internal Policy" enumTypeId="AgreementType"/>

            <!-- Agreement Document Type: parentEnumId is the agreement type it belongs to -->
            <moqui.basic.EnumerationType description="Agreement Document Type" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtRegulation" description="Regulation" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtDirective" description="Directive" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtDecision" description="Decision" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtDelegatedAct" description="Delegated Act" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtImplementingAct" description="Implementing Act" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtLaw" description="Law" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtDecree" description="Decree" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtTreaty" description="Treaty" parentEnumId="AgrLegislation" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtStandard" description="Standard" parentEnumId="AgrStandard" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtTechSpec" description="Technical Specification" parentEnumId="AgrStandard" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtTechReport" description="Technical Report" parentEnumId="AgrStandard" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtPas" description="Publicly Available Specification" parentEnumId="AgrStandard" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtStdGuide" description="Standardization Guide" parentEnumId="AgrStandard" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtGuideline" description="Guideline" parentEnumId="AgrGuidance" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtCodeOfPractice" description="Code of Practice" parentEnumId="AgrGuidance" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtPolicy" description="Policy" parentEnumId="AgrPolicy" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtProcedure" description="Procedure" parentEnumId="AgrPolicy" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtWorkInstruction" description="Work Instruction" parentEnumId="AgrPolicy" enumTypeId="AgreementDocumentType"/>
            <!-- documents that change another one, of any agreement type (associated to it with AatAmendment, AatCorrection) -->
            <moqui.basic.Enumeration enumId="AdtAmendment" description="Amendment" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtCorrigendum" description="Corrigendum" enumTypeId="AgreementDocumentType"/>
            <moqui.basic.Enumeration enumId="AdtConsolidated" description="Consolidated Version" enumTypeId="AgreementDocumentType"/>

            <!-- Agreement Status -->
            <moqui.basic.StatusType description="Agreement" statusTypeId="Agreement"/>
        </seed-data>
    </entity>

    <entity entity-name="AgreementAddendum" package="mantle.party.agreement">
        <field name="agreementAddendumId" type="id" is-pk="true"/>
        <field name="agreementId" type="id"/>
        <field name="agreementItemSeqId" type="id"/>
        <field name="addendumCreationDate" type="date-time"/>
        <field name="addendumEffectiveDate" type="date-time"/>
        <field name="addendumText" type="text-long"/>
        <relationship type="one" related="mantle.party.agreement.Agreement"/>
        <relationship type="one" related="mantle.party.agreement.AgreementItem">
            <key-map field-name="agreementId"/>
            <key-map field-name="agreementItemSeqId"/>
        </relationship>
    </entity>

    <entity entity-name="AgreementAssoc" package="mantle.party.agreement">
        <field name="agreementAssocId" type="id" is-pk="true"/>
        <field name="agreementId" type="id" not-null="true"/>
        <field name="toAgreementId" type="id" not-null="true"/>
        <field name="agreementAssocTypeEnumId" type="id"/>
        <field name="geoId" type="id"/>
        <field name="agreementItemSeqId" type="id"><description>Item of the from agreement the association starts from,
            for example the article that cites or amends another one; empty for the whole agreement</description></field>
        <field name="toAgreementItemSeqId" type="id"><description>Item of the to agreement; empty for the whole agreement
            (also when its items are not available)</description></field>
        <field name="assocText" type="text-medium"><description>The association as written in the from agreement, for
            example "see ISO 14118:2000, Clause 5" or "Article 3 is replaced by the following"</description></field>
        <field name="sequenceNum" type="number-integer"/>
        <field name="fromDate" type="date-time"><description>When the association takes effect: the date an amendment,
            a repeal or a replacement applies from</description></field>
        <field name="thruDate" type="date-time"/>

        <relationship type="one" related="mantle.party.agreement.Agreement" short-alias="agreement"/>
        <relationship type="one" title="To" related="mantle.party.agreement.Agreement" short-alias="toAgreement">
            <key-map field-name="toAgreementId"/></relationship>
        <relationship type="one" related="moqui.basic.Geo" short-alias="geo">
            <key-map field-name="geoId"/></relationship>
        <relationship type="one" title="AgreementAssocType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="agreementAssocTypeEnumId"/></relationship>
        <relationship type="one-nofk" related="mantle.party.agreement.AgreementItem" short-alias="item">
            <key-map field-name="agreementId"/><key-map field-name="agreementItemSeqId"/></relationship>
        <relationship type="one-nofk" title="To" related="mantle.party.agreement.AgreementItem" short-alias="toItem">
            <key-map field-name="toAgreementId" related="agreementId"/>
            <key-map field-name="toAgreementItemSeqId" related="agreementItemSeqId"/></relationship>
        <index name="AGRASSOC_ITEM"><index-field name="agreementId"/><index-field name="agreementItemSeqId"/></index>
        <index name="AGRASSOC_TO_ITEM"><index-field name="toAgreementId"/><index-field name="toAgreementItemSeqId"/></index>
        <seed-data>
            <!-- Agreement Assoc Type -->
            <moqui.basic.EnumerationType description="Agreement Association Type" enumTypeId="AgreementAssocType"/>

            <moqui.basic.Enumeration description="Alternate" enumId="AatAlternate" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Addendum" enumId="AatAddendum" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Upgrade" enumId="AatUpgrade" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Replacement" enumId="AatReplacement" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Amendment" enumId="AatAmendment" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Restatement" enumId="AatRestatement" enumTypeId="AgreementAssocType"/>
            <!-- From the agreement (or item) that does it to the one it is done to. Of a norm, Amendment changes the text
                 of the other, Replacement supersedes it (a new edition, a repealed act and its successor) and Restatement
                 is a consolidated version of it -->
            <moqui.basic.Enumeration description="Reference" enumId="AatReference" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Translation" enumId="AatTranslation" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Repeal" enumId="AatRepeal" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Correction" enumId="AatCorrection" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Transposition" enumId="AatTransposition" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Implementation" enumId="AatImplementation" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Adoption" enumId="AatAdoption" enumTypeId="AgreementAssocType"/>
            <!-- between items of norms, as the text states them: the use of a defined term to its definition (assocText the
                 term); a provision fixing when others apply to them (fromDate the date); an exclusion from or extension of
                 the scope of the items it names; a derogation from them; an entry of the normative references (the
                 documents indispensable for applying it) to the document; a clause of a harmonised standard to the
                 essential requirement of the act it covers (Annex ZA) -->
            <moqui.basic.Enumeration description="Defined Term" enumId="AatDefinedTerm" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Efficacy" enumId="AatEfficacy" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Scope Exclusion" enumId="AatScopeExclusion" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Scope Extension" enumId="AatScopeExtension" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Derogation" enumId="AatDerogation" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Normative Reference" enumId="AatNormativeReference" enumTypeId="AgreementAssocType"/>
            <moqui.basic.Enumeration description="Harmonisation" enumId="AatHarmonisation" enumTypeId="AgreementAssocType"/>
        </seed-data>
    </entity>

    <entity entity-name="AgreementContent" package="mantle.party.agreement">
        <field name="agreementContentId" type="id" is-pk="true"/>
        <field name="agreementId" type="id"/>
        <field name="contentLocation" type="text-medium"/>
        <field name="contentTypeEnumId" type="id"/>
        <field name="description" type="text-long"/>
        <field name="contentDate" type="date-time" default="ec.user.nowTimestamp"/>
        <field name="userId" type="id" default="ec.user.userId"/>
        <field name="contentHash" type="text-medium"><description>SHA-256 of the content, hex: the exact file the items of
            the agreement were read from</description></field>
        <relationship type="one" related="mantle.party.agreement.Agreement"/>
        <relationship type="one" title="AgreementContentType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="contentTypeEnumId"/></relationship>
        <seed-data>
            <moqui.basic.EnumerationType description="Agreement Content Type" enumTypeId="AgreementContentType"/>
            <moqui.basic.Enumeration description="Agreement Document" enumId="AcntDocument" enumTypeId="AgreementContentType"/>
            <moqui.basic.Enumeration description="Supporting Document" enumId="AcntSupporting" enumTypeId="AgreementContentType"/>
            <moqui.basic.Enumeration description="Price Sheet" enumId="AcntPriceSheet" enumTypeId="AgreementContentType"/>
            <!-- the sources of a norm and their readings: the items of the agreement are read from a source, and checked
                 against a second, independent reading of it -->
            <moqui.basic.Enumeration description="Source Document" enumId="AcntSource" enumTypeId="AgreementContentType"/>
            <moqui.basic.Enumeration description="Source Structured Text" enumId="AcntSourceStructured" enumTypeId="AgreementContentType"/>
            <moqui.basic.Enumeration description="Source Reading" enumId="AcntSourceReading" enumTypeId="AgreementContentType"/>
        </seed-data>
    </entity>

    <entity entity-name="AgreementIdentification" package="mantle.party.agreement">
        <description>An identifier of the agreement in a scheme: the European Legislation Identifier, a CELEX number, the
            reference of a standards body, a national adoption. The agreementId stays the record's own key.</description>
        <field name="agreementId" type="id" is-pk="true"/>
        <field name="agreementIdTypeEnumId" type="id" is-pk="true"/>
        <field name="idValue" type="text-medium"/>
        <relationship type="one" related="mantle.party.agreement.Agreement" short-alias="agreement"/>
        <relationship type="one" title="AgreementIdType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="agreementIdTypeEnumId"/></relationship>
        <index name="AGREEMENT_ID_VALUE"><index-field name="idValue"/></index>
        <seed-data>
            <moqui.basic.EnumerationType description="Agreement Identification Type" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidEli" description="European Legislation Identifier (ELI)" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidCelex" description="CELEX Number" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidOfficialJournal" description="Official Journal Reference" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidPublisherRef" description="Publisher Reference" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidNationalAdoption" description="National Adoption Reference" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidDoi" description="DOI" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidIsbn" description="ISBN" enumTypeId="AgreementIdType"/>
            <moqui.basic.Enumeration enumId="AgidUrn" description="URN" enumTypeId="AgreementIdType"/>
        </seed-data>
    </entity>

    <entity entity-name="AgreementParty" package="mantle.party.agreement">
        <field name="agreementId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="roleTypeId" type="id" is-pk="true"/>
        <relationship type="one" related="mantle.party.agreement.Agreement" short-alias="agreement"/>
        <relationship type="one" related="mantle.party.Party" short-alias="party"/>
        <relationship type="one" related="mantle.party.RoleType" short-alias="roleType"/>
    </entity>

    <entity entity-name="AgreementTerm" package="mantle.party.agreement">
        <field name="agreementTermId" type="id" is-pk="true"/>
        <field name="agreementId" type="id"/>
        <field name="agreementItemSeqId" type="id"/>
        <field name="settlementTermId" type="id"/>
        <field name="termTypeEnumId" type="id"/>
        <!-- Really need these? redundant with fields on Agreement: <field name="fromDate" type="date-time"/><field name="thruDate" type="date-time"/> -->
        <field name="termText" type="text-long"/>
        <field name="termNumber" type="number-decimal"/>
        <relationship type="one" related="mantle.party.agreement.Agreement"/>
        <relationship type="one-nofk" related="mantle.party.agreement.AgreementItem">
            <key-map field-name="agreementId"/><key-map field-name="agreementItemSeqId"/></relationship>
        <relationship type="one" related="mantle.account.invoice.SettlementTerm"/>
        <relationship type="one" title="TermType" related="moqui.basic.Enumeration">
            <key-map field-name="termTypeEnumId"/></relationship>
        <!-- see the mantle.account.invoice.SettlementTerm entity for TermType enums -->
    </entity>

    <entity entity-name="AgreementItem" package="mantle.party.agreement">
        <description>For price lists associated with an AgreementItem use the ProducePrice entity.</description>
        <field name="agreementId" type="id" is-pk="true"/>
        <field name="agreementItemSeqId" type="id" is-pk="true"/>
        <field name="agreementItemTypeEnumId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <field name="productId" type="id"/>
        <field name="quantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id"/>
        <field name="itemText" type="text-very-long"/>
        <!-- A partition of a norm (or of any structured text): a tree by parentItemSeqId, in printed order by sequenceNum
             among siblings. fromDate and thruDate are when the item applies, for items applying on their own dates (a
             staggered application, an item an amendment replaced) -->
        <field name="parentItemSeqId" type="id"><description>The item this one is part of (an article of a chapter, a
            paragraph of an article, a point of a paragraph)</description></field>
        <field name="itemNumber" type="text-short"><description>Number or letter as printed: 5, 1-bis, a, iii, 5.5.3.5,
            III</description></field>
        <field name="itemTitle" type="text-medium"/>
        <field name="sequenceNum" type="number-integer"><description>Order among the items with the same parent</description></field>
        <field name="sourceLocation" type="text-medium"><description>Where the item is in the source document: the page
            of a PDF, the file of a Formex act</description></field>
        <field name="sourcePage" type="number-integer"><description>Page of the source document (1-based, as the PDF
            numbers it) where the item starts</description></field>
        <field name="sourceRegion" type="text-short"><description>Region of the page the item occupies, in PDF points
            from the top left: x0,y0,x1,y1</description></field>
        <field name="provisionTypeEnumId" type="id"><description>What the item provides (AgreementProvisionType), a
            leaf of its families: constitutive (a definition, the scope, an exclusion), regulative (a requirement, a
            prohibition, a recommendation, a permission), procedural, sanction, meta (efficacy, amendment, derogation)
            or informative (a statement, a possibility); empty when not classified</description></field>
        <field name="informative" type="text-indicator"><description>Y for an informative part (an informative annex,
            a bibliography, guidance): read, not met</description></field>
        <field name="listTypeEnumId" type="id"><description>What the list this item introduces is (AgreementListType):
            all of its points apply, one or more of them, they are conditions, or they are the contents of something;
            its points take the provision of this item</description></field>
        <relationship type="one" related="mantle.party.agreement.Agreement"/>
        <relationship type="one" title="AgreementItemType" related="moqui.basic.Enumeration">
            <key-map field-name="agreementItemTypeEnumId"/></relationship>
        <relationship type="one-nofk" title="Parent" related="mantle.party.agreement.AgreementItem" short-alias="parentItem">
            <key-map field-name="agreementId"/><key-map field-name="parentItemSeqId" related="agreementItemSeqId"/></relationship>
        <relationship type="many" title="Child" related="mantle.party.agreement.AgreementItem" short-alias="childItems">
            <key-map field-name="agreementId"/><key-map field-name="agreementItemSeqId" related="parentItemSeqId"/></relationship>
        <relationship type="one-nofk" title="AgreementProvisionType" related="moqui.basic.Enumeration" short-alias="provisionType">
            <key-map field-name="provisionTypeEnumId"/></relationship>
        <relationship type="one-nofk" title="AgreementListType" related="moqui.basic.Enumeration" short-alias="listType">
            <key-map field-name="listTypeEnumId"/></relationship>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <relationship type="one" title="Quantity" related="moqui.basic.Uom" short-alias="quantityUom">
            <key-map field-name="quantityUomId"/></relationship>
        <relationship type="many" related="mantle.party.agreement.AgreementTerm" short-alias="terms">
            <key-map field-name="agreementId"/><key-map field-name="agreementItemSeqId"/></relationship>
        <index name="AGRITEM_PARENT"><index-field name="agreementId"/><index-field name="parentItemSeqId"/></index>
        <seed-data>
            <!-- Agreement Item Type -->
            <moqui.basic.EnumerationType description="Agreement Item Type" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitSubAgreement" description="Sub-Agreement" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitExhibit" description="Exhibit" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitPricing" description="Pricing" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitPurchase" description="Purchase" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitSection" description="Section" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitCommissionRate" description="Commission Rate" enumTypeId="AgreementItemType"/>
            <!-- partitions of a legal or technical text (after Akoma Ntoso): book > part > title > chapter > section >
                 subsection > article > paragraph > subparagraph > point > sub-point > indent; the preamble and its
                 recitals; annexes and their parts; notes, examples, footnotes, formulas, figures, tables and their rows.
                 A numbered clause of a standard, at any level, is an article -->
            <moqui.basic.Enumeration enumId="AitPreamble" description="Preamble" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitRecital" description="Recital" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitBook" description="Book" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitPart" description="Part" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitTitle" description="Title" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitChapter" description="Chapter" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitSubsection" description="Subsection" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitArticle" description="Article" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitParagraph" description="Paragraph" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitSubparagraph" description="Subparagraph" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitPoint" description="Point" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitSubPoint" description="Sub-point" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitIndent" description="Indent" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitAnnex" description="Annex" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitAnnexPart" description="Annex Part" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitNote" description="Note" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitExample" description="Example" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitFootnote" description="Footnote" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitFormula" description="Formula" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitFigure" description="Figure" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitTable" description="Table" enumTypeId="AgreementItemType"/>
            <moqui.basic.Enumeration enumId="AitTableRow" description="Table Row" enumTypeId="AgreementItemType"/>
            <!-- a cell of a table row: the column header (levels joined with ": ") in itemTitle, the value in itemText -->
            <moqui.basic.Enumeration enumId="AitTableCell" description="Table Cell" enumTypeId="AgreementItemType"/>
            <!-- a sentence of an item that holds more than one provision (a requirement and its exemption), so that each
                 provision is an item of its own -->
            <moqui.basic.Enumeration enumId="AitSentence" description="Sentence" enumTypeId="AgreementItemType"/>

            <!-- Agreement Provision Type: what a provision does, in families (parentEnumId) after the provision types of
                 legal informatics (Biagioli), the modifications of Akoma Ntoso and the statements of LegalRuleML. An item
                 takes a leaf; the verbal form of the ISO/IEC Directives, Part 2, is the enumCode of the regulative ones -->
            <moqui.basic.EnumerationType description="Agreement Provision Type" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptfConstitutive" description="Constitutive" sequenceNum="10" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptfRegulative" description="Regulative" sequenceNum="20" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptfProcedural" description="Procedural" sequenceNum="30" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptfSanction" description="Sanction" sequenceNum="40" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptfMeta" description="On Other Provisions" sequenceNum="50" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptfInformative" description="Informative" sequenceNum="60" enumTypeId="AgreementProvisionType"/>
            <!-- constitutive: what the text defines, covers, leaves out or presumes -->
            <moqui.basic.Enumeration enumId="AptDefinition" description="Definition" parentEnumId="AptfConstitutive" sequenceNum="11" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptScope" description="Scope" parentEnumId="AptfConstitutive" sequenceNum="12" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptExclusion" description="Exclusion from Scope" parentEnumId="AptfConstitutive" sequenceNum="13" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptPresumption" description="Presumption" parentEnumId="AptfConstitutive" sequenceNum="14" enumTypeId="AgreementProvisionType"/>
            <!-- the classes, levels or categories the text sets up: security levels, performance levels, important products -->
            <moqui.basic.Enumeration enumId="AptClassification" description="Classification" parentEnumId="AptfConstitutive" sequenceNum="15" enumTypeId="AgreementProvisionType"/>
            <!-- regulative: what someone or something shall, shall not, should or may do -->
            <moqui.basic.Enumeration enumId="AptRequirement" description="Requirement" enumCode="shall" parentEnumId="AptfRegulative" sequenceNum="21" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptProhibition" description="Prohibition" enumCode="shall not" parentEnumId="AptfRegulative" sequenceNum="22" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptRecommendation" description="Recommendation" enumCode="should" parentEnumId="AptfRegulative" sequenceNum="23" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptPermission" description="Permission" enumCode="may" parentEnumId="AptfRegulative" sequenceNum="24" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptRight" description="Right" parentEnumId="AptfRegulative" sequenceNum="25" enumTypeId="AgreementProvisionType"/>
            <!-- procedural: how a conformity assessment, a notification, a verification is carried out -->
            <moqui.basic.Enumeration enumId="AptProcedure" description="Procedure" parentEnumId="AptfProcedural" sequenceNum="31" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptPenalty" description="Penalty" parentEnumId="AptfSanction" sequenceNum="41" enumTypeId="AgreementProvisionType"/>
            <!-- on other provisions: when they apply, how they change, where they give way -->
            <moqui.basic.Enumeration enumId="AptEfficacy" description="Entry into Force or Application" parentEnumId="AptfMeta" sequenceNum="51" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptAmending" description="Amending" parentEnumId="AptfMeta" sequenceNum="52" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptDerogation" description="Derogation" parentEnumId="AptfMeta" sequenceNum="53" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptDelegation" description="Delegation of Power" parentEnumId="AptfMeta" sequenceNum="54" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptTransitional" description="Transitional" parentEnumId="AptfMeta" sequenceNum="55" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptNormativeReference" description="Normative Reference" parentEnumId="AptfMeta" sequenceNum="56" enumTypeId="AgreementProvisionType"/>
            <!-- a saving clause: "Paragraphs 1 and 2 shall not affect", "without prejudice to" other provisions -->
            <moqui.basic.Enumeration enumId="AptSaving" description="Saving Clause" parentEnumId="AptfMeta" sequenceNum="57" enumTypeId="AgreementProvisionType"/>
            <!-- informative: what is read, never met -->
            <moqui.basic.Enumeration enumId="AptPossibility" description="Possibility" enumCode="can" parentEnumId="AptfInformative" sequenceNum="61" enumTypeId="AgreementProvisionType"/>
            <moqui.basic.Enumeration enumId="AptStatement" description="Statement" parentEnumId="AptfInformative" sequenceNum="62" enumTypeId="AgreementProvisionType"/>

            <!-- Agreement List Type: what the points of a list introduced by an item are -->
            <moqui.basic.EnumerationType description="Agreement List Type" enumTypeId="AgreementListType"/>
            <moqui.basic.Enumeration enumId="AltAll" description="All Apply" sequenceNum="1" enumTypeId="AgreementListType"/>
            <moqui.basic.Enumeration enumId="AltAny" description="One or More Apply" sequenceNum="2" enumTypeId="AgreementListType"/>
            <!-- conditions or criteria: "where all of the following are met", "where any of the following criteria is met" -->
            <moqui.basic.Enumeration enumId="AltConditionsAll" description="Conditions, All Met" sequenceNum="3" enumTypeId="AgreementListType"/>
            <moqui.basic.Enumeration enumId="AltConditionsAny" description="Conditions, One or More Met" sequenceNum="4" enumTypeId="AgreementListType"/>
            <moqui.basic.Enumeration enumId="AltContents" description="Contents" sequenceNum="5" enumTypeId="AgreementListType"/>
            <moqui.basic.Enumeration enumId="AltExamples" description="Examples" sequenceNum="6" enumTypeId="AgreementListType"/>
        </seed-data>
    </entity>

