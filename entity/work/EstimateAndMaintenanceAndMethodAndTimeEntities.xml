        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-definition.xsd">
    <!-- ========================================================= -->
    <!-- mantle.work.estimate -->
    <!-- ========================================================= -->
    <entity entity-name="ProductionEstimate" package="mantle.work.estimate" cache="never">
        <field name="productionEstimateId" type="id" is-pk="true"/>
        <field name="estimateName" type="text-medium"/>
        <field name="productId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="destinationFacilityId" type="id"/>
        <field name="quantity" type="number-decimal"/>
        <field name="quantityUomId" type="id"/>
        <field name="readyDate" type="date"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="mantle.facility.Facility"/>
        <relationship type="one" title="Destination" related="mantle.facility.Facility" short-alias="destinationFacility">
            <key-map field-name="destinationFacilityId"/></relationship>
        <relationship type="one" title="Quantity" related="moqui.basic.Uom">
            <key-map field-name="quantityUomId"/></relationship>
        <index name="PRODEST_PDDFRD"><index-field name="productId"/><index-field name="destinationFacilityId"/>
            <index-field name="readyDate"/></index>
    </entity>

    <entity entity-name="ProductionEstimateWorkEff" package="mantle.work.estimate" cache="never">
        <field name="productionEstimateId" type="id" is-pk="true"/>
        <field name="workEffortId" type="id" is-pk="true"/>
        <relationship type="one" related="mantle.work.estimate.ProductionEstimate"/>
        <relationship type="one" related="mantle.work.effort.WorkEffort"/>
    </entity>

    <entity entity-name="ProductionEstimateAsset" package="mantle.work.estimate" cache="never">
        <field name="productionEstimateId" type="id" is-pk="true"/>
        <field name="assetId" type="id" is-pk="true"/>
        <relationship type="one" related="mantle.work.estimate.ProductionEstimate"/>
        <relationship type="one" related="mantle.product.asset.Asset"/>
    </entity>
    <entity entity-name="ProductionEstimateParty" package="mantle.work.estimate" cache="never">
        <field name="productionEstimateId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="roleTypeId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="receiveNotifications" type="text-indicator"/>
        <relationship type="one" related="mantle.work.estimate.ProductionEstimate" short-alias="estimate"/>
        <relationship type="one" related="mantle.party.Party" short-alias="party"/>
        <relationship type="one" related="mantle.party.RoleType" short-alias="role"/>
        <relationship type="one-nofk" related="mantle.party.Person" short-alias="person"/>
        <relationship type="one-nofk" related="mantle.party.Organization" short-alias="organization"/>
        <seed-data>
            <moqui.basic.Enumeration description="ProductionEstimate" enumId="RgpProductionEstimate" enumTypeId="RoleGroup"/>
            <mantle.party.RoleGroupMember roleGroupEnumId="RgpProductionEstimate" roleTypeId="Assignee"/>
            <mantle.party.RoleGroupMember roleGroupEnumId="RgpProductionEstimate" roleTypeId="Manager"/>
            <mantle.party.RoleGroupMember roleGroupEnumId="RgpProductionEstimate" roleTypeId="Reporter"/>
            <mantle.party.RoleGroupMember roleGroupEnumId="RgpProductionEstimate" roleTypeId="Analyst"/>
        </seed-data>
    </entity>
    <entity entity-name="ProductionEstimateBudgetAllocation" package="mantle.work.estimate" cache="never">
        <field name="productionEstimateId" type="id" is-pk="true"/>
        <field name="budgetId" type="id" is-pk="true"/>
        <field name="budgetItemSeqId" type="id" is-pk="true"/>
        <field name="amount" type="currency-amount"/>
        <relationship type="one" related="mantle.other.budget.BudgetItem">
            <key-map field-name="budgetId"/>
            <key-map field-name="budgetItemSeqId"/>
        </relationship>
        <relationship type="one" related="mantle.work.estimate.ProductionEstimate"/>
    </entity>

<!-- Maintenance work orders (IronStone Maintenance design §3 "Record shape", §9 Settings, MT-02; impl-maintenance P3). A work
    order is a root WorkEffort (a WetTask of purpose WepMaintenance with no project) and its MaintenanceWorkOrder row, keyed by the
    root's workEffortId: the row is what makes the root managed, so the generic task and work-effort services refuse it and its
    steps (mantle.work.ProcessServices.check#ManagedWork reads this entity by name, impl-maintenance F59) and only
    mantle.work.MaintenanceServices changes it. Equipment work has one primary AssetMaintenance (assetMaintenanceId), which
    follows the root's status; facility work has none and its facility is WorkEffort.facilityId. The organization's work policy is
    a dated MaintenancePolicy row: a change starts a new row and ends the one in effect. -->
    <entity entity-name="MaintenanceWorkOrder" package="mantle.work.maintenance" cache="never">
        <description>A maintenance work order: the extension of its root WorkEffort (workEffortId), with its target equipment
            (assetId; a facility's work has none and names WorkEffort.facilityId), its primary AssetMaintenance, its kind, type,
            source, severity and failure mode, the hold and cancel reasons and the status a hold came from, the outcome and the
            resource disposition entered at completion, the cost centre and the project a repair is charged to, a revision every
            write increments (a stale write is refused naming the current one) and the operation key and request it was created
            with (a retry answers the first root; changed input under the key is refused).</description>
        <field name="workEffortId" type="id" is-pk="true"/>
        <field name="assetId" type="id" enable-audit-log="update"/>
        <field name="assetMaintenanceId" type="id"><description>The primary AssetMaintenance of equipment work, made at
            create or adopted (adopt#MaintenanceRecord); it follows the root's status</description></field>
        <field name="maintenanceKindEnumId" type="id" enable-audit-log="update"><description>MaintenanceKind: corrective or
            preventive</description></field>
        <field name="maintenanceTypeEnumId" type="id"><description>MaintenanceType (an AssetMaintenance's type)</description></field>
        <field name="sourceEnumId" type="id"><description>MaintenanceSource: how the work came</description></field>
        <field name="severityEnumId" type="id"/>
        <field name="failureModeEnumId" type="id"/>
        <field name="holdReasonEnumId" type="id"/>
        <field name="holdFromStatusId" type="id"><description>The status the root was in when held, which Resume returns
            to</description></field>
        <field name="cancelReasonEnumId" type="id"/>
        <field name="outcomeEnumId" type="id"><description>MaintenanceOutcome, entered at completion</description></field>
        <field name="dispositionEnumId" type="id"><description>MaintenanceDisposition: the resource's state the technician
            declared at completion (completion does not imply restoration)</description></field>
        <field name="costCenterId" type="id" enable-audit-log="update"/>
        <field name="projectWorkEffortId" type="id" enable-audit-log="update"/>
        <field name="procedureWorkEffortId" type="id"><description>The procedure (a template root) the work was made from
            (impl-maintenance P6); its steps are the root's tree, each linked to its template step (WeatBasedOn)</description></field>
        <field name="procedureDate" type="date-time"><description>When the work was made from the procedure: the definition
            and instructions in effect then are the work's</description></field>
        <field name="revision" type="number-integer"/>
        <!-- P5: downtime (design §3 WorkDowntime) -->
        <field name="offlineIntent" type="text-indicator"><description>Y: starting the work takes its equipment or facility out
            of service (records or links its outage)</description></field>
        <field name="resourceUnavailabilityId" type="id"><description>The outage of the target this work order recorded or
            linked (mantle.work.effort.ResourceUnavailability); a restoration (end#ResourceUnavailability) lists the open work
            orders linked to it, which stay open, and needs a reason while any is</description></field>
        <field name="operationKey" type="text-medium"/>
        <field name="operationHash" type="text-medium"/>
        <relationship type="one" related="mantle.work.effort.WorkEffort" short-alias="workEffort"/>
        <relationship type="one" related="mantle.product.asset.Asset" short-alias="asset"/>
        <relationship type="one" related="mantle.product.maintenance.AssetMaintenance" short-alias="assetMaintenance"/>
        <relationship type="one" title="MaintenanceKind" related="moqui.basic.Enumeration" short-alias="kind">
            <key-map field-name="maintenanceKindEnumId"/></relationship>
        <relationship type="one" title="MaintenanceType" related="moqui.basic.Enumeration" short-alias="type">
            <key-map field-name="maintenanceTypeEnumId"/></relationship>
        <relationship type="one" title="MaintenanceSource" related="moqui.basic.Enumeration" short-alias="source">
            <key-map field-name="sourceEnumId"/></relationship>
        <relationship type="one" title="MaintenanceSeverity" related="moqui.basic.Enumeration" short-alias="severity">
            <key-map field-name="severityEnumId"/></relationship>
        <relationship type="one" title="MaintenanceFailureMode" related="moqui.basic.Enumeration" short-alias="failureMode">
            <key-map field-name="failureModeEnumId"/></relationship>
        <relationship type="one" title="MaintenanceHoldReason" related="moqui.basic.Enumeration" short-alias="holdReason">
            <key-map field-name="holdReasonEnumId"/></relationship>
        <relationship type="one" title="MaintenanceCancelReason" related="moqui.basic.Enumeration" short-alias="cancelReason">
            <key-map field-name="cancelReasonEnumId"/></relationship>
        <relationship type="one" title="MaintenanceOutcome" related="moqui.basic.Enumeration" short-alias="outcome">
            <key-map field-name="outcomeEnumId"/></relationship>
        <relationship type="one" title="MaintenanceDisposition" related="moqui.basic.Enumeration" short-alias="disposition">
            <key-map field-name="dispositionEnumId"/></relationship>
        <relationship type="one-nofk" title="Project" related="mantle.work.effort.WorkEffort" short-alias="project">
            <key-map field-name="projectWorkEffortId" related="workEffortId"/></relationship>
        <index name="MNT_WO_ASSET_MNT"><index-field name="assetMaintenanceId"/></index>
        <index name="MNT_WO_OPKEY"><index-field name="operationKey"/></index>
        <index name="MNT_WO_ASSET"><index-field name="assetId"/></index>
        <index name="MNT_WO_PROCEDURE"><index-field name="procedureWorkEffortId"/></index>
        <index name="MNT_WO_OUTAGE"><index-field name="resourceUnavailabilityId"/></index>
    </entity>

    <entity entity-name="MaintenancePolicy" package="mantle.work.maintenance" cache="never">
        <description>An organization's maintenance work policy from fromDate (design-maintenance §9 MaintenanceSettings): the
            default maintenance type and team of new work, the planned-work approval threshold in hours (template, preventive
            and planned work above it needs a supervisor's approval; zero, the default, puts all of it before a supervisor, and
            work with no estimated hours is over it), its cost half (an estimated-cost threshold with its currency, unset by
            default; impl-maintenance P11), the closure policy (a supervisor
            closes completed work, or completion closes it) and whether the organization's production maintenance requests and
            warranty repairs become managed work (off by default; the adapters are later phases'), whether a procedure's
            last author may approve it (off by default), and whether a technician's voice note on a checklist step is sent to the
            speech model to be transcribed (off by default; the audio is kept either way). A change ends the row in
            effect and starts the next; with no row the defaults hold.</description>
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="defaultMaintenanceTypeEnumId" type="id"/>
        <field name="defaultTeamPartyId" type="id"/>
        <field name="approvalThresholdHours" type="number-decimal"/>
        <field name="closurePolicyEnumId" type="id"><description>MaintenanceClosurePolicy</description></field>
        <field name="productionRequestsManaged" type="text-indicator"/>
        <field name="warrantyRepairsManaged" type="text-indicator"/>
        <field name="procedureSelfApproval" type="text-indicator"><description>Y: a procedure's last author may approve it
            (off by default; impl-maintenance P6)</description></field>
        <field name="voiceNoteTranscription" type="text-indicator"><description>Y: a checklist step's voice note is transcribed
            by SpeechServices.transcribe#Audio (off by default; impl-maintenance P7 review, the user's call of Nov 12)</description></field>
        <!-- impl-maintenance P11 (§4): the threshold's cost half, unset by default and compared only where set; the work's
            estimated cost is computed at the Approve gate and never stored (MaintenanceCosts.js) -->
        <field name="approvalThresholdCost" type="currency-amount"><description>Planned work whose estimated cost (its planned
            parts at their approved standard cost and its estimated hours at the costing rate) is above this, or cannot be
            priced, needs a supervisor's approval; empty: not compared</description></field>
        <field name="approvalThresholdCurrencyUomId" type="id"><description>The threshold's currency; empty: the
            organization's base currency</description></field>
        <!-- impl-maintenance P8 (design §9 MaintenanceSettings, review Y8): the qualification check of assignment and Start -->
        <field name="qualificationBlocks" type="text-indicator"><description>Y: assigning or starting work with a technician whose
            required qualification is missing or expired is refused; empty or N (the default): it is allowed with a
            warning</description></field>
        <field name="changedByUserId" type="id"/>
        <field name="comments" type="text-medium"/>
        <relationship type="one" title="Organization" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="DefaultTeam" related="mantle.party.Party" short-alias="defaultTeam">
            <key-map field-name="defaultTeamPartyId" related="partyId"/></relationship>
        <relationship type="one" title="DefaultMaintenanceType" related="moqui.basic.Enumeration" short-alias="defaultType">
            <key-map field-name="defaultMaintenanceTypeEnumId"/></relationship>
        <relationship type="one" title="MaintenanceClosurePolicy" related="moqui.basic.Enumeration" short-alias="closurePolicy">
            <key-map field-name="closurePolicyEnumId"/></relationship>
    </entity>

<!-- Preventive maintenance plans (IronStone Maintenance design §5.1, Plans and PlanDetail, MT-05; impl-maintenance P13). A plan
    (MaintenanceSchedule) names one piece of equipment or one facility, optionally the equipment model's maintenance default
    (ProductMaintenance) it follows, and its organization (the target's, kept for the scoped list). Its dated terms
    (MaintenanceScheduleTerm) carry one trigger, calendar or meter, and what the due projection reads; a change of an active
    plan's terms ends the term in effect and starts the next, so earlier terms and the work done under them stay as they were. A
    term field left empty takes the model default's value (the plan shows the origin of each). Only
    mantle.work.MaintenancePlanServices writes these; P14 adds the occurrences and sets a generated work order's plan. -->
    <entity entity-name="MaintenanceSchedule" package="mantle.work.maintenance" cache="never">
        <description>A preventive maintenance plan of one piece of equipment (assetId) or one facility (facilityId), never both:
            its name, the equipment model's maintenance default it follows (productMaintenanceId, equipment only), its
            organization (the target's when the plan was made), its state (draft, active, ended; activation checks the time zone
            and a named procedure, an end needs a reason), a revision every write increments (a stale write is refused naming the
            current one) and the operation key and request it was created with (a retry answers the first plan).</description>
        <field name="maintenanceScheduleId" type="id" is-pk="true"/>
        <field name="scheduleName" type="text-medium"/>
        <field name="organizationPartyId" type="id"/>
        <field name="assetId" type="id"/>
        <field name="facilityId" type="id"/>
        <field name="productMaintenanceId" type="id"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time"><description>When the plan was activated</description></field>
        <field name="thruDate" type="date-time"><description>When the plan was ended</description></field>
        <field name="endReason" type="text-medium"/>
        <field name="revision" type="number-integer"/>
        <field name="createdByUserId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="operationKey" type="text-medium"/>
        <field name="operationHash" type="text-medium"/>
        <relationship type="one" title="Organization" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.product.asset.Asset" short-alias="asset"/>
        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
        <relationship type="one" related="mantle.product.maintenance.ProductMaintenance" short-alias="productMaintenance"/>
        <relationship type="one" title="MaintenanceSchedule" related="moqui.basic.StatusItem" short-alias="status">
            <key-map field-name="statusId"/></relationship>
        <relationship type="many" related="mantle.work.maintenance.MaintenanceScheduleTerm" short-alias="terms">
            <key-map field-name="maintenanceScheduleId"/></relationship>
        <index name="MNT_SCH_ORG"><index-field name="organizationPartyId"/></index>
        <index name="MNT_SCH_ASSET"><index-field name="assetId"/></index>
        <index name="MNT_SCH_FACILITY"><index-field name="facilityId"/></index>
        <index name="MNT_SCH_OPKEY"><index-field name="operationKey"/></index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="MaintenanceSchedule" description="Maintenance Plan Status"/>
            <moqui.basic.StatusItem statusId="MschDraft" statusTypeId="MaintenanceSchedule" sequenceNum="1" description="Draft"/>
            <moqui.basic.StatusItem statusId="MschActive" statusTypeId="MaintenanceSchedule" sequenceNum="2" description="Active"/>
            <moqui.basic.StatusItem statusId="MschEnded" statusTypeId="MaintenanceSchedule" sequenceNum="3" description="Ended"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MschDraft" toStatusId="MschActive" transitionName="Activate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MschDraft" toStatusId="MschEnded" transitionName="End"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MschActive" toStatusId="MschEnded" transitionName="End"/>

            <moqui.basic.EnumerationType enumTypeId="MaintenanceScheduleTrigger" description="Maintenance Plan Trigger"/>
            <moqui.basic.Enumeration enumId="MstCalendar" enumTypeId="MaintenanceScheduleTrigger" sequenceNum="1" description="Calendar"/>
            <moqui.basic.Enumeration enumId="MstMeter" enumTypeId="MaintenanceScheduleTrigger" sequenceNum="2" description="Meter"/>
            <moqui.basic.EnumerationType enumTypeId="MaintenanceScheduleCadence" description="Maintenance Plan Calendar Cadence"/>
            <moqui.basic.Enumeration enumId="MscFixed" enumTypeId="MaintenanceScheduleCadence" sequenceNum="1"
                    description="Fixed dates from the first due date"/>
            <moqui.basic.Enumeration enumId="MscCompletion" enumTypeId="MaintenanceScheduleCadence" sequenceNum="2"
                    description="From the last completion"/>
        </seed-data>
    </entity>

    <entity entity-name="MaintenanceScheduleTerm" package="mantle.work.maintenance" cache="never">
        <description>A plan's terms from fromDate (the one in effect has no thruDate in the past). One trigger: a calendar
            (intervalQuantity of intervalUomId: days, weeks, months or years; a fixed cadence from firstDueLocal, the first
            obligation's local date and time in the target's time zone, or from the last completion; a due date that falls on a weekend or
            holiday is planned on the next business day when businessDaysOnly, the due date kept; holidays of the organization
            and of holidayCategoryId, a People holiday calendar) or a meter (productMeterId, a counting meter of the equipment's
            model, every intervalQuantity of its unit from the baseline reading baselineValue at baselineDate; a reading older
            than maxReadingAgeDays leaves the due unknown). The procedure (templateWorkEffortId; optional: with none the work is
            an ad hoc work order with the plan's name and estimatedWorkTime, hours), the maintenance type, the lead days before
            the due date and the team. A draft's terms are changed in place; from activation they are dated rows. A field left empty takes the plan's model default's value. The trigger fields
            are audit-logged, and a change starts a new row with its reason.</description>
        <field name="maintenanceScheduleId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time"/>
        <field name="triggerEnumId" type="id" enable-audit-log="update"/>
        <field name="cadenceEnumId" type="id" enable-audit-log="update"/>
        <field name="intervalQuantity" type="number-decimal" enable-audit-log="update"/>
        <field name="intervalUomId" type="id" enable-audit-log="update"/>
        <field name="firstDueLocal" type="text-short" enable-audit-log="update"><description>The first obligation as a local date
            and time in the target's time zone (yyyy-MM-dd HH:mm), not an instant: its wall time holds across a daylight-saving
            change and a move of the zone</description></field>
        <field name="productMeterId" type="id" enable-audit-log="update"/>
        <field name="baselineValue" type="number-decimal" enable-audit-log="update"/>
        <field name="baselineDate" type="date-time" enable-audit-log="update"/>
        <field name="maxReadingAgeDays" type="number-integer"/>
        <field name="businessDaysOnly" type="text-indicator"/>
        <field name="holidayCategoryId" type="id"/>
        <field name="leadDays" type="number-integer"/>
        <field name="templateWorkEffortId" type="id"/>
        <field name="maintenanceTypeEnumId" type="id"/>
        <field name="teamPartyId" type="id"/>
        <field name="estimatedWorkTime" type="number-decimal"><description>The hours the work takes: P14's ad hoc work order of a
            plan with no procedure carries it (the user's call, Nov 12)</description></field>
        <field name="changeReason" type="text-medium"/>
        <field name="changedByUserId" type="id"/>
        <relationship type="one" related="mantle.work.maintenance.MaintenanceSchedule" short-alias="schedule"/>
        <relationship type="one" title="MaintenanceScheduleTrigger" related="moqui.basic.Enumeration" short-alias="trigger">
            <key-map field-name="triggerEnumId"/></relationship>
        <relationship type="one" title="MaintenanceScheduleCadence" related="moqui.basic.Enumeration" short-alias="cadence">
            <key-map field-name="cadenceEnumId"/></relationship>
        <relationship type="one" title="Interval" related="moqui.basic.Uom" short-alias="intervalUom">
            <key-map field-name="intervalUomId" related="uomId"/></relationship>
        <relationship type="one" related="mantle.product.maintenance.ProductMeter" short-alias="meter"/>
        <relationship type="one-nofk" title="HolidayCalendar" related="mantle.work.effort.WorkEffortCategory" short-alias="holidayCalendar">
            <key-map field-name="holidayCategoryId" related="workEffortCategoryId"/></relationship>
        <relationship type="one" title="Template" related="mantle.work.effort.WorkEffort" short-alias="procedure">
            <key-map field-name="templateWorkEffortId" related="workEffortId"/></relationship>
        <relationship type="one" title="MaintenanceType" related="moqui.basic.Enumeration" short-alias="maintenanceType">
            <key-map field-name="maintenanceTypeEnumId"/></relationship>
        <relationship type="one" title="Team" related="mantle.party.Party" short-alias="team">
            <key-map field-name="teamPartyId" related="partyId"/></relationship>
    </entity>

    <!-- P14 (design §5.1 occurrences, DueMaintenance, PlanDetail's Due history, §8 PreventiveComplianceReport): an obligation of a
        plan has its own identity, apart from the work that executes it -->
    <entity entity-name="MaintenanceOccurrence" package="mantle.work.maintenance" cache="never">
        <description>One obligation of a plan, kept once it is acted on: generated (work made for it), completed (that work
            complete or closed), skipped (with a reason), coalesced into a catch-up (coveredByOccurrenceId, whose work counts for it),
            or open again (its work cancelled: a cancellation is no completion). obligationKey names the obligation within its plan
            (a calendar plan's local due date and time in the target's zone, "yyyy-MM-dd HH:mm"; a meter plan's "meter" and its
            threshold) and is unique with the plan, so a planner's and the job's generation of the same obligation make one row
            and one work order (impl-maintenance F52, F112: a real unique key). dueDate (a calendar obligation's instant) or
            dueThreshold (a meter's) and termFromDate (the term it fell under, impl-maintenance F186) are fixed when it is
            recorded. A completion is counted once (completedDate); a correction leaves its work order as it was, opens the
            obligation again and names the work no longer counted (uncountedWorkEffortId, with its reason). Only mantle.work.MaintenancePlanServices and the work order's lifecycle
            write these.</description>
        <field name="maintenanceOccurrenceId" type="id" is-pk="true"/>
        <field name="maintenanceScheduleId" type="id"/>
        <field name="obligationKey" type="text-short"/>
        <field name="dueDate" type="date-time"/>
        <field name="dueLocal" type="text-short"><description>The calendar obligation as its local date and time in the target's
            zone (yyyy-MM-dd HH:mm)</description></field>
        <field name="dueThreshold" type="number-decimal"/>
        <field name="termFromDate" type="date-time"/>
        <field name="statusId" type="id" enable-audit-log="update"/>
        <field name="workEffortId" type="id" enable-audit-log="update"><description>The work order made for it (none once that
            work is cancelled; the audit log keeps which it was)</description></field>
        <field name="catchUp" type="text-indicator"><description>Y: the catch-up of missed obligations coalesced into it</description></field>
        <field name="coveredByOccurrenceId" type="id"/>
        <field name="generatedDate" type="date-time"/>
        <field name="generatedByUserId" type="id"><description>Empty when the scheduled job made it</description></field>
        <field name="operationKey" type="text-medium"/>
        <field name="completedDate" type="date-time"/>
        <field name="uncountedWorkEffortId" type="id" enable-audit-log="update"><description>A completion corrected as not
            counted for this obligation: its work order stays as it was and no longer advances the plan</description></field>
        <field name="decisionReason" type="text-medium"/>
        <field name="decidedByUserId" type="id"/>
        <field name="decidedDate" type="date-time"/>
        <field name="revision" type="number-integer"/>
        <relationship type="one" related="mantle.work.maintenance.MaintenanceSchedule" short-alias="schedule"/>
        <relationship type="one" title="MaintenanceOccurrence" related="moqui.basic.StatusItem" short-alias="status">
            <key-map field-name="statusId"/></relationship>
        <relationship type="one-nofk" related="mantle.work.effort.WorkEffort" short-alias="workEffort"/>
        <relationship type="one-nofk" title="CoveredBy" related="mantle.work.maintenance.MaintenanceOccurrence" short-alias="coveredBy">
            <key-map field-name="coveredByOccurrenceId" related="maintenanceOccurrenceId"/></relationship>
        <index name="MNT_OCC_KEY" unique="true"><index-field name="maintenanceScheduleId"/><index-field name="obligationKey"/></index>
        <index name="MNT_OCC_WORK"><index-field name="workEffortId"/></index>
        <index name="MNT_OCC_DUE"><index-field name="dueDate"/></index>
        <seed-data>
            <moqui.basic.StatusType statusTypeId="MaintenanceOccurrence" description="Maintenance Obligation Status"/>
            <moqui.basic.StatusItem statusId="MocOpen" statusTypeId="MaintenanceOccurrence" sequenceNum="1" description="Open"/>
            <moqui.basic.StatusItem statusId="MocGenerated" statusTypeId="MaintenanceOccurrence" sequenceNum="2" description="Work made"/>
            <moqui.basic.StatusItem statusId="MocCompleted" statusTypeId="MaintenanceOccurrence" sequenceNum="3" description="Completed"/>
            <moqui.basic.StatusItem statusId="MocSkipped" statusTypeId="MaintenanceOccurrence" sequenceNum="4" description="Skipped"/>
            <moqui.basic.StatusItem statusId="MocCoalesced" statusTypeId="MaintenanceOccurrence" sequenceNum="5" description="Coalesced"/>
            <!-- generated, skipped or coalesced from open; completed, or open again (cancelled), from generated; open again from
                completed (a correction) and from coalesced (its catch-up cancelled or corrected) -->
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocOpen" toStatusId="MocGenerated" transitionName="Generate"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocOpen" toStatusId="MocSkipped" transitionName="Skip"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocOpen" toStatusId="MocCoalesced" transitionName="Coalesce"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocGenerated" toStatusId="MocCompleted" transitionName="Complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocGenerated" toStatusId="MocOpen" transitionName="Reopen"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocCompleted" toStatusId="MocOpen" transitionName="Correct"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="MocCoalesced" toStatusId="MocOpen" transitionName="Reopen"/>
        </seed-data>
    </entity>

<!-- Maintenance's lookups (IronStone Maintenance design §9 Lookups FailureModes; impl-maintenance P18): a failure mode (an
    Enumeration of MaintenanceFailureMode, ended by People's Enumeration.thruDate) applies to every piece of equipment, or, once it
    has applicability rows in effect, to the equipment of those asset classes and models alone. A row is dated and ended, never
    deleted (mantle.work.MaintenanceSettingsServices.store#MaintenanceLookup). -->
    <entity entity-name="MaintenanceLookupApplicability" package="mantle.work.maintenance" cache="never">
        <description>Where a maintenance lookup value applies, from fromDate to thruDate: equipment of an asset class (classEnumId,
            AssetClass) or of a model (productId), one of the two. A value with no row in effect applies everywhere.</description>
        <field name="applicabilityId" type="id" is-pk="true"/>
        <field name="enumId" type="id"/>
        <field name="classEnumId" type="id"/>
        <field name="productId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="createdByUserId" type="id"/>
        <relationship type="one" related="moqui.basic.Enumeration" short-alias="value"/>
        <relationship type="one" title="AssetClass" related="moqui.basic.Enumeration" short-alias="assetClass">
            <key-map field-name="classEnumId" related="enumId"/></relationship>
        <relationship type="one" related="mantle.product.Product" short-alias="product"/>
        <index name="MNT_LKP_APPL_ENUM"><index-field name="enumId"/></index>
    </entity>

    <!-- impl-maintenance P8 (design-maintenance §9 Teams TeamDefaults, review Y4): a team is People's (an OrgTeam Organization with
        dated PrtMember rows, written by mantle.humanres.OrganizationServices); Maintenance owns only its dispatch defaults. -->
    <entity entity-name="MaintenanceTeamDefaults" package="mantle.work.maintenance" cache="never">
        <description>A maintenance team's dispatch and intake defaults from fromDate (mantle.work.MaintenanceSettingsServices
            .store#MaintenanceTeamDefaults; a change ends the row in effect and starts the next, nothing is deleted): the resource
            scope (a facility and those under it whose work the team takes by default), the default assignee (a member of the team),
            and the project its work is charged to by default (the plus-tag of its intake address is the team's PartySetting
            MntIntakePlusTag, which the mail intake reads, impl-maintenance P4). The defaults grant nothing: membership and these
            rows give no permission and move no custody.</description>
        <field name="teamPartyId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="organizationPartyId" type="id"><description>The team's organization (its ownerPartyId when written)</description></field>
        <field name="facilityId" type="id"><description>The resource scope: this facility and those under it</description></field>
        <field name="defaultAssigneePartyId" type="id"/>
        <field name="projectWorkEffortId" type="id"/>
        <field name="changedByUserId" type="id"/>
        <field name="comments" type="text-medium"/>
        <relationship type="one" title="Team" related="mantle.party.Party" short-alias="team">
            <key-map field-name="teamPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Organization" related="mantle.party.Party" short-alias="organization">
            <key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
        <relationship type="one" title="DefaultAssignee" related="mantle.party.Party" short-alias="defaultAssignee">
            <key-map field-name="defaultAssigneePartyId" related="partyId"/></relationship>
        <relationship type="one" title="Project" related="mantle.work.effort.WorkEffort" short-alias="project">
            <key-map field-name="projectWorkEffortId" related="workEffortId"/></relationship>
        <index name="MNT_TEAM_DEF_ORG"><index-field name="organizationPartyId"/></index>
    </entity>

    <entity entity-name="MethodReleaseDecision" package="mantle.work.method" create-only="true">
        <description>An approval fact, not a method version. Audit references identify the values approved; stamped line facts are its children.</description>
        <field name="methodReleaseDecisionId" type="id" is-pk="true"/>
        <field name="methodEntityName" type="text-medium" enable-audit-log="true"/>
        <field name="methodId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="inputFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="auditRefsJson" type="text-very-long" enable-audit-log="true"/>
    </entity>

    <entity entity-name="MethodReleaseItem" package="mantle.work.method" create-only="true">
        <field name="methodReleaseDecisionId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="number-integer" is-pk="true"/>
        <field name="lineEntityName" type="text-medium" enable-audit-log="true"/>
        <field name="lineId" type="id" enable-audit-log="true"/>
        <field name="action" type="text-short" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="previousFromDate" type="date-time" enable-audit-log="true"/>
        <relationship type="one" related="mantle.work.method.MethodReleaseDecision"/>
    </entity>

    <!-- ========================================================= -->
    <!-- mantle.work.time -->
    <!-- ========================================================= -->
    <entity entity-name="TimeEntry" package="mantle.work.time" short-alias="timeEntries" cache="never">
        <field name="timeEntryId" type="id" is-pk="true"/>
        <field name="parentEntryId" type="id"/>
        <field name="timesheetId" type="id"/>
        <field name="partyId" type="id"><description>The party performing work (worker, may be the vendor or work for the vendor)</description></field>
        <field name="teamPartyId" type="id"/>
        <field name="vendorPartyId" type="id"><description>The vendor (employer, etc) who pays the worker.
            With workEffortId (task or project) the party in the Vendor role, with facilityId the party in the Manager role</description></field>
        <field name="clientPartyId" type="id"><description>The client who pays the vendor for bill through.
            May get through timesheetId, workEffortId (with Customer or CustomerBillTo role), or facilityId (Facility.ownerPartyId)</description></field>
        <field name="rateTypeEnumId" type="id"/>
        <field name="rateModifierEnumId" type="id"/>
        <field name="workTypeEnumId" type="id"/>
        <field name="emplPositionClassId" type="id"/>
        <field name="hasModifiedRates" type="text-indicator"><description>Set to Y when *Rate fields are manually set and not from RateAmount lookups</description></field>
        <field name="rateAmountId" type="id"><description>Client/customer hourly RateAmount reference</description></field>
        <field name="clientHourRate" type="number-decimal"/>
        <field name="vendorRateAmountId" type="id"><description>Vendor/worker hourly RateAmount reference</description></field>
        <field name="vendorHourRate" type="number-decimal" ai-opt-out="true"><description>The worker's rate, an employee's pay
            rate copied on the entry: opted out of AI (IronStone People PE-21, the user's call of Nov 12, 2026), as a view's alias of
            it is</description></field>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <field name="hours" type="number-decimal"/>
        <field name="breakHours" type="number-decimal"><description>Non-paid break hours e.g. Lunch</description></field>
        <field name="pieceCount" type="number-decimal"/>
        <field name="pieceRateTypeEnumId" type="id"/>
        <field name="pieceRateAmountId" type="id"><description>Client/customer piece RateAmount reference</description></field>
        <field name="clientPieceRate" type="number-decimal"/>
        <field name="vendorPieceRateAmountId" type="id"><description>Vendor/worker piece RateAmount reference</description></field>
        <field name="vendorPieceRate" type="number-decimal" ai-opt-out="true"><description>The worker's piece rate: opted out of
            AI as vendorHourRate is</description></field>
        <field name="comments" type="text-long"/>
        <field name="facilityId" type="id"><description>Where the work was done; if null and workEffortId is set get from WorkEffort.facilityId</description></field>
        <field name="workEffortId" type="id"/>
        <field name="invoiceId" type="id"/>
        <field name="invoiceItemSeqId" type="id"/>
        <field name="vendorInvoiceId" type="id"/>
        <field name="vendorInvoiceItemSeqId" type="id"/>
        <relationship type="one" related="mantle.work.time.Timesheet" short-alias="timesheet"/>
        <relationship type="one" title="Parent" related="mantle.work.time.TimeEntry" short-alias="parentEntry">
            <key-map field-name="parentEntryId"/></relationship>
        <relationship type="one" related="mantle.party.Party" short-alias="party"/>
        <relationship type="one-nofk" related="mantle.party.Person" short-alias="person"/>
        <relationship type="one" title="Team" related="mantle.party.Party" short-alias="teamParty">
            <key-map field-name="teamPartyId"/></relationship>
        <relationship type="one" title="Client" related="mantle.party.Party" short-alias="clientParty">
            <key-map field-name="clientPartyId"/></relationship>
        <relationship type="one" title="RateType" related="moqui.basic.Enumeration" short-alias="rateType">
            <key-map field-name="rateTypeEnumId"/></relationship>
        <relationship type="one" title="RateModifier" related="moqui.basic.Enumeration" short-alias="rateModifier">
            <key-map field-name="rateModifierEnumId"/></relationship>
        <relationship type="one" title="WorkType" related="moqui.basic.Enumeration" short-alias="workType">
            <key-map field-name="workTypeEnumId"/></relationship>
        <relationship type="one" related="mantle.humanres.position.EmplPositionClass" short-alias="emplPositionClass"/>
        <relationship type="one" related="mantle.humanres.rate.RateAmount" short-alias="rateAmount"/>
        <relationship type="one" title="Vendor" related="mantle.humanres.rate.RateAmount" short-alias="vendorRateAmount">
            <key-map field-name="vendorRateAmountId"/></relationship>
        <relationship type="one" title="PieceRateType" related="moqui.basic.Enumeration" short-alias="pieceRateType">
            <key-map field-name="pieceRateTypeEnumId"/></relationship><!-- Uses enumTypeId = RateType -->
        <relationship type="one" title="Piece" related="mantle.humanres.rate.RateAmount" short-alias="pieceRateAmount">
            <key-map field-name="pieceRateAmountId"/></relationship>
        <relationship type="one" title="VendorPiece" related="mantle.humanres.rate.RateAmount" short-alias="vendorPieceRateAmount">
            <key-map field-name="vendorPieceRateAmountId"/></relationship>

        <relationship type="one" related="mantle.facility.Facility" short-alias="facility"/>
        <relationship type="one" related="mantle.work.effort.WorkEffort" short-alias="workEffort"/>
        <relationship type="one" related="mantle.account.invoice.InvoiceItem" short-alias="invoiceItem">
            <key-map field-name="invoiceId"/>
            <key-map field-name="invoiceItemSeqId"/>
        </relationship>
        <relationship type="one" title="Vendor" related="mantle.account.invoice.InvoiceItem" short-alias="vendorInvoiceItem">
            <key-map field-name="vendorInvoiceId" related="invoiceId"/>
            <key-map field-name="vendorInvoiceItemSeqId" related="invoiceItemSeqId"/>
        </relationship>
    </entity>

    <entity entity-name="Timesheet" package="mantle.work.time" cache="never">
        <field name="timesheetId" type="id" is-pk="true"/>
        <field name="partyId" type="id"/>
        <field name="clientPartyId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>
        <field name="statusId" type="id" enable-audit-log="true"/>
        <field name="comments" type="text-medium"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" title="Client" related="mantle.party.Party">
            <key-map field-name="clientPartyId"/></relationship>
        <relationship type="one" title="Timesheet" related="moqui.basic.StatusItem"/>
        <seed-data>
            <!-- Timesheet Status -->
            <moqui.basic.StatusType description="Timesheet" statusTypeId="Timesheet"/>
            <moqui.basic.StatusItem description="In-Process" sequenceNum="1" statusId="TmshInProcess" statusTypeId="Timesheet"/>
            <moqui.basic.StatusItem description="Completed" sequenceNum="2" statusId="TmshCompleted" statusTypeId="Timesheet"/>
            <moqui.basic.StatusItem description="Approved" sequenceNum="3" statusId="TmshApproved" statusTypeId="Timesheet"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TmshInProcess" toStatusId="TmshCompleted" transitionName="Confirm complete"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TmshCompleted" toStatusId="TmshApproved" transitionName="Approve"/>
            <!-- IronStone Projects (design-projects.md §8, §15 Timesheet services): an approver returns a submitted timesheet with a
                reason, and reopens an approved one until any of its entries is invoiced (mantle.work.TimesheetServices) -->
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TmshCompleted" toStatusId="TmshInProcess" transitionName="Return"/>
            <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="TmshApproved" toStatusId="TmshInProcess" transitionName="Reopen"/>
        </seed-data>
    </entity>

    <entity entity-name="TimesheetParty" package="mantle.work.time" cache="never">
        <field name="timesheetId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true"/>
        <field name="roleTypeId" type="id" is-pk="true"/>
        <relationship type="one" related="mantle.work.time.Timesheet"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" related="mantle.party.RoleType"/>
    </entity>
</entities>
