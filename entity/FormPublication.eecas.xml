<!-- Commons form invitations (FormPublicationEntities.xml; impl-customer-service P13, CS-FEEDBACK) and case feedback. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <!-- A response that answers a FormInvitation is kept as submitted: the framework's update#FormResponse and
        delete#FormResponse, and any other write of its rows, are refused (RESPONSE_LOCKED). A response with no invitation
        is not touched, so the framework services work for it as before. -->
    <eeca id="InvitedFormResponseImmutable" entity="moqui.screen.form.FormResponse" on-update="true" on-delete="true"
            run-before="true" run-on-error="false">
        <actions><script>ec.resource.script('component://mr-mantle/service/mantle/party/FormPublication.js')
            .guardResponse(formResponseId)</script></actions>
    </eeca>
    <eeca id="InvitedFormResponseAnswerImmutable" entity="moqui.screen.form.FormResponseAnswer" on-create="true"
            on-update="true" on-delete="true" run-before="true" run-on-error="false" get-entire-entity="true">
        <actions><script>ec.resource.script('component://mr-mantle/service/mantle/party/FormPublication.js')
            .guardResponse(formResponseId)</script></actions>
    </eeca>
    <!-- An invitation that has its response keeps it: a change of its formResponseId, or a delete of the invitation, is
        refused (RESPONSE_LOCKED), so the response cannot be unlinked past the rules above. -->
    <eeca id="AnsweredFormInvitationKeepsResponse" entity="mantle.party.FormInvitation" on-update="true" run-before="true"
            run-on-error="false" get-entire-entity="true" get-original-value="true">
        <condition><expression>originalValue != null &amp;&amp; originalValue.formResponseId</expression></condition>
        <actions><script>ec.resource.script('component://mr-mantle/service/mantle/party/FormPublication.js')
            .guardInvitation(invitationId, formResponseId, originalValue.formResponseId)</script></actions>
    </eeca>
    <eeca id="AnsweredFormInvitationNotDeleted" entity="mantle.party.FormInvitation" on-delete="true" run-before="true"
            run-on-error="false" get-entire-entity="true">
        <condition><expression>formResponseId</expression></condition>
        <actions><script>ec.resource.script('component://mr-mantle/service/mantle/party/FormPublication.js')
            .guardInvitation(invitationId, null, formResponseId, true)</script></actions>
    </eeca>
    <!-- IronStone Customer Service (impl-customer-service P13, CS-FEEDBACK): a case resolved (its status set Completed from
        any path) is offered for feedback after the commit (mantle.request.CaseFeedbackServices.queue#Invitation): an
        invitation under its organization's FeedbackDeliveryPolicy, which the send job mails after the policy's delay. A
        request that is not a case, or an organization with no policy, makes nothing. -->
    <eeca id="SupportCaseFeedbackInvitation" entity="mantle.request.Request" on-update="true" get-entire-entity="true"
            get-original-value="true">
        <condition><expression>statusId == 'ReqCompleted' &amp;&amp; originalValue != null &amp;&amp; originalValue.statusId != 'ReqCompleted'</expression></condition>
        <actions><service-call name="mantle.request.CaseFeedbackServices.queue#Invitation" in-map="{requestId:requestId}"/></actions>
    </eeca>
</eecas>
