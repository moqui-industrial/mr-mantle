<!-- IronStone Customer Service (impl-customer-service P11, F67): a repair finishing, by any path (WarrantyServices'
    update#WarrantyWork, Manufacturing's equipment screens, a direct update), tells the agent of each warranty claim it is
    linked to (notify#WarrantyWorkFinished: an RqtWarranty case with a RequestRecord on the AssetMaintenance; any other
    maintenance does nothing) and resolves nothing: the case stays as it is. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="WarrantyWorkFinished" entity="mantle.product.maintenance.AssetMaintenance" on-update="true"
            get-entire-entity="true" get-original-value="true">
        <condition><expression>statusId == 'AsMntCompleted' &amp;&amp; originalValue != null
            &amp;&amp; originalValue.statusId != 'AsMntCompleted'</expression></condition>
        <actions><service-call name="mantle.request.WarrantyServices.notify#WarrantyWorkFinished"
                in-map="{assetMaintenanceId:assetMaintenanceId}"/></actions>
    </eeca>
</eecas>
