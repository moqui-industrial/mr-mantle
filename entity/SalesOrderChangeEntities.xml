<!-- Sales' commercial order changes (IronStone Sales design §6 OrderChangeDetail, §17 SAL-CHANGE; impl-sales P14): the commercial
    kinds of Customer Service's proposal (SupportOrderChangeEntities.xml) are applied by the order's owner under SALES_ORDER_CHANGE
    (mantle.order.OrderChangeServices over OrderChanges.js and SalesOrderChanges.js). An address, ship method or carrier change
    applies to one part of the order, named on the proposal, so it never reaches a part the proposal did not show; the field is
    audit-logged and so counts in the proposal's revision. No change or application record of Sales' own. -->
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-entity-definition.xsd">
    <extend-entity entity-name="Request" package="mantle.request">
        <field name="orderPartSeqId" type="id" enable-audit-log="true"><description>An order change of an address, ship method or
            carrier (OckAddress, OckShipMethod, OckCarrier): the part of the order it changes; empty on another kind (its lines
            name their order lines) and on every other request.</description></field>
    </extend-entity>
</entities>
