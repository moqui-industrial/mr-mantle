<!-- Maintenance purchases (IronStone Maintenance design §3 PurchaseLinks; impl-maintenance P10, F45): when Purchasing sources a
    line of a purchase request raised from managed equipment work (its RequestItemOrder), the work's primary AssetMaintenance is
    linked to the order line (AssetMaintenanceOrderItem), so the order lines that fulfil a work order are its own without a step
    and Purchasing's sourcing is unchanged. A request with no maintenance work links nothing. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="MaintenancePurchaseSourced" entity="mantle.request.RequestItemOrder" on-create="true" run-on-error="false">
        <condition><expression>requestId &amp;&amp; orderId &amp;&amp; orderItemSeqId</expression></condition>
        <actions><service-call name="mantle.work.MaintenanceServices.link#SourcedMaintenancePurchase"
                in-map="{requestId:requestId, orderId:orderId, orderItemSeqId:orderItemSeqId}"/></actions>
    </eeca>
</eecas>
