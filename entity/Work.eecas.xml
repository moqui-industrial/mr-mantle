<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="TimeEntryUpdateTask" entity="mantle.work.time.TimeEntry"
            on-create="true" on-update="true" on-delete="true" get-entire-entity="true">
        <condition><expression>workEffortId</expression></condition>
        <actions><service-call name="mantle.work.TaskServices.update#TaskFromTime" in-map="context"/></actions>
    </eeca>

    <eeca id="WorkEffortUpdateProject" entity="mantle.work.effort.WorkEffort"
            on-create="true" on-update="true" on-delete="true" get-entire-entity="true">
        <condition><expression>rootWorkEffortId != null &amp;&amp; workEffortTypeEnumId == 'WetTask'</expression></condition>
        <actions><service-call name="mantle.work.TaskServices.update#ProjectTimeFromTask" in-map="context"/></actions>
    </eeca>
    <eeca id="WorkEffortTaskDefault" entity="mantle.work.effort.WorkEffort"
            on-create="true" on-update="true" on-delete="false" run-before="true" get-entire-entity="true">
        <condition><expression>workEffortTypeEnumId == 'WetTask'</expression></condition>
        <actions><service-call name="mantle.work.TaskServices.set#TaskDefaults" in-map="context"/></actions>
    </eeca>
    <!-- IronStone Projects (impl-projects.md P4b): a project's documentation space follows its internal members -->
    <eeca id="WorkEffortPartyDocsUsers" entity="mantle.work.effort.WorkEffortParty"
            on-create="true" on-update="true" on-delete="true" get-entire-entity="true">
        <condition><expression>workEffortId</expression></condition>
        <actions><service-call name="mantle.work.ProjectServices.sync#ProjectDocsSpaceUsers" in-map="{workEffortId:workEffortId}"/></actions>
    </eeca>
    <!-- IronStone Projects (impl-projects.md P5): a request follows its work items' status (complete#RequestFromWork) -->
    <eeca id="WorkEffortRequestFromWork" entity="mantle.work.effort.WorkEffort" on-update="true" get-entire-entity="true" get-original-value="true">
        <condition><expression>workEffortTypeEnumId == 'WetTask' &amp;&amp; originalValue != null &amp;&amp; originalValue.statusId != statusId</expression></condition>
        <actions><service-call name="mantle.request.RequestServices.complete#RequestFromWork" in-map="{workEffortId:workEffortId}"/></actions>
    </eeca>
    <!-- IronStone Manufacturing (impl-manufacturing P2, §4): a published production instruction is stored once with its
        checksum and only ended; the generic file screens and services write WorkEffortContent too, so the guard is on the
        entity (OperationTemplates.js guardInstruction) -->
    <eeca id="WorkEffortInstructionImmutable" entity="mantle.work.effort.WorkEffortContent"
            on-create="true" on-update="true" on-delete="true" run-before="true" run-on-error="false"
            get-entire-entity="true" get-original-value="true">
        <condition><expression>contentTypeEnumId == 'WectInstruction' || originalValue?.contentTypeEnumId == 'WectInstruction'</expression></condition>
        <actions>
            <set field="contentValue" from="{workEffortContentId:workEffortContentId, workEffortId:workEffortId,
                contentTypeEnumId:contentTypeEnumId, contentLocation:contentLocation, contentChecksum:contentChecksum,
                fromDate:fromDate, thruDate:thruDate}"/>
            <script>ec.resource.script('component://mr-mantle/service/mantle/work/OperationTemplates.js').execute('guardInstruction',
                {eecaOperation:eecaOperation, originalValue:originalValue, entityValue:contentValue})</script>
        </actions>
    </eeca>
    <!-- IronStone Maintenance (impl-maintenance P7 review, design-maintenance §4.3): a check's evidence and a stored completed
        checklist are never updated or deleted, and closed or cancelled managed work takes no new file, whatever writes the row (the
        content services, RecordFiles, entity-auto, the entity REST); a check's link to its evidence is never changed
        (ProcessChecks.js guardEvidence, guardEvidenceLink) -->
    <eeca id="WorkEffortEvidenceProtected" entity="mantle.work.effort.WorkEffortContent"
            on-create="true" on-update="true" on-delete="true" run-before="true" run-on-error="false"
            get-entire-entity="true" get-original-value="true">
        <actions>
            <set field="contentValue" from="{workEffortContentId:workEffortContentId, workEffortId:workEffortId, contentTypeEnumId:contentTypeEnumId}"/>
            <script>ec.resource.script('component://mr-mantle/service/mantle/work/ProcessChecks.js').execute('guardEvidence',
                {eecaOperation:eecaOperation, originalValue:originalValue, entityValue:contentValue})</script>
        </actions>
    </eeca>
    <eeca id="WorkEffortEvidenceLinkKept" entity="mantle.work.effort.WorkEffortCheckEvidence"
            on-update="true" on-delete="true" run-before="true" run-on-error="false">
        <actions>
            <script>ec.resource.script('component://mr-mantle/service/mantle/work/ProcessChecks.js').execute('guardEvidenceLink', {})</script>
        </actions>
    </eeca>
</eecas>
