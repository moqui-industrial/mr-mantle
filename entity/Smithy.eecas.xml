<!-- Smithy (mr-pass plan/design-smithy.md §9.1, §9.3): a merge request whose first post is held is hidden in the git host, so
    its head is fetched by nobody but through Smithy's own reads for its author and its moderators. When the visibility of
    a post changes (a moderator approves it, hides it or removes it) the merge request it is the first post of follows.
    The service returns at once for any other post. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="SmithyMergeRequestPostVisibility" entity="mantle.forum.ForumPostState" on-update="true" get-original-value="true" run-on-error="false">
        <condition><expression>originalValue != null &amp;&amp; visibility != null &amp;&amp; visibility != originalValue.visibility</expression></condition>
        <actions><service-call name="mantle.smithy.SmithyReviewServices.sync#MergeRequestHidden"
                in-map="{communicationEventId:communicationEventId}" disable-authz="true"/></actions>
    </eeca>
    <!-- DG8 (F6): the framework tells only the account that stored a push mirror of its failure (topic GitMirrorFailure,
        no record); a repository Smithy keeps tells its other Maintainers and Owners too (handle#MirrorFailure's notice has the repository as its record, so this rule leaves it alone) -->
    <eeca id="SmithyMirrorFailure" entity="moqui.security.user.NotificationMessage" on-create="true" run-on-error="false">
        <condition><expression>topic == 'GitMirrorFailure' &amp;&amp; !recordEntityName</expression></condition>
        <actions><service-call name="mantle.smithy.SmithyImportServices.handle#MirrorFailure"
                in-map="{subTopic:subTopic, messageJson:messageJson}" disable-authz="true"/></actions>
    </eeca>
    <!-- DG8 review: an account that signed in with GitHub before it joined a site claims that site's placeholders of its
        proven id when its membership becomes active (handle#MembershipActive; claim#GithubAccount checks the proof) -->
    <eeca id="SmithyClaimOnMembership" entity="mantle.public.PublicSiteParty" on-create="true" on-update="true"
            get-original-value="true" run-on-error="false">
        <condition><expression>state == 'active' &amp;&amp; (originalValue == null || originalValue.state != 'active')</expression></condition>
        <actions><service-call name="mantle.smithy.SmithyImportServices.handle#MembershipActive" in-map="{partyId:partyId}"
                disable-authz="true"/></actions>
    </eeca>
</eecas>
