<!-- Shippo (mantle.ext.shipment.ShippoServices, docs/Shippo.md; ported from mantle-shippo 1.2.1, 2356f07): its
    options group and its webhook (the gateway type ShGtwyShippo and its option SgoLookupGraceSeconds are the seed of
    ShippingGatewayEntities.xml). A Shippo webhook posts to
    /rest/sm/ShippoWebhook/{systemMessageRemoteId}, the remote of the gateway's connection, whose
    SmatHmacSha256Timestamp check of Shippo-Auth-Signature (or SmatUrlToken check of ?token=) runs before anything is kept.
    The API token is never an option: it is the remote's encrypted password. -->
<entity-facade-xml type="seed">
    <moqui.basic.Enumeration description="Shippo Gateway Options" enumId="EgShippoOption" enumTypeId="EnumGroup"/>
    <moqui.basic.EnumGroupMember enumGroupEnumId="EgShippoOption" enumId="SgoLabelType" sequenceNum="1"/>
    <moqui.basic.EnumGroupMember enumGroupEnumId="EgShippoOption" enumId="SgoLookupGraceSeconds" sequenceNum="2"/>
    <moqui.service.message.SystemMessageType systemMessageTypeId="ShippoWebhook" description="Shippo webhook event" contentType="application/json" receiveServiceName="mantle.ext.shipment.ShippoServices.receive#Webhook" consumeServiceName="mantle.ext.shipment.ShippoServices.consume#Webhook"/>
</entity-facade-xml>
