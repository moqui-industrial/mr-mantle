    goes only to its locations); extended as data. -->
<entity-facade-xml type="seed">
    <moqui.basic.EnumerationType enumTypeId="StorageType" description="Storage type"/>
    <moqui.basic.Enumeration enumId="StgCold" enumTypeId="StorageType" description="Refrigerated" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="StgFrozen" enumTypeId="StorageType" description="Frozen" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="StgHazardous" enumTypeId="StorageType" description="Hazardous" sequenceNum="3"/>
    <moqui.basic.Enumeration enumId="StgOversize" enumTypeId="StorageType" description="Oversize" sequenceNum="4"/>
</entity-facade-xml>
