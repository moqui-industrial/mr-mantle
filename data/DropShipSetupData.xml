<!-- Drop-ship (impl-purchasing P7; entity/DropShipEntities.xml): the facility type and the rare order roles of Moqui Java's
    dropship-moqui branch, and the transaction that moves a drop-ship line's cost from Unreceived Inventory to the cost of
    goods sold when the supplier's delivery is confirmed (F39). -->
<entity-facade-xml type="seed">
    <moqui.basic.Enumeration description="Drop-ship" enumId="FcTpDropShip" enumTypeId="FacilityType"/>

    <mantle.party.RoleType description="Customer - Ship From (rare)" parentTypeId="Customer" roleTypeId="CustomerShipFrom"/>
    <mantle.party.RoleType description="Vendor - Ship To (rare)" parentTypeId="Vendor" roleTypeId="VendorShipTo"/>
    <mantle.party.RoleGroupMember roleGroupEnumId="RgpOrder" roleTypeId="CustomerShipFrom"/>
    <mantle.party.RoleGroupMember roleGroupEnumId="RgpOrder" roleTypeId="VendorShipTo"/>

    <moqui.basic.Enumeration enumId="AttDropShipDelivery" description="Drop-ship delivery" enumTypeId="AcctgTransType"/>
</entity-facade-xml>
