<entity-facade-xml type="seed-initial">
    <!-- A late purchase receipt (mantle.order.PurchaseReceiptServices.notify#LateReceipts, impl-purchasing P5): once a day,
        each order part past its due date with something still to come is told once per due date to its organization's
        buyers (PURCHASE_ORDER_EDIT). No link template: the order's screen belongs to the app. -->
    <moqui.security.user.NotificationTopic topic="PurchaseLateReceipt" inboxEnumId="NinNotifications"
            description="Late purchase receipt" typeString="warning" showAlert="N" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y"
            titleTemplate="Order ${orderId} from ${supplierName} is late: due ${dueDay}"/>
    <moqui.service.job.ServiceJob jobName="notify_LateReceipts" description="Tell buyers of late purchase receipts"
            serviceName="mantle.order.PurchaseReceiptServices.notify#LateReceipts" cronExpression="0 15 6 * * ?" paused="N"
            transactionTimeout="1800"/>
</entity-facade-xml>
