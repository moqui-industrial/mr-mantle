<entity-facade-xml type="demo">
    <!-- An Authorize.Net sandbox gateway, with no credentials: enter the API login id (username), transaction key
        (password) and signature key (sharedSecret) on the remote in the System Message Remote screen, or in a data file
        of the deployment's own, and the public client key on PaymentGatewayAuthorizeNet. For production use another
        remote with sendUrl https://api.authorize.net/xml/v1/request.api and usageCode P. To take cards for a store add a
        ProductStorePaymentGateway (paymentInstrumentEnumId PiCreditCard, paymentGatewayConfigId AuthorizeNetDemo). For a
        sale instead of authorize then capture, set authorizeServiceName to
        mantle.ext.account.gateway.AuthorizeNetServices.authorizeAndCapture#Payment and leave captureServiceName empty. -->
    <moqui.service.message.SystemMessageRemote systemMessageRemoteId="AuthorizeNetSandbox" description="Authorize.Net sandbox" sendUrl="https://apitest.authorize.net/xml/v1/request.api" usageCode="T" messageAuthEnumId="SmatHmacSha512" authHeaderName="X-ANET-Signature"/>
    <mantle.account.method.PaymentGatewayConfig paymentGatewayConfigId="AuthorizeNetDemo" paymentGatewayTypeEnumId="PgtAuthorizeNet" description="Authorize.Net sandbox" systemMessageRemoteId="AuthorizeNetSandbox" authorizeServiceName="mantle.ext.account.gateway.AuthorizeNetServices.authorize#Payment" captureServiceName="mantle.ext.account.gateway.AuthorizeNetServices.capture#Payment" releaseServiceName="mantle.ext.account.gateway.AuthorizeNetServices.release#Payment" refundServiceName="mantle.ext.account.gateway.AuthorizeNetServices.refund#Payment" detailsServiceName="mantle.ext.account.gateway.AuthorizeNetServices.get#PaymentGatewayDetails"/>
    <mantle.account.method.PaymentGatewayAuthorizeNet paymentGatewayConfigId="AuthorizeNetDemo" validationMode="none" lookupGraceSeconds="300"/>
</entity-facade-xml>
