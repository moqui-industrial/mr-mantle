<entity-facade-xml type="seed">
    <moqui.security.UserPermission userPermissionId="ACCOUNTING_ADMIN" description="Accounting Admin"/>
    <!-- Accounting's scope in every internal organization, which reads and changes nothing by itself (as PEOPLE_ALL_ORGANIZATIONS
        and SALES_ALL_ORGANIZATIONS): without it a finance administrator (ACCOUNTING_ADMIN) works in the organizations they work
        for, and selects only one of those as active. ADMIN's alone (the user's call of Nov 16, 2026, SEC-BOS-02). -->
    <moqui.security.UserPermission userPermissionId="ACCOUNTING_ALL_ORGANIZATIONS" description="Accounting in every organization"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ACCOUNTING_ALL_ORGANIZATIONS" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="BANK_RECONCILE" description="Bank Reconcile"/>
    <moqui.security.UserPermission userPermissionId="BUDGET_APPROVE" description="Budget Approve"/>
    <moqui.security.UserPermission userPermissionId="BUDGET_EDIT" description="Budget Edit"/>
    <moqui.security.UserPermission userPermissionId="BUDGET_OVERRIDE" description="Budget Override"/>
    <moqui.security.UserPermission userPermissionId="CREDIT_HOLD_RELEASE" description="Credit Hold Release"/>
    <moqui.security.UserPermission userPermissionId="CUSTOMER_CREDIT_VIEW" description="Customer Credit View"/>
    <moqui.security.UserPermission userPermissionId="FISCAL_CLOSE" description="Fiscal Close"/>
    <moqui.security.UserPermission userPermissionId="INVOICE_APPROVE" description="Invoice Approve"/>
    <moqui.security.UserPermission userPermissionId="INVOICE_HOLD" description="Invoice Hold"/>
    <moqui.security.UserPermission userPermissionId="INVOICE_HOLD_RELEASE" description="Invoice Hold Release"/>
    <moqui.security.UserPermission userPermissionId="INVOICE_MATCH" description="Invoice Match"/>
    <moqui.security.UserPermission userPermissionId="PAYABLE_EDIT" description="Payable Edit"/>
    <moqui.security.UserPermission userPermissionId="PAYABLE_IMPORT" description="Payable Import"/>
    <moqui.security.UserPermission userPermissionId="PAYABLE_VIEW" description="Payable View"/>
    <moqui.security.UserPermission userPermissionId="PAYMENT_EDIT" description="Payment Edit"/>
    <!-- the whole card and bank account numbers of a payment method (PaymentMethodServices.get#PartyPaymentMethodInfo, the
        edit form; the REST GET of paymentMethods/info); others but the owner's own user see them masked. CARD_NUMBER_EDIT
        (typing a new card number) and PAYMENT_EDIT do not show them (the user's call of Nov 16, 2026, SEC-BAP-04). -->
    <moqui.security.UserPermission userPermissionId="PAYMENT_NUMBER_VIEW" description="Payment Method Number View"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="PAYMENT_NUMBER_VIEW" fromDate="0"/>
    <moqui.security.UserPermission userPermissionId="PAYMENT_RUN_APPROVE" description="Payment Run Approve"/>
    <moqui.security.UserPermission userPermissionId="PAYMENT_VIEW" description="Payment View"/>
