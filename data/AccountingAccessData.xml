    <moqui.security.UserPermission userPermissionId="RETURN_CREDIT_APPROVE" description="Return Credit Approve"/>
    <!-- Warehouse's receipt permission, which WarehouseTaskServices.receive#ReturnItems checks -->
    <moqui.security.UserPermission userPermissionId="STOCK_RECEIVE" description="Stock Receive"/>
    <moqui.security.UserPermission userPermissionId="SUPPLIER_TERMS_EDIT" description="Supplier Terms Edit"/>
    <moqui.security.UserPermission userPermissionId="TAX_STATEMENT_EDIT" description="Tax Statement Edit"/>
    <moqui.basic.Enumeration enumId="AtrPostingFailed" enumTypeId="AcctgTransResult" description="Posting failed; review error journal"/>
