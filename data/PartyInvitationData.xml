<!-- Staff invitations (mantle.party.IdentityServices; mr-boss impl-admin P5, design-admin §4.1, §16), named to load after
    MantleSetupData (its filter sets): the invitation's states,
    the invitation email and the organization filters of its records. -->
<entity-facade-xml type="seed">
    <moqui.basic.StatusType statusTypeId="UserInvitation" description="Staff invitation"/>
    <moqui.basic.StatusItem statusId="UinvPending" statusTypeId="UserInvitation" description="Pending" sequenceNum="1"/>
    <moqui.basic.StatusItem statusId="UinvAccepted" statusTypeId="UserInvitation" description="Accepted" sequenceNum="2"/>
    <moqui.basic.StatusItem statusId="UinvRevoked" statusTypeId="UserInvitation" description="Revoked" sequenceNum="3"/>
    <!-- not stored: a pending invitation past its expiry reads as expired -->
    <moqui.basic.StatusItem statusId="UinvExpired" statusTypeId="UserInvitation" description="Expired" sequenceNum="4"/>

    <!-- The invitation email (EmailType EMT_ACCOUNT_INVITE, framework BasicEntities): the organization, the inviter, the access
        proposed, the inviter's note and the acceptance link /i/<token>, sent without an EmailMessage record so the link is not
        stored (invite#User and resend#Invitation, createEmailMessage false) -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_STAFF_INVITATION" description="Staff Invitation" emailServerId="SYSTEM"
            emailTypeEnumId="EMT_ACCOUNT_INVITE" bodyScreenLocation="component://mr-mantle/template/party/StaffInvitation.xml"
            webappName="webroot" fromAddress="" ccAddresses="" bccAddresses="" subject="${organizationName}: you are invited to join"
            sendPartial="Y"/>

    <!-- An invitation is read under an app's organization filters by its organization (the Users area's MANTLE_USER_ORG for
        the identity operator, MANTLE_ACTIVE_ORG for the administrator), beside the services' own scope check -->
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_UINV" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.UserInvitation" filterMap="({organizationPartyId: filterOrgIds})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_UINV" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.UserInvitation" filterMap="({organizationPartyId: activeOrgId})"/>

    <!-- The import of staff invitations (mr-boss impl-admin P15; design-admin §4 Invitations' bulk invite, §11.1): a target
        of the framework's org.moqui.admin.DataTransferServices with no batch of its own (the framework keeps a
        TransferBatch). Its fields are exactly the address, an existing person, a display name, the organization (the
        batch's own) and the approved bundles; the expiry, the relationship and the note are options of the batch. A file
        with a column named like a password, a factor, a token, a group, a permission or a user id is refused whole. Each row is
        validated by invite#User's own checks and applied by invite#User as the importer, in a transaction of its own.
        Besides ADMIN_IDENTITY_MANAGE, which the row services check, the registration asks for ADMIN_TRANSFER_RUN. -->
    <moqui.server.TransferTarget targetId="staffInvitations" direction="import" targetMode="rows" title="Staff invitations"
            description="Invitations of staff to an organization, each with the access it proposes"
            effectsNote="Each row sends one invitation by email, as Invite users does. A person gets the organization and the access when they accept."
            ownerApp="Admin" targetVersion="1" fieldLabel="Invitation field" scopeLabel="Organization"
            columnsJson="[{&quot;name&quot;:&quot;emailAddress&quot;,&quot;label&quot;:&quot;Email&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;partyId&quot;,&quot;label&quot;:&quot;Existing person ID&quot;},{&quot;name&quot;:&quot;displayName&quot;,&quot;label&quot;:&quot;Name&quot;},{&quot;name&quot;:&quot;organizationPartyId&quot;,&quot;label&quot;:&quot;Organization ID&quot;},{&quot;name&quot;:&quot;bundleGroupIds&quot;,&quot;label&quot;:&quot;Access bundles&quot;}]"
            keyFields="emailAddress"
            optionsJson="[{&quot;name&quot;:&quot;expireDays&quot;,&quot;label&quot;:&quot;Link expires after (days)&quot;,&quot;type&quot;:&quot;integer&quot;,&quot;min&quot;:1,&quot;max&quot;:30,&quot;default&quot;:&quot;7&quot;},{&quot;name&quot;:&quot;relationshipTypeEnumId&quot;,&quot;label&quot;:&quot;Works as&quot;,&quot;type&quot;:&quot;option&quot;,&quot;default&quot;:&quot;PrtEmployee&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;PrtEmployee&quot;,&quot;label&quot;:&quot;Employee&quot;},{&quot;value&quot;:&quot;PrtAgent&quot;,&quot;label&quot;:&quot;Agent&quot;},{&quot;value&quot;:&quot;PrtMember&quot;,&quot;label&quot;:&quot;Member&quot;}]},{&quot;name&quot;:&quot;message&quot;,&quot;label&quot;:&quot;Note in the email&quot;,&quot;type&quot;:&quot;text&quot;,&quot;maxLength&quot;:2000,&quot;multiline&quot;:true}]"
            refusedColumns="group,permission,role,authz,privilege,userid"
            validateRowService="mantle.party.IdentityServices.validate#InvitationImportRow"
            applyRowService="mantle.party.IdentityServices.apply#InvitationImportRow"
            scopeService="mantle.party.IdentityServices.find#InvitationImportScopes"
            maxBytes="262144" maxRows="500" retentionDays="30"
            importPermission="ADMIN_TRANSFER_RUN,ADMIN_IDENTITY_MANAGE" viewPermission="ADMIN_TRANSFER_VIEW,ADMIN_IDENTITY_VIEW"
            ownerRoute="adminInvitations" sequenceNum="20"/>
</entity-facade-xml>
