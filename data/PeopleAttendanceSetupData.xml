<entity-facade-xml type="seed-initial">
    <!-- impl-people P13 (design-people §6 Attendance, §12 ApprovalPolicies; F42): a correction of a day's attendance
        (AttendanceServices.request#Correction asks for it), sent to the approvers of the step waiting (the person's manager unless a
        rule says otherwise); approve#NotificationMessage and refuse#NotificationMessage call mantle.humanres.AttendanceServices
        approve#Correction and refuse#Correction as the user, which decide it at the correction's revision in the message
        (decide#Correction over PeopleApprovalServices.record#Decision): the last approval makes it the day's attendance, a refusal
        needs a reason. The message holds peopleApprovalId, attendanceCorrectionId, attendanceDayId, sourceRevision, personName,
        dayText, workedText, subjectText, organizationName, departmentName and stepText: never the reason. The app that shows them sets
        the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleAttendanceApproval" inboxEnumId="NinNotifications"
            description="Attendance correction to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.AttendanceServices.approve#Correction"
            refuseServiceName="mantle.humanres.AttendanceServices.refuse#Correction" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>

    <!-- impl-people P30 review (the user's call of Nov 12, 2026): a burst of refused proofs at a clocking kiosk (KioskIdentity.js: ten
        within ten minutes) told to the HR editors of the device's organizations, at most once an hour per device, to them alone.
        The message holds deviceId, deviceName, refusalCount and windowMinutes: never a badge, a number, a PIN or a person. Its
        record is the device (moqui.security.DeviceCredential), which the app's record link resolves for each recipient: in BOSS,
        Admin's Security › Devices for one who may open it there (follow-up 4), no link for the others. -->
    <moqui.security.user.NotificationTopic topic="PeopleKioskRefusals" inboxEnumId="NinNotifications"
            description="Refused attempts at a clocking kiosk" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${refusalCount} refused attempts at the clocking kiosk ${deviceName} in ${windowMinutes} minutes"/>
    <!-- People follow-up 4 (the user's call of Nov 12, 2026): a clocking badge stopped after twenty wrong PINs within a day
        (KioskIdentity.js) told to the HR editors of its employer, to them alone, once, when it stops. The message holds partyId,
        partyRelationshipId, personName, organizationName and wrongCount, and its record is the employment (an HR reader opens its
        Employee360, where the PIN is reset or a new badge issued): never the badge's number or a PIN. -->
    <moqui.security.user.NotificationTopic topic="PeopleKioskBadgeDisabled" inboxEnumId="NinNotifications"
            description="A clocking badge stopped after wrong PINs" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${personName}'s clocking badge is stopped after ${wrongCount} wrong PINs in a day: reset its PIN or issue a new badge"/>
    <!-- P30 review (the user's call of Nov 12, 2026): refused kiosk attempts are kept 90 days; the daily prune deletes older ones a
        batch at a time, a failing row logged and left for the next run -->
    <moqui.service.job.ServiceJob jobName="prune_KioskAttempts"
            description="Delete clocking kiosk attempts older than 90 days"
            serviceName="mantle.humanres.AttendanceServices.prune#KioskAttempts" cronExpression="0 20 1 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- impl-people P13 (design-people §6 TimeImport; design-admin §11.1; impl-people §4): the time-and-attendance import as a
        registered target of the framework's org.moqui.admin.DataTransferServices, on the pattern of Accounting's statement imports
        (AccountingSetupData.xml): People keeps its own wizard (TimeImport: punches need a device and a zone), so only its result
        contract is registered, the imports of the employers the caller reads with the place that opens each. Its import permissions
        are all that preview#Import and import#Records require (the framework's holdsAll: every one of the list): People's own import
        permission PEOPLE_IMPORT with PEOPLE_HR_VIEW and PEOPLE_HR_EDIT, which the services check again with the employer; no ADMIN_*
        permission; its runs are read with PEOPLE_HR_VIEW and People's scope, which find#ImportRuns checks again. Nothing is staged or applied through the registration, and it adds no
        right. Its owner place is People's TimeImport (the app maps ownerRoute). -->
    <moqui.server.TransferTarget targetId="timeAndAttendance" direction="import" targetMode="wizard" title="Time and attendance"
            description="Clock events of a device or time system (worker, time, in or out), previewed and recorded in People's Time import"
            effectsNote="Each new event becomes a raw attendance punch of the worker's employment; events already recorded are skipped. Nothing is approved and no timesheet changes."
            ownerApp="People" targetVersion="1" scopeLabel="Employer"
            findService="mantle.humanres.AttendanceServices.find#ImportRuns"
            importPermission="PEOPLE_IMPORT,PEOPLE_HR_VIEW,PEOPLE_HR_EDIT" viewPermission="PEOPLE_HR_VIEW"
            ownerRoute="peopleTimeImport" sequenceNum="41"/>
    <!-- the find service runs as the reader wherever the framework calls it (Admin's Imports): every user may call it, and it
        checks PEOPLE_HR_VIEW and People's scope itself -->
    <moqui.security.ArtifactGroup artifactGroupId="MantlePeopleAttendanceRuns" description="People's attendance import runs"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantlePeopleAttendanceRuns" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            artifactName="mantle.humanres.AttendanceServices.find#ImportRuns"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantlePeopleAttendanceRunsALL" userGroupId="ALL_USERS"
            artifactGroupId="MantlePeopleAttendanceRuns" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
