<entity-facade-xml type="seed">
    <!-- Resource policy and blackouts (IronStone Maintenance design §7.1, ResourcePolicyDetail, Blackouts; impl-maintenance P15):
        how a managed resource's booking is approved, and the planned reasons of a blackout and of Manufacturing's offline time of a
        work center (both planned blocks, RukPlanned, written by record#ResourceUnavailability). Loads after
        MaintenanceWorkOutageData.xml, whose enumeration type the reasons are of. -->
    <moqui.basic.EnumerationType description="Resource Booking Approval Mode" enumTypeId="ResourceBookingApprovalMode"/>
    <moqui.basic.Enumeration enumId="RbamAutomatic" description="Booked at once" sequenceNum="1"
            enumTypeId="ResourceBookingApprovalMode"/>
    <moqui.basic.Enumeration enumId="RbamApprovers" description="Approved by its approvers" sequenceNum="2"
            enumTypeId="ResourceBookingApprovalMode"/>
    <moqui.basic.Enumeration enumId="RurClosure" description="Closed (blackout)" sequenceNum="7" optionIndicator="Y"
            enumTypeId="ResourceUnavailabilityReason"/>
    <moqui.basic.Enumeration enumId="RurOffline" description="Planned offline (production)" sequenceNum="8" optionIndicator="Y"
            enumTypeId="ResourceUnavailabilityReason"/>
</entity-facade-xml>
