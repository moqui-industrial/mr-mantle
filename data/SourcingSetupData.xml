<entity-facade-xml type="seed-initial">
    <!-- A request for quotation sent to an invited supplier (mantle.order.SourcingServices.send#QuoteRequest, impl-purchasing
        P11): from the buying organization's order or primary address, with the published RFQ's PDF attached; the service
        passes subject, fromAddress and fromName in bodyParameters, and the body -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_RFQ_EMAIL" description="Request for Quotation"
            emailServerId="SYSTEM" fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses=""
            subject="${subject}"/>
</entity-facade-xml>
