<!-- The production run notices (design-manufacturing §11, F40; impl-manufacturing P5a), sent by
    mantle.work.ProductionServices.transition#ProductionOrder to the run organization's users holding PRODUCTION_SUPERVISE:
    the release notice, and a planner's request to approve a staged release of a run short of a component. The staged release
    is decided on the run (transition#ProductionOrder approveStaged), never from the notification, so neither has an approve
    service; the approval and the release mark the requests read. -->
<entity-facade-xml type="seed-initial">
    <moqui.security.user.NotificationTopic topic="ProductionRelease" inboxEnumId="NinNotifications"
            description="Work order released" typeString="info" showAlert="N" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" titleTemplate="Work order ${workEffortId} released: ${workEffortName}"/>
    <moqui.security.user.NotificationTopic topic="ProductionStagedRelease" inboxEnumId="NinNotifications"
            description="Staged release to approve" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="Approve a staged release of ${workEffortName}"/>
</entity-facade-xml>
