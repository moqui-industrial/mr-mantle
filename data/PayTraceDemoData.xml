<entity-facade-xml type="demo">
    <!-- A PayTrace sandbox gateway, with no credentials: enter the API user (username) and its password (password) on the
        remote in the System Message Remote screen, or in a data file of the deployment's own, and the merchant id and the
        integrator id PayTrace issued on PaymentGatewayPayTrace. For production use another remote with sendUrl
        https://api.paytrace.com and usageCode P. To take cards for a store add a ProductStorePaymentGateway
        (paymentInstrumentEnumId PiCreditCard, paymentGatewayConfigId PayTraceDemo). For a sale instead of authorize then
        capture, set authorizeServiceName to mantle.ext.account.gateway.PayTraceServices.authorizeAndCapture#Payment and leave
        captureServiceName empty. -->
    <moqui.service.message.SystemMessageRemote systemMessageRemoteId="PayTraceSandbox" description="PayTrace sandbox" sendUrl="https://api.sandbox.paytrace.com" usageCode="T"/>
    <mantle.account.method.PaymentGatewayConfig paymentGatewayConfigId="PayTraceDemo" paymentGatewayTypeEnumId="PgtPayTrace" description="PayTrace sandbox" systemMessageRemoteId="PayTraceSandbox" authorizeServiceName="mantle.ext.account.gateway.PayTraceServices.authorize#Payment" captureServiceName="mantle.ext.account.gateway.PayTraceServices.capture#Payment" releaseServiceName="mantle.ext.account.gateway.PayTraceServices.release#Payment" refundServiceName="mantle.ext.account.gateway.PayTraceServices.refund#Payment" detailsServiceName="mantle.ext.account.gateway.PayTraceServices.get#PaymentGatewayDetails"/>
    <mantle.account.method.PaymentGatewayPayTrace paymentGatewayConfigId="PayTraceDemo" currencyUomId="USD" lookupGraceSeconds="300" sendEnhancedData="Y" defaultUnitOfMeasure="PCE"/>
</entity-facade-xml>
