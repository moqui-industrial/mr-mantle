<entity-facade-xml type="seed-initial">
    <!-- SEC-BOS-82: a payroll bank account added or changed by payroll (PayrollSetupServices store#PayrollBankAccount) tells its
        person, and them alone (directOnly), in the app and by email (emailNotifications Y, the NOTIFICATION template): the
        employer, the bank and last four digits, and who changed it, never the number. -->
    <moqui.security.user.NotificationTopic topic="PayrollBankAccountChanged" inboxEnumId="NinNotifications"
            description="Your payroll bank account was changed" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" emailNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your payroll bank account at ${organizationName} was ${actionText}: ${accountText}, by ${changedByName} on ${changedDateText}"/>
</entity-facade-xml>
