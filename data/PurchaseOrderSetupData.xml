<entity-facade-xml type="seed-initial">
    <!-- A purchase order sent to its supplier (mantle.order.OrderServices.send#PurchaseOrder, impl-purchasing P3): from the
        buying organization's order or primary address, with the PDF attached; the service passes subject, fromAddress and
        fromName in bodyParameters, and the body -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_PURCHASE_ORDER_EMAIL" description="Purchase Order"
            emailServerId="SYSTEM" fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses=""
            subject="${subject}"/>
</entity-facade-xml>
