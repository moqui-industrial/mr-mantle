    <userPermissions userPermissionId="PAYROLL_EDIT" description="Payroll Edit (an employee's pay rate)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PAYROLL_EDIT" fromDate="0"/>
    <!-- People (IronStone People; checked by mantle.humanres.PeopleServices and the People service families that follow it): the
        directory, self-service, team, HR, recruiting, development, case and configuration permissions, People's own import
        permission, and the approval of a payroll run, each a view or an edit apart (an edit permission alone reads nothing).
        Each is granted to ADMIN here; an application grants them to its own groups. -->
    <userPermissions userPermissionId="PEOPLE_DIRECTORY_VIEW" description="People Directory View (the public work identity of employees)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_DIRECTORY_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_SELF_SERVICE" description="People Self Service (own employment, requests and corrections)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_SELF_SERVICE" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_TEAM_VIEW" description="People Team View (a manager's live reports)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_TEAM_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_REQUEST_APPROVE" description="People Request Approve (approval steps assigned to the user)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_REQUEST_APPROVE" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_HR_VIEW" description="People HR View (employment and private person data of an employer)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_HR_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_HR_EDIT" description="People HR Edit (employment and private person data of an employer)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_HR_EDIT" fromDate="0"/>
    <!-- the shift roster (impl-people P14; the user's call, impl-people §4, Nov 12, 2026): saving and publishing shifts, which a
        manager (on their live reporting lines) and an HR editor (of the employer) need beside their own scope -->
    <userPermissions userPermissionId="PEOPLE_ROSTER_EDIT" description="People Roster Edit (save and publish shifts in the user's scope)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_ROSTER_EDIT" fromDate="0"/>
    <!-- expense claims and advances (impl-people P15; the user's call, impl-people §4, Nov 12, 2026): reading every claim and advance
        of the user's employers and acting for an employee (a claim made, changed, submitted or cancelled, an advance asked for them);
        the claimant's own and the approvers' route need no more than their own scope -->
    <userPermissions userPermissionId="PEOPLE_EXPENSE_MANAGE" description="People Expense Manage (every claim and advance of the user's employers)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_EXPENSE_MANAGE" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_RECRUIT_VIEW" description="People Recruit View (openings, applications and offers)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_RECRUIT_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_RECRUIT_EDIT" description="People Recruit Edit (openings, applications and offers)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_RECRUIT_EDIT" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_DEVELOP_VIEW" description="People Develop View (skills, training and reviews)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_DEVELOP_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_DEVELOP_EDIT" description="People Develop Edit (skills, training and reviews)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_DEVELOP_EDIT" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_CASE_HANDLE" description="People Case Handle (confidential cases the user is assigned)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_CASE_HANDLE" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_IMPORT" description="People Import (People's own employee and time imports)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_IMPORT" fromDate="0"/>
    <!-- the clocking kiosk (impl-people P30; design-people §6 ClockingKiosk): a punch recorded at a registered shared device for the
        worker its badge and PIN name (AttendanceServices record#KioskPunch, only in a device's request), held by the device's display
        account, never by a person who clocks for themselves -->
    <userPermissions userPermissionId="PEOPLE_KIOSK_PUNCH" description="People Kiosk Punch (a clocking device records the punches of workers by badge and PIN)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_KIOSK_PUNCH" fromDate="0"/>
    <userPermissions userPermissionId="PEOPLE_CONFIGURE" description="People Configure (People policy, setup and readiness)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_CONFIGURE" fromDate="0"/>
    <!-- a People reader's scope in every internal organization (the active one when there is one), as COMMERCE_ALL_ORGANIZATIONS
        and FACILITY_ALL_ORGANIZATIONS widen theirs; it reads nothing by itself (the user's call, impl-people §4, Nov 11, 2026) -->
    <userPermissions userPermissionId="PEOPLE_ALL_ORGANIZATIONS" description="People work in every organization"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_ALL_ORGANIZATIONS" fromDate="0"/>
    <!-- offboarding: another user's People approval rules handed to a new approver (PeopleApprovalServices find#OwnedApprovals and
        transfer#ApprovalOwner, the owned-resource contract), as the other owners' *_OWNER_CHANGE -->
    <userPermissions userPermissionId="PEOPLE_APPROVAL_OWNER_CHANGE" description="People Approval Owner Change (another user's approval rules)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PEOPLE_APPROVAL_OWNER_CHANGE" fromDate="0"/>
    <userPermissions userPermissionId="PAYROLL_APPROVE" description="Payroll Approve (a payroll run another prepared)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PAYROLL_APPROVE" fromDate="0"/>
    <!-- payroll configuration (impl-people P22 review; the user's call of Nov 12, 2026): pay components, structures, groups and
        localizations, changed with PAYROLL_VIEW, PAYROLL_EDIT and this (mantle.humanres.PayrollSetupServices), in place of
        PEOPLE_CONFIGURE, so payroll configures pay and People's administrator its policies -->
    <userPermissions userPermissionId="PAYROLL_CONFIGURE" description="Payroll Configure (pay components, structures, groups and localizations)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PAYROLL_CONFIGURE" fromDate="0"/>
    <!-- a salary set outside the pay change, for data repair (impl-people P23 review; the user's call of Nov 12, 2026): only an
        employment's first salary is set by create#EmploymentSalary, and a salary in place changes through an approved pay change;
        a holder of this sets one anyway, with a reason the audit log keeps. ADMIN's alone: no BOSS group holds it -->
    <userPermissions userPermissionId="PAYROLL_REPAIR" description="Payroll Repair (a salary set outside an approved pay change, audited)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="PAYROLL_REPAIR" fromDate="0"/>
    <!-- approving anyone's timesheet when the organization's timesheet policy says any (mantle.work.TimesheetServices) -->
    <userPermissions userPermissionId="TIMESHEET_APPROVE" description="Timesheet Approve (any person, by policy)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="TIMESHEET_APPROVE" fromDate="0"/>
    <!-- approving, rejecting and changing allocations of people to projects, and staffing placeholders (mantle.work.ResourceServices) -->
    <userPermissions userPermissionId="ALLOCATION_APPROVE" description="Allocation Approve (people's time on projects)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="ALLOCATION_APPROVE" fromDate="0"/>
    <!-- a milestone's gate decided for its approver (a client contact) by one who manages projects (mantle.work.ProjectServices
        approve#MilestoneApproval), the gates set and the estimate sent on the projects they see -->
    <userPermissions userPermissionId="MILESTONE_APPROVE" description="Milestone Approve (record a gate's decision for its approver)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="MILESTONE_APPROVE" fromDate="0"/>
    <!-- a client contact who signs in (granted by the owning application): the project services see
        for such a user only the shared part of the client projects of its organizations (mantle.work.ProjectServices
        get#ClientProjectInfo, get#VisibleProjectInfo; mantle.party.CommunicationServices get#RecordLinkInfo, get#RecordTimeline),
        whatever other group it is in. Not granted to ADMIN, nor to any group by default. The group that holds it should hold
        the framework's EXTERNAL_USER too (no record rooms, records drive, others' presence or agents), as IronStone's does. -->
    <userPermissions userPermissionId="PROJECT_CLIENT" description="Project Client (sees only the shared part of its organizations' projects)"/>
    <!-- the time logged on a work effort in its record timeline (Chatter; mantle.party.CommunicationServices.get#RecordTimeline) -->
    <moqui.service.ServiceRegister serviceRegisterId="TimeEntryTimeline" serviceTypeEnumId="RecordTimelineSource"
            description="Time logged on a work effort" serviceName="mantle.work.TimeServices.get#TimeEntryTimeline"/>

    <!-- deleting a directory party (mantle.party.ContactBookServices.delete#Contact); a personal contact's owner needs none -->
    <userPermissions userPermissionId="CONTACT_ADMIN" description="Contact Admin (delete directory contacts)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="CONTACT_ADMIN" fromDate="0"/>

    <!-- The CalDAV and CardDAV adapters (MoquiConf.xml dav-server), called as a user who logged in with an app password;
        each checks the calendar's or the contact book's access itself, as the screens do. -->
    <moqui.security.ArtifactGroup artifactGroupId="MantleDavServices" description="CalDAV and CardDAV adapters"/>

    <moqui.security.ArtifactGroupMember artifactGroupId="MantleDavServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="mantle\.(work\.CalendarDavServices|party\.ContactDavServices)\.(get#DavCollections|get#DavObjects|put#DavObject|delete#DavObject)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleDavServicesALL" userGroupId="ALL_USERS" artifactGroupId="MantleDavServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- Commerce's stores, merchandising, website, orders, promotions, channels and subscriptions (impl-commerce P1, F2;
        design-commerce §1.1), each checked by the store services with the store's organization: COMMERCE_VIEW reads stores and
        their records, COMMERCE_STORE_EDIT keeps a store's configuration and checkout settings, COMMERCE_MERCHANDISE its
        assortment, categories, navigation and review moderation, COMMERCE_PUBLISH publishes assortment and content,
        COMMERCE_THEME_EDIT edits themes and pages, COMMERCE_THEME_CODE a theme's template source, COMMERCE_THEME_PUBLISH
        publishes or restores a theme release, COMMERCE_ORDER_VIEW reads store orders and carts, COMMERCE_RECOVERY works cart
        recovery, COMMERCE_PROMOTION_EDIT keeps promotions and codes, COMMERCE_CHANNEL_OPERATE operates integrations, imports and
        feeds, COMMERCE_SUBSCRIPTION_MANAGE manages recurring contracts. No permission implies another, and a store assignment
        (a StoreStaff ProductStoreParty) grants none. Granted to the Commerce groups by the app's setup data. -->
    <userPermissions userPermissionId="COMMERCE_VIEW" description="Commerce View"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_STORE_EDIT" description="Commerce Store Edit"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_STORE_EDIT" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_MERCHANDISE" description="Commerce Merchandise"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_MERCHANDISE" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_PUBLISH" description="Commerce Publish"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_PUBLISH" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_THEME_EDIT" description="Commerce Theme Edit"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_THEME_EDIT" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_THEME_CODE" description="Commerce Theme Code"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_THEME_CODE" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_THEME_PUBLISH" description="Commerce Theme Publish"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_THEME_PUBLISH" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_ORDER_VIEW" description="Commerce Order View"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_ORDER_VIEW" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_RECOVERY" description="Commerce Recovery"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_RECOVERY" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_PROMOTION_EDIT" description="Commerce Promotion Edit"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_PROMOTION_EDIT" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_CHANNEL_OPERATE" description="Commerce Channel Operate"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_CHANNEL_OPERATE" fromDate="0"/>
    <userPermissions userPermissionId="COMMERCE_SUBSCRIPTION_MANAGE" description="Commerce Subscription Manage"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_SUBSCRIPTION_MANAGE" fromDate="0"/>

    <!-- Commerce P6 review (impl-commerce F-P6-3): store work in every organization, or the active one, not only the user's
        own (StoreAdmin.js scope), as a Commerce administrator's active organization filter reaches; ADMIN is a system
        administrator already. Granted to the Commerce administrator group by the app's setup data. -->
    <userPermissions userPermissionId="COMMERCE_ALL_ORGANIZATIONS" description="Commerce store work in every organization"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="COMMERCE_ALL_ORGANIZATIONS" fromDate="0"/>
</entity-facade-xml>
