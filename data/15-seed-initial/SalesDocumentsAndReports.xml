<?xml version="1.0" encoding="UTF-8"?>
<!-- CC0 1.0 Universal plus Grant of Patent License. See LICENSE.md. -->
<entity-facade-xml type="seed-initial">
    <!-- NOTE: when updating these it's best to delete the indexes through ElasticSearch, then reindex the MantleSales feed:

        curl http://localhost:9200/_cat/indices?v

        curl -X DELETE http://localhost:9200/mantle_sales_order_part?pretty
        curl -X DELETE http://localhost:9200/mantle_sales_order_item?pretty
        curl -X DELETE http://localhost:9200/mantle_sales_invoice?pretty
        curl -X DELETE http://localhost:9200/mantle_sales_invoice_item?pretty
    -->

    <!-- Sales OrderPart -->
    <dataDocuments dataDocumentId="MantleSalesOrderPart" indexName="mantle_sales" documentName="Sales Order Part"
            primaryEntityName="mantle.order.OrderPart" documentTitle="${orderId}:${orderPartSeqId}">
        <fields fieldSeqId="01" fieldPath="orderId"/>
        <fields fieldSeqId="02" fieldPath="orderPartSeqId"/>
        <fields fieldSeqId="03" fieldPath="statusId" fieldNameAlias="partStatusId"/>
        <fields fieldSeqId="04" fieldPath="facilityId"/>
        <fields fieldSeqId="05" fieldPath="shipmentMethodEnumId"/>
        <fields fieldSeqId="08" fieldPath="partTotal"/>

        <fields fieldSeqId="11" fieldPath="vendorPartyId"/>
        <fields fieldSeqId="12" fieldPath="vendorRoles:roleTypeId" fieldNameAlias="vendorRoleTypeId"/>
        <fields fieldSeqId="15" fieldPath="customerPartyId"/>
        <fields fieldSeqId="19" fieldPath="isNewCustomer"/>

        <fields fieldSeqId="31" fieldPath="postalAddress:city"/>
        <fields fieldSeqId="32" fieldPath="postalAddress:stateProvinceGeoId"/>
        <fields fieldSeqId="33" fieldPath="postalAddress:countryGeoId"/>
        <fields fieldSeqId="34" fieldPath="postalAddress:postalCode"/>
        <fields fieldSeqId="35" fieldPath="postalAddress:postalCodeExt"/>

        <fields fieldSeqId="41" fieldPath="orderHeader:entryDate"/>
        <fields fieldSeqId="42" fieldPath="orderHeader:placedDate"/>
        <fields fieldSeqId="43" fieldPath="orderHeader:statusId"/>
        <fields fieldSeqId="44" fieldPath="orderHeader:productStoreId"/>
        <fields fieldSeqId="45" fieldPath="orderHeader:salesChannelEnumId"/>
        <fields fieldSeqId="46" fieldPath="orderHeader:currencyUomId"/>
        <fields fieldSeqId="47" fieldPath="orderHeader:grandTotal"/>
        <!-- a RecurringTemplate base is never a sale (X5): orders panels leave it out (impl-insights F61) -->
        <fields fieldSeqId="48" fieldPath="orderHeader:orderPurposeEnumId"/>

        <fields fieldSeqId="51" fieldPath="orderHeader:statusLogs:oldValueText" fieldNameAlias="oldStatusId"/>
        <fields fieldSeqId="52" fieldPath="orderHeader:statusLogs:newValueText" fieldNameAlias="newStatusId"/>
        <fields fieldSeqId="53" fieldPath="orderHeader:statusLogs:changedDate" fieldNameAlias="statusChangedDate"/>
        <fields fieldSeqId="54" fieldPath="orderHeader:statusLogs:changeReason" fieldNameAlias="statusChangeReason"/>
        <fields fieldSeqId="55" fieldPath="orderHeader:statusLogs:changedByUserId" fieldNameAlias="statusChangedByUserId"/>

        <!-- get most recent approved and completed dates (sort reverse) -->
        <fields fieldSeqId="61" fieldPath="(statusLogs?.slice().sort((a, b) => Number(b.statusChangedDate) - Number(a.statusChangedDate)).find((it) => it.newStatusId == 'OrderApproved')?.statusChangedDate)"
                fieldNameAlias="approvedDate" fieldType="date"/>
        <fields fieldSeqId="62" fieldPath="(statusLogs?.slice().sort((a, b) => Number(b.statusChangedDate) - Number(a.statusChangedDate)).find((it) => it.newStatusId == 'OrderCompleted')?.statusChangedDate)"
                fieldNameAlias="completedDate" fieldType="date"/>
        <fields fieldSeqId="65" fieldPath="(approvedDate &amp;&amp; placedDate ? (Number(approvedDate) - Number(placedDate)) / (60*60*1000) : null)"
                fieldNameAlias="approvedHours" fieldType="double"/>
        <fields fieldSeqId="66" fieldPath="(completedDate &amp;&amp; approvedDate ? (Number(completedDate) - Number(approvedDate)) / (60*60*1000) : null)"
                fieldNameAlias="completedHours" fieldType="double"/>

        <conditions conditionSeqId="01" fieldNameAlias="vendorRoleTypeId" fieldValue="OrgInternal"/>
    </dataDocuments>

    <!-- Sales OrderItem -->
    <dataDocuments dataDocumentId="MantleSalesOrderItem" indexName="mantle_sales" documentName="Sales Order Item"
            primaryEntityName="mantle.order.OrderItem" documentTitle="${orderId}:${orderItemSeqId}">
        <fields fieldSeqId="01" fieldPath="orderId"/>
        <fields fieldSeqId="02" fieldPath="orderItemSeqId"/>
        <fields fieldSeqId="03" fieldPath="parentItemSeqId"/>
        <fields fieldSeqId="04" fieldPath="orderPartSeqId"/>
        <fields fieldSeqId="05" fieldPath="itemTypeEnumId"/>
        <fields fieldSeqId="06" fieldPath="productId"/>
        <fields fieldSeqId="07" fieldPath="quantity" fieldNameAlias="orderQuantity"/>
        <fields fieldSeqId="08" fieldPath="selectedAmount"/>
        <fields fieldSeqId="09" fieldPath="unitAmount"/>
        <fields fieldSeqId="10" fieldPath="unitListPrice"/>
        <fields fieldSeqId="11" fieldPath="requiredByDate"/>
        <fields fieldSeqId="12" fieldPath="isPromo"/>
        <fields fieldSeqId="13" fieldPath="((toNumber(orderQuantity) || 1) * (toNumber(unitAmount) || 0))" fieldNameAlias="itemSaleTotal" fieldType="double"/>
        <fields fieldSeqId="14" fieldPath="(issuances?.length ? issuances.reduce((sum, it) => sum + (toNumber(it.acquireCost) || 0) * toNumber(it.issuedQuantity), 0) : null)"
                fieldNameAlias="itemCostTotal" fieldType="double"/>
        <fields fieldSeqId="15" fieldPath="(issuances?.length ? ((toNumber(orderQuantity) || 1) * (toNumber(unitAmount) || 0)) - issuances.reduce((sum, it) => sum + (toNumber(it.acquireCost) || 0) * toNumber(it.issuedQuantity), 0) : null)"
                fieldNameAlias="itemMarginTotal" fieldType="double"/>
        <fields fieldSeqId="16" fieldPath="(issuances?.length &amp;&amp; toNumber(unitAmount) ? (((toNumber(orderQuantity) || 1) * toNumber(unitAmount)) - issuances.reduce((sum, it) => sum + (toNumber(it.acquireCost) || 0) * toNumber(it.issuedQuantity), 0)) / ((toNumber(orderQuantity) || 1) * toNumber(unitAmount)) : null)"
                fieldNameAlias="itemMarginPercent" fieldType="double"/>

        <fields fieldSeqId="21" fieldPath="part:statusId" fieldNameAlias="partStatusId"/>
        <fields fieldSeqId="22" fieldPath="part:facilityId"/>
        <fields fieldSeqId="23" fieldPath="part:vendorPartyId"/>
        <fields fieldSeqId="24" fieldPath="part:vendorRoles:roleTypeId" fieldNameAlias="vendorRoleTypeId"/>
        <fields fieldSeqId="25" fieldPath="part:customerPartyId"/>
        <fields fieldSeqId="26" fieldPath="part:isNewCustomer"/>
        <fields fieldSeqId="27" fieldPath="part:shipmentMethodEnumId"/>

        <fields fieldSeqId="31" fieldPath="part:postalAddress:city"/>
        <fields fieldSeqId="32" fieldPath="part:postalAddress:stateProvinceGeoId"/>
        <fields fieldSeqId="33" fieldPath="part:postalAddress:countryGeoId"/>
        <fields fieldSeqId="34" fieldPath="part:postalAddress:postalCode"/>
        <fields fieldSeqId="35" fieldPath="part:postalAddress:postalCodeExt"/>

        <fields fieldSeqId="41" fieldPath="header:entryDate"/>
        <fields fieldSeqId="42" fieldPath="header:placedDate"/>
        <fields fieldSeqId="43" fieldPath="header:statusId"/>
        <fields fieldSeqId="44" fieldPath="header:productStoreId"/>
        <fields fieldSeqId="45" fieldPath="header:salesChannelEnumId"/>
        <fields fieldSeqId="46" fieldPath="header:currencyUomId"/>
        <!-- a RecurringTemplate base is never a sale (X5; mr-pass impl-shop P7, impl-commerce F139): the summaries leave it out -->
        <fields fieldSeqId="47" fieldPath="header:orderPurposeEnumId"/>

        <fields fieldSeqId="51" fieldPath="issuances:issuedDate"/>
        <fields fieldSeqId="52" fieldPath="issuances:quantity" fieldNameAlias="issuedQuantity"/>
        <fields fieldSeqId="53" fieldPath="issuances:asset:acquireCost"/>
        <fields fieldSeqId="54" fieldPath="issuances:asset:lotId"/>
        <fields fieldSeqId="55" fieldPath="issuances:(toNumber(issuedQuantity) * (toNumber(unitAmount) || 0))" fieldNameAlias="issuedSaleTotal" fieldType="double"/>
        <fields fieldSeqId="56" fieldPath="issuances:(toNumber(acquireCost) ? toNumber(issuedQuantity) * toNumber(acquireCost) : null)" fieldNameAlias="issuedCostTotal" fieldType="double"/>
        <fields fieldSeqId="57" fieldPath="issuances:(toNumber(acquireCost) ? (toNumber(unitAmount) || 0) - toNumber(acquireCost) : null)" fieldNameAlias="issuedMargin" fieldType="double"/>
        <fields fieldSeqId="58" fieldPath="issuances:(toNumber(acquireCost) &amp;&amp; toNumber(unitAmount) ? (toNumber(unitAmount) - toNumber(acquireCost)) / toNumber(unitAmount) : null)"
                fieldNameAlias="issuedMarginPercent" fieldType="float"/>
        <fields fieldSeqId="59" fieldPath="issuances:(toNumber(acquireCost) ? (toNumber(issuedQuantity) * (toNumber(unitAmount) || 0)) - (toNumber(issuedQuantity) * toNumber(acquireCost)) : null)"
                fieldNameAlias="issuedMarginTotal" fieldType="double"/>

        <fields fieldSeqId="61" fieldPath="product:pseudoId"/>
        <fields fieldSeqId="62" fieldPath="product:productTypeEnumId"/>
        <fields fieldSeqId="63" fieldPath="product:productClassEnumId"/>
        <fields fieldSeqId="64" fieldPath="product:assetTypeEnumId"/>
        <fields fieldSeqId="65" fieldPath="product:assetClassEnumId"/>

        <fields fieldSeqId="71" fieldPath="product:dimensions:dimensionTypeId"/>
        <fields fieldSeqId="72" fieldPath="product:dimensions:value" fieldNameAlias="dimensionValue"/>

        <fields fieldSeqId="81" fieldPath="product:features:productFeatureId"/>
        <fields fieldSeqId="82" fieldPath="product:features:applTypeEnumId"/>
        <fields fieldSeqId="83" fieldPath="product:features:fromDate" fieldNameAlias="applFromDate"/>
        <fields fieldSeqId="84" fieldPath="product:features:thruDate" fieldNameAlias="applThruDate"/>
        <fields fieldSeqId="85" fieldPath="product:features:feature:productFeatureTypeEnumId"/>

        <fields fieldSeqId="90" fieldPath="part:customerClasses:partyClassificationId"/>
        <fields fieldSeqId="91" fieldPath="part:customerClasses:fromDate" fieldNameAlias="classFromDate"/>
        <fields fieldSeqId="92" fieldPath="part:customerClasses:thruDate" fieldNameAlias="classThruDate"/>
        <fields fieldSeqId="93" fieldPath="part:customerClasses:classification:classificationTypeEnumId"/>
        <fields fieldSeqId="94" fieldPath="((customerClasses || []).find((it) => (!it.classFromDate || Number(it.classFromDate) &lt;= Date.now()) &amp;&amp; (!it.classThruDate || Number(it.classThruDate) > Date.now()))?.partyClassificationId || 'CustConsumer')"
                fieldNameAlias="customerClassId" fieldType="keyword"/>

        <conditions conditionSeqId="01" fieldNameAlias="vendorRoleTypeId" fieldValue="OrgInternal"/>
    </dataDocuments>

    <!-- Sales Invoice -->
    <dataDocuments dataDocumentId="MantleSalesInvoice" indexName="mantle_sales" documentName="Sales Invoice"
            primaryEntityName="mantle.account.invoice.Invoice" documentTitle="${invoiceId}">
        <fields fieldSeqId="01" fieldPath="invoiceId"/>
        <fields fieldSeqId="02" fieldPath="invoiceTypeEnumId"/>
        <fields fieldSeqId="03" fieldPath="invoiceTotal"/>
        <fields fieldSeqId="04" fieldPath="appliedPaymentsTotal"/>
        <fields fieldSeqId="05" fieldPath="unpaidTotal"/>
        <fields fieldSeqId="06" fieldPath="currencyUomId"/>
        <fields fieldSeqId="07" fieldPath="productStoreId"/>

        <fields fieldSeqId="11" fieldPath="fromPartyId"/>
        <fields fieldSeqId="12" fieldPath="fromRoles:roleTypeId" fieldNameAlias="fromRoleTypeId"/>
        <fields fieldSeqId="13" fieldPath="toPartyId"/>
        <fields fieldSeqId="14" fieldPath="invoiceDate"/>
        <fields fieldSeqId="15" fieldPath="dueDate"/>
        <fields fieldSeqId="16" fieldPath="statusId"/>

        <fields fieldSeqId="21" fieldPath="paymentApplications:paymentId"/>
        <fields fieldSeqId="22" fieldPath="paymentApplications:amountApplied"/>
        <fields fieldSeqId="23" fieldPath="paymentApplications:appliedDate"/>
        <fields fieldSeqId="24" fieldPath="paymentApplications:payment:effectiveDate"/>
        <fields fieldSeqId="28" fieldNameAlias="prePaymentsTotal" fieldType="double"
                fieldPath="((paymentApplications || []).filter((it) => invoiceDate &amp;&amp; it.effectiveDate &amp;&amp; Number(invoiceDate) - Number(it.effectiveDate) >= 0).reduce((sum, it) => sum + (toNumber(it.amountApplied) || 0), 0))"/>

        <fields fieldSeqId="31" fieldPath="toClasses:partyClassificationId"/>
        <fields fieldSeqId="32" fieldPath="toClasses:fromDate" fieldNameAlias="classFromDate"/>
        <fields fieldSeqId="33" fieldPath="toClasses:thruDate" fieldNameAlias="classThruDate"/>
        <fields fieldSeqId="34" fieldPath="toClasses:classification:classificationTypeEnumId"/>
        <fields fieldSeqId="35" fieldPath="((toClasses || []).find((it) => (!it.classFromDate || Number(it.classFromDate) &lt;= Date.now()) &amp;&amp; (!it.classThruDate || Number(it.classThruDate) > Date.now()))?.partyClassificationId || 'CustConsumer')"
                fieldNameAlias="customerClassId" fieldType="keyword"/>

        <conditions conditionSeqId="01" fieldNameAlias="fromRoleTypeId" fieldValue="OrgInternal"/>
    </dataDocuments>
    <!-- Sales InvoiceItem -->
    <dataDocuments dataDocumentId="MantleSalesInvoiceItem" indexName="mantle_sales" documentName="Sales Invoice Item"
            primaryEntityName="mantle.account.invoice.InvoiceItem" documentTitle="${invoiceId}:${invoiceItemSeqId}">
        <fields fieldSeqId="01" fieldPath="invoiceId"/>
        <fields fieldSeqId="02" fieldPath="invoiceItemSeqId"/>
        <fields fieldSeqId="03" fieldPath="parentItemSeqId"/>
        <fields fieldSeqId="04" fieldPath="itemTypeEnumId"/>
        <fields fieldSeqId="05" fieldPath="productId"/>
        <fields fieldSeqId="06" fieldPath="quantity"/>
        <fields fieldSeqId="07" fieldPath="amount"/>

        <fields fieldSeqId="11" fieldPath="((toNumber(quantity) || 1) * (toNumber(amount) || 0))" fieldNameAlias="itemSaleTotal" fieldType="double"/>

        <fields fieldSeqId="14" fieldPath="(issuances?.length ? issuances.reduce((sum, it) => sum + (toNumber(it.acquireCost) || 0) * toNumber(it.issuedQuantity), 0) : null)"
                fieldNameAlias="itemCostTotal" fieldType="double"/>
        <fields fieldSeqId="15" fieldPath="(issuances?.length ? ((toNumber(quantity) || 1) * (toNumber(amount) || 0)) - issuances.reduce((sum, it) => sum + (toNumber(it.acquireCost) || 0) * toNumber(it.issuedQuantity), 0) : null)"
                fieldNameAlias="itemMarginTotal" fieldType="double"/>
        <fields fieldSeqId="16" fieldPath="(issuances?.length &amp;&amp; toNumber(amount) ? (((toNumber(quantity) || 1) * toNumber(amount)) - issuances.reduce((sum, it) => sum + (toNumber(it.acquireCost) || 0) * toNumber(it.issuedQuantity), 0)) / ((toNumber(quantity) || 1) * toNumber(amount)) : null)"
                fieldNameAlias="itemMarginPercent" fieldType="double"/>

        <fields fieldSeqId="21" fieldPath="invoice:fromPartyId"/>
        <fields fieldSeqId="22" fieldPath="invoice:fromRoles:roleTypeId" fieldNameAlias="fromRoleTypeId"/>
        <fields fieldSeqId="23" fieldPath="invoice:toPartyId"/>
        <fields fieldSeqId="24" fieldPath="invoice:invoiceDate"/>
        <fields fieldSeqId="25" fieldPath="invoice:dueDate"/>
        <fields fieldSeqId="26" fieldPath="invoice:statusId"/>
        <fields fieldSeqId="27" fieldPath="invoice:currencyUomId"/>
        <fields fieldSeqId="28" fieldPath="invoice:productStoreId"/>

        <fields fieldSeqId="51" fieldPath="issuances:issuedDate"/>
        <fields fieldSeqId="52" fieldPath="issuances:quantity" fieldNameAlias="issuedQuantity"/>
        <fields fieldSeqId="53" fieldPath="issuances:asset:acquireCost"/>
        <fields fieldSeqId="54" fieldPath="issuances:asset:lotId"/>
        <fields fieldSeqId="55" fieldPath="issuances:(toNumber(issuedQuantity) * (toNumber(amount) || 0))" fieldNameAlias="issuedSaleTotal" fieldType="double"/>
        <fields fieldSeqId="56" fieldPath="issuances:(toNumber(acquireCost) ? toNumber(issuedQuantity) * toNumber(acquireCost) : null)" fieldNameAlias="issuedCostTotal" fieldType="double"/>
        <fields fieldSeqId="57" fieldPath="issuances:(toNumber(acquireCost) ? (toNumber(amount) || 0) - toNumber(acquireCost) : null)" fieldNameAlias="issuedMargin" fieldType="double"/>
        <fields fieldSeqId="58" fieldPath="issuances:(toNumber(acquireCost) &amp;&amp; toNumber(amount) ? (toNumber(amount) - toNumber(acquireCost)) / toNumber(amount) : null)"
                fieldNameAlias="issuedMarginPercent" fieldType="float"/>
        <fields fieldSeqId="59" fieldPath="issuances:(toNumber(acquireCost) ? (toNumber(issuedQuantity) * (toNumber(amount) || 0)) - (toNumber(issuedQuantity) * toNumber(acquireCost)) : null)"
                fieldNameAlias="issuedMarginTotal" fieldType="double"/>

        <fields fieldSeqId="61" fieldPath="product:pseudoId"/>
        <fields fieldSeqId="62" fieldPath="product:productTypeEnumId"/>
        <fields fieldSeqId="63" fieldPath="product:productClassEnumId"/>
        <fields fieldSeqId="64" fieldPath="product:assetTypeEnumId"/>
        <fields fieldSeqId="65" fieldPath="product:assetClassEnumId"/>

        <fields fieldSeqId="71" fieldPath="product:dimensions:dimensionTypeId"/>
        <fields fieldSeqId="72" fieldPath="product:dimensions:value" fieldNameAlias="dimensionValue"/>

        <fields fieldSeqId="81" fieldPath="product:features:productFeatureId"/>
        <fields fieldSeqId="82" fieldPath="product:features:applTypeEnumId"/>
        <fields fieldSeqId="83" fieldPath="product:features:fromDate" fieldNameAlias="applFromDate"/>
        <fields fieldSeqId="84" fieldPath="product:features:thruDate" fieldNameAlias="applThruDate"/>
        <fields fieldSeqId="85" fieldPath="product:features:feature:productFeatureTypeEnumId"/>

        <fields fieldSeqId="90" fieldPath="invoice:toClasses:partyClassificationId"/>
        <fields fieldSeqId="91" fieldPath="invoice:toClasses:fromDate" fieldNameAlias="classFromDate"/>
        <fields fieldSeqId="92" fieldPath="invoice:toClasses:thruDate" fieldNameAlias="classThruDate"/>
        <fields fieldSeqId="93" fieldPath="invoice:toClasses:classification:classificationTypeEnumId"/>
        <fields fieldSeqId="94" fieldPath="((toClasses || []).find((it) => (!it.classFromDate || Number(it.classFromDate) &lt;= Date.now()) &amp;&amp; (!it.classThruDate || Number(it.classThruDate) > Date.now()))?.partyClassificationId || 'CustConsumer')"
                fieldNameAlias="customerClassId" fieldType="keyword"/>

        <conditions conditionSeqId="01" fieldNameAlias="fromRoleTypeId" fieldValue="OrgInternal"/>
    </dataDocuments>

    <!-- =============== -->
    <!-- Index Data Feed -->
    <moqui.entity.feed.DataFeed dataFeedId="MantleSales" dataFeedTypeEnumId="DTFDTP_RT_PUSH"
            feedName="Mantle Sales Data" feedReceiveServiceName="org.moqui.search.SearchServices.index#DataDocuments"
            feedDeleteServiceName="org.moqui.search.SearchServices.delete#DataDocument">
        <documents dataDocumentId="MantleSalesOrderPart"/>
        <documents dataDocumentId="MantleSalesOrderItem"/>
        <documents dataDocumentId="MantleSalesInvoice"/>
        <documents dataDocumentId="MantleSalesInvoiceItem"/>
    </moqui.entity.feed.DataFeed>

    <!-- The shipped sales dashboard executes through the authorized reporting boundary. -->
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOrderItem" userGroupId="ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOrderPart" userGroupId="ADMIN"/>
    <!-- the sales invoice documents (index:mantle_sales and the sales summaries read them) and the inventory asset document of
        the mantle-inventory dataset, the system administrator's as the orders are; an application grants its own groups -->
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesInvoice" userGroupId="ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesInvoiceItem" userGroupId="ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleInventoryAsset" userGroupId="ADMIN"/>
    <!-- The organization scope policy of business datasets (the report engine's ReportScopePolicy; mantle-sales-orders,
        mantle-sales-items and mantle-inventory name it): the rows of the viewer's organizations on the field the dataset names
        in the rowFilterParameters entry registered here (optionValue: organizationField), which the dataset forms ask for -->
    <moqui.basic.Enumeration enumId="MantleOrganization" enumTypeId="ReportScopePolicy"
            enumCode="mantle.party.PartyServices.get#OrganizationRowFilter" description="the viewer's organizations"
            optionValue="organizationField"/>
    <!-- Business events (mantle.party.BusinessEventServices; the report engine's ReportAnnotationSource): the dataset
        mantle-business-events over the engine's annotations, scoped to the viewer's organizations by the policy above, which a
        dashboard over business data reads for its markers; the system administrator reads it through the engine's dataset
        administration, and an application grants its own groups the dataset's artifact -->
    <moqui.basic.Enumeration enumId="MantleBusinessEvents" enumTypeId="ReportAnnotationSource"
            enumCode="mantle-business-events" description="Mantle's business events (price lists, promotions, period closes)"/>

    <!-- The pipeline dataset's document and feed (impl-sales P6, §4 "the pipeline dataset and its document and feed are Mantle's"; design-sales
        §1.4 CX-OPS-REPORTS, §8; F66), beside Mantle's sales documents (15-seed-initial/SalesDocumentsAndReports.xml): MantleSalesOpportunity, a lead or
        opportunity with its type, outcome, organization, pipeline, stage (its name, order and a label that sorts by the order), owner,
        team, account, source, campaign, amounts, probability and dates, indexed by the MantleSalesPipeline push feed as each deal and
        its people are written, and read by report/mantle-sales-pipeline.json, whose row filter is Sales' scope (the ReportScopePolicy
        MantleSalesScope, 10-seed/Sales.xml), never the organization alone. Granted here to ADMIN; an application grants its own
        groups the document and the dataset's artifact (mr-boss data/BossSetupSalesData.xml). -->
    <dataDocuments dataDocumentId="MantleSalesOpportunity" indexName="mantle_sales" documentName="Sales Opportunity"
            primaryEntityName="mantle.sales.opportunity.SalesOpportunity" documentTitle="${salesOpportunityId}">
        <fields fieldSeqId="01" fieldPath="salesOpportunityId"/>
        <fields fieldSeqId="02" fieldPath="opportunityName"/>
        <fields fieldSeqId="03" fieldPath="typeEnumId"/>
        <fields fieldSeqId="04" fieldPath="statusId"/>
        <fields fieldSeqId="05" fieldPath="organizationPartyId"/>
        <fields fieldSeqId="06" fieldPath="salesPipelineId"/>
        <fields fieldSeqId="07" fieldPath="opportunityStageId"/>
        <fields fieldSeqId="08" fieldPath="accountPartyId"/>
        <fields fieldSeqId="09" fieldPath="dataSourceId"/>
        <fields fieldSeqId="10" fieldPath="marketingCampaignId"/>
        <fields fieldSeqId="11" fieldPath="estimatedAmount"/>
        <fields fieldSeqId="12" fieldPath="currencyUomId"/>
        <fields fieldSeqId="13" fieldPath="estimatedProbability"/>
        <fields fieldSeqId="14" fieldPath="recurringAmount"/>
        <fields fieldSeqId="15" fieldPath="lostReasonEnumId"/>
        <fields fieldSeqId="16" fieldPath="estimatedCloseDate"/>
        <fields fieldSeqId="17" fieldPath="createdDate"/>
        <fields fieldSeqId="18" fieldPath="stageEnteredDate"/>
        <fields fieldSeqId="19" fieldPath="convertedDate"/>
        <fields fieldSeqId="20" fieldPath="closedDate"/>
        <fields fieldSeqId="31" fieldPath="stage:description" fieldNameAlias="stageName"/>
        <fields fieldSeqId="32" fieldPath="stage:sequenceNum" fieldNameAlias="stageSequence"/>
        <!-- the stage's order and name in one value, so a funnel's terms sort by the pipeline's order; an expression field is mapped
            as a number unless typed, so the derived ids and label are keyword (impl-sales P20: a terms split on them was empty) -->
        <fields fieldSeqId="33" fieldPath="((stageSequence == null ? '99' : String(stageSequence).padStart(2, '0')) + ' ' + (stageName || 'No stage'))"
                fieldNameAlias="stageLabel" fieldType="keyword"/>
        <fields fieldSeqId="41" fieldPath="parties:partyId" fieldNameAlias="assignedPartyId"/>
        <fields fieldSeqId="42" fieldPath="parties:roleTypeId" fieldNameAlias="assignedRoleTypeId"/>
        <fields fieldSeqId="43" fieldPath="parties:thruDate" fieldNameAlias="assignedThruDate"/>
        <!-- the current owner and team: the party rows of those roles not ended -->
        <fields fieldSeqId="51" fieldPath="(parties?.find((it) =&gt; it.assignedRoleTypeId == 'SalesRepresentative' &amp;&amp; !it.assignedThruDate)?.assignedPartyId)"
                fieldNameAlias="ownerPartyId" fieldType="keyword"/>
        <fields fieldSeqId="52" fieldPath="(parties?.find((it) =&gt; it.assignedRoleTypeId == 'SalesTeam' &amp;&amp; !it.assignedThruDate)?.assignedPartyId)"
                fieldNameAlias="teamPartyId" fieldType="keyword"/>
    </dataDocuments>
    <!-- impl-sales P20 (§4 Nov 14, the user's call): the quote dataset's document, MantleSalesQuote, a Sales quote's part (OrderPart of an
        order of purpose OrpSalesQuote; a template, OrpSalesQuoteTemplate, is never one) with its selling organization, customer, validity,
        status, total and currency, placed date and current owner and team, indexed by the same push feed and read by
        report/mantle-sales-quotes.json, timed by the quote's valid-through date (the quote-expiring alert), whose row filter is Sales'
        quote scope (get#QuoteRowFilter, the ReportScopePolicy MantleSalesQuoteScope): a placed quote is left out there, as the open
        quotes' lists leave it out. -->
    <dataDocuments dataDocumentId="MantleSalesQuote" indexName="mantle_sales" documentName="Sales Quote"
            primaryEntityName="mantle.order.OrderPart" documentTitle="${orderId}:${orderPartSeqId}">
        <fields fieldSeqId="01" fieldPath="orderId"/>
        <fields fieldSeqId="02" fieldPath="orderPartSeqId"/>
        <fields fieldSeqId="03" fieldPath="vendorPartyId"/>
        <fields fieldSeqId="04" fieldPath="customerPartyId"/>
        <fields fieldSeqId="05" fieldPath="validFromDate"/>
        <fields fieldSeqId="06" fieldPath="validThruDate"/>
        <fields fieldSeqId="07" fieldPath="partTotal"/>
        <fields fieldSeqId="11" fieldPath="orderHeader:orderName"/>
        <fields fieldSeqId="12" fieldPath="orderHeader:statusId"/>
        <fields fieldSeqId="13" fieldPath="orderHeader:entryDate"/>
        <fields fieldSeqId="14" fieldPath="orderHeader:placedDate"/>
        <fields fieldSeqId="15" fieldPath="orderHeader:currencyUomId"/>
        <fields fieldSeqId="16" fieldPath="orderHeader:grandTotal"/>
        <fields fieldSeqId="17" fieldPath="orderHeader:orderPurposeEnumId"/>
        <fields fieldSeqId="21" fieldPath="parties:partyId" fieldNameAlias="assignedPartyId"/>
        <fields fieldSeqId="22" fieldPath="parties:roleTypeId" fieldNameAlias="assignedRoleTypeId"/>
