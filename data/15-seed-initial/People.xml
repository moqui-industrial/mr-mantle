<entity-facade-xml type="seed-initial">
    <!-- People's approval topics (IronStone People design §12 ApprovalPolicies, PE-15; impl-people §4, F42): each seeded here,
        beside its decision service, with the phase that builds that service, so no topic names a missing one. P5: a position's
        activation (request#PositionApproval), sent to the approvers of the step waiting, one message for the step;
        approve#NotificationMessage and refuse#NotificationMessage call mantle.humanres.PositionServices approve#PositionApproval
        and refuse#PositionApproval as the user, which decide the request at the position's revision in the message
        (decide#PositionApproval over PeopleApprovalServices.record#Decision): the last step's approval activates the position,
        a refusal needs a reason. The message holds peopleApprovalId, emplPositionId, sourceRevision, positionName,
        organizationName, departmentName and stepText, and no pay. The app that shows them sets the link (IronStone People:
        BossSetupData.xml). Later phases add PeopleLeaveApproval, PeopleExpenseApproval and the others of design §12. -->
    <moqui.security.user.NotificationTopic topic="PeoplePositionApproval" inboxEnumId="NinNotifications"
            description="Position activation to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.PositionServices.approve#PositionApproval"
            refuseServiceName="mantle.humanres.PositionServices.refuse#PositionApproval" refuseReasonRequired="Y"
            titleTemplate="Approve the activation of position ${positionName} (${organizationName}, ${stepText})"/>

    <!-- P6: an employment change, a transfer or a separation (PeopleServices.apply#EmploymentChange asks for it), sent to the
        approvers of the step waiting; approve#NotificationMessage and refuse#NotificationMessage call mantle.humanres.PeopleServices
        approve#EmploymentChange and refuse#EmploymentChange as the user, which decide the request at the revision in the message
        (decide#EmploymentChange over record#Decision): the last step's approval applies the change, a refusal needs a reason.
        The message holds peopleApprovalId, employmentChangeId, sourceRevision, changeText, subjectText, organizationName,
        departmentName and stepText, and no pay; the title of a separation names no one (it may show on a locked screen). -->
    <moqui.security.user.NotificationTopic topic="PeopleEmploymentChangeApproval" inboxEnumId="NinNotifications"
            description="Employment change to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.PeopleServices.approve#EmploymentChange"
            refuseServiceName="mantle.humanres.PeopleServices.refuse#EmploymentChange" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>

    <!-- P12: a leave request, or the cancellation of approved leave the person asked for (LeaveServices.submit#Request and
        decide#Request ask for it), sent to the approvers of the step waiting (the person's manager unless a rule says otherwise);
        approve#NotificationMessage and refuse#NotificationMessage call mantle.humanres.LeaveServices approve#Request and
        refuse#Request as the user, which decide it at the request's revision in the message (decide#Request over record#Decision):
        the last approval recounts the days, checks overlaps and the balance with the other reservations under the employment's
        lock and posts the leave taken once (a cancellation its reversal once), a refusal needs a reason. The message holds
        peopleApprovalId, leaveRequestId, sourceRevision, personName, datesText, chargedText, subjectText, organizationName,
        departmentName and stepText: never the leave type or the person's reason. -->
    <moqui.security.user.NotificationTopic topic="PeopleLeaveApproval" inboxEnumId="NinNotifications"
            description="Leave to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.LeaveServices.approve#Request"
            refuseServiceName="mantle.humanres.LeaveServices.refuse#Request" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>
    <!-- P6 (the user's call, Nov 11): Employment.emplPositionId holds the seat in effect; a change dated later sets it on its date,
        through this daily job (mantle.humanres.PeopleServices.apply#DueAssignments: each employment in its own transaction, a
        failing one logged and the rest going on; a rerun changes nothing) -->
    <!-- P7 (F134): the same job routes the waiting People decisions of an employer again on the date a separation or manager
        change set for later comes -->
    <moqui.service.job.ServiceJob jobName="apply_EmploymentDueAssignments" description="Set each employment's seat in effect and route the decisions of a leaver again on the date"
            serviceName="mantle.humanres.PeopleServices.apply#DueAssignments" cronExpression="0 15 0 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- the skill levels People's lookups maintain (PeopleServices find#Lookups and store#Lookup; design §12 Lookups, PE-03):
        the vocabulary of PartySkill.skillLevel and of a requirement's level (P18), each value's enumCode its number -->
    <moqui.basic.EnumerationType description="Skill Level" enumTypeId="SkillLevel"/>
    <moqui.basic.Enumeration enumId="SklBasic" enumTypeId="SkillLevel" enumCode="1" description="Basic" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="SklWorking" enumTypeId="SkillLevel" enumCode="2" description="Working" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="SklProficient" enumTypeId="SkillLevel" enumCode="3" description="Proficient" sequenceNum="3"/>
    <moqui.basic.Enumeration enumId="SklAdvanced" enumTypeId="SkillLevel" enumCode="4" description="Advanced" sequenceNum="4"/>
    <moqui.basic.Enumeration enumId="SklExpert" enumTypeId="SkillLevel" enumCode="5" description="Expert" sequenceNum="5"/>

    <!-- impl-people P13 (design-people §6 Attendance, §12 ApprovalPolicies; F42): a correction of a day's attendance
        (AttendanceServices.request#Correction asks for it), sent to the approvers of the step waiting (the person's manager unless a
        rule says otherwise); approve#NotificationMessage and refuse#NotificationMessage call mantle.humanres.AttendanceServices
        approve#Correction and refuse#Correction as the user, which decide it at the correction's revision in the message
        (decide#Correction over PeopleApprovalServices.record#Decision): the last approval makes it the day's attendance, a refusal
        needs a reason. The message holds peopleApprovalId, attendanceCorrectionId, attendanceDayId, sourceRevision, personName,
        dayText, workedText, subjectText, organizationName, departmentName and stepText: never the reason. The app that shows them sets
        the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleAttendanceApproval" inboxEnumId="NinNotifications"
            description="Attendance correction to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.AttendanceServices.approve#Correction"
            refuseServiceName="mantle.humanres.AttendanceServices.refuse#Correction" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>

    <!-- impl-people P30 review (the user's call of Nov 12, 2026): a burst of refused proofs at a clocking kiosk (KioskIdentity.js: ten
        within ten minutes) told to the HR editors of the device's organizations, at most once an hour per device, to them alone.
        Follow-up 4 (the user's call of Nov 12, 2026): the access administrators (ADMIN_ACCESS_MANAGE) whose scope covers the
        device's display account are told too, in the same notice, under the same hourly mark.
        The message holds deviceId, deviceName, refusalCount and windowMinutes: never a badge, a number, a PIN or a person. Its
        record is the device (moqui.security.DeviceCredential), which the app's record link resolves for each recipient: in BOSS,
        Admin's Security › Devices for one who may open it there (follow-up 4), no link for the others. -->
    <moqui.security.user.NotificationTopic topic="PeopleKioskRefusals" inboxEnumId="NinNotifications"
            description="Refused attempts at a clocking kiosk" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${refusalCount} refused attempts at the clocking kiosk ${deviceName} in ${windowMinutes} minutes"/>
    <!-- People follow-up 4 (the user's call of Nov 12, 2026): a clocking badge stopped after twenty wrong PINs within a day
        (KioskIdentity.js) told to the HR editors of its employer, to them alone, once, when it stops. The message holds partyId,
        partyRelationshipId, personName, organizationName and wrongCount, and its record is the employment (an HR reader opens its
        Employee360, where the PIN is reset or a new badge issued): never the badge's number or a PIN. -->
    <moqui.security.user.NotificationTopic topic="PeopleKioskBadgeDisabled" inboxEnumId="NinNotifications"
            description="A clocking badge stopped after wrong PINs" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${personName}'s clocking badge is stopped after ${wrongCount} wrong PINs in a day: reset its PIN or issue a new badge"/>
    <!-- follow-up 4 (the user's call of Nov 12, 2026): the worker told that their own badge is stopped, to them alone, once, when it
        stops. The message holds organizationName and wrongCount: never the badge's number or a PIN. The app sets the link (BOSS:
        their SelfService, where My clocking badge shows the badge stopped). -->
    <moqui.security.user.NotificationTopic topic="PeopleMyKioskBadgeDisabled" inboxEnumId="NinNotifications"
            description="Your clocking badge is stopped" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your clocking badge at ${organizationName} is stopped after ${wrongCount} wrong PINs in a day: ask HR to reset its PIN"/>
    <!-- P30 review (the user's call of Nov 12, 2026): refused kiosk attempts are kept 90 days; the daily prune deletes older ones a
        batch at a time, a failing row logged and left for the next run -->
    <moqui.service.job.ServiceJob jobName="prune_KioskAttempts"
            description="Delete clocking kiosk attempts older than 90 days"
            serviceName="mantle.humanres.AttendanceServices.prune#KioskAttempts" cronExpression="0 20 1 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- impl-people P13 (design-people §6 TimeImport; design-admin §11.1; impl-people §4): the time-and-attendance import as a
        registered target of the framework's org.moqui.admin.DataTransferServices, on the pattern of Accounting's statement imports
        (10-seed/Accounting.xml): People keeps its own wizard (TimeImport: punches need a device and a zone), so only its result
        contract is registered, the imports of the employers the caller reads with the place that opens each. Its import permissions
        are all that preview#Import and import#Records require (the framework's holdsAll: every one of the list): People's own import
        permission PEOPLE_IMPORT with PEOPLE_HR_VIEW and PEOPLE_HR_EDIT, which the services check again with the employer; no ADMIN_*
        permission; its runs are read with PEOPLE_HR_VIEW and People's scope, which find#ImportRuns checks again. Nothing is staged or applied through the registration, and it adds no
        right. Its owner place is People's TimeImport (the app maps ownerRoute). -->
    <moqui.server.TransferTarget targetId="timeAndAttendance" direction="import" targetMode="wizard" title="Time and attendance"
            description="Clock events of a device or time system (worker, time, in or out), previewed and recorded in People's Time import"
            effectsNote="Each new event becomes a raw attendance punch of the worker's employment; events already recorded are skipped. Nothing is approved and no timesheet changes."
            ownerApp="People" targetVersion="1" scopeLabel="Employer"
            findService="mantle.humanres.AttendanceServices.find#ImportRuns"
            importPermission="PEOPLE_IMPORT,PEOPLE_HR_VIEW,PEOPLE_HR_EDIT" viewPermission="PEOPLE_HR_VIEW"
            ownerRoute="peopleTimeImport" sequenceNum="41"/>
    <!-- the find service runs as the reader wherever the framework calls it (Admin's Imports): every user may call it, and it
        checks PEOPLE_HR_VIEW and People's scope itself -->
    <moqui.security.ArtifactGroup artifactGroupId="MantlePeopleAttendanceRuns" description="People's attendance import runs"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantlePeopleAttendanceRuns" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            artifactName="mantle.humanres.AttendanceServices.find#ImportRuns"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantlePeopleAttendanceRunsALL" userGroupId="ALL_USERS"
            artifactGroupId="MantlePeopleAttendanceRuns" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>

    <!-- impl-people P21 (design-people §4 Grievances, §1.4 notification topics): a confidential case filed with a handler, assigned to
        one, or changed (a move, a note, a message) is told to its people on this topic. The message holds requestId and one of a few
        fixed sentences (noticeText), never a person, the employer or what the case is about, so neither a lock screen nor an inbox
        shows anything of it; no push. The app that shows it sets the link (IronStone People: BossSetupData.xml). Sent by its owning
        services, mantle.request.RequestServices' case services and notify#PeopleCaseUpdate, which the record notices of a case
        (notify#RecordMention, notify#RecordFollowers) hand to it. -->
    <moqui.security.user.NotificationTopic topic="PeopleCaseUpdate" inboxEnumId="NinNotifications"
            description="Confidential case" typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" pushNotifications="N" emailTemplateId="NOTIFICATION" titleTemplate="${noticeText}"/>
    <!-- an employer's designated intake handlers: the parties a new case goes to (comma-separated party ids), each with an account
        holding PEOPLE_CASE_HANDLE and working for the employer (create#PeopleCase skips, and logs, one who does not) -->
    <mantle.party.PartySettingType partySettingTypeId="PeopleCaseIntake" description="People - Confidential case intake handlers"
            validRegexp="^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$"><roles roleTypeId="OrgInternal"/></mantle.party.PartySettingType>

    <!-- impl-people P18 (design-people §10 Qualifications, §1.4 notification topics): a person is reminded once per expiry that a
        verified qualification of theirs expires within thirty days (and not renewed by a later one). The message holds
        partyQualificationId, typeText and expiryText, never the reference, issuer or a file, so the title is safe on a lock
        screen. The app that shows them sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="QualificationExpiring" inboxEnumId="NinNotifications"
            description="Your qualification expiring" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your ${typeText} expires ${expiryText}"/>
    <!-- the daily reminder (mantle.humanres.DevelopmentServices.send#ExpiryReminders): each qualification in its own transaction,
        a failing one logged by its id and the rest going on; a rerun sends nothing again for the same expiry -->
    <moqui.service.job.ServiceJob jobName="send_QualificationExpiryReminders"
            description="Remind each person once that a verified qualification of theirs expires within thirty days"
            serviceName="mantle.humanres.DevelopmentServices.send#ExpiryReminders" cronExpression="0 45 0 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>
    <!-- impl-people P19 (design-people §10 TrainingDetail's Enrollment, §12 ApprovalPolicies; F42): a place asked for in a training
        session by the person (DevelopmentServices.enroll#Training) waits for a People approval of kind PakTraining, sent to the
        approvers of the step waiting (the person's manager unless a rule says otherwise; never the person or who asked).
        approve#NotificationMessage and refuse#NotificationMessage call the topic's approve and refuse services as the user, which
        decide it at the revision in the message (decide#Enrollment over PeopleApprovalServices.record#Decision): the last approval
        enrolls the person (an attendee of the session's event), a refusal needs its reason. The message holds peopleApprovalId,
        personTrainingId, workEffortId, sourceRevision, partyId, personName, subjectText (the course and the session's day),
        organizationName, departmentName and stepText: no reason, result or score. The app that shows them sets the link
        (IronStone People: BossSetupData.xml). -->
    <moqui.basic.Enumeration enumId="PakTraining" description="Training enrollment" sequenceNum="8" enumTypeId="PeopleApprovalKind"/>
    <moqui.security.user.NotificationTopic topic="PeopleTrainingApproval" inboxEnumId="NinNotifications"
            description="Training place to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.DevelopmentServices.approve#Enrollment"
            refuseServiceName="mantle.humanres.DevelopmentServices.refuse#Enrollment" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>
    <!-- impl-people P19 review: the person (and who asked for them, when another) is told the outcome of the place they asked for,
        approved or refused (decide#Enrollment). The message holds personTrainingId, workEffortId, courseText, dayText and
        outcomeText, never the reason. The app that shows them sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleTrainingDecision" inboxEnumId="NinNotifications"
            description="Your training place decided" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your place in ${courseText} on ${dayText}: ${outcomeText}"/>

    <!-- impl-people P11 (design-people §7, PE-07): the daily leave accrual (mantle.humanres.LeaveServices.run#AccrualJob): each
        policy assignment in its own transaction, keyed by employment, policy and period so a rerun posts nothing again, a failing
        one logged by its employment and policy and the rest going on. The leave types, units, frequencies, block kinds and ledger
        entry types are in entity/humanres/LeaveEntities.xml. -->
    <moqui.service.job.ServiceJob jobName="run_LeaveAccrual" description="Post each leave policy assignment's accruals and expiries that are due"
            serviceName="mantle.humanres.LeaveServices.run#AccrualJob" cronExpression="0 30 0 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>
    <!-- impl-people P12 (design-people §7 LeaveRequestDetail, §15 the leave decision statement): the person (and an HR officer who
        asked for them) is told the outcome of their leave request: approved, refused, cancelled or the cancellation refused. The
        message holds leaveRequestId, datesText and outcomeText, never the leave type or the reason. The app that shows them sets the
        link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleLeaveDecision" inboxEnumId="NinNotifications"
            description="Your leave request decided" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your leave ${datesText}: ${outcomeText}"/>
    <!-- impl-people P12 (CX-SYNC, PE-24; F22, F67): Team absence, the first projected CalDAV collection
        (mantle.work.CalendarDavServices: collectionId projected-PeopleTeamAbsence, read only), answered by
        LeaveServices.get#AbsenceProjection: the approved leave of the people the user's People scope shows (their own and their
        colleagues', a manager's reports, an HR reader's employers'), each as "Out" with its days, never its type or reason -->
    <mantle.work.calendar.CalendarProjection projectionId="PeopleTeamAbsence" title="Team absence"
            description="Who is out: approved leave of you and the people you see in People" sequenceNum="10"
            ownerServiceName="mantle.humanres.LeaveServices.get#AbsenceProjection"/>

    <!-- impl-people P16 (design-people §5; F9, F11): an applicant is a Person with the Applicant role, separate from employee roles
        and user accounts; an application's stages, the flow mantle.humanres.RecruitingServices.change#ApplicationStage follows
        (Hired is never a stage change: P17 hires from an accepted offer; Offer needs its offer, P17) -->
    <mantle.party.RoleType roleTypeId="Applicant" description="Applicant"/>
    <moqui.basic.StatusItem statusId="EaReceived" statusTypeId="EmploymentApplication" sequenceNum="1" description="Received"/>
    <moqui.basic.StatusItem statusId="EaScreening" statusTypeId="EmploymentApplication" sequenceNum="2" description="Screening"/>
    <moqui.basic.StatusItem statusId="EaInterview" statusTypeId="EmploymentApplication" sequenceNum="3" description="Interview"/>
    <moqui.basic.StatusItem statusId="EaOffer" statusTypeId="EmploymentApplication" sequenceNum="4" description="Offer"/>
    <moqui.basic.StatusItem statusId="EaHired" statusTypeId="EmploymentApplication" sequenceNum="5" description="Hired"/>
    <moqui.basic.StatusItem statusId="EaRefused" statusTypeId="EmploymentApplication" sequenceNum="8" description="Refused"/>
    <moqui.basic.StatusItem statusId="EaWithdrawn" statusTypeId="EmploymentApplication" sequenceNum="9" description="Withdrawn"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaReceived" toStatusId="EaScreening" transitionName="Screen"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaReceived" toStatusId="EaInterview" transitionName="Interview"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaScreening" toStatusId="EaReceived" transitionName="Back to received"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaScreening" toStatusId="EaInterview" transitionName="Interview"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaInterview" toStatusId="EaScreening" transitionName="Back to screening"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaInterview" toStatusId="EaOffer" transitionName="Offer"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaOffer" toStatusId="EaHired" transitionName="Hire"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaReceived" toStatusId="EaRefused" transitionName="Refuse"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaScreening" toStatusId="EaRefused" transitionName="Refuse"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaInterview" toStatusId="EaRefused" transitionName="Refuse"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaOffer" toStatusId="EaRefused" transitionName="Refuse"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaReceived" toStatusId="EaWithdrawn" transitionName="Withdraw"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaScreening" toStatusId="EaWithdrawn" transitionName="Withdraw"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaInterview" toStatusId="EaWithdrawn" transitionName="Withdraw"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="EaOffer" toStatusId="EaWithdrawn" transitionName="Withdraw"/>
    <moqui.basic.Enumeration enumId="EarbEmail" description="Email" enumTypeId="EmploymentApplicationReferredBy"/>
    <moqui.basic.Enumeration enumId="EarbCareers" description="Careers page" enumTypeId="EmploymentApplicationReferredBy"/>

    <!-- impl-people P16 (F51, F62): People's purposes of the survey builder's forms, private to the respondents a People service
        assigns (no publication access kind, so no public or invitation link): built under People › Settings › Forms by the
        People administrator (PEOPLE_CONFIGURE) for the employers People's scope reads (PeopleServices.get#Scope), and read with
        the purpose's own People permission. Their answers are read only through the People service of the record they belong
        to (the scorecard: RecruitingServices.get#Application, P16; the review and the training assessment: P19 and P20; the exit
        interview: the leaver's checklist task). -->
    <moqui.basic.Enumeration enumId="DbfpInterviewScorecard" description="Interview scorecard" sequenceNum="21" enumTypeId="DbFormPurpose"/>
    <moqui.basic.Enumeration enumId="DbfpReview" description="Review" sequenceNum="22" enumTypeId="DbFormPurpose"/>
    <moqui.basic.Enumeration enumId="DbfpTrainingAssessment" description="Training assessment" sequenceNum="23" enumTypeId="DbFormPurpose"/>
    <moqui.basic.Enumeration enumId="DbfpExitInterview" description="Exit interview" sequenceNum="24" enumTypeId="DbFormPurpose"/>
    <moqui.basic.Enumeration enumId="FppInterviewScorecard" description="Interview scorecard" sequenceNum="21" enumTypeId="FormPublicationPurpose"/>
    <moqui.basic.Enumeration enumId="FppReview" description="Review" sequenceNum="22" enumTypeId="FormPublicationPurpose"/>
    <moqui.basic.Enumeration enumId="FppTrainingAssessment" description="Training assessment" sequenceNum="23" enumTypeId="FormPublicationPurpose"/>
    <moqui.basic.Enumeration enumId="FppExitInterview" description="Exit interview" sequenceNum="24" enumTypeId="FormPublicationPurpose"/>
    <mantle.party.FormPurpose purposeEnumId="DbfpInterviewScorecard" publicationPurposeEnumId="FppInterviewScorecard"
            editPermission="PEOPLE_CONFIGURE" viewPermission="PEOPLE_RECRUIT_VIEW"
            scopeServiceName="mantle.humanres.PeopleServices.get#Scope" formNoun="form"/>
    <!-- impl-people P20: a review form is also built by a development editor (the review administrator) -->
    <mantle.party.FormPurpose purposeEnumId="DbfpReview" publicationPurposeEnumId="FppReview"
            editPermission="PEOPLE_CONFIGURE,PEOPLE_DEVELOP_EDIT" viewPermission="PEOPLE_DEVELOP_VIEW"
            scopeServiceName="mantle.humanres.PeopleServices.get#Scope" formNoun="form"/>
    <!-- impl-people P19 review: a training assessment is also built by a development editor (the learning administrator) -->
    <mantle.party.FormPurpose purposeEnumId="DbfpTrainingAssessment" publicationPurposeEnumId="FppTrainingAssessment"
            editPermission="PEOPLE_CONFIGURE,PEOPLE_DEVELOP_EDIT" viewPermission="PEOPLE_DEVELOP_VIEW"
            scopeServiceName="mantle.humanres.PeopleServices.get#Scope" formNoun="form"/>
    <mantle.party.FormPurpose purposeEnumId="DbfpExitInterview" publicationPurposeEnumId="FppExitInterview"
            editPermission="PEOPLE_CONFIGURE" viewPermission="PEOPLE_HR_VIEW"
            scopeServiceName="mantle.humanres.PeopleServices.get#Scope" formNoun="form"/>

    <!-- impl-people P16 (PE-24, F65): the mail rule action that makes an application from a message sent to an opening's
        address (mantle.humanres.RecruitingServices.create#ApplicationFromEmail, run by run#EmailRules with authorization off,
        which checks itself what the rule's owner may do) -->
    <moqui.basic.Enumeration enumId="ErActCreateApplication" enumTypeId="EmailRuleAction" enumCode="createApplication" sequenceNum="5"
            description="Make a job application" optionValue="mantle.humanres.RecruitingServices.create#ApplicationFromEmail"/>

    <!-- impl-people P16 (CX-SYNC, PE-24): My interviews, a projected CalDAV collection (projected-PeopleMyInterviews, read only)
        on the kind P12 built, answered by RecruitingServices.get#InterviewProjection: the interviews the user is on the panel of,
        each its time and "Interview · {opening}", never the candidate's other applications or the scorecards -->
    <mantle.work.calendar.CalendarProjection projectionId="PeopleMyInterviews" title="My interviews"
            description="The interviews you are on the panel of" sequenceNum="30"
            ownerServiceName="mantle.humanres.RecruitingServices.get#InterviewProjection"/>

    <!-- impl-people P17 (design-people §5 OfferDetail, §12 ApprovalPolicies; F42): an offer submitted (RecruitingServices
        change#OfferState submit) sent to the approvers of the step waiting (the employer's HR officers unless a rule says otherwise;
        never who submitted it or the applicant; with none it waits). approve#NotificationMessage and refuse#NotificationMessage call
        the topic's approve#Offer and refuse#Offer as the user, which decide it at the offer's revision in the message (change#OfferState
        over PeopleApprovalServices.record#Decision): the last approval approves the offer for issue, a refusal (its reason required)
        makes it a draft again. The message holds peopleApprovalId, employmentOfferId, sourceRevision, partyId, personName, the
        opening's and position's names, subjectText, organizationName, departmentName and stepText: never pay. The app that shows them
        sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleOfferApproval" inboxEnumId="NinNotifications"
            description="Offer of employment to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.RecruitingServices.approve#Offer"
            refuseServiceName="mantle.humanres.RecruitingServices.refuse#Offer" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>

    <!-- impl-people P17 review (the user's call of Nov 12, 2026): an issued offer's letter emailed to the applicant
        (RecruitingServices.send#OfferLetter), the letter attached as it was stored; the service passes subject, fromAddress (the
        employer's address) and fromName in bodyParameters, and the body, which names the position and the expiry, never pay -->
    <moqui.basic.email.EmailTemplate emailTemplateId="PEOPLE_OFFER_LETTER" description="Offer of employment to the applicant"
            emailServerId="SYSTEM" fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses="" subject="${subject}"/>

    <!-- impl-people P20 (design-people §11 Goals, PE-16): a goal is a WorkEffort of its own type and the WepGoal purpose (Mantle had
        no goal enumeration), never a WetTask: the task lists (CalDAV's Tasks collection, Today's and My tasks), the project rollups
        and the search index read WetTask, WetProject and WetEvent work efforts only, so a goal reaches none of them -->
    <moqui.basic.Enumeration enumId="WetGoal" description="Goal" enumTypeId="WorkEffortType"/>
    <moqui.basic.Enumeration enumId="WepGoal" description="Goal" parentEnumId="WetGoal" enumTypeId="WorkEffortPurpose"/>

    <!-- impl-people P20 (design-people §11 ReviewDetail, §12 ApprovalPolicies; F42): a review whose template asks for approval is
        finalized only after a People approval of kind PakReview (ReviewServices.change#ReviewState finalize), sent to the approvers of
        the step waiting (the employer's HR officers unless a rule says otherwise; never the reviewer who asked or the person
        reviewed; with none it waits). approve#NotificationMessage and refuse#NotificationMessage call the topic's approve and refuse
        services as the user, which decide it at the review's revision in the message (change#ReviewState over
        PeopleApprovalServices.record#Decision): the last approval finalizes the review, a refusal (its reason required) returns the
        reviewer's assessment to them. The message holds peopleApprovalId, performanceReviewId, sourceRevision, partyId, personName,
        subjectText (the cycle: a lock-screen-safe title names no person, design-people §1.4), organizationName, departmentName and
        stepText: never a rating, an answer or a note.
        The app that shows them sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.basic.Enumeration enumId="PakReview" description="Review" sequenceNum="9" enumTypeId="PeopleApprovalKind"/>
    <moqui.security.user.NotificationTopic topic="PeopleReviewStep" inboxEnumId="NinNotifications"
            description="Review to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.ReviewServices.approve#ReviewStep"
            refuseServiceName="mantle.humanres.ReviewServices.refuse#ReviewStep" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>
    <!-- impl-people P20: a review step given to someone (a self assessment, a reviewer's assessment, feedback asked for, a step
        returned with its reason kept on the review) and a review released to its person (the availability notice of design §15).
        The message holds performanceReviewId and noticeText, a sentence naming the cycle and the due date or the release, never
        the person reviewed (a lock-screen-safe title, design-people §1.4), a rating, an answer, a summary or a note. The app that
        shows it sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleReviewUpdate" inboxEnumId="NinNotifications"
            description="Review" typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" emailTemplateId="NOTIFICATION" titleTemplate="${noticeText}"/>

    <!-- impl-people P14 (design-people §6 ShiftRoster): a worker is told when their shifts are published, and when a published
        shift of theirs is changed or removed. The message holds datesText, firstDay, outcomeText and shiftCount, never who rostered
        it or why. The app that shows them sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PeopleShiftChange" inboxEnumId="NinNotifications"
            description="Your shifts published or changed" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your shifts ${datesText}: ${outcomeText}"/>
    <!-- impl-people P14 (CX-SYNC, PE-24): My shifts, a projected CalDAV collection (mantle.work.CalendarDavServices: collectionId
        projected-PeopleMyShifts, read only) on the kind P12 built, answered by ScheduleServices.get#ShiftProjection: the user's own
        published shifts, on their phone's calendar -->
    <mantle.work.calendar.CalendarProjection projectionId="PeopleMyShifts" title="My shifts"
            description="Your published shifts" sequenceNum="20"
            ownerServiceName="mantle.humanres.ScheduleServices.get#ShiftProjection"/>
</entity-facade-xml>
