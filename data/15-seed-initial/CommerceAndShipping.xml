<entity-facade-xml type="seed-initial">
    <!-- Cart recovery's job (impl-commerce P10): every ten minutes, the carts of the stores that enabled recovery idle past their
        delay, each in its own transaction; a store that has not enabled it is never read. -->
    <moqui.service.job.ServiceJob jobName="run_CartRecovery" description="Send cart recovery for stores that enabled it"
            serviceName="mantle.order.StoreOperationsServices.run#CartRecovery" cronExpression="0 0/10 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- A short pick (mantle.shipment.WarehouseTaskServices.record#ShortPick), to the facility owner's users holding
        SHIPMENT_LOAD_EDIT (the pick supervisors). No link template: the shipment's screen belongs to the app. -->
    <moqui.security.user.NotificationTopic topic="WarehouseShortPick" description="Short pick" typeString="warning"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y"
            titleTemplate="Short pick on ${shipmentId}: ${quantityShort} of ${productId} at ${locationSeqId || 'no location'}"/>

    <!-- Shipping setup (impl-warehouse P13; design-warehouse §12 Carriers): the permission to edit carrier methods and which
        gateway serves a carrier (mantle.shipment.carrier.CarrierSetupServices). Carrier setup is shared by every organization,
        so it is its own permission rather than a facility's. -->
    <moqui.security.UserPermission userPermissionId="SHIPPING_CARRIER_EDIT" description="Shipping Carrier Edit"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="SHIPPING_CARRIER_EDIT" fromDate="0"/>
    <!-- a test shipping gateway (ShippingGatewayConfig.testMode) buys labels only for an organization that says Y here
        (P13 review A2); off by default -->
    <mantle.party.PartySettingType partySettingTypeId="ShippingTestGatewayAllowed" defaultValue="N"
            description="Shipping test gateways may buy labels"/>
    <!-- the driver of labels and refunds a gateway accepted and has not finished (Shippo's QUEUED; plan S1): each request
        left Unknown with LABEL_PENDING is run again as its user, asking the gateway first and never buying again
        (WarehouseTaskServices.finish#PendingLabelRequests). Paused by default; every 10 minutes when enabled. -->
    <moqui.service.job.ServiceJob jobName="finish_PendingLabelRequests" description="Finish pending shipping labels"
            serviceName="mantle.shipment.WarehouseTaskServices.finish#PendingLabelRequests" cronExpression="0 */10 * * * ?"
            paused="Y" transactionTimeout="1800"/>

    <!-- Shop's checkout and payment (mr-pass impl-shop P5; design-shop §7.2, §8.2, §8.4): the payment hold's release
        permission (X4, F15) with its ADMIN grant (BOSS grants it to Accounting's treasury group), and the checkout jobs, each
        attempt or checkout in its own transaction: the reconciliation of pending checkout payments (a lookup by reference,
        bounded with backoff, then the one placement) and the expiry of checkouts left unsubmitted. -->
    <!-- PAYMENT_HOLD_RELEASE releases an order's Payment hold reason (OrderHoldType OhtPayment's enumCode): a capture that
        failed, or an amount or account mismatch found after placement (design-shop §8.2) -->
    <moqui.security.UserPermission userPermissionId="PAYMENT_HOLD_RELEASE" description="Payment Hold Release"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="PAYMENT_HOLD_RELEASE" fromDate="0"/>

    <moqui.service.job.ServiceJob jobName="reconcile_StoreCheckouts" description="Reconcile pending Shop checkout payments"
            serviceName="mantle.order.ShopCheckoutServices.reconcile#Checkouts" cronExpression="0 0/5 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>
    <moqui.service.job.ServiceJob jobName="expire_StoreCheckouts" description="Expire unsubmitted Shop checkouts"
            serviceName="mantle.order.ShopCheckoutServices.expire#Checkouts" cronExpression="0 15 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- Shop's digital delivery and the delivery ledger (mr-pass impl-shop P6): the jobs that resume digital fulfillment and run
        the ledger's queued and retrying deliveries, each item in its own transaction, the download-ready notice's store email
        type and ledger source, and the ledger's review permission with its ADMIN grant. -->
    <moqui.basic.Enumeration description="Downloads Ready" enumId="PsetDownloadReady" enumTypeId="ProductStoreEmailType"/>
    <moqui.basic.Enumeration enumId="MdsrcShopDownloads" description="Shop download-ready notice" sequenceNum="1"
            enumTypeId="MessageDeliverySource" enumCode="mantle.product.ShopFulfillmentServices.build#DownloadNotice"/>
    <moqui.security.UserPermission userPermissionId="MESSAGE_DELIVERY_REVIEW" description="Message Delivery Review"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MESSAGE_DELIVERY_REVIEW" fromDate="0"/>

    <moqui.service.job.ServiceJob jobName="fulfill_StoreItems" description="Resume Shop digital fulfillment"
            serviceName="mantle.product.ShopFulfillmentServices.fulfill#StoreItems" cronExpression="0 0/5 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>
    <moqui.service.job.ServiceJob jobName="run_MessageDeliveries" description="Send queued and retrying deliveries"
            serviceName="mantle.party.MessageServices.run#Deliveries" cronExpression="0 0/2 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- The ledger as an owner of mail send outcomes (the framework's moqui.server.MailOutcomeOwner; mr-boss impl-admin P12):
        the mail queue asks it which stored messages are its attempts and leaves those to it; an uncertain one is reconciled
        through it, by a holder of MESSAGE_DELIVERY_REVIEW. -->
    <moqui.server.MailOutcomeOwner ownerKey="mantleDeliveryLedger" title="Delivery ledger" sequenceNum="10"
            description="Notices the apps queue on the outbound delivery ledger, which keeps their attempts"
            ownerService="mantle.party.MessageServices.find#MailOutcomeOwners"
            recoverService="mantle.party.MessageServices.recover#OwnedMailOutcome"/>

    <!-- Shop's operations (mr-pass impl-shop P8; ShopOperationsServices.xml): the job that retires expired carts through the order
        path and searches recent hosted references for a later second approval, each item in its own transaction; and the
        permission to resolve a stuck placement (impl-commerce F108: retry it, or release or refund its payment), with its ADMIN
        grant (BOSS grants it to the Commerce administrator). -->
    <moqui.security.UserPermission userPermissionId="COMMERCE_PLACEMENT_RESOLVE" description="Commerce Placement Resolve"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="COMMERCE_PLACEMENT_RESOLVE" fromDate="0"/>
    <moqui.service.job.ServiceJob jobName="run_ShopOperations" description="Retire expired Shop carts; search recent hosted references"
            serviceName="mantle.order.ShopOperationsServices.run#ShopOperations" cronExpression="0 40 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- Shop's prepaid and recurring access (mr-pass impl-shop P7): the renewal notices' delivery ledger source (its
        parameters queued with it, no secret among them; their store email types PsetPaymentRetry and PsetSubscriptionRenewal
        are ProductStoreEmailType seed already), and the job that advances renewal occurrences in flight and due retries, each
        in its own transaction (create_RecurringOrders hands Shop's bases to the coordinator). -->
    <moqui.basic.Enumeration enumId="MdsrcShopRenewals" description="Shop subscription renewal notice" sequenceNum="2"
            enumTypeId="MessageDeliverySource"/>

    <moqui.service.job.ServiceJob jobName="run_StoreRenewals" description="Advance Shop subscription renewals"
            serviceName="mantle.product.ShopSubscriptionServices.run#Renewals" cronExpression="0 15 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- Store reviews (impl-commerce P9): the review request's source on the delivery ledger (CX-DELIVERY; its build service
        makes the message, or suppresses it once the item is reviewed, returned or no longer public). The request's store email
        type, PsetReviewRequest, is ProductStoreEmailType seed data already. -->
    <moqui.basic.Enumeration enumId="MdsrcReviewRequest" description="Store review request" sequenceNum="2"
            enumTypeId="MessageDeliverySource" enumCode="mantle.product.StoreMerchandisingServices.build#ReviewRequest"/>
</entity-facade-xml>
