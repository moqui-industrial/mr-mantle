<entity-facade-xml type="seed-initial">
    <!-- Purchase agreements past their thru date (impl-purchasing P13): once a day an active purchase agreement whose thru
        date has passed is set Expired (mantle.party.AgreementServices.expire#PurchaseAgreements). A release checks the
        dates itself, so an agreement the job has not reached yet takes no release either; its POs stay. An agreement's
        activation is approved on PurchaseOrderApproval with the agreement as source (PurchaseApprovalSetupData.xml). -->
    <moqui.service.job.ServiceJob jobName="expire_PurchaseAgreements" description="Expire purchase agreements past their dates"
            serviceName="mantle.party.AgreementServices.expire#PurchaseAgreements" cronExpression="0 5 0 * * ?" paused="N"
            transactionTimeout="1800"/>
</entity-facade-xml>
