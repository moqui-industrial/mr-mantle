<?xml version="1.0" encoding="UTF-8"?>
<!--
    ITALIAN FISCAL AND COMPLIANCE SEED DATA (ENGLISH)
    Ordinary Regime - E-Invoicing SdI (v1.2.2 / v1.9.1),
    Customs (EUCDM / ADM Accounting Summary Statement), VAT Registers, General Journal, Withholding.
    All Italian descriptions are localized via mr-l10n.
-->
<entity-facade-xml type="seed">
    <!-- ================================================================= -->
    <!-- SECTION 1: PARTY IDENTIFICATION TYPES                             -->
    <!-- ================================================================= -->
    <moqui.basic.Enumeration enumId="PtidREA" enumTypeId="PartyIdType" description="REA Number (Business Register)" sequenceNum="10"/>
    <moqui.basic.Enumeration enumId="PtidEORI" enumTypeId="PartyIdType" description="EORI Code" sequenceNum="11"/>
    <moqui.basic.Enumeration enumId="PtidExchSysCode" enumTypeId="PartyIdType" description="SDI Exchange System Code (7 chars)" sequenceNum="12"/>
    <moqui.basic.Enumeration enumId="PtidPec" enumTypeId="PartyIdType" description="Certified Email Address (PEC)" sequenceNum="13"/>

    <!-- ================================================================= -->
    <!-- SECTION 2: TAX AUTHORITIES                                        -->
    <!-- ================================================================= -->
    <!-- Italian Revenue Agency (Agenzia delle Entrate - AdE) -->
    <mantle.party.Party partyId="IT_ADE" partyTypeEnumId="PtyOrganization" disabled="N"/>
    <mantle.party.Organization partyId="IT_ADE" organizationName="Italian Revenue Agency (AdE)"/>
    <mantle.other.tax.TaxAuthority taxAuthorityId="IT_ADE" taxAuthGeoId="ITA" taxAuthPartyId="IT_ADE"
        taxAuthorityTypeEnumId="TatFederal" description="Italian Revenue Agency (Agenzia delle Entrate)"/>

    <!-- Italian Customs and Monopolies Agency (ADM) -->
    <mantle.party.Party partyId="IT_ADM" partyTypeEnumId="PtyOrganization" disabled="N"/>
    <mantle.party.Organization partyId="IT_ADM" organizationName="Italian Customs and Monopolies Agency (ADM)"/>
    <mantle.other.tax.TaxAuthority taxAuthorityId="IT_ADM" taxAuthGeoId="ITA" taxAuthPartyId="IT_ADM"
        taxAuthorityTypeEnumId="TatFederal" description="Italian Customs Agency (Agenzia delle Dogane)"/>

    <!-- ================================================================= -->
    <!-- SECTION 3: VAT RATES (ITALY - PRES. DECREE 633/72)               -->
    <!-- ================================================================= -->
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_10" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 10% Reduced" description="Products subject to 10% reduced VAT"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_5" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 5% Reduced" description="Products subject to 5% reduced VAT"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_4" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 4% Super Reduced" description="Products subject to 4% super reduced VAT"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N1" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N1" description="Excluded operations ex art. 15"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N2" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N2" description="Not subject to VAT"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N3" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N3" description="Non-taxable operations"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N4" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N4" description="Exempt operations ex art. 10"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N5" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N5" description="Margin scheme operations"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N6" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N6" description="Reverse charge operations"/>
    <mantle.product.category.ProductCategory productCategoryId="CAT_VAT_0_N7" productCategoryTypeEnumId="PctTax"
        categoryName="VAT 0% N7" description="VAT paid in another EU country"/>

    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_22" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        taxPercentage="22.0" description="VAT 22% - Standard Rate" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_10" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_10" taxPercentage="10.0" description="VAT 10% - Reduced Rate" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_5" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_5" taxPercentage="5.0" description="VAT 5% - Reduced Rate" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_4" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_4" taxPercentage="4.0" description="VAT 4% - Super Reduced Rate" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N1" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N1" taxPercentage="0.0" description="VAT 0% - N1 Excluded ex art. 15" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N2" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N2" taxPercentage="0.0" description="VAT 0% - N2 Not subject to VAT" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N3" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N3" taxPercentage="0.0" description="VAT 0% - N3 Non-taxable (exports/intra-EU)" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N4" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N4" taxPercentage="0.0" description="VAT 0% - N4 Exempt operations ex art. 10" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N5" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N5" taxPercentage="0.0" description="VAT 0% - N5 Margin scheme" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N6" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N6" taxPercentage="0.0" description="VAT 0% - N6 Reverse charge" fromDate="2020-01-01 00:00:00"/>
    <mantle.other.tax.TaxAuthorityRate taxAuthorityRateId="IT_VAT_0_N7" taxAuthorityId="IT_ADE" rateTypeEnumId="TarVatTax"
        productCategoryId="CAT_VAT_0_N7" taxPercentage="0.0" description="VAT 0% - N7 VAT paid in another EU country" fromDate="2020-01-01 00:00:00"/>

    <!-- ================================================================= -->
    <!-- SECTION 4: FATTURAPA ENUMERATIONS (DOCUMENT TYPE TD01 - TD29)     -->
    <!-- ================================================================= -->
    <moqui.basic.EnumerationType enumTypeId="ElectronicInvoiceType" description="FatturaPA Document Type (TD01-TD29)"/>
    <moqui.basic.Enumeration enumId="TD01" enumTypeId="ElectronicInvoiceType" description="TD01 Standard invoice" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="TD02" enumTypeId="ElectronicInvoiceType" description="TD02 Advance payment on invoice" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="TD03" enumTypeId="ElectronicInvoiceType" description="TD03 Advance payment on fee" sequenceNum="3"/>
    <moqui.basic.Enumeration enumId="TD04" enumTypeId="ElectronicInvoiceType" description="TD04 Credit note" sequenceNum="4"/>
    <moqui.basic.Enumeration enumId="TD05" enumTypeId="ElectronicInvoiceType" description="TD05 Debit note" sequenceNum="5"/>
    <moqui.basic.Enumeration enumId="TD06" enumTypeId="ElectronicInvoiceType" description="TD06 Professional fee invoice" sequenceNum="6"/>
    <moqui.basic.Enumeration enumId="TD16" enumTypeId="ElectronicInvoiceType" description="TD16 Domestic reverse charge integration" sequenceNum="16"/>
    <moqui.basic.Enumeration enumId="TD17" enumTypeId="ElectronicInvoiceType" description="TD17 Foreign services reverse charge / self-invoice" sequenceNum="17"/>
    <moqui.basic.Enumeration enumId="TD18" enumTypeId="ElectronicInvoiceType" description="TD18 Intra-EU goods purchase integration" sequenceNum="18"/>
    <moqui.basic.Enumeration enumId="TD19" enumTypeId="ElectronicInvoiceType" description="TD19 Foreign goods purchase integration ex art. 17 c. 2" sequenceNum="19"/>
    <moqui.basic.Enumeration enumId="TD20" enumTypeId="ElectronicInvoiceType" description="TD20 Regularization self-invoice for missing supplier invoice" sequenceNum="20"/>
    <moqui.basic.Enumeration enumId="TD24" enumTypeId="ElectronicInvoiceType" description="TD24 Deferred invoice (art. 21, par. 4, let. a)" sequenceNum="24"/>
    <moqui.basic.Enumeration enumId="TD25" enumTypeId="ElectronicInvoiceType" description="TD25 Triangular deferred invoice (art. 21, par. 4, let. b)" sequenceNum="25"/>
    <moqui.basic.Enumeration enumId="TD27" enumTypeId="ElectronicInvoiceType" description="TD27 Self-consumption or free sample invoice" sequenceNum="27"/>
    <moqui.basic.Enumeration enumId="TD28" enumTypeId="ElectronicInvoiceType" description="TD28 Purchases from San Marino with VAT (paper invoice)" sequenceNum="28"/>
    <moqui.basic.Enumeration enumId="TD29" enumTypeId="ElectronicInvoiceType" description="TD29 Missing or irregular invoice notice" sequenceNum="29"/>

    <!-- ================================================================= -->
    <!-- SECTION 5: VAT NATURE CODES (FATTURAPA v1.2.2 / v1.9 / v1.9.1)    -->
    <!-- ================================================================= -->
    <moqui.basic.EnumerationType enumTypeId="VatNature" description="FatturaPA VAT Nature Code (N1-N7)"/>
    <moqui.basic.Enumeration enumId="N1" enumTypeId="VatNature" description="N1 Excluded ex art. 15 Pres. Decree 633/72"/>
    <moqui.basic.Enumeration enumId="N2.1" enumTypeId="VatNature" description="N2.1 Not subject to VAT - art. 7 to 7-septies"/>
    <moqui.basic.Enumeration enumId="N2.2" enumTypeId="VatNature" description="N2.2 Not subject to VAT - other cases"/>
    <moqui.basic.Enumeration enumId="N3.1" enumTypeId="VatNature" description="N3.1 Non-taxable - exports art. 8 par. 1 let. a/b"/>
    <moqui.basic.Enumeration enumId="N3.2" enumTypeId="VatNature" description="N3.2 Non-taxable - intra-community supplies"/>
    <moqui.basic.Enumeration enumId="N3.3" enumTypeId="VatNature" description="N3.3 Non-taxable - supplies to San Marino"/>
    <moqui.basic.Enumeration enumId="N3.4" enumTypeId="VatNature" description="N3.4 Non-taxable - transactions assimilated to exports"/>
    <moqui.basic.Enumeration enumId="N3.5" enumTypeId="VatNature" description="N3.5 Non-taxable - declarations of intent"/>
    <moqui.basic.Enumeration enumId="N3.6" enumTypeId="VatNature" description="N3.6 Non-taxable - other transactions"/>
    <moqui.basic.Enumeration enumId="N4" enumTypeId="VatNature" description="N4 Exempt ex art. 10 Pres. Decree 633/72"/>
    <moqui.basic.Enumeration enumId="N5" enumTypeId="VatNature" description="N5 Margin scheme / VAT not shown on invoice"/>
    <moqui.basic.Enumeration enumId="N6.1" enumTypeId="VatNature" description="N6.1 Reverse charge - scrap and recycled materials"/>
    <moqui.basic.Enumeration enumId="N6.2" enumTypeId="VatNature" description="N6.2 Reverse charge - pure gold and silver"/>
    <moqui.basic.Enumeration enumId="N6.3" enumTypeId="VatNature" description="N6.3 Reverse charge - construction subcontracting"/>
    <moqui.basic.Enumeration enumId="N6.4" enumTypeId="VatNature" description="N6.4 Reverse charge - building transfers"/>
    <moqui.basic.Enumeration enumId="N6.5" enumTypeId="VatNature" description="N6.5 Reverse charge - mobile phones"/>
    <moqui.basic.Enumeration enumId="N6.6" enumTypeId="VatNature" description="N6.6 Reverse charge - electronic products / processors"/>
    <moqui.basic.Enumeration enumId="N6.7" enumTypeId="VatNature" description="N6.7 Reverse charge - construction and finishing services"/>
    <moqui.basic.Enumeration enumId="N6.8" enumTypeId="VatNature" description="N6.8 Reverse charge - energy sector operations"/>
    <moqui.basic.Enumeration enumId="N6.9" enumTypeId="VatNature" description="N6.9 Reverse charge - other cases"/>
    <moqui.basic.Enumeration enumId="N7" enumTypeId="VatNature" description="N7 VAT paid in another EU member state"/>

    <!-- ================================================================= -->
    <!-- SECTION 6: WITHHOLDING TAX TYPES (RT01 - RT06)                    -->
    <!-- ================================================================= -->
    <moqui.basic.EnumerationType enumTypeId="WithholdingTaxType" description="FatturaPA Withholding Tax Type (RT01-RT06)"/>
    <moqui.basic.Enumeration enumId="RT01" enumTypeId="WithholdingTaxType" description="RT01 Natural person withholding (e.g. 20% professionals)"/>
    <moqui.basic.Enumeration enumId="RT02" enumTypeId="WithholdingTaxType" description="RT02 Legal entity withholding"/>
    <moqui.basic.Enumeration enumId="RT03" enumTypeId="WithholdingTaxType" description="RT03 INPS contribution withholding"/>
    <moqui.basic.Enumeration enumId="RT04" enumTypeId="WithholdingTaxType" description="RT04 ENASARCO contribution withholding"/>
    <moqui.basic.Enumeration enumId="RT05" enumTypeId="WithholdingTaxType" description="RT05 ENPAM contribution withholding"/>
    <moqui.basic.Enumeration enumId="RT06" enumTypeId="WithholdingTaxType" description="RT06 Other social security contribution"/>

    <!-- ================================================================= -->
    <!-- SECTION 7: SDI NOTIFICATIONS & STATUS                             -->
    <!-- ================================================================= -->
    <moqui.basic.EnumerationType enumTypeId="SdiNotificationType" description="SDI Notification Type"/>
    <moqui.basic.Enumeration enumId="RC" enumTypeId="SdiNotificationType" description="RC Delivery Receipt"/>
    <moqui.basic.Enumeration enumId="NS" enumTypeId="SdiNotificationType" description="NS Rejection Notice"/>
    <moqui.basic.Enumeration enumId="MC" enumTypeId="SdiNotificationType" description="MC Failed Delivery Notice"/>
    <moqui.basic.Enumeration enumId="DT" enumTypeId="SdiNotificationType" description="DT Expiry of Terms (PA)"/>
    <moqui.basic.Enumeration enumId="EC" enumTypeId="SdiNotificationType" description="EC Customer Outcome Notice"/>
    <moqui.basic.Enumeration enumId="NE" enumTypeId="SdiNotificationType" description="NE Outcome Notification"/>

    <moqui.basic.EnumerationType enumTypeId="SdiStatus" description="SDI E-Invoice Status"/>
    <moqui.basic.Enumeration enumId="SdiDraft" enumTypeId="SdiStatus" description="Draft / Not Generated"/>
    <moqui.basic.Enumeration enumId="SdiGenerated" enumTypeId="SdiStatus" description="XML Generated and Validated"/>
    <moqui.basic.Enumeration enumId="SdiSent" enumTypeId="SdiStatus" description="Sent to SDI"/>
    <moqui.basic.Enumeration enumId="SdiDelivered" enumTypeId="SdiStatus" description="Delivered to Recipient (RC)"/>
    <moqui.basic.Enumeration enumId="SdiAccepted" enumTypeId="SdiStatus" description="Accepted by Recipient / PA"/>
    <moqui.basic.Enumeration enumId="SdiRejected" enumTypeId="SdiStatus" description="Rejected by SDI (NS)"/>
    <moqui.basic.Enumeration enumId="SdiUndelivered" enumTypeId="SdiStatus" description="Available for Pickup (MC)"/>
    <moqui.basic.Enumeration enumId="SdiReceived" enumTypeId="SdiStatus" description="Received from Vendor (Incoming)"/>

    <!-- ================================================================= -->
    <!-- SECTION 8: CUSTOMS DECLARATIONS (EUCDM H1-H7 / ADM SUMMARY)       -->
    <!-- ================================================================= -->
    <moqui.basic.EnumerationType enumTypeId="CustomsDeclarationType" description="EUCDM Customs Declaration Type"/>
    <moqui.basic.Enumeration enumId="H1" enumTypeId="CustomsDeclarationType" description="H1 Release for free circulation and special procedures"/>
    <moqui.basic.Enumeration enumId="H2" enumTypeId="CustomsDeclarationType" description="H2 Customs warehousing"/>
    <moqui.basic.Enumeration enumId="H3" enumTypeId="CustomsDeclarationType" description="H3 Inward processing"/>
    <moqui.basic.Enumeration enumId="H4" enumTypeId="CustomsDeclarationType" description="H4 Temporary admission"/>
    <moqui.basic.Enumeration enumId="H5" enumTypeId="CustomsDeclarationType" description="H5 End-use"/>
    <moqui.basic.Enumeration enumId="H6" enumTypeId="CustomsDeclarationType" description="H6 Reduced dataset declaration"/>
    <moqui.basic.Enumeration enumId="H7" enumTypeId="CustomsDeclarationType" description="H7 Low value consignments (IOSS)"/>
    <moqui.basic.Enumeration enumId="B1" enumTypeId="CustomsDeclarationType" description="B1 Standard export declaration"/>
    <moqui.basic.Enumeration enumId="B2" enumTypeId="CustomsDeclarationType" description="B2 Outward processing declaration"/>

    <!-- Customs Declaration Status -->
    <moqui.basic.StatusType statusTypeId="CustomsDeclaration" description="Customs Declaration Status"/>
    <moqui.basic.StatusItem statusId="CustDeclDraft" statusTypeId="CustomsDeclaration" statusCode="DRAFT" description="Draft"/>
    <moqui.basic.StatusItem statusId="CustDeclRegistered" statusTypeId="CustomsDeclaration" statusCode="REGISTERED" description="Registered in Purchase VAT"/>
    <moqui.basic.StatusItem statusId="CustDeclCleared" statusTypeId="CustomsDeclaration" statusCode="CLEARED" description="Cleared / Settled"/>
</entity-facade-xml>
