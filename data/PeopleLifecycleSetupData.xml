<!-- People's employee lifecycle (IronStone People design §4, §12 EmployeeImport; impl-people P7): the import target `employees`, a
    target of the framework's org.moqui.admin.DataTransferServices with no batch of its own (the framework keeps a TransferBatch),
    on the pattern of the staff invitations target (PartyInvitationData.xml). Its fields are the hire's: the person (an existing one
    by id, else a new one by name and work email), the start and optional end, and the first assignment by id; the employer is the
    batch's own. Each row is validated by preview#Hire's checks and applied by hire#Employee as the importer, in a transaction of
    its own, under the row's operation key. A file with a column named like a password, a group, a permission, a user id or pay is
    refused whole: an import never sets a password, grants a group or writes pay or tax history. It asks PEOPLE_IMPORT and
    PEOPLE_HR_EDIT to import and PEOPLE_HR_VIEW to view, and no ADMIN_* permission (impl-people §4: a target's permissions are all
    required, so ADMIN_TRANSFER_RUN beside them would shut HR out of EmployeeImport); Admin's Imports lists a run for a data
    operator who also holds PEOPLE_HR_VIEW. Its owner place is People's EmployeeImport (the app maps ownerRoute). -->
<entity-facade-xml type="seed">
    <moqui.server.TransferTarget targetId="employees" direction="import" targetMode="rows" title="Employees"
            description="Employees hired into an employer, each with the first assignment"
            effectsNote="Each row hires one person into the employer, as Hire employee does: a new person or one People knows, one employment, its first assignment. No account is made and no pay is set."
            ownerApp="People" targetVersion="1" fieldLabel="Employee field" scopeLabel="Employer"
            columnsJson="[{&quot;name&quot;:&quot;firstName&quot;,&quot;label&quot;:&quot;First name&quot;},{&quot;name&quot;:&quot;lastName&quot;,&quot;label&quot;:&quot;Last name&quot;},{&quot;name&quot;:&quot;preferredName&quot;,&quot;label&quot;:&quot;Preferred name&quot;},{&quot;name&quot;:&quot;workEmail&quot;,&quot;label&quot;:&quot;Work email&quot;},{&quot;name&quot;:&quot;workPhone&quot;,&quot;label&quot;:&quot;Work phone&quot;},{&quot;name&quot;:&quot;partyId&quot;,&quot;label&quot;:&quot;Existing person ID&quot;},{&quot;name&quot;:&quot;fromDate&quot;,&quot;label&quot;:&quot;Start&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;thruDate&quot;,&quot;label&quot;:&quot;End&quot;},{&quot;name&quot;:&quot;departmentPartyId&quot;,&quot;label&quot;:&quot;Department ID&quot;},{&quot;name&quot;:&quot;emplPositionId&quot;,&quot;label&quot;:&quot;Position ID&quot;},{&quot;name&quot;:&quot;managerPartyId&quot;,&quot;label&quot;:&quot;Manager ID&quot;},{&quot;name&quot;:&quot;facilityId&quot;,&quot;label&quot;:&quot;Work location ID&quot;},{&quot;name&quot;:&quot;confirmNewPerson&quot;,&quot;label&quot;:&quot;New person although someone matches&quot;},{&quot;name&quot;:&quot;organizationPartyId&quot;,&quot;label&quot;:&quot;Employer ID&quot;},{&quot;name&quot;:&quot;reason&quot;,&quot;label&quot;:&quot;Note&quot;}]"
            keyFields="partyId,workEmail"
            refusedColumns="password,group,permission,authz,privilege,userid,salary,wage,pay,tax,bank,iban"
            validateRowService="mantle.humanres.PeopleServices.validate#EmployeeImportRow"
            applyRowService="mantle.humanres.PeopleServices.apply#EmployeeImportRow"
            scopeService="mantle.humanres.PeopleServices.find#EmployeeImportScopes"
            maxBytes="262144" maxRows="500" retentionDays="30"
            importPermission="PEOPLE_IMPORT,PEOPLE_HR_EDIT" viewPermission="PEOPLE_HR_VIEW"
            ownerRoute="peopleEmployeeImport" sequenceNum="40"/>
    <!-- The row and scope services run as the importer wherever the framework calls them (the wizard under People, Admin's Imports,
        an apply carried on after the request): every user may call them, as Mantle's identity services (PartyAccessData.xml), and each
        checks PEOPLE_IMPORT with the hire's own permissions and employer scope itself, as preview#Hire and hire#Employee do again. -->
    <moqui.security.ArtifactGroup artifactGroupId="MantlePeopleImportServices" description="People's employees import row services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantlePeopleImportServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.humanres\.PeopleServices\.(validate#EmployeeImportRow|apply#EmployeeImportRow|find#EmployeeImportScopes)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantlePeopleImportServicesALL" userGroupId="ALL_USERS"
            artifactGroupId="MantlePeopleImportServices" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
