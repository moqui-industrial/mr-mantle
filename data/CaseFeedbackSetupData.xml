<entity-facade-xml type="seed-initial">
    <!-- Case feedback (impl-customer-service P13, CS-FEEDBACK, CS-JOBS; mantle.request.CaseFeedbackServices): the invitation
        email, from the organization's address, its subject and body made by the service (subject, fromAddress and fromName
        in bodyParameters) with the Support app's Feedback link -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_CASE_FEEDBACK_EMAIL" description="Case feedback invitation"
            emailServerId="SYSTEM" fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses=""
            subject="${subject}"/>
    <!-- every fifteen minutes, a bounded batch of the invitations due and the reminders due, each in its own transaction, a
        failing one logged by its id and the rest going on; idempotent by invitation -->
    <moqui.service.job.ServiceJob jobName="send_CaseFeedbackInvitations" description="Send case feedback invitations and reminders"
            serviceName="mantle.request.CaseFeedbackServices.send#Invitations" cronExpression="0 0/15 * * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>
    <!-- a low score's follow-up, to the follow-up team's managers (followUpId, formResponseId, requestId, requestName,
        customerName, scoreText; the case as the record; never the comment). The app that works cases sets the link (IronStone
        Customer Service: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="CaseFeedbackFollowUp" inboxEnumId="NinNotifications" description="Low Feedback Score to Follow Up"
            typeString="warning" showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${customerName} rated case ${requestId} ${scoreText}: ${requestName}"/>
</entity-facade-xml>
