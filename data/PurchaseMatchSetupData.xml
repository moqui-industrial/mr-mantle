<entity-facade-xml type="seed-initial">
    <!-- A supplier bill whose match holds it, for the buyers of its organization (notify#MatchException, impl-purchasing
        P6). The buyer resolves the source or asks for the hold's release on the bill; the notice has no approve service. -->
    <moqui.security.user.NotificationTopic topic="PurchaseMatchException" inboxEnumId="NinNotifications"
            description="Supplier bill held on its match" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="Bill ${invoiceId} is held on its match"/>
</entity-facade-xml>
