<!-- Marketing's audience import and membership export as registered targets of the framework's
    org.moqui.admin.DataTransferServices (impl-marketing P4, §4; design-marketing §4 AudienceImport, §18; design-admin §11.1), a file of
    their own so a parallel phase's appends do not meet them (impl-marketing §1).
    - marketingAudience: an owner wizard (Marketing's AudienceImport keeps its own wizard and its AudienceImport record, as Commerce's
      channel orders do): only its runs finder and its owner place are registered; nothing is staged through Admin. Its import
      permission is the app's own, MARKETING_AUDIENCE_IMPORT, beside MARKETING_AUDIENCE_EDIT, and no ADMIN_* permission (the user's
      call, §4: a target's permissions are all required); the wizard's services check them and the list's organization themselves.
      Admin's Imports lists a run for a data operator who also holds MARKETING_AUDIENCE_VIEW (the view permission), as a summary.
    - marketingAudienceMembers: a list's members as rows of the framework's export (a file written here, its record kept and bounded
      as every export's), asking MARKETING_AUDIENCE_EXPORT alone; the address is a field of its own, given to a holder of
      MARKETING_AUDIENCE_VIEW only. The owner places are keys the app showing them resolves (IronStone: Admin.js mountRoutes). -->
<entity-facade-xml type="seed">
    <moqui.server.TransferTarget targetId="marketingAudience" direction="import" targetMode="wizard" title="Marketing audience members"
            description="Contacts for a Marketing list, with their consent evidence, previewed and imported in Marketing's audience import"
            effectsNote="Each row files one subscription request for the list, pending until the person confirms or accepted with the evidence you give; a withdrawal or a suppression is never cleared. A contact is matched by the list's address alone, or made."
            ownerApp="Marketing" targetVersion="1" scopeLabel="Organization"
            findService="mantle.marketing.AudienceServices.find#AudienceImportRuns"
            importPermission="MARKETING_AUDIENCE_IMPORT,MARKETING_AUDIENCE_EDIT" viewPermission="MARKETING_AUDIENCE_VIEW"
            ownerRoute="marketingAudienceImport" sequenceNum="72"/>
    <moqui.server.TransferTarget targetId="marketingAudienceMembers" direction="export" targetMode="rows" title="Marketing list members"
            description="The members of a Marketing list with their state, as a file"
            ownerApp="Marketing" targetVersion="1" scopeLabel="List"
            columnsJson="[{&quot;name&quot;:&quot;partyId&quot;,&quot;label&quot;:&quot;Contact ID&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;partyName&quot;,&quot;label&quot;:&quot;Name&quot;},{&quot;name&quot;:&quot;status&quot;,&quot;label&quot;:&quot;State&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;fromDate&quot;,&quot;label&quot;:&quot;Since&quot;},{&quot;name&quot;:&quot;thruDate&quot;,&quot;label&quot;:&quot;Until&quot;,&quot;selected&quot;:false},{&quot;name&quot;:&quot;address&quot;,&quot;label&quot;:&quot;Address&quot;,&quot;permission&quot;:&quot;MARKETING_AUDIENCE_VIEW&quot;}]"
            optionsJson="[{&quot;name&quot;:&quot;memberStatus&quot;,&quot;label&quot;:&quot;Members&quot;,&quot;type&quot;:&quot;option&quot;,&quot;default&quot;:&quot;current&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;current&quot;,&quot;label&quot;:&quot;Current members&quot;},{&quot;value&quot;:&quot;subscribed&quot;,&quot;label&quot;:&quot;Subscribed&quot;},{&quot;value&quot;:&quot;pending&quot;,&quot;label&quot;:&quot;Pending&quot;},{&quot;value&quot;:&quot;unsubscribed&quot;,&quot;label&quot;:&quot;Unsubscribed&quot;},{&quot;value&quot;:&quot;history&quot;,&quot;label&quot;:&quot;Every membership row&quot;}]}]"
            exportService="mantle.marketing.AudienceServices.export#MemberTransfer"
            scopeService="mantle.marketing.AudienceServices.find#MemberExportScopes"
            maxRows="20000" maxBytes="4194304" exportPermission="MARKETING_AUDIENCE_EXPORT" viewPermission="MARKETING_AUDIENCE_EXPORT"
            retentionDays="366" ownerRoute="marketingLists" sequenceNum="73"/>
    <!-- The services the framework calls as the caller (Admin's Imports, an export from ListDetail): every user may call them, and each
        checks MARKETING_AUDIENCE_VIEW or MARKETING_AUDIENCE_EXPORT and the organization itself, as People's import services. -->
    <moqui.security.ArtifactGroup artifactGroupId="MantleMarketingTransferServices" description="Marketing's audience import runs and member export"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleMarketingTransferServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.marketing\.AudienceServices\.(find#AudienceImportRuns|find#MemberExportScopes|export#MemberTransfer)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleMarketingTransferServicesALL" userGroupId="ALL_USERS"
            artifactGroupId="MantleMarketingTransferServices" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    <!-- The expiry of staged import files: nightly at 2:40 am, the files of the imports past their expiry removed, the outcomes kept; a
        run again changes nothing it changed (a purged import is left out) -->
    <moqui.service.job.ServiceJob jobName="purge_MarketingAudienceImports" description="Purge expired Marketing audience import files"
            serviceName="mantle.marketing.AudienceServices.purge#AudienceImports" cronExpression="0 40 2 * * ?" paused="N"
            transactionTimeout="1800"/>
    <moqui.server.JobRegistration jobName="purge_MarketingAudienceImports" ownerApp="Marketing" title="Purge expired audience import files"
            description="Removes the staged file of each audience import 30 days after it was staged; the row outcomes are kept, and an import never applied expires"
            managePermission="MARKETING_CONFIGURE" scheduleEditable="Y" minIntervalMinutes="60" pauseEditable="Y"
            priorityEditable="Y" retryEditable="Y" recipientPermission="MARKETING_CONFIGURE" sequenceNum="60"/>
</entity-facade-xml>
