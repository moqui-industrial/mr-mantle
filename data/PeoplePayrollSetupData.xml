<entity-facade-xml type="seed-initial">
    <!-- impl-people P22 review (the user's calls of Nov 12, 2026; design-people §8 PayComponentDetail, PayStructureDetail, §12
        ApprovalPolicies): publishing a pay component's term or a pay structure's draft lines takes effect only on a People approval
        of kind PakPayrollConfig (PayrollSetupServices publish#Component and publish#Structure ask for it), sent to the approvers of
        the step waiting: the employer's payroll approvers (PAYROLL_APPROVE) and HR editors who read payroll configuration
        (PAYROLL_VIEW) unless a rule says otherwise; never one who drafted it or asked to publish it; with none it waits.
        approve#NotificationMessage and refuse#NotificationMessage call the topic's approve and refuse services as the user, which
        decide it at the revision in the message (PayrollSetupServices decide#Publication over PeopleApprovalServices.record#Decision):
        the last approval publishes the draft, a refusal (its reason required) leaves it a draft. The message holds peopleApprovalId,
        sourceRevision, payrollComponentId and payrollComponentTermId or payrollStructureId, sourceText, subjectText,
        organizationName and stepText: never an amount, a formula or a rate. The app that shows them sets the link (IronStone
        People: BossSetupData.xml). -->
    <moqui.basic.Enumeration enumId="PakPayrollConfig" description="Payroll configuration" sequenceNum="10" enumTypeId="PeopleApprovalKind"/>
    <!-- impl-people P23 review (the user's call of Nov 12, 2026): a pay change (PeopleServices.apply#EmploymentChange, changeKind
        pay), the first salary included, waits for a People approval of its own kind, on the PeopleEmploymentChangeApproval topic:
        the employer's payroll approvers (PAYROLL_APPROVE with PAYROLL_VIEW) unless a rule of the kind routes it (to the manager, who
        then reads the new salary of that change alone); never the payroll editor who asked, nor the person. Its notice names no one
        and no amount. -->
    <moqui.basic.Enumeration enumId="PakPayChange" description="Pay change" sequenceNum="11" enumTypeId="PeopleApprovalKind"/>
    <moqui.security.user.NotificationTopic topic="PeoplePayrollConfigApproval" inboxEnumId="NinNotifications"
            description="Payroll configuration to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.PayrollSetupServices.approve#Publication"
            refuseServiceName="mantle.humanres.PayrollSetupServices.refuse#Publication" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>
</entity-facade-xml>
