<entity-facade-xml type="seed-initial">
    <!-- A supplier's response from the PASS Supplier app (mantle.order.SupplierPortalServices, impl-purchasing P16): a quote
        submitted, a purchase order acknowledged or a drop-ship delivery reported, each a claim for the buyers of the
        organization (PURCHASE_ORDER_EDIT) to review. The message holds orderId, responseKind, kindText, supplierName,
        and detailText (the revision, and late when it is). The app that shows them sets the link (IronStone Purchasing: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="PurchaseSupplierResponse" inboxEnumId="NinNotifications"
            description="Supplier response to review" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y"
            titleTemplate="${supplierName}: ${kindText} for ${orderId}${detailText}"/>
</entity-facade-xml>
