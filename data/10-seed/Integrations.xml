<entity-facade-xml type="seed">
    <!-- Authorize.Net webhooks: an Authorize.Net webhook posts to /rest/sm/AuthorizeNetWebhook/{systemMessageRemoteId}, the
        remote of the gateway's connection, whose SmatHmacSha512 check of X-ANET-Signature runs before anything is kept.
        The gateway type (PgtAuthorizeNet) is the seed of PaymentGatewayAuthorizeNet; see docs/AuthorizeNet.md. -->
    <moqui.service.message.SystemMessageType systemMessageTypeId="AuthorizeNetWebhook" description="Authorize.Net webhook notification" contentType="application/json" receiveServiceName="mantle.ext.account.gateway.AuthorizeNetServices.receive#Webhook" consumeServiceName="mantle.ext.account.gateway.AuthorizeNetServices.consume#Webhook"/>

    <!-- X12 EDI (plan/payments-shipping-edi.md E1, docs/EdiX12.md; ported from mantle-edi 1.1.5, 134acb6,
        MantleEdiSetupData.xml): the message type and the operator permission. A connection is a SystemMessageRemote (its
        transport and credentials, entered by an administrator, never in data; a remote receiving /rest/sm posts by login names
        the partner's own integration account as its receiveUserId, SEC-BAP-96) with an EdiConnection; its partner's rules are
        a profile, such as the sample in 15-seed-initial/Purchasing.xml. No produce-ack service on the type: the 997s are this
        side's per group (EdiServices.record#GroupAcknowledgment), never the framework's per message. -->
    <moqui.service.message.SystemMessageType systemMessageTypeId="EdiX12" description="X12 EDI interchange" contentType="application/edi-x12" receiveServiceName="mantle.edi.EdiServices.receive#X12Interchange" consumeServiceName="mantle.edi.EdiServices.consume#X12Interchange"/>
    <moqui.security.UserPermission userPermissionId="EDI_ADMIN" description="EDI Admin"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="EDI_ADMIN" fromDate="0"/>

    <!-- PayTrace (PaymentGatewayPayTrace, docs/PayTrace.md; its gateway type PgtPayTrace is the entity's seed): a product's
        level 3 commodity code, sent with its order and invoice lines as enhanced data (else the gateway's commodityCode). -->
    <moqui.basic.Enumeration description="Commodity Code (Level 3)" enumId="PidtCommodityCode" enumTypeId="ProductIdentificationType"/>

    <!-- Mantle's connection kinds for delegated connection administration (mr-boss plan/design-admin.md §8.1, §14; impl-admin P11):
        the gateway configurations as kinds of the framework's connection registry, each through
        mantle.account.GatewayConnectionServices.run#GatewayConnectionAdapter, the Mantle records that use a framework connection,
        and who may call store#PaymentGatewayOrganization. Named to load after 10-seed/01OrganizationFilterSets.xml, whose entity filter sets the grants name. -->
    <moqui.server.ConnectionAdapter adapterKey="paymentGateway" title="Payment gateway" adapterGroup="integration" creatable="Y"
            organizationBinding="Y" sequenceNum="10" description="A payment provider's configuration and connection (PaymentGatewayConfig)"
            adapterServiceName="mantle.account.GatewayConnectionServices.run#GatewayConnectionAdapter"/>
    <moqui.server.ConnectionAdapter adapterKey="shippingGateway" title="Shipping gateway" adapterGroup="integration" creatable="Y"
            sequenceNum="20" description="A carrier or label provider's configuration and connection (ShippingGatewayConfig)"
            adapterServiceName="mantle.account.GatewayConnectionServices.run#GatewayConnectionAdapter"/>
    <moqui.server.ConnectionAdapter adapterKey="taxGateway" title="Tax gateway" adapterGroup="integration" creatable="N"
            sequenceNum="30" description="A sales tax calculation (TaxGatewayConfig)"
            adapterServiceName="mantle.account.GatewayConnectionServices.run#GatewayConnectionAdapter"/>
    <moqui.server.ConnectionConsumerProvider providerKey="MantleRemoteGateways" adapterKey="remote" sequenceNum="10"
            serviceName="mantle.account.GatewayConnectionServices.find#RemoteConsumers"/>
    <moqui.server.ConnectionConsumerProvider providerKey="MantleFacilityPrinters" adapterKey="printer" sequenceNum="10"
            serviceName="mantle.account.GatewayConnectionServices.find#PrinterConsumers"/>

    <!-- store#PaymentGatewayOrganization for every signed-in user: it refuses without ADMIN_CONNECTION_MANAGE and outside the
        organizations the caller administers, which are the organization entity filters of the authorization the call runs
        under, as mantle.party.IdentityServices (10-seed/PartyAndIdentity.xml): an app screen's grant lends its own, this one carries
        MANTLE_USER_ORG where no screen grant covers the call, and ADMIN's MANTLE_ACTIVE_ORG. The adapter and consumer
        services are named in no grant: they are reached through the framework's connection services only. -->
    <moqui.security.ArtifactGroup artifactGroupId="MantleGatewayOrganizationServices" description="Mantle payment gateway organization bindings"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleGatewayOrganizationServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            artifactName="mantle.account.GatewayConnectionServices.store#PaymentGatewayOrganization"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleGatewayOrgServicesALL" userGroupId="ALL_USERS"
            artifactGroupId="MantleGatewayOrganizationServices" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="MantleGatewayOrgServicesALL" entityFilterSetId="MANTLE_USER_ORG"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleGatewayOrgServicesADMIN" userGroupId="ADMIN"
            artifactGroupId="MantleGatewayOrganizationServices" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="MantleGatewayOrgServicesADMIN" entityFilterSetId="MANTLE_ACTIVE_ORG"/>

    <!-- Shippo (mantle.ext.shipment.ShippoServices, docs/Shippo.md; ported from mantle-shippo 1.2.1, 2356f07): its
        options group and its webhook (the gateway type ShGtwyShippo and its option SgoLookupGraceSeconds are seeded in
        entity/shipment/ShipmentAndCarrierExtensions.xml). A Shippo webhook posts to
        /rest/sm/ShippoWebhook/{systemMessageRemoteId}, the remote of the gateway's connection, whose
        SmatHmacSha256Timestamp check of Shippo-Auth-Signature (or SmatUrlToken check of ?token=) runs before anything is kept.
        The API token is never an option: it is the remote's encrypted password. -->
    <moqui.basic.Enumeration description="Shippo Gateway Options" enumId="EgShippoOption" enumTypeId="EnumGroup"/>
    <moqui.basic.EnumGroupMember enumGroupEnumId="EgShippoOption" enumId="SgoLabelType" sequenceNum="1"/>
    <moqui.basic.EnumGroupMember enumGroupEnumId="EgShippoOption" enumId="SgoLookupGraceSeconds" sequenceNum="2"/>
    <moqui.service.message.SystemMessageType systemMessageTypeId="ShippoWebhook" description="Shippo webhook event" contentType="application/json" receiveServiceName="mantle.ext.shipment.ShippoServices.receive#Webhook" consumeServiceName="mantle.ext.shipment.ShippoServices.consume#Webhook"/>
</entity-facade-xml>
