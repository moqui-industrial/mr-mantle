    <!-- The export target of contact books (mantle.party.ContactImportServices; mr-boss impl-admin P16, design-admin §11
        DataExport, §16 "Business export"): a registration of the framework's org.moqui.admin.DataTransferServices, which
        dispatches an export to its owner's service as the exporter. A contact book the exporter may view, as vCard 4.0: the
        scopes are the books the caller owns or is given a share of, the fields the groups of a card's fields (the name
        always; birthdays and notes only when asked for), and the one selection option all contacts or the favorites. The
        services check the caller's own permission on the book and never write a contact another user owns privately; the
        registration asks for ADMIN_TRANSFER_RUN besides, and ADMIN_TRANSFER_VIEW to read the records of others' exports of a
        book the reader may view. No field names a permission of its own: what a viewer of a book reads of a contact is the
        whole card (Commons' own export gives the same). -->
    <moqui.server.TransferTarget targetId="contactBookVCard" direction="export" targetMode="file" title="Contact book (vCard)"
            description="The contacts of a contact book you may view, as a vCard file other address books read"
            ownerApp="Commons" targetVersion="1" scopeLabel="Contact book"
            columnsJson="[{&quot;name&quot;:&quot;name&quot;,&quot;label&quot;:&quot;Name&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;organization&quot;,&quot;label&quot;:&quot;Organization and title&quot;},{&quot;name&quot;:&quot;emails&quot;,&quot;label&quot;:&quot;Email addresses&quot;},{&quot;name&quot;:&quot;phones&quot;,&quot;label&quot;:&quot;Phone numbers&quot;},{&quot;name&quot;:&quot;addresses&quot;,&quot;label&quot;:&quot;Postal addresses&quot;},{&quot;name&quot;:&quot;websites&quot;,&quot;label&quot;:&quot;Websites&quot;},{&quot;name&quot;:&quot;groups&quot;,&quot;label&quot;:&quot;Groups and favorites&quot;},{&quot;name&quot;:&quot;birthday&quot;,&quot;label&quot;:&quot;Birthdays&quot;,&quot;selected&quot;:false},{&quot;name&quot;:&quot;notes&quot;,&quot;label&quot;:&quot;Notes&quot;,&quot;selected&quot;:false}]"
            optionsJson="[{&quot;name&quot;:&quot;favoritesOnly&quot;,&quot;label&quot;:&quot;Contacts&quot;,&quot;type&quot;:&quot;option&quot;,&quot;default&quot;:&quot;N&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;N&quot;,&quot;label&quot;:&quot;Every contact of the book&quot;},{&quot;value&quot;:&quot;Y&quot;,&quot;label&quot;:&quot;Favorites only&quot;}]}]"
            exportService="mantle.party.ContactImportServices.export#ContactBookTransfer"
            scopeService="mantle.party.ContactImportServices.find#ContactExportScopes"
            maxRows="5000" maxBytes="2097152"
            exportPermission="ADMIN_TRANSFER_RUN" viewPermission="ADMIN_TRANSFER_VIEW"
            ownerRoute="commonsContacts" sequenceNum="50"/>

    <!-- Staff invitations (mantle.party.IdentityServices; mr-boss impl-admin P5, design-admin §4.1, §16), named to load after
        01OrganizationFilterSets.xml (its filter sets): the invitation's states,
        the invitation email and the organization filters of its records. -->
    <moqui.basic.StatusType statusTypeId="UserInvitation" description="Staff invitation"/>
    <moqui.basic.StatusItem statusId="UinvPending" statusTypeId="UserInvitation" description="Pending" sequenceNum="1"/>
    <moqui.basic.StatusItem statusId="UinvAccepted" statusTypeId="UserInvitation" description="Accepted" sequenceNum="2"/>
    <moqui.basic.StatusItem statusId="UinvRevoked" statusTypeId="UserInvitation" description="Revoked" sequenceNum="3"/>
    <!-- not stored: a pending invitation past its expiry reads as expired -->
    <moqui.basic.StatusItem statusId="UinvExpired" statusTypeId="UserInvitation" description="Expired" sequenceNum="4"/>

    <!-- The invitation email (EmailType EMT_ACCOUNT_INVITE, framework BasicEntities): the organization, the inviter, the access
        proposed, the inviter's note and the acceptance link /i/<token>, sent without an EmailMessage record so the link is not
        stored (invite#User and resend#Invitation, createEmailMessage false) -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_STAFF_INVITATION" description="Staff Invitation" emailServerId="SYSTEM"
            emailTypeEnumId="EMT_ACCOUNT_INVITE" bodyScreenLocation="component://mr-mantle/template/party/StaffInvitation.xml"
            webappName="webroot" fromAddress="" ccAddresses="" bccAddresses="" subject="${organizationName}: you are invited to join"
            sendPartial="Y"/>

    <!-- An invitation is read under an app's organization filters by its organization (the Users area's MANTLE_USER_ORG for
        the identity operator, MANTLE_ACTIVE_ORG for the administrator), beside the services' own scope check -->
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_UINV" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.UserInvitation" filterMap="({organizationPartyId: filterOrgIds})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_UINV" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.UserInvitation" filterMap="({organizationPartyId: activeOrgId})"/>

    <!-- The import of staff invitations (mr-boss impl-admin P15; design-admin §4 Invitations' bulk invite, §11.1): a target
        of the framework's org.moqui.admin.DataTransferServices with no batch of its own (the framework keeps a
        TransferBatch). Its fields are exactly the address, an existing person, a display name, the organization (the
        batch's own) and the approved bundles; the expiry, the relationship and the note are options of the batch. A file
        with a column named like a password, a factor, a token, a group, a permission or a user id is refused whole. Each row is
        validated by invite#User's own checks and applied by invite#User as the importer, in a transaction of its own.
        Besides ADMIN_IDENTITY_MANAGE, which the row services check, the registration asks for ADMIN_TRANSFER_RUN. -->
    <moqui.server.TransferTarget targetId="staffInvitations" direction="import" targetMode="rows" title="Staff invitations"
            description="Invitations of staff to an organization, each with the access it proposes"
            effectsNote="Each row sends one invitation by email, as Invite users does. A person gets the organization and the access when they accept."
            ownerApp="Admin" targetVersion="1" fieldLabel="Invitation field" scopeLabel="Organization"
            columnsJson="[{&quot;name&quot;:&quot;emailAddress&quot;,&quot;label&quot;:&quot;Email&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;partyId&quot;,&quot;label&quot;:&quot;Existing person ID&quot;},{&quot;name&quot;:&quot;displayName&quot;,&quot;label&quot;:&quot;Name&quot;},{&quot;name&quot;:&quot;organizationPartyId&quot;,&quot;label&quot;:&quot;Organization ID&quot;},{&quot;name&quot;:&quot;bundleGroupIds&quot;,&quot;label&quot;:&quot;Access bundles&quot;}]"
            keyFields="emailAddress"
            optionsJson="[{&quot;name&quot;:&quot;expireDays&quot;,&quot;label&quot;:&quot;Link expires after (days)&quot;,&quot;type&quot;:&quot;integer&quot;,&quot;min&quot;:1,&quot;max&quot;:30,&quot;default&quot;:&quot;7&quot;},{&quot;name&quot;:&quot;relationshipTypeEnumId&quot;,&quot;label&quot;:&quot;Works as&quot;,&quot;type&quot;:&quot;option&quot;,&quot;default&quot;:&quot;PrtEmployee&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;PrtEmployee&quot;,&quot;label&quot;:&quot;Employee&quot;},{&quot;value&quot;:&quot;PrtAgent&quot;,&quot;label&quot;:&quot;Agent&quot;},{&quot;value&quot;:&quot;PrtMember&quot;,&quot;label&quot;:&quot;Member&quot;}]},{&quot;name&quot;:&quot;message&quot;,&quot;label&quot;:&quot;Note in the email&quot;,&quot;type&quot;:&quot;text&quot;,&quot;maxLength&quot;:2000,&quot;multiline&quot;:true}]"
            refusedColumns="group,permission,role,authz,privilege,userid"
            validateRowService="mantle.party.IdentityServices.validate#InvitationImportRow"
            applyRowService="mantle.party.IdentityServices.apply#InvitationImportRow"
            scopeService="mantle.party.IdentityServices.find#InvitationImportScopes"
            maxBytes="262144" maxRows="500" retentionDays="30"
            importPermission="ADMIN_TRANSFER_RUN,ADMIN_IDENTITY_MANAGE" viewPermission="ADMIN_TRANSFER_VIEW,ADMIN_IDENTITY_VIEW"
            ownerRoute="adminInvitations" sequenceNum="20"/>

    <!-- An account's lifecycle (mantle.party.IdentityServices; mr-boss impl-admin P6, design-admin §4.1 Offboarding, §17.2), named to
        load after 01OrganizationFilterSets.xml (its filter sets): the operation's kinds and states, the steps' states, the organization filters
        of the operations, and the owner change of calendars and contact books (F31). -->
    <moqui.basic.EnumerationType enumTypeId="UserLifecycleKind" description="Account lifecycle operation"/>
    <moqui.basic.Enumeration enumId="UlkDisable" enumTypeId="UserLifecycleKind" description="Disable" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="UlkOrgRemoval" enumTypeId="UserLifecycleKind" description="Organization removal" sequenceNum="2"/>
    <moqui.basic.Enumeration enumId="UlkRestore" enumTypeId="UserLifecycleKind" description="Restore" sequenceNum="3"/>
    <!-- impl-people P7: a People hire's provisioning (IdentityServices.request#Provisioning; design-admin §4.1 Provisioning from
        People): the membership, the account or invitation, the grants and the notice -->
    <moqui.basic.Enumeration enumId="UlkProvision" enumTypeId="UserLifecycleKind" description="Provisioning" sequenceNum="4"/>

    <moqui.basic.StatusType statusTypeId="UserLifecycleOperation" description="Account lifecycle operation"/>
    <moqui.basic.StatusItem statusId="UlopCompleted" statusTypeId="UserLifecycleOperation" description="Completed" sequenceNum="1"/>
    <moqui.basic.StatusItem statusId="UlopScheduled" statusTypeId="UserLifecycleOperation" description="Scheduled" sequenceNum="2"/>
    <moqui.basic.StatusItem statusId="UlopAttention" statusTypeId="UserLifecycleOperation" description="Needs attention" sequenceNum="3"/>
    <!-- impl-people P7 review (the user's call, Nov 11): a People access end whose separation was withdrawn before its date
        (PeopleServices.withdraw#EmploymentChange): its waiting steps skipped, the memberships and relationships it ended at the date
        continued; nothing more runs -->
    <moqui.basic.StatusItem statusId="UlopWithdrawn" statusTypeId="UserLifecycleOperation" description="Withdrawn" sequenceNum="4"/>
    <!-- impl-people P7 review (the user's call, Nov 11): a People provisioning or access end whose steps wait for an identity operator
        (IdentityServices.request#Provisioning and request#AccessEnd, Lifecycle.js notifyOperators) tells the employer's identity
        operators, who act from the tray or LifecycleOperations. The message holds operationId, kind, actionText, personName,
        organizationName and dateText: the person and employer an operator reads on the operation, no email, reason or terms. The app
        that shows it sets the link (IronStone: BossSetupData.xml, LifecycleDetail). -->
    <moqui.security.user.NotificationTopic topic="IdentityOperatorRequest" inboxEnumId="NinNotifications"
            description="Account request waiting for an identity operator" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="${actionText}: ${personName} (${organizationName})"/>
    <moqui.basic.StatusType statusTypeId="UserLifecycleStep" description="Account lifecycle step"/>
    <moqui.basic.StatusItem statusId="UlstDone" statusTypeId="UserLifecycleStep" description="Done" sequenceNum="1"/>
    <moqui.basic.StatusItem statusId="UlstWaiting" statusTypeId="UserLifecycleStep" description="Waiting for a new owner" sequenceNum="2"/>
    <moqui.basic.StatusItem statusId="UlstFailed" statusTypeId="UserLifecycleStep" description="Failed" sequenceNum="3"/>
    <moqui.basic.StatusItem statusId="UlstSkipped" statusTypeId="UserLifecycleStep" description="Skipped" sequenceNum="4"/>

    <!-- An operation is read under an app's organization filters by the organization it was requested for (the Users area's
        MANTLE_USER_ORG for the identity operator, MANTLE_ACTIVE_ORG for the administrator), beside the services' own checks; its
        steps are read only through it -->
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_ULOP" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.UserLifecycleOperation" filterMap="({organizationPartyId: filterOrgIds})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_ULOP" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.UserLifecycleOperation" filterMap="({organizationPartyId: activeOrgId})"/>

    <!-- The owner change of a calendar and of a shared contact book (CalendarServices, ContactBookServices; impl-admin P6, F31):
        their owner, or a manager of a shared one, hands them over; another user's need these permissions, granted to ADMIN (an
        app grants them to its identity operators). The services check the permission and the new owner themselves, so
        ALL_USERS may call them. -->
    <moqui.security.UserPermission userPermissionId="CALENDAR_OWNER_CHANGE" description="Calendars: change the owner of another user's calendar"/>
    <moqui.security.UserPermission userPermissionId="CONTACT_BOOK_OWNER_CHANGE" description="Contacts: change the manager of another user's shared contact book"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="CALENDAR_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="CONTACT_BOOK_OWNER_CHANGE" fromDate="0"/>
    <moqui.security.ArtifactGroup artifactGroupId="MantleResourceOwnerServices" description="Mantle owned resource lookup and owner change"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleResourceOwnerServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.(work\.CalendarServices\.(find#OwnedCalendars|transfer#CalendarOwner)|party\.ContactBookServices\.(find#OwnedContactBooks|transfer#ContactBookOwner))"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleResourceOwnerServicesALL" userGroupId="ALL_USERS"
            artifactGroupId="MantleResourceOwnerServices" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
