<entity-facade-xml type="seed">
    <!-- Change an internal organization's own Constitution, for an organization the user works in
        (service/mantle/party/ConstitutionServices.xml); the global document needs the framework's ADMIN_CONSTITUTION_GLOBAL -->
    <moqui.security.UserPermission userPermissionId="ORG_CONSTITUTION_EDIT" description="Change an organization's Constitution"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="ORG_CONSTITUTION_EDIT" fromDate="0"/>
    <!-- Organization-scoped identity (service/mantle/party/IdentityServices.xml; mr-boss impl-admin P4): every signed-in user may
        call the services, each refusing without the framework's ADMIN_IDENTITY_VIEW or ADMIN_IDENTITY_MANAGE (ADMIN holds them)
        and outside the organizations the caller administers; inheritable, so their writes (a person, its organization
        relationship, an account, the grant proposal through the framework's AccessServices) are authorized as the service and
        the security EECAs still decide each membership. Which identities and organizations are in scope is the organization
        entity filters of the authorization the call runs under (the views UserAccountOrganization and InternalOrganization;
        mr-boss impl-admin §4): an app screen's inheritable ALWAYS grant lends its own (MANTLE_ACTIVE_ORG for an administrator,
        every organization with none active), and this grant, used where no such screen grant covers the call (an Assistant
        tool, another app's service), carries MANTLE_USER_ORG: the caller's own organizations, the active one when set. ADMIN's
        own grant, ALWAYS so it is taken over the ALL_USERS one, carries MANTLE_ACTIVE_ORG, as ADMIN's app root grants do: every
        organization with none active, only the active one with one (mr-boss impl-admin §4, the P4 follow-up review). -->
    <moqui.security.ArtifactGroup artifactGroupId="MantleIdentityServices" description="Mantle identity services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleIdentityServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.party\.IdentityServices\..*"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleIdentityServicesALL" userGroupId="ALL_USERS"
            artifactGroupId="MantleIdentityServices" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="MantleIdentityServicesALL" entityFilterSetId="MANTLE_USER_ORG"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleIdentityServicesADMIN" userGroupId="ADMIN"
            artifactGroupId="MantleIdentityServices" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactAuthzFilter artifactAuthzId="MantleIdentityServicesADMIN" entityFilterSetId="MANTLE_ACTIVE_ORG"/>
    <!-- The owner services the framework's operation screens call as the caller (org.moqui.admin.OperationServices; the
        registrations moqui.server.RecoveryDescriptor in 10-seed/MarketingAndCommerce.xml and moqui.server.MailOutcomeOwner in
        15-seed-initial/CommerceAndShipping.xml and 15-seed-initial/Communications.xml): every user may call them, and each checks its own permission
        (SEC-ADM-10): the store channel ones COMMERCE_VIEW, COMMERCE_CHANNEL_OPERATE and the store scope (a message outside
        it is answered as held), the mail outcome owners a reader of the mail queue, the ledger's reconciliation
        MESSAGE_DELIVERY_REVIEW. Inheritable, so their own reads and writes run as them; the registration adds no right. -->
    <moqui.security.ArtifactGroup artifactGroupId="MantleOperationOwners" description="Mantle owner services of the operation screens"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleOperationOwners" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.product\.StoreChannelServices\.(find#MessageRecoveryTargets|recover#StoreMessage)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleOperationOwners" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.party\.MessageServices\.(find#MailOutcomeOwners|recover#OwnedMailOutcome)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleOperationOwners" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="N" artifactName="mantle.forum.DeliveryWorkerServices.find#MailOutcomeOwners"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleOperationOwnersALL" userGroupId="ALL_USERS"
            artifactGroupId="MantleOperationOwners" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>

    <!-- Change evidence of the records that belong to an internal organization (mantle.party.IdentityServices
        find#IdentityChanges; mr-boss impl-admin P17, design-admin §12 AuditChanges), named to load after 01OrganizationFilterSets.xml (its
        filter sets): the organization filters of the audit-log views (entity/party/PartyAndAgreementAndCommunicationViews.xml), and the projections the
        framework's org.moqui.admin.AuditServices answers through Mantle's source, each within the caller's organizations. The
        framework registers its own records of the whole instance (its data/AdminAuditData.xml); a user's account, its
        memberships, invitations and lifecycle belong to the organizations the user works for, which only Mantle knows. -->
    <!-- an audit row of an organization's record is read under an app's organization filters, as the record is -->
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDACCOUN" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogAccountOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDACCOUN" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogAccountOrganization" filterMap="({organizationPartyId: activeOrgId})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDMEMBER" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogMemberOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDMEMBER" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogMemberOrganization" filterMap="({organizationPartyId: activeOrgId})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDORG" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDORG" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogOrganization" filterMap="({organizationPartyId: activeOrgId})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDRELATI" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogRelationshipOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDRELATI" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogRelationshipOrganization" filterMap="({organizationPartyId: activeOrgId})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDINVITA" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogInvitationOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDINVITA" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogInvitationOrganization" filterMap="({organizationPartyId: activeOrgId})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDLIFECY" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogLifecycleOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDLIFECY" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogLifecycleOrganization" filterMap="({organizationPartyId: activeOrgId})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_USER_ORG_AUDACTOR" entityFilterSetId="MANTLE_USER_ORG"
            entityName="mantle.party.AuditLogActorOrganization" filterMap="({organizationPartyId: (filterOrgIds || []).concat(['_NA_'])})"/>
    <moqui.security.EntityFilter entityFilterId="MANTLE_ACTIVE_ORG_AUDACTOR" entityFilterSetId="MANTLE_ACTIVE_ORG"
            entityName="mantle.party.AuditLogActorOrganization" filterMap="({organizationPartyId: activeOrgId})"/>

