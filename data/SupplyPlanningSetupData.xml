<entity-facade-xml type="seed-initial">
    <!-- The plan schedule (crosscut CX-PLANNING, D20; impl-manufacturing P13): every 15 minutes, the active PlanSchedule rows
        whose next run is due, each its own planning run (SupplyPlanningServices.run#ScheduledSupplyPlans); with no schedule
        it does nothing -->
    <moqui.service.job.ServiceJob jobName="run_ScheduledSupplyPlans" description="Run the due supply plan schedules"
            serviceName="mantle.product.SupplyPlanningServices.run#ScheduledSupplyPlans" cronExpression="0 */15 * * * ?"
            paused="N" transactionTimeout="1800" errorHistoryOnly="Y"/>
</entity-facade-xml>
