<!-- The production schedule (design-manufacturing ProductionSchedule, §11; impl-manufacturing P12, F40): the states and kinds
    of a ProductionScheduleChange; its two notices are in ProductionScheduleNotificationData.xml. -->
<entity-facade-xml type="seed">
    <moqui.basic.StatusType statusTypeId="ProductionScheduleChange" description="Production schedule change"/>
    <moqui.basic.StatusItem statusId="SchApplied" statusTypeId="ProductionScheduleChange" description="Applied" sequenceNum="1"/>
    <moqui.basic.StatusItem statusId="SchRequested" statusTypeId="ProductionScheduleChange" description="Override requested"
            sequenceNum="2"/>
    <moqui.basic.StatusItem statusId="SchRefused" statusTypeId="ProductionScheduleChange" description="Override refused"
            sequenceNum="3"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SchRequested" toStatusId="SchApplied"
            transitionName="Approve override"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="SchRequested" toStatusId="SchRefused"
            transitionName="Refuse override"/>

    <moqui.basic.EnumerationType enumTypeId="ScheduleChangeKind" description="Schedule Change Kind"/>
    <moqui.basic.Enumeration enumId="SckMove" enumTypeId="ScheduleChangeKind" description="Move" sequenceNum="1"/>
    <moqui.basic.Enumeration enumId="SckUnschedule" enumTypeId="ScheduleChangeKind" description="Unschedule" sequenceNum="2"/>
</entity-facade-xml>
