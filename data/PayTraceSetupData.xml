<entity-facade-xml type="seed-initial">
    <!-- PayTrace (PaymentGatewayPayTrace, docs/PayTrace.md; its seed is PayTraceSeedData.xml). This job sends again the
        enhanced data PayTrace did not accept after a capture or sale (paused by default; every hour); the charge is never
        sent again, and a settled payment drops out. -->
    <moqui.service.job.ServiceJob jobName="retry_PayTraceEnhancedData" description="Retry PayTrace enhanced data" serviceName="mantle.account.PayTraceServices.retry#EnhancedData" cronExpression="0 15 * * * ?" paused="Y" transactionTimeout="1800"/>
</entity-facade-xml>
