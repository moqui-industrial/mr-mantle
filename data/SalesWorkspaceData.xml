<!-- Sales' workspace (impl-sales P6; IronStone Sales design §3 Home and OpportunityImport, §1.4 CX-OPS-REPORTS, §16; F24, F44, F54,
    F66):
    - the `opportunities` import target of the framework's org.moqui.admin.DataTransferServices (rows mode, the framework keeps the
      batch), on the staff invitations' and Maintenance's equipment pattern: its fields are a deal's facts, its source key and the
      people and stage it names, never a price, cost or password; its permissions Sales' own, all required, and no ADMIN_* one
      (impl-sales §4, F44); each row validated and applied by Sales' own guarded services as the importer (SalesImport.js);
    - the ReportScopePolicy MantleSalesScope: the pipeline dataset's row filter, Sales' scope (the organization, then the
      assignment or team), not the organization alone (F66), so the report engine calls it as its own reviewed code;
    - the row, scope and lifecycle services every user may call, each checking its own permission (SALES_IMPORT with
      SALES_OPPORTUNITY_EDIT; SALES_OWNER_CHANGE for another user's assignments), as Maintenance's import services are, and the
      check of a mail rule's createLead action every rule save runs (SalesIntake.secas.xml);
    - the lost reason the intake purge closes an untouched lead with (the user's call of Nov 13), ended from the start so it is
      offered to no one. -->
<entity-facade-xml type="seed">
    <moqui.server.TransferTarget targetId="opportunities" direction="import" targetMode="rows" title="Leads and opportunities"
            description="Leads and opportunities of an organization, each with its stage, owner, account and amount"
            effectsNote="Each row makes one lead or opportunity, or changes the one its source key or ID names when you choose to update matched deals, as New lead and New opportunity do. No account is made: a row names an existing account or none."
            ownerApp="Sales" targetVersion="1" fieldLabel="Deal field" scopeLabel="Organization"
            columnsJson="[{&quot;name&quot;:&quot;externalSource&quot;,&quot;label&quot;:&quot;Source system&quot;},{&quot;name&quot;:&quot;externalKey&quot;,&quot;label&quot;:&quot;Source key&quot;,&quot;required&quot;:true},{&quot;name&quot;:&quot;salesOpportunityId&quot;,&quot;label&quot;:&quot;Existing deal ID&quot;},{&quot;name&quot;:&quot;typeEnumId&quot;,&quot;label&quot;:&quot;Type (lead or opportunity)&quot;},{&quot;name&quot;:&quot;opportunityName&quot;,&quot;label&quot;:&quot;Name&quot;},{&quot;name&quot;:&quot;description&quot;,&quot;label&quot;:&quot;Description&quot;},{&quot;name&quot;:&quot;accountPartyId&quot;,&quot;label&quot;:&quot;Account ID&quot;},{&quot;name&quot;:&quot;contactPartyId&quot;,&quot;label&quot;:&quot;Contact ID&quot;},{&quot;name&quot;:&quot;salesPipelineId&quot;,&quot;label&quot;:&quot;Pipeline ID&quot;},{&quot;name&quot;:&quot;opportunityStageId&quot;,&quot;label&quot;:&quot;Stage&quot;},{&quot;name&quot;:&quot;ownerPartyId&quot;,&quot;label&quot;:&quot;Owner ID&quot;},{&quot;name&quot;:&quot;teamPartyId&quot;,&quot;label&quot;:&quot;Team ID&quot;},{&quot;name&quot;:&quot;estimatedAmount&quot;,&quot;label&quot;:&quot;Amount&quot;},{&quot;name&quot;:&quot;currencyUomId&quot;,&quot;label&quot;:&quot;Currency&quot;},{&quot;name&quot;:&quot;estimatedProbability&quot;,&quot;label&quot;:&quot;Probability&quot;},{&quot;name&quot;:&quot;estimatedCloseDate&quot;,&quot;label&quot;:&quot;Expected close&quot;},{&quot;name&quot;:&quot;dataSourceId&quot;,&quot;label&quot;:&quot;Lead source ID&quot;},{&quot;name&quot;:&quot;nextStep&quot;,&quot;label&quot;:&quot;Next step&quot;},{&quot;name&quot;:&quot;organizationPartyId&quot;,&quot;label&quot;:&quot;Organization ID&quot;}]"
            keyFields="externalSource,externalKey"
            optionsJson="[{&quot;name&quot;:&quot;duplicateStrategy&quot;,&quot;label&quot;:&quot;A deal already here&quot;,&quot;type&quot;:&quot;option&quot;,&quot;default&quot;:&quot;skip&quot;,&quot;options&quot;:[{&quot;value&quot;:&quot;skip&quot;,&quot;label&quot;:&quot;Skip it&quot;},{&quot;value&quot;:&quot;update&quot;,&quot;label&quot;:&quot;Update matched deals&quot;}]}]"
            refusedColumns="password,group,permission,authz,privilege,userid,cost,margin"
            validateRowService="mantle.sales.OpportunityServices.validate#OpportunityImportRow"
            applyRowService="mantle.sales.OpportunityServices.apply#OpportunityImportRow"
            scopeService="mantle.sales.OpportunityServices.find#OpportunityImportScopes"
            maxBytes="262144" maxRows="1000" retentionDays="30"
            importPermission="SALES_IMPORT,SALES_OPPORTUNITY_EDIT,SALES_TEAM_MANAGE" viewPermission="SALES_TEAM_VIEW"
            ownerRoute="salesOpportunityImport" sequenceNum="48"/>

    <moqui.basic.Enumeration enumId="MantleSalesScope" enumTypeId="ReportScopePolicy"
            enumCode="mantle.sales.SalesWorkspaceServices.get#PipelineRowFilter" description="the viewer's sales scope (organization, then assignment or team)"/>
    <!-- impl-sales P20: the quote dataset's (report/mantle-sales-quotes.json) -->
    <moqui.basic.Enumeration enumId="MantleSalesQuoteScope" enumTypeId="ReportScopePolicy"
            enumCode="mantle.sales.SalesWorkspaceServices.get#QuoteRowFilter" description="the viewer's sales quote scope (organization, then assignment or team)"/>

    <moqui.security.ArtifactGroup artifactGroupId="MantleSalesWorkspaceServices" description="Sales' import and lifecycle services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleSalesWorkspaceServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.sales\.OpportunityServices\.(validate#OpportunityImportRow|apply#OpportunityImportRow|find#OpportunityImportScopes|check#LeadRuleOwner)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleSalesWorkspaceServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            nameIsPattern="Y" artifactName="mantle\.sales\.SalesWorkspaceServices\.(find#OwnedSalesAssignments|transfer#SalesAssignment)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleSalesWorkspaceServicesALL" userGroupId="ALL_USERS"
            artifactGroupId="MantleSalesWorkspaceServices" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>

    <moqui.basic.Enumeration enumId="SlrIntakePurged" enumTypeId="SalesLostReason" description="Unverified inquiry purged"
            sequenceNum="99" thruDate="2000-01-01 00:00:00.000"/>
</entity-facade-xml>
