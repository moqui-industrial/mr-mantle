<entity-facade-xml type="seed-initial">
    <!-- A short pick (mantle.shipment.WarehouseTaskServices.record#ShortPick), to the facility owner's users holding
        SHIPMENT_LOAD_EDIT (the pick supervisors). No link template: the shipment's screen belongs to the app. -->
    <moqui.security.user.NotificationTopic topic="WarehouseShortPick" description="Short pick" typeString="warning"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y"
            titleTemplate="Short pick on ${shipmentId}: ${quantityShort} of ${productId} at ${locationSeqId || 'no location'}"/>
</entity-facade-xml>
