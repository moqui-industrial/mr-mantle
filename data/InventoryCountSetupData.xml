<entity-facade-xml type="seed-initial">
    <!-- Counts come due by the count schedule (InventoryCountServices.notify#DueCounts): the counters of the facility's
        organization, and each schedule's assignee, hear of a facility's due counts once a day. An app adds its
        linkTemplate. -->
    <moqui.security.user.NotificationTopic topic="WarehouseCountsDue" inboxEnumId="NinNotifications"
            description="Counts due" typeString="info" showAlert="N" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" titleTemplate="${dueCount} counts are due at ${facilityName}"/>
    <moqui.service.job.ServiceJob jobName="notify_DueCounts" description="Tell counters of the counts due"
            serviceName="mantle.product.InventoryCountServices.notify#DueCounts" cronExpression="0 30 5 * * ?" paused="N"
            transactionTimeout="1800"/>
</entity-facade-xml>
