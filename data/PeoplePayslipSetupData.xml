<entity-facade-xml type="seed-initial">
    <!-- impl-people P26 (design-people §8 PayslipDetail StatementOutput, §15 the payslip, §1.4 notification topics): a final payslip
        issued (PayrollResultServices issue#Payslip) tells its person, and them alone (directOnly: a subscription to every message of
        the topic receives none), that it is available: the message holds payslipId, organizationName, periodText and payDateText,
        never an amount; its link needs a sign-in and no attachment is mailed. The app that shows it sets the link (IronStone
        People: BossSetupData.xml, the person's own payslip in their self-service). -->
    <moqui.security.user.NotificationTopic topic="PayslipIssued" inboxEnumId="NinNotifications"
            description="Your payslip is available" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your payslip from ${organizationName} for ${periodText} is available"/>
</entity-facade-xml>
