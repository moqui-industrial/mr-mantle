<entity-facade-xml type="seed-initial">
    <!-- impl-people P18 (design-people §10 Qualifications, §1.4 notification topics): a person is reminded once per expiry that a
        verified qualification of theirs expires within thirty days (and not renewed by a later one). The message holds
        partyQualificationId, typeText and expiryText, never the reference, issuer or a file, so the title is safe on a lock
        screen. The app that shows them sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="QualificationExpiring" inboxEnumId="NinNotifications"
            description="Your qualification expiring" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your ${typeText} expires ${expiryText}"/>
    <!-- the daily reminder (mantle.humanres.DevelopmentServices.send#ExpiryReminders): each qualification in its own transaction,
        a failing one logged by its id and the rest going on; a rerun sends nothing again for the same expiry -->
    <moqui.service.job.ServiceJob jobName="send_QualificationExpiryReminders"
            description="Remind each person once that a verified qualification of theirs expires within thirty days"
            serviceName="mantle.humanres.DevelopmentServices.send#ExpiryReminders" cronExpression="0 45 0 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>
</entity-facade-xml>
