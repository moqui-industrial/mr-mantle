<entity-facade-xml type="seed-initial">
    <!-- impl-people P18 (design-people §10 Qualifications, §1.4 notification topics): a person is reminded once per expiry that a
        verified qualification of theirs expires within thirty days (and not renewed by a later one). The message holds
        partyQualificationId, typeText and expiryText, never the reference, issuer or a file, so the title is safe on a lock
        screen. The app that shows them sets the link (IronStone People: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="QualificationExpiring" inboxEnumId="NinNotifications"
            description="Your qualification expiring" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your ${typeText} expires ${expiryText}"/>
    <!-- the daily reminder (mantle.humanres.DevelopmentServices.send#ExpiryReminders): each qualification in its own transaction,
        a failing one logged by its id and the rest going on; a rerun sends nothing again for the same expiry -->
    <moqui.service.job.ServiceJob jobName="send_QualificationExpiryReminders"
            description="Remind each person once that a verified qualification of theirs expires within thirty days"
            serviceName="mantle.humanres.DevelopmentServices.send#ExpiryReminders" cronExpression="0 45 0 * * ?" paused="N"
            errorHistoryOnly="Y" transactionTimeout="1800"/>
    <!-- impl-people P19 (design-people §10 TrainingDetail's Enrollment, §12 ApprovalPolicies; F42): a place asked for in a training
        session by the person (DevelopmentServices.enroll#Training) waits for a People approval of kind PakTraining, sent to the
        approvers of the step waiting (the person's manager unless a rule says otherwise; never the person or who asked).
        approve#NotificationMessage and refuse#NotificationMessage call the topic's approve and refuse services as the user, which
        decide it at the revision in the message (decide#Enrollment over PeopleApprovalServices.record#Decision): the last approval
        enrolls the person (an attendee of the session's event), a refusal needs its reason. The message holds peopleApprovalId,
        personTrainingId, workEffortId, sourceRevision, partyId, personName, subjectText (the course and the session's day),
        organizationName, departmentName and stepText: no reason, result or score. The app that shows them sets the link
        (IronStone People: BossSetupData.xml). -->
    <moqui.basic.Enumeration enumId="PakTraining" description="Training enrollment" sequenceNum="8" enumTypeId="PeopleApprovalKind"/>
    <moqui.security.user.NotificationTopic topic="PeopleTrainingApproval" inboxEnumId="NinNotifications"
            description="Training place to approve" typeString="info" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.humanres.DevelopmentServices.approve#Enrollment"
            refuseServiceName="mantle.humanres.DevelopmentServices.refuse#Enrollment" refuseReasonRequired="Y"
            titleTemplate="Approve ${subjectText} (${organizationName}, ${stepText})"/>
</entity-facade-xml>
