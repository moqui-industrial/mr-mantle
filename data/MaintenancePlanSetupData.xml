<entity-facade-xml type="seed-initial">
    <!-- The preventive generation job (IronStone Maintenance design §5.1, DueMaintenance "disabled by default until configured";
        impl-maintenance P14): every morning at 05:30 (the machine's zone) it makes the work of the active plans whose next
        obligation is due (mantle.work.MaintenancePlanServices.run#MaintenanceGeneration). Seeded paused: an operations manager
        who holds MAINTENANCE_SETTINGS_EDIT resumes it in Admin's Jobs (its registration, data/MaintenancePlanData.xml). Initial
        data, so a resumed job is not paused again by a later load. -->
    <moqui.service.job.ServiceJob jobName="generate_MaintenanceWorkOrders" description="Make preventive maintenance work"
            serviceName="mantle.work.MaintenancePlanServices.run#MaintenanceGeneration" cronExpression="0 30 5 * * ?" paused="Y"
            transactionTimeout="1800"/>
</entity-facade-xml>
