<!-- Shop's digital delivery and the delivery ledger (mr-pass impl-shop P6): the jobs that resume digital fulfillment and run
    the ledger's queued and retrying deliveries, each item in its own transaction, the download-ready notice's store email
    type and ledger source, and the ledger's review permission with its ADMIN grant. -->
<entity-facade-xml type="seed-initial">
    <moqui.basic.Enumeration description="Downloads Ready" enumId="PsetDownloadReady" enumTypeId="ProductStoreEmailType"/>
    <moqui.basic.Enumeration enumId="MdsrcShopDownloads" description="Shop download-ready notice" sequenceNum="1"
            enumTypeId="MessageDeliverySource" enumCode="mantle.product.ShopFulfillmentServices.build#DownloadNotice"/>
    <moqui.security.UserPermission userPermissionId="MESSAGE_DELIVERY_REVIEW" description="Message Delivery Review"/>
    <moqui.security.UserGroupPermission userGroupId="ADMIN" userPermissionId="MESSAGE_DELIVERY_REVIEW" fromDate="0"/>

    <moqui.service.job.ServiceJob jobName="fulfill_StoreItems" description="Resume Shop digital fulfillment"
            serviceName="mantle.product.ShopFulfillmentServices.fulfill#StoreItems" cronExpression="0 0/5 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>
    <moqui.service.job.ServiceJob jobName="run_MessageDeliveries" description="Send queued and retrying deliveries"
            serviceName="mantle.party.MessageServices.run#Deliveries" cronExpression="0 0/2 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>

    <!-- The ledger as an owner of mail send outcomes (the framework's moqui.server.MailOutcomeOwner; mr-boss impl-admin P12):
        the mail queue asks it which stored messages are its attempts and leaves those to it; an uncertain one is reconciled
        through it, by a holder of MESSAGE_DELIVERY_REVIEW. -->
    <moqui.server.MailOutcomeOwner ownerKey="mantleDeliveryLedger" title="Delivery ledger" sequenceNum="10"
            description="Notices the apps queue on the outbound delivery ledger, which keeps their attempts"
            ownerService="mantle.party.MessageServices.find#MailOutcomeOwners"
            recoverService="mantle.party.MessageServices.recover#OwnedMailOutcome"/>
</entity-facade-xml>
