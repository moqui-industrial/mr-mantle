<!-- The production run's own transitions (design-manufacturing WorkOrderDetail States, F9; impl-manufacturing P5a): unrelease
    (Approved to In Planning), hold before start (Approved to On Hold) and its resume as released (On Hold to Approved). The
    framework accepts a transition of any status flow on any WorkEffort (call.rs check_status matches by from and to only),
    so each carries the permission its guard in transition#ProductionOrder checks: a task or project, and a user without the
    permission, still cannot take it through a generic update. transition#ProductionOrder is the path to a run's status and
    checks the run's state and facts besides. -->
<entity-facade-xml type="seed">
    <moqui.basic.StatusFlow statusFlowId="WorkEffortProduction" statusTypeId="WorkEffort"
            description="Production runs: unrelease, and hold before start with its resume as released"/>
    <moqui.basic.StatusFlowTransition statusFlowId="WorkEffortProduction" statusId="WeApproved" toStatusId="WeInPlanning"
            transitionName="Unrelease" userPermissionId="PRODUCTION_PLAN"/>
    <moqui.basic.StatusFlowTransition statusFlowId="WorkEffortProduction" statusId="WeApproved" toStatusId="WeOnHold"
            transitionName="Hold" userPermissionId="PRODUCTION_SUPERVISE"/>
    <moqui.basic.StatusFlowTransition statusFlowId="WorkEffortProduction" statusId="WeOnHold" toStatusId="WeApproved"
            transitionName="Resume as released" userPermissionId="PRODUCTION_SUPERVISE"/>
</entity-facade-xml>
