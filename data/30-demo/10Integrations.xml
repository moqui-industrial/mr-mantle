<entity-facade-xml type="demo">
    <!-- An Authorize.Net sandbox gateway, with no credentials: enter the API login id (username), transaction key
        (password) and signature key (sharedSecret) on the remote in the System Message Remote screen, or in a data file
        of the deployment's own, and the public client key on PaymentGatewayAuthorizeNet. For production use another
        remote with sendUrl https://api.authorize.net/xml/v1/request.api and usageCode P. To take cards for a store add a
        ProductStorePaymentGateway (paymentInstrumentEnumId PiCreditCard, paymentGatewayConfigId AuthorizeNetDemo). For a
        sale instead of authorize then capture, set authorizeServiceName to
        mantle.ext.account.gateway.AuthorizeNetServices.authorizeAndCapture#Payment and leave captureServiceName empty. -->
    <!-- the remote takes only its webhook type (SEC-RTE-86); the demo also declares that type for a standalone load -->
    <moqui.service.message.SystemMessageType systemMessageTypeId="AuthorizeNetWebhook" description="Authorize.Net webhook notification" contentType="application/json" receiveServiceName="mantle.ext.account.gateway.AuthorizeNetServices.receive#Webhook" consumeServiceName="mantle.ext.account.gateway.AuthorizeNetServices.consume#Webhook"/>
    <moqui.service.message.SystemMessageRemote systemMessageRemoteId="AuthorizeNetSandbox" systemMessageTypeId="AuthorizeNetWebhook" description="Authorize.Net sandbox" sendUrl="https://apitest.authorize.net/xml/v1/request.api" usageCode="T" messageAuthEnumId="SmatHmacSha512" authHeaderName="X-ANET-Signature"/>
    <mantle.account.method.PaymentGatewayConfig paymentGatewayConfigId="AuthorizeNetDemo" paymentGatewayTypeEnumId="PgtAuthorizeNet" description="Authorize.Net sandbox" systemMessageRemoteId="AuthorizeNetSandbox" authorizeServiceName="mantle.ext.account.gateway.AuthorizeNetServices.authorize#Payment" captureServiceName="mantle.ext.account.gateway.AuthorizeNetServices.capture#Payment" releaseServiceName="mantle.ext.account.gateway.AuthorizeNetServices.release#Payment" refundServiceName="mantle.ext.account.gateway.AuthorizeNetServices.refund#Payment" detailsServiceName="mantle.ext.account.gateway.AuthorizeNetServices.get#PaymentGatewayDetails"/>
    <mantle.account.method.PaymentGatewayAuthorizeNet paymentGatewayConfigId="AuthorizeNetDemo" validationMode="none" lookupGraceSeconds="300"/>

    <!-- A PayTrace sandbox gateway, with no credentials: enter the API user (username) and its password (password) on the
        remote in the System Message Remote screen, or in a data file of the deployment's own, and the merchant id and the
        integrator id PayTrace issued on PaymentGatewayPayTrace. For production use another remote with sendUrl
        https://api.paytrace.com and usageCode P. To take cards for a store add a ProductStorePaymentGateway
        (paymentInstrumentEnumId PiCreditCard, paymentGatewayConfigId PayTraceDemo). For a sale instead of authorize then
        capture, set authorizeServiceName to mantle.ext.account.gateway.PayTraceServices.authorizeAndCapture#Payment and leave
        captureServiceName empty. -->
    <moqui.service.message.SystemMessageRemote systemMessageRemoteId="PayTraceSandbox" description="PayTrace sandbox" sendUrl="https://api.sandbox.paytrace.com" usageCode="T"/>
    <mantle.account.method.PaymentGatewayConfig paymentGatewayConfigId="PayTraceDemo" paymentGatewayTypeEnumId="PgtPayTrace" description="PayTrace sandbox" systemMessageRemoteId="PayTraceSandbox" authorizeServiceName="mantle.ext.account.gateway.PayTraceServices.authorize#Payment" captureServiceName="mantle.ext.account.gateway.PayTraceServices.capture#Payment" releaseServiceName="mantle.ext.account.gateway.PayTraceServices.release#Payment" refundServiceName="mantle.ext.account.gateway.PayTraceServices.refund#Payment" detailsServiceName="mantle.ext.account.gateway.PayTraceServices.get#PaymentGatewayDetails"/>
    <mantle.account.method.PaymentGatewayPayTrace paymentGatewayConfigId="PayTraceDemo" currencyUomId="USD" lookupGraceSeconds="300" sendEnhancedData="Y" defaultUnitOfMeasure="PCE"/>

    <!-- A Shippo test-mode gateway (docs/Shippo.md), with no credentials: enter the Shippo test API token as the password of
        the remote ShippoSandbox, and the webhook secret as its sharedSecret (Shippo's HMAC secret with
        SmatHmacSha256Timestamp, or a self-generated URL token with SmatUrlToken), in the System Message Remote screen or a
        deployment's own data file, never here. For SmatUrlToken also set authHeaderName to token (the query parameter's name;
        Shippo-Auth-Signature would refuse every delivery) and use a URL-safe token (letters, digits, - and _: a + decodes to a
        space). Fill each carrier's gatewayAccountId with the object_id of its Shippo carrier
        account (GET /carrier_accounts with the token). A test gateway buys labels only for an organization whose
        ShippingTestGatewayAllowed party setting is Y; bind the gateway to a store's carrier (ProductStoreShippingGateway) or a
        route segment, then request, track, refund and print labels through the Warehouse shipping flow. For production use
        another remote with the live token, usageCode P, and a gateway with testMode N. -->
    <!-- Shippo parcel templates (see Shippo's parcel templates) as box types, from mantle-shippo's demo data -->
    <mantle.shipment.ShipmentBoxType shipmentBoxTypeId="USPS_SmFlat" description="USPS Small Flat Rate Box" dimensionUomId="LEN_in" boxLength="8.69" boxWidth="5.44" boxHeight="1.75" gatewayBoxId="USPS_SmallFlatRateBox"/>
    <mantle.shipment.ShipmentBoxType shipmentBoxTypeId="USPS_MdFlat1" description="USPS Medium Flat Rate Box 1" dimensionUomId="LEN_in" boxLength="11.25" boxWidth="8.75" boxHeight="6" gatewayBoxId="USPS_MediumFlatRateBox1"/>
    <mantle.shipment.ShipmentBoxType shipmentBoxTypeId="USPS_LgFlat" description="USPS Large Flat Rate Box" dimensionUomId="LEN_in" boxLength="12.25" boxWidth="12.25" boxHeight="6" gatewayBoxId="USPS_LargeFlatRateBox"/>
    <!-- the remote takes only its webhook type (SEC-RTE-86); the demo also declares that type for a standalone load -->
    <moqui.service.message.SystemMessageType systemMessageTypeId="ShippoWebhook" description="Shippo webhook event" contentType="application/json" receiveServiceName="mantle.ext.shipment.ShippoServices.receive#Webhook" consumeServiceName="mantle.ext.shipment.ShippoServices.consume#Webhook"/>
    <moqui.service.message.SystemMessageRemote systemMessageRemoteId="ShippoSandbox" systemMessageTypeId="ShippoWebhook" description="Shippo (test token)" sendUrl="https://api.goshippo.com" usageCode="T" messageAuthEnumId="SmatHmacSha256Timestamp" authHeaderName="Shippo-Auth-Signature"/>
    <mantle.shipment.carrier.ShippingGatewayConfig shippingGatewayConfigId="SHIPPO_DEMO" shippingGatewayTypeEnumId="ShGtwyShippo" description="Shippo (test mode)" testMode="Y" systemMessageRemoteId="ShippoSandbox" getOrderRateServiceName="mantle.ext.shipment.ShippoServices.get#OrderShippingRate" getShippingRatesBulkName="mantle.ext.shipment.ShippoServices.get#ShippingRatesBulk" getRateServiceName="mantle.ext.shipment.ShippoServices.get#ShippingRate" requestLabelsServiceName="mantle.ext.shipment.ShippoServices.request#ShippingLabels" findLabelServiceName="mantle.ext.shipment.ShippoServices.find#ShippingLabels" refundLabelsServiceName="mantle.ext.shipment.ShippoServices.refund#ShippingLabels" trackLabelsServiceName="mantle.ext.shipment.ShippoServices.track#ShippingLabels" validateAddressServiceName="mantle.ext.shipment.ShippoServices.validate#ShippingPostalAddress">
        <!-- the Shippo carrier account object_ids of this Shippo account, to fill in -->
        <carriers carrierPartyId="USPS" gatewayAccountId=""/>
        <carriers carrierPartyId="UPS" gatewayAccountId=""/>
        <carriers carrierPartyId="FedEx" gatewayAccountId=""/>
        <carriers carrierPartyId="DHLX" gatewayAccountId=""/>
        <options optionEnumId="SgoLabelType" optionValue="PDF_4x6"/>
        <options optionEnumId="SgoLookupGraceSeconds" optionValue="300"/>
        <!-- USPS First-Class Package (usps_first, 20-install/Carriers.xml) became Ground Advantage -->
        <methods carrierPartyId="USPS" shipmentMethodEnumId="ShMthGround" gatewayServiceCode="usps_ground_advantage"/>
        <boxTypes shipmentBoxTypeId="USPS_SmFlat" gatewayBoxId="USPS_SmallFlatRateBox"/>
    </mantle.shipment.carrier.ShippingGatewayConfig>

    <!-- The Mantle test carrier's carrier (impl-warehouse P13 review A2): TEST_CARRIER with three services, served by the
        TEST_SHIPPING gateway (20-install/Carriers.xml). Demo data, so specs and demos have it and a production install's carrier
        choices do not. -->
    <mantle.party.Party partyId="TEST_CARRIER" partyTypeEnumId="PtyOrganization">
        <organization organizationName="Test Carrier"/>
        <roles roleTypeId="Carrier"/>
    </mantle.party.Party>
    <mantle.shipment.carrier.CarrierShipmentMethod carrierPartyId="TEST_CARRIER" shipmentMethodEnumId="ShMthGround"
            sequenceNum="1" description="Test Ground" gatewayServiceCode="test_ground"/>
    <mantle.shipment.carrier.CarrierShipmentMethod carrierPartyId="TEST_CARRIER" shipmentMethodEnumId="ShMthSecondDay"
            sequenceNum="2" description="Test Second Day" gatewayServiceCode="test_second_day"/>
    <mantle.shipment.carrier.CarrierShipmentMethod carrierPartyId="TEST_CARRIER" shipmentMethodEnumId="ShMthNextDay"
            sequenceNum="3" description="Test Next Day" gatewayServiceCode="test_next_day"/>
    <mantle.shipment.carrier.ShippingGatewayCarrier shippingGatewayConfigId="TEST_SHIPPING" carrierPartyId="TEST_CARRIER"
            gatewayAccountId="TEST-ACCOUNT-0001"/>
</entity-facade-xml>
