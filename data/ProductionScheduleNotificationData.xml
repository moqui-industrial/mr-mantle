<!-- The production schedule's notices (design-manufacturing §11, F40; impl-manufacturing P12). ProductionScheduleOverride is a
    scheduler's request that a supervisor apply a move over its conflicts, sent by schedule#ProductionOperation (action
    request) to the organization's PRODUCTION_SUPERVISE holders and decided on the schedule (approve or refuse, which mark
    the requests read), so it has no approve service. ProductionScheduleChange is the notice of an applied change, to the
    run's people (else the supervisors). -->
<entity-facade-xml type="seed-initial">
    <moqui.security.user.NotificationTopic topic="ProductionScheduleOverride" inboxEnumId="NinNotifications"
            description="Schedule override to decide" typeString="warning" showAlert="Y" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="Decide a schedule override of ${operationName}"/>
    <moqui.security.user.NotificationTopic topic="ProductionScheduleChange" inboxEnumId="NinNotifications"
            description="Production schedule changed" typeString="info" showAlert="N" persistOnSend="Y"
            receiveNotifications="Y" isPrivate="Y" titleTemplate="${operationName} of ${workEffortId} moved: ${changeText}"/>
</entity-facade-xml>
