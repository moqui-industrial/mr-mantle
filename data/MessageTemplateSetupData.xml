<!-- Comms' templates, sending profiles and bounce intake (impl-marketing P6, F13, F14, F18, F76; design-marketing §5, §12, §15.1,
    §15.3; mantle.party.MessageServices): the ledger's template source, whose build renders a template's content in effect; the
    bounce intake's poll job, its registration with Admin (a job with its operation) and its registered recovery (a run outside its
    schedule reads again the reports a run could not: each message is read once, so a run again changes nothing it applied). -->
<entity-facade-xml type="seed-initial">
    <moqui.basic.Enumeration enumId="MdsrcMessageTemplate" description="Message template" sequenceNum="30" enumTypeId="MessageDeliverySource"
            enumCode="mantle.party.MessageServices.build#TemplateDelivery"/>

    <moqui.service.job.ServiceJob jobName="run_DeliveryReports" description="Read the bounce accounts' delivery and abuse reports"
            serviceName="mantle.party.MessageServices.run#DeliveryReports" cronExpression="0 0/10 * * * ?"
            paused="N" errorHistoryOnly="Y" transactionTimeout="1800"/>
    <moqui.server.JobRegistration jobName="run_DeliveryReports" ownerApp="Comms" title="Read delivery and abuse reports"
            description="Reads the reports the bounce accounts received and the edge relay's bounces that were not read when they came, each once: a hard bounce or a complaint suppresses the address"
            managePermission="MESSAGE_SENDING_CONFIGURE" scheduleEditable="Y" minIntervalMinutes="5" pauseEditable="Y"
            priorityEditable="Y" retryEditable="Y" recipientPermission="MESSAGE_SENDING_CONFIGURE" sequenceNum="70"/>
    <moqui.server.RecoveryDescriptor descriptorKey="messageDeliveryReports" title="Delivery and abuse reports" ownerApp="Comms"
            targetKind="ServiceJob" targetKey="run_DeliveryReports" retryMode="native" managePermission="MESSAGE_SENDING_CONFIGURE"
            idempotencyNote="Each report is read once (one record a message) and each fact of a delivery is kept once, so a run again reads only what was not read or failed, and suppresses an address once."
            sequenceNum="70"/>
</entity-facade-xml>
