<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="seed-initial">
    <!-- The shipped sales dashboard executes through the authorized reporting boundary. -->
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOrderItem" userGroupId="ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesOrderPart" userGroupId="ADMIN"/>
    <!-- the sales invoice documents (index:mantle_sales and the sales summaries read them) and the inventory asset document of
        the mantle-inventory dataset, the system administrator's as the orders are; an application grants its own groups -->
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesInvoice" userGroupId="ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleSalesInvoiceItem" userGroupId="ADMIN"/>
    <moqui.entity.document.DataDocumentUserGroup dataDocumentId="MantleInventoryAsset" userGroupId="ADMIN"/>
    <!-- The organization scope policy of business datasets (the report engine's ReportScopePolicy; mantle-sales-orders,
        mantle-sales-items and mantle-inventory name it): the rows of the viewer's organizations on the field the dataset names
        in the rowFilterParameters entry registered here (optionValue: organizationField), which the dataset forms ask for -->
    <moqui.basic.Enumeration enumId="MantleOrganization" enumTypeId="ReportScopePolicy"
            enumCode="mantle.party.PartyServices.get#OrganizationRowFilter" description="the viewer's organizations"
            optionValue="organizationField"/>
    <!-- Business events (mantle.party.BusinessEventServices; the report engine's ReportAnnotationSource): the dataset
        mantle-business-events over the engine's annotations, scoped to the viewer's organizations by the policy above, which a
        dashboard over business data reads for its markers; the system administrator reads it through the engine's dataset
        administration, and an application grants its own groups the dataset's artifact -->
    <moqui.basic.Enumeration enumId="MantleBusinessEvents" enumTypeId="ReportAnnotationSource"
            enumCode="mantle-business-events" description="Mantle's business events (price lists, promotions, period closes)"/>
</entity-facade-xml>
