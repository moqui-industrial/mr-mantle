<entity-facade-xml type="seed-initial">
    <!-- Sent to the method organization's users holding METHOD_APPROVE when a method engineer asks for a BOM or routing
        draft to be released (mantle.product.BomServices request#BomRelease, mantle.work.RoutingServices
        request#RoutingRelease). The release is decided on the method (release#BomDraft, release#RoutingDraft), never from
        the notification, so these have no approve service; the release marks them read. -->
    <moqui.security.user.NotificationTopic topic="BomRelease" inboxEnumId="NinNotifications"
            description="BOM draft to release" typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" titleTemplate="Release the BOM of ${methodName}"/>
    <moqui.security.user.NotificationTopic topic="RoutingRelease" inboxEnumId="NinNotifications"
            description="Routing draft to release" typeString="info" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            isPrivate="Y" titleTemplate="Release routing ${methodName}"/>
</entity-facade-xml>
