<#-- An applied order change (mantle.order.OrderChangeServices.apply#OrderChange): the PDF stored as the order's OrderContent
     (OctOrderChangeApplied) that send#OrderChangeConfirmation attaches. orderId, requestId, organizationName, customerName,
     kindText, reasonText, appliedText, revisionText and lines (seq, actionText, beforeText, afterText). -->
<!doctype html>
<html><head><meta charset="utf-8"><title>${ec.l10n.localize('Order change')} ${requestId}</title>
<style>
@page { size: A4; margin: 18mm; }
body { font: 10pt Helvetica, Arial, sans-serif; color: #20252b; }
h1 { font-size: 18pt; margin: 0 0 2mm; }
.sub { color: #59606b; margin: 0 0 6mm; }
table { border-collapse: collapse; width: 100%; }
td, th { padding: 4px 6px; text-align: left; vertical-align: top; }
.facts th { width: 38mm; font-weight: bold; }
.lines { margin-top: 6mm; }
.lines th { border-bottom: 1px solid #20252b; }
.lines td { border-bottom: 1px solid #ddd; }
</style></head>
<body>
<h1>${ec.l10n.localize('Change to order')} ${orderId}</h1>
<p class="sub">${ec.l10n.localize('Applied')} ${appliedText}</p>
<table class="facts"><tbody>
    <tr><th>${ec.l10n.localize('Seller')}</th><td>${organizationName}</td></tr>
    <tr><th>${ec.l10n.localize('Customer')}</th><td>${customerName}</td></tr>
    <tr><th>${ec.l10n.localize('Change')}</th><td>${kindText} (${requestId}, ${ec.l10n.localize('revision of')} ${revisionText})</td></tr>
    <#if reasonText><tr><th>${ec.l10n.localize('Reason')}</th><td>${reasonText}</td></tr></#if>
</tbody></table>
<table class="lines">
    <thead><tr>
        <th>#</th>
        <th>${ec.l10n.localize('Change')}</th>
        <th>${ec.l10n.localize('Before')}</th>
        <th>${ec.l10n.localize('After')}</th>
    </tr></thead>
    <tbody>
    <#list lines as line>
        <tr><td>${line.seq}</td><td>${line.actionText}</td><td>${line.beforeText}</td><td>${line.afterText}</td></tr>
    </#list>
    </tbody>
</table>
</body></html>
