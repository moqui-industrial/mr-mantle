<#-- A customer return's authorization (RMA) as the customer reads it (mantle.order.ReturnPolicyServices
     get#ReturnAuthorizationPrint; authorize#Return stores its PDF as the return's ReturnContent and send#ReturnAuthorization
     mails it): returnId, displayId, organizationName, customerName, customerReference, authorizedText, expireText,
     shipToText, trackingText, instructions and lines (productText, quantityText, reasonText, responseText). No amount, cost or
     internal note. -->
<!doctype html>
<html><head><meta charset="utf-8"><title>${ec.l10n.localize('Return authorization')} ${displayId}</title>
<style>
@page { size: A4; margin: 18mm; }
body { font: 10pt Helvetica, Arial, sans-serif; color: #20252b; }
h1 { font-size: 18pt; margin: 0 0 2mm; }
.sub { color: #59606b; margin: 0 0 6mm; }
table { border-collapse: collapse; width: 100%; }
td, th { padding: 4px 6px; text-align: left; vertical-align: top; }
thead { display: table-header-group; }
tbody tr { break-inside: avoid; }
.facts th { width: 42mm; font-weight: bold; }
.lines { margin-top: 6mm; }
.lines th { border-bottom: 1px solid #20252b; }
.lines td { border-bottom: 1px solid #ddd; }
.amount { text-align: right; white-space: nowrap; }
.note { color: #59606b; font-size: 9pt; margin-top: 6mm; }
</style></head>
<body>
<h1>${ec.l10n.localize('Return authorization')} ${displayId}</h1>
<p class="sub">${ec.l10n.localize('Authorized')} ${authorizedText}<#if expireText> · ${ec.l10n.localize('send the goods by')} ${expireText}</#if></p>
<table class="facts"><tbody>
    <tr><th>${ec.l10n.localize('From')}</th><td>${organizationName}</td></tr>
    <tr><th>${ec.l10n.localize('Customer')}</th><td>${customerName}</td></tr>
    <#if customerReference><tr><th>${ec.l10n.localize('Your reference')}</th><td>${customerReference}</td></tr></#if>
    <#if shipToText><tr><th>${ec.l10n.localize('Send to')}</th><td>${shipToText}</td></tr></#if>
    <#if trackingText><tr><th>${ec.l10n.localize('Return label')}</th><td>${trackingText}</td></tr></#if>
</tbody></table>
<table class="lines">
    <thead><tr>
        <th>${ec.l10n.localize('Item')}</th>
        <th class="amount">${ec.l10n.localize('Quantity')}</th>
        <th>${ec.l10n.localize('Reason')}</th>
        <th>${ec.l10n.localize('Asked for')}</th>
    </tr></thead>
    <tbody>
    <#list lines as line>
        <tr>
            <td>${line.productText}</td>
            <td class="amount">${line.quantityText}</td>
            <td>${line.reasonText}</td>
            <td>${line.responseText}</td>
        </tr>
    </#list>
    </tbody>
</table>
<#if instructions><p class="note">${instructions}</p></#if>
<p class="note">${ec.l10n.localize('Write the authorization number on the package. Goods that arrive after the date above may be refused.')}</p>
</body></html>
