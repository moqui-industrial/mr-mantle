<#-- Mantle's default reminder of an issued quote (locked, F70): the organization's own text takes this one's place by
     SalesPolicy.reminderTextLocation. It sees only its map: quoteId, quoteName, customerName, contactName, sellerName, repName,
     issuedText, validThruText, totalText, linkUrl. -->
<p>${localize('Dear')} ${contactName || customerName},</p>
<p>${localize('A reminder of our quote')} ${quoteId}<#if quoteName> (${quoteName})</#if> ${localize('of')} ${issuedText}, ${localize('valid through')} ${validThruText}. ${localize('It is attached again for you.')}</p>
<#if linkUrl><p>${localize('You can open it here')}: ${linkUrl}</p></#if>
<p>${localize('Kind regards')},<br>${repName || sellerName}<br>${sellerName}</p>
