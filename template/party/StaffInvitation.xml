<!-- The staff invitation email (EmailTemplate MANTLE_STAFF_INVITATION, EmailType EMT_ACCOUNT_INVITE; mr-boss design-admin §16,
    impl-admin P5): who invited the person to which organization, the access proposed, the inviter's note, when the link
    expires and the acceptance link (acceptUrl, /i/<token>). mantle.party.IdentityServices invite#User and resend#Invitation pass
    the body parameters and send it with no EmailMessage record, so the link is not stored. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" default-menu-include="false">
    <widgets>
        <render-mode><text type="html"><![CDATA[<html><body>]]></text></render-mode>
        <container><label text="${inviterName || 'An administrator'} invited you to join ${organizationName} in IronStone BOSS." type="p"/></container>
        <container><label text="Access proposed: ${bundleSummary}" type="p" condition="bundleSummary"/></container>
        <container><label text="${message}" type="p" condition="message"/></container>
        <container><link url="${acceptUrl}" url-type="plain" text="Accept the invitation"/></container>
        <container><label text="Or open this address: ${acceptUrl}" type="p"/></container>
        <container><label text="The link works once and expires on ${expiresText}. If you did not expect this invitation, ignore this email." type="p"/></container>
        <render-mode><text type="html"><![CDATA[</body></html>]]></text></render-mode>
    </widgets>
</screen>
